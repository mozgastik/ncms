<?php

namespace App\Controller\User;

use App\Entity\User\User;

use App\Entity\System\Favorite;
use App\Entity\Notification\UserNotificationSettings;
use App\Entity\Notification\AdminNotification;
use App\Repository\AdminNotificationRepository;
use App\Form\ProfileType;
use App\Form\ChangePasswordType;
use App\Form\UserNotificationSettingsType;
use Doctrine\ORM\EntityManagerInterface;
use Symfony\Bundle\FrameworkBundle\Controller\AbstractController;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\HttpFoundation\Response;
use Symfony\Component\PasswordHasher\Hasher\UserPasswordHasherInterface;
use Symfony\Component\Routing\Annotation\Route;
use Symfony\Component\Security\Http\Attribute\IsGranted;
use Symfony\Component\HttpFoundation\JsonResponse;

#[Route('/user')]
class UserController extends AbstractController
{

    // ДОДАНО: маршрут для /user (перенаправляє на dashboard)
    #[Route('', name: 'user_index')]
    #[IsGranted('ROLE_USER')]
    public function index(): Response
    {
        return $this->redirectToRoute('user_dashboard');
    }

    #[Route('/dashboard', name: 'user_dashboard')]
    #[IsGranted('ROLE_USER')]
    public function dashboard(): Response
    {
        $user = $this->getUser();
        
        return $this->render('user/dashboard.html.twig', [
            'user' => $user,
        ]);
    }

    #[Route('/profile', name: 'user_profile')]
    #[IsGranted('ROLE_USER')]
    public function profile(Request $request, EntityManagerInterface $entityManager): Response
{
    $user = $this->getUser();
    $form = $this->createForm(ProfileType::class, $user);
    
    $form->handleRequest($request);
    
    if ($form->isSubmitted() && $form->isValid()) {
        // Обробка завантаженого аватара
        $avatarFile = $form->get('avatarFile')->getData();
        
        if ($avatarFile) {
            // Видаляємо старий аватар
            if ($user->getAvatar()) {
                $oldAvatarPath = $this->getParameter('avatars_directory') . '/' . $user->getAvatar();
                if (file_exists($oldAvatarPath)) {
                    unlink($oldAvatarPath);
                }
            }
            
            // Генеруємо унікальне ім'я файлу
            $newFilename = uniqid() . '.' . $avatarFile->guessExtension();
            
            // Переміщуємо файл у директорію avatars
            try {
                $avatarFile->move(
                    $this->getParameter('avatars_directory'),
                    $newFilename
                );
                
                // Оновлюємо поле avatar в базі даних
                $user->setAvatar($newFilename);
                
                $this->addFlash('success', 'Аватар успішно оновлено!');
            } catch (FileException $e) {
                $this->addFlash('error', 'Помилка при завантаженні аватара');
            }
        }
        
        $user->setUpdatedAt(new \DateTimeImmutable());
        $entityManager->flush();
        
        $this->addFlash('success', 'Профіль успішно оновлено!');
        return $this->redirectToRoute('user_profile');
    }
    
    return $this->render('user/profile.html.twig', [
        'form' => $form->createView(),
        'user' => $user,
    ]);
}
    #[Route('/comments', name: 'user_comments')]
    #[IsGranted('ROLE_USER')]
    public function comments(): Response
    {
        $user = $this->getUser();
        
        return $this->render('user/comments.html.twig', [
            'user' => $user,
            'comments' => $user->getComments(),
        ]);
    }

    #[Route('/change-password', name: 'user_change_password')]
    #[IsGranted('ROLE_USER')]
    public function changePassword(
        Request $request, 
        EntityManagerInterface $entityManager,
        UserPasswordHasherInterface $passwordHasher
    ): Response
    {
        $user = $this->getUser();
        $form = $this->createForm(ChangePasswordType::class, $user);
        
        $form->handleRequest($request);
        
        if ($form->isSubmitted() && $form->isValid()) {
            $newPassword = $form->get('plainPassword')->getData();
            $user->setPassword($passwordHasher->hashPassword($user, $newPassword));
            
            $user->setUpdatedAt(new \DateTimeImmutable());
            $entityManager->flush();
            
            $this->addFlash('success', 'Пароль успішно змінено!');
            return $this->redirectToRoute('user_dashboard');
        }
        
        return $this->render('user/change_password.html.twig', [
            'form' => $form->createView(),
            'user' => $user,
        ]);
    }

   // src/Controller/UserController.php

#[Route('/favorites', name: 'user_favorites')]
#[IsGranted('ROLE_USER')]
public function favorites(Request $request, EntityManagerInterface $em): Response
{
    $user = $this->getUser();
    $type = $request->query->get('type', 'all');
    $page = $request->query->getInt('page', 1);
    $limit = 10;
    
    $favoriteRepository = $em->getRepository(Favorite::class);
    $favorites = $favoriteRepository->findBy(
        ['user' => $user],
        ['createdAt' => 'DESC']
    );
    
    // Завантажуємо пов'язані сутності
    foreach ($favorites as $favorite) {
        if ($favorite->getEntityType() === 'article') {
            $favorite->article = $em->getRepository(Article::class)->find($favorite->getEntityId());
        } elseif ($favorite->getEntityType() === 'blog') {
            $favorite->blog = $em->getRepository(Blog::class)->find($favorite->getEntityId());
        }
    }
    
    // Фільтрація за типом
    if ($type !== 'all') {
        $favorites = array_filter($favorites, fn($f) => $f->getEntityType() === $type);
    }
    
    // Пагінація
    $total = count($favorites);
    $offset = ($page - 1) * $limit;
    $paginatedFavorites = array_slice($favorites, $offset, $limit);
    
    return $this->render('user/favorites.html.twig', [
        'user' => $user,
        'favorites' => $paginatedFavorites,
        'total' => $total,
        'page' => $page,
        'totalPages' => ceil($total / $limit),
        'currentFilter' => $type,
    ]);
}

#[Route('/favorites/add', name: 'user_favorites_add', methods: ['POST'])]
#[IsGranted('ROLE_USER')]
public function addFavorite(Request $request, EntityManagerInterface $em): JsonResponse
{
    $data = json_decode($request->getContent(), true);
    $user = $this->getUser();
    $entityType = $data['type'];
    $entityId = $data['id'];
    
    // Перевірка чи вже є в обраному
    $existing = $em->getRepository(Favorite::class)->findOneBy([
        'user' => $user,
        'entityType' => $entityType,
        'entityId' => $entityId
    ]);
    
    if (!$existing) {
        $favorite = new Favorite();
        $favorite->setUser($user);
        $favorite->setEntityType($entityType);
        $favorite->setEntityId($entityId);
        
        $em->persist($favorite);
        $em->flush();
        
        return $this->json(['success' => true, 'action' => 'added']);
    }
    
    return $this->json(['success' => false, 'error' => 'Already in favorites']);
}

#[Route('/favorites/remove', name: 'user_favorites_remove', methods: ['POST'])]
#[IsGranted('ROLE_USER')]
public function removeFavorite(Request $request, EntityManagerInterface $em): JsonResponse
{
    $data = json_decode($request->getContent(), true);
    $user = $this->getUser();
    $entityType = $data['type'];
    $entityId = $data['id'];
    
    $favorite = $em->getRepository(Favorite::class)->findOneBy([
        'user' => $user,
        'entityType' => $entityType,
        'entityId' => $entityId
    ]);
    
    if ($favorite) {
        $em->remove($favorite);
        $em->flush();
        return $this->json(['success' => true, 'action' => 'removed']);
    }
    
    return $this->json(['success' => false, 'error' => 'Not found']);
}
#[Route('/favorites/article/{id}/remove', name: 'user_favorites_article_remove', methods: ['POST'])]
#[IsGranted('ROLE_USER')]
public function removeArticleFavorite(Article $article, EntityManagerInterface $em): JsonResponse
{
    $user = $this->getUser();
    
    // Видалити статтю з обраного
    $user->removeArticleFavorite($article);
    $em->flush();
    
    return $this->json(['success' => true]);
}

#[Route('/favorites/blog/{id}/remove', name: 'user_favorites_blog_remove', methods: ['POST'])]
#[IsGranted('ROLE_USER')]
public function removeBlogFavorite(Blog $blog, EntityManagerInterface $em): JsonResponse
{
    $user = $this->getUser();
    
    // Видалити блог з обраного
    $user->removeBlogFavorite($blog);
    $em->flush();
    
    return $this->json(['success' => true]);
}
    #[Route('/notifications', name: 'user_notifications')]
#[IsGranted('ROLE_USER')]
public function notifications(AdminNotificationRepository $notificationRepository): Response
{
    /** @var User $user */
    $user = $this->getUser();

    $notifications = $notificationRepository->findForUser($user, 50);
    $unreadCount = $notificationRepository->countUnreadByUser($user);

    return $this->render('user/notifications.html.twig', [
        'user' => $user,
        'notifications' => $notifications,
        'unreadCount' => $unreadCount,
    ]);
}


#[Route('/profile/update-field', name: 'user_profile_update_field', methods: ['POST'])]
public function updateField(Request $request, UserManager $userManager): JsonResponse
{
    $user = $this->getUser();
    $data = json_decode($request->getContent(), true);
    
    $field = $data['field'] ?? null;
    $value = $data['value'] ?? null;
    
    if (!$field || !in_array($field, ['mail', 'username', 'fullName', 'birthDate', 'bio'])) {
        return $this->json(['success' => false, 'message' => 'Invalid field'], 400);
    }
    
    // Валідація та оновлення поля
    try {
        switch ($field) {
            case 'mail':
                // Валідація email
                if (!filter_var($value, FILTER_VALIDATE_EMAIL)) {
                    return $this->json(['success' => false, 'message' => 'Invalid email format'], 400);
                }
                $user->setMail($value);
                break;
            case 'username':
                // Перевірка унікальності
                if ($userManager->findUserByUsername($value) && $user->getUsername() !== $value) {
                    return $this->json(['success' => false, 'message' => 'Username already taken'], 400);
                }
                $user->setUsername($value);
                break;
            case 'fullName':
                $user->setFullName($value);
                break;
            case 'birthDate':
                $user->setBirthDate($value ? new \DateTime($value) : null);
                break;
            case 'bio':
                $user->setBio($value);
                break;
        }
        
        $this->entityManager->flush();
        
        return $this->json(['success' => true]);
    } catch (\Exception $e) {
        return $this->json(['success' => false, 'message' => $e->getMessage()], 400);
    }
}

#[Route('/profile/upload-avatar', name: 'user_upload_avatar', methods: ['POST'])]
public function uploadAvatar(Request $request): JsonResponse
{
    $user = $this->getUser();
    $file = $request->files->get('avatar');
    
    if (!$file) {
        return $this->json(['success' => false, 'message' => 'No file uploaded'], 400);
    }
    
    // Валідація
    if (!in_array($file->getMimeType(), ['image/jpeg', 'image/png', 'image/gif'])) {
        return $this->json(['success' => false, 'message' => 'Invalid file type'], 400);
    }
    
    if ($file->getSize() > 2 * 1024 * 1024) {
        return $this->json(['success' => false, 'message' => 'File too large (max 2MB)'], 400);
    }
    
    // Видаляємо старий аватар
    if ($user->getAvatar()) {
        $oldAvatarPath = $this->getParameter('kernel.project_dir') . '/public/uploads/avatars/' . $user->getAvatar();
        if (file_exists($oldAvatarPath)) {
            unlink($oldAvatarPath);
        }
    }
    
    // Генеруємо нове ім'я файлу
    $filename = uniqid() . '.' . $file->guessExtension();
    $uploadDir = $this->getParameter('kernel.project_dir') . '/public/uploads/avatars/';
    
    // Створюємо директорію якщо не існує
    if (!is_dir($uploadDir)) {
        mkdir($uploadDir, 0777, true);
    }
    
    $file->move($uploadDir, $filename);
    
    // Обрізаємо зображення до квадрата 500x500
    $this->cropImage($uploadDir . $filename, 500, 500);
    
    $user->setAvatar($filename);
    $this->entityManager->flush();
    
    return $this->json([
        'success' => true,
        'avatarUrl' => '/uploads/avatars/' . $filename,
        'avatarFilename' => $filename
    ]);
}

private function cropImage($path, $width, $height)
{
    list($origWidth, $origHeight, $type) = getimagesize($path);
    
    // Створюємо ресурс в залежності від типу
    switch ($type) {
        case IMAGETYPE_JPEG:
            $image = imagecreatefromjpeg($path);
            break;
        case IMAGETYPE_PNG:
            $image = imagecreatefrompng($path);
            break;
        case IMAGETYPE_GIF:
            $image = imagecreatefromgif($path);
            break;
        default:
            return;
    }
    
    // Обчислюємо координати обрізки
    $size = min($origWidth, $origHeight);
    $x = ($origWidth - $size) / 2;
    $y = ($origHeight - $size) / 2;
    
    // Створюємо нове зображення
    $newImage = imagecreatetruecolor($width, $height);
    imagecopyresampled($newImage, $image, 0, 0, $x, $y, $width, $height, $size, $size);
    
    // Зберігаємо
    switch ($type) {
        case IMAGETYPE_JPEG:
            imagejpeg($newImage, $path, 90);
            break;
        case IMAGETYPE_PNG:
            imagepng($newImage, $path, 8);
            break;
        case IMAGETYPE_GIF:
            imagegif($newImage, $path);
            break;
    }
    
    imagedestroy($image);
    imagedestroy($newImage);
}
}