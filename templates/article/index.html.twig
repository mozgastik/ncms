{% extends 'base.html.twig' %}

{% block title %}Усі статті - Новинний портал{% endblock %}

{% block body %}
    <div class="container mx-auto px-4 py-8">
        <div class="mb-8">
            <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-4">Усі статті</h1>
            <p class="text-gray-600 dark:text-gray-400">Перегляньте всі наші публікації</p>
        </div>

        {% if pagination|length > 0 %}
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {% for article in pagination %}
                    <article class="bg-white dark:bg-gray-800 rounded-lg shadow-md overflow-hidden hover:shadow-xl dark:shadow-gray-700/30 transition dark:border dark:border-gray-700">
                        {% if article.coverImage %}
                            <img src="{{ article.coverImage }}" 
                                 alt="{{ article.title }}" 
                                 class="w-full h-48 object-cover">
                        {% else %}
                            <div class="w-full h-48 bg-gradient-to-br from-gray-100 to-gray-200 dark:from-gray-700 dark:to-gray-800 flex items-center justify-center">
                                <i class="fas fa-newspaper text-4xl text-gray-400 dark:text-gray-500"></i>
                            </div>
                        {% endif %}
                        <div class="p-6">
                            <div class="flex items-center mb-2">
                                {% if article.category %}
                                    <span class="bg-blue-100 dark:bg-blue-900/30 text-blue-800 dark:text-blue-300 text-xs font-medium px-2.5 py-0.5 rounded">
                                        {{ article.category.name }}
                                    </span>
                                {% endif %}
                                <span class="text-gray-500 dark:text-gray-400 text-sm ml-2">
                                    {{ article.publishedAt|date('d.m.Y') }}
                                </span>
                            </div>
                            <h3 class="text-xl font-bold mb-3">
                                <a href="{{ path('app_article_show', {slug: article.slug}) }}" 
                                   class="text-gray-800 dark:text-gray-200 hover:text-blue-600 dark:hover:text-blue-400 transition">
                                    {{ article.title }}
                                </a>
                            </h3>
                            <p class="text-gray-600 dark:text-gray-400 mb-4">
                                {{ article.excerpt|slice(0, 120) }}...
                            </p>
                            <div class="flex justify-between items-center">
                                <div class="flex space-x-2">
                                    {% for tag in article.tags|slice(0, 2) %}
                                        <span class="bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-300 text-xs px-2 py-1 rounded">
                                            {{ tag.name }}
                                        </span>
                                    {% endfor %}
                                    {% if article.tags|length > 2 %}
                                        <span class="bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-300 text-xs px-2 py-1 rounded">
                                            +{{ article.tags|length - 2 }}
                                        </span>
                                    {% endif %}
                                </div>
                                <span class="text-gray-500 dark:text-gray-400 text-sm flex items-center gap-1">
                                    <i class="fas fa-eye text-xs"></i>
                                    {{ article.views }}
                                </span>
                            </div>
                        </div>
                    </article>
                {% endfor %}
            </div>

           <!-- Пагінація -->
{% if pagination|length > 0 and pagination.totalItemCount > pagination.getItemNumberPerPage() %}
    <div class="mt-12">
        <nav class="flex items-center justify-center" aria-label="Пагінація">
            <div class="flex items-center gap-1.5 sm:gap-2">
                {# Кнопка "Попередня" #}
                {% if pagination.currentPageNumber > 1 %}
                    <a href="{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({page: pagination.currentPageNumber - 1})) }}"
                       class="inline-flex items-center justify-center min-w-[40px] h-10 px-3 text-sm font-medium rounded-xl bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700/50 hover:border-blue-500 dark:hover:border-blue-400 transition-all duration-200 group"
                       aria-label="Попередня сторінка">
                        <svg class="w-4 h-4 mr-0.5 group-hover:-translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                        </svg>
                        <span class="hidden sm:inline">Попередня</span>
                    </a>
                {% else %}
                    <span class="inline-flex items-center justify-center min-w-[40px] h-10 px-3 text-sm font-medium rounded-xl bg-gray-100 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700 text-gray-400 dark:text-gray-500 cursor-not-allowed">
                        <svg class="w-4 h-4 mr-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                        </svg>
                        <span class="hidden sm:inline">Попередня</span>
                    </span>
                {% endif %}

                {# Номери сторінок #}
                {% for page in 1..pagination.pageCount %}
                    {% if page == 1 or page == pagination.pageCount or (page >= pagination.currentPageNumber - 2 and page <= pagination.currentPageNumber + 2) %}
                        {% if page == pagination.currentPageNumber %}
                            <span class="inline-flex items-center justify-center min-w-[40px] h-10 px-3 text-sm font-bold rounded-xl bg-blue-600 dark:bg-blue-500 text-white shadow-md shadow-blue-500/20">
                                {{ page }}
                            </span>
                        {% else %}
                            <a href="{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({page: page})) }}"
                               class="inline-flex items-center justify-center min-w-[40px] h-10 px-3 text-sm font-medium rounded-xl bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700/50 hover:border-blue-500 dark:hover:border-blue-400 transition-all duration-200">
                                {{ page }}
                            </a>
                        {% endif %}
                    {% elseif page == pagination.currentPageNumber - 3 or page == pagination.currentPageNumber + 3 %}
                        <span class="inline-flex items-center justify-center min-w-[40px] h-10 px-2 text-sm text-gray-400 dark:text-gray-500">...</span>
                    {% endif %}
                {% endfor %}

                {# Кнопка "Наступна" #}
                {% if pagination.currentPageNumber < pagination.pageCount %}
                    <a href="{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({page: pagination.currentPageNumber + 1})) }}"
                       class="inline-flex items-center justify-center min-w-[40px] h-10 px-3 text-sm font-medium rounded-xl bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700/50 hover:border-blue-500 dark:hover:border-blue-400 transition-all duration-200 group"
                       aria-label="Наступна сторінка">
                        <span class="hidden sm:inline">Наступна</span>
                        <svg class="w-4 h-4 ml-0.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                    </a>
                {% else %}
                    <span class="inline-flex items-center justify-center min-w-[40px] h-10 px-3 text-sm font-medium rounded-xl bg-gray-100 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700 text-gray-400 dark:text-gray-500 cursor-not-allowed">
                        <span class="hidden sm:inline">Наступна</span>
                        <svg class="w-4 h-4 ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                    </span>
                {% endif %}
            </div>
        </nav>
        
        {# Інформація про поточну сторінку #}
        <div class="text-center mt-3 text-sm text-gray-500 dark:text-gray-400">
            Сторінка {{ pagination.currentPageNumber }} з {{ pagination.pageCount }} (всього {{ pagination.totalItemCount }} {{ pagination.totalItemCount == 1 ? 'запис' : (pagination.totalItemCount < 5 ? 'записи' : 'записів') }})
        </div>
    </div>
{% endif %}

        {% else %}
            <div class="text-center py-12">
                <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-gray-100 dark:bg-gray-800 mb-4">
                    <i class="fas fa-newspaper text-gray-400 dark:text-gray-500 text-2xl"></i>
                </div>
                <h3 class="text-xl font-semibold text-gray-700 dark:text-gray-300 mb-2">Статтей поки що немає</h3>
                <p class="text-gray-500 dark:text-gray-400">Спробуйте перевірити пізніше</p>
            </div>
        {% endif %}
    </div>
{% endblock %}