<style>
/* ========================================== */
/* БАЗОВІ АНІМАЦІЇ */
/* ========================================== */

@keyframes fade-in {
    from { opacity: 0; transform: scale(0.95); }
    to { opacity: 1; transform: scale(1); }
}

@keyframes slide-in {
    from { transform: translateX(100%); opacity: 0; }
    to { transform: translateX(0); opacity: 1; }
}

@keyframes pulse-like {
    0% { transform: scale(1); }
    50% { transform: scale(1.2); }
    100% { transform: scale(1); }
}

.animate-fade-in {
    animation: fade-in 0.3s ease-out;
}
.animate-slide-in {
    animation: slide-in 0.3s ease-out;
}
.liked {
    animation: pulse-like 0.3s ease;
}
.scale-125 {
    transform: scale(1.25);
    transition: transform 0.3s ease;
}

/* ========================================== */
/* КОНТЕНТ СТАТТІ */
/* ========================================== */

.article-content {
    max-width: 100%;
    margin-left: auto;
    margin-right: auto;
}

/* ========================================== */
/* ЗОБРАЖЕННЯ В КОНТЕНТІ */
/* ========================================== */

.article-content img {
    max-width: 100%;
    height: auto;
    max-height: 600px;
    object-fit: contain;
    border-radius: 0.75rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    background-color: #f3f4f6;
    margin: 1.5rem auto;
    display: block;
}

.article-content img.wp-image-full,
.article-content img.size-full {
    max-width: 100%;
    width: 100%;
    max-height: none;
}

/* Підписи до зображень */
.article-content .wp-caption {
    max-width: 100%;
    margin: 1.5rem 0;
    background: #f9fafb;
    border-radius: 0.75rem;
    padding: 0.5rem;
}
.article-content .wp-caption-text {
    text-align: center;
    font-size: 0.875rem;
    color: #6b7280;
    margin-top: 0.5rem;
}

/* ========================================== */
/* PROSE СТИЛІ (основний текст) */
/* ========================================== */

.prose {
    line-height: 1.8;
}

.prose p {
    margin-bottom: 1.5rem;
}

/* Заголовки */
.prose h2 {
    font-size: 2rem;
    font-weight: 700;
    margin-top: 2.5rem;
    margin-bottom: 1.25rem;
    color: #1f2937;
    letter-spacing: -0.02em;
}
.prose h3 {
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: #374151;
}

.dark .prose h2 {
    color: #f3f4f6;
}
.dark .prose h3 {
    color: #e5e7eb;
}

/* Цитати */
.prose blockquote {
    border-left: 4px solid #3b82f6;
    padding-left: 1rem;
    font-style: italic;
    color: #4b5563;
    margin: 1.5rem 0;
    background: linear-gradient(to right, #eff6ff, transparent);
    border-radius: 0 1rem 1rem 0;
}

.dark .prose blockquote {
    border-left-color: #60a5fa;
    color: #9ca3af;
    background: linear-gradient(to right, rgba(59, 130, 246, 0.1), transparent);
}

/* Списки */
.prose ul,
.prose ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
}
.prose ul { list-style-type: disc; }
.prose ol { list-style-type: decimal; }
.prose li { margin-bottom: 0.5rem; }

/* Посилання */
.prose a {
    color: #3b82f6;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 2px;
    transition: color 0.3s ease;
}
.prose a:hover { color: #2563eb; }
.dark .prose a { color: #60a5fa; }
.dark .prose a:hover { color: #93c5fd; }

/* Код */
.prose code {
    background-color: #f3f4f6;
    padding: 0.25rem 0.5rem;
    border-radius: 0.5rem;
    font-family: monospace;
    font-size: 0.875rem;
    color: #1f2937;
}
.prose pre {
    background-color: #1f2937;
    color: #f3f4f6;
    padding: 1rem;
    border-radius: 1rem;
    overflow-x: auto;
    margin: 1.5rem 0;
}
.dark .prose code {
    background-color: #374151;
    color: #e5e7eb;
}
.dark .prose pre {
    background-color: #111827;
}

/* Зображення в prose */
.prose img {
    max-width: 100%;
    height: auto;
    border-radius: 1rem;
    margin: 1.5rem 0;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    cursor: pointer;
    transition: transform 0.3s ease;
}
.prose img:hover {
    transform: scale(1.02);
}

/* ========================================== */
/* МОДАЛЬНІ ВІКНА */
/* ========================================== */

#imageModal,
#authorModal {
    backdrop-filter: blur(8px);
    transition: opacity 0.3s ease;
}
#imageModal.flex,
#authorModal.flex {
    animation: fade-in 0.3s ease-out;
}

/* ========================================== */
/* СКРОЛБАР (Custom Scrollbar) */
/* ========================================== */

.scrollbar-thin::-webkit-scrollbar {
    width: 4px;
}
.scrollbar-thin::-webkit-scrollbar-track {
    background: transparent;
}
.scrollbar-thin::-webkit-scrollbar-thumb {
    background: #d1d5db;
    border-radius: 2px;
}
.scrollbar-thin::-webkit-scrollbar-thumb:hover {
    background: #9ca3af;
}
.dark .scrollbar-thin::-webkit-scrollbar-thumb {
    background: #4b5563;
}
.dark .scrollbar-thin::-webkit-scrollbar-thumb:hover {
    background: #6b7280;
}

/* ========================================== */
/* ОБРІЗАННЯ ТЕКСТУ */
/* ========================================== */

.line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

/* ========================================== */
/* АДАПТИВНІСТЬ */
/* ========================================== */

@media (max-width: 1024px) {
    .sticky {
        position: relative;
        top: 0;
    }
}

@media (max-width: 640px) {
    .article-content img {
        max-height: 400px;
    }
    .prose h2 {
        font-size: 1.5rem;
    }
    .prose h3 {
        font-size: 1.25rem;
    }
}

</style>
{% endblock %}
