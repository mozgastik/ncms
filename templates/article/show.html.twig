<div id="imageModal" class="fixed inset-0 bg-black/90 z-50 hidden items-center justify-center p-4" onclick="closeImageModal()">
    <button class="absolute top-4 right-4 text-white hover:text-gray-300 transition-colors" onclick="closeImageModal()">
        <svg class="w-6 h-6 sm:w-8 sm:h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
    </button>
    <img id="modalImage" src="" alt="" class="max-w-full max-h-[90vh] object-contain animate-fade-in">
</div>

<!-- ============================================ -->
<!-- СКРИПТИ -->
<!-- ============================================ -->

<script>
// Копіювання посилання
function copyToClipboard() {
    navigator.clipboard.writeText(window.location.href).then(() => {
        showNotification('Посилання скопійовано!', 'success');
    }).catch(() => {
        showNotification('Помилка при копіюванні', 'error');
    });
}

// Модальне вікно зображення
function openImageModal(imageUrl) {
    const modal = document.getElementById('imageModal');
    const modalImg = document.getElementById('modalImage');
    modalImg.src = imageUrl;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
}

function closeImageModal() {
    const modal = document.getElementById('imageModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = 'auto';
}

// Сповіщення
function showNotification(message, type = 'info') {
    const colors = {
        success: 'bg-green-500',
        error: 'bg-red-500',
        warning: 'bg-yellow-500',
        info: 'bg-blue-500'
    };
    
    const icons = {
        success: '✓',
        error: '✕',
        warning: '⚠',
        info: 'ℹ'
    };
    
    const notification = document.createElement('div');
    notification.className = `fixed top-4 right-4 z-50 ${colors[type] || colors.info} text-white px-3 sm:px-4 md:px-6 py-2.5 sm:py-3 md:py-4 rounded-lg shadow-2xl transform transition-all duration-500 translate-x-full max-w-[90%] sm:max-w-md flex items-start gap-2 md:gap-3 text-xs sm:text-sm md:text-base`;
    notification.innerHTML = `
        <span class="text-base sm:text-lg md:text-xl font-bold">${icons[type] || 'ℹ'}</span>
        <span class="flex-1">${message}</span>
        <button class="text-white hover:text-gray-200 transition" onclick="this.parentElement.remove()">✕</button>
    `;
    
    document.body.appendChild(notification);
    
    setTimeout(() => {
        notification.classList.remove('translate-x-full');
        notification.classList.add('translate-x-0');
    }, 10);
    
    setTimeout(() => {
        notification.classList.remove('translate-x-0');
        notification.classList.add('translate-x-full');
        setTimeout(() => notification.remove(), 500);
    }, 5000);
}

// Escape для закриття модального вікна
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        closeImageModal();
    }
});

// Голосування за статтю
document.addEventListener('DOMContentLoaded', function() {
    const likeBtn = document.getElementById('likeBtn');
    const dislikeBtn = document.getElementById('dislikeBtn');
    
    if (likeBtn) {
        likeBtn.addEventListener('click', function() {
            const articleId = document.getElementById('voteFormCompact')?.dataset?.articleId;
            handleVote(articleId, 'like');
        });
    }
    
    if (dislikeBtn) {
        dislikeBtn.addEventListener('click', function() {
            const articleId = document.getElementById('voteFormCompact')?.dataset?.articleId;
            handleVote(articleId, 'dislike');
        });
    }
});

async function handleVote(articleId, action) {
    if (!articleId) {
        showNotification('ID статті не знайдено', 'error');
        return;
    }
    
    {% if not app.user %}
        showNotification('Будь ласка, увійдіть для голосування', 'warning');
        return;
    {% endif %}
    
    try {
        const formData = new FormData();
        formData.append('action', action);
        
        const token = document.querySelector('input[name="_token"]')?.value;
        if (token) {
            formData.append('_token', token);
        }
        
        const response = await fetch(`/article/${articleId}/vote`, {
            method: 'POST',
            body: formData,
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        });
        
        const data = await response.json();
        
        if (data.success) {
            document.getElementById('likeCount').textContent = data.likes;
            document.getElementById('dislikeCount').textContent = data.dislikes;
            showNotification(data.message, 'success');
        } else {
            showNotification(data.message, 'error');
        }
    } catch (error) {
        console.error('Error:', error);
        showNotification('Помилка при обробці запиту', 'error');
    }
}
</script>

