{% extends 'base.html.twig' %}

{% block title %}{% if article is not null %}{{ article.title }}{% else %}Стаття не знайдена{% endif %} - Новинний портал{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 dark:bg-gray-900 py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col lg:flex-row gap-6">
            
            <!-- ========================================== -->
            <!-- ОСНОВНИЙ КОНТЕНТ (75% ширини) -->
            <!-- ========================================== -->
            <main class="lg:w-3/4 w-full min-w-0">
                <article class="bg-white dark:bg-gray-800 rounded-xl shadow-lg overflow-hidden transition-all duration-300">
                    
                    <!-- Головне зображення -->
                    {% if article.coverImage %}
                    <div class="relative w-full h-64 sm:h-80 md:h-96 overflow-hidden group">
                    <img src="{{ vich_uploader_asset(article, 'coverImageFile') }}" 
                             alt="{{ article.title }}" 
                             class="w-full h-full object-cover transition-transform duration-700 hover:scale-105"
                             loading="eager"
                        >
                        <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div>
                        
                        <button onclick="openImageModal('{{ vich_uploader_asset(article, 'coverImageFile') }}')" 
                                class="absolute top-4 right-4 p-2 bg-black/50 hover:bg-black/70 text-white rounded-xl backdrop-blur-sm opacity-0 group-hover:opacity-100 transition-all duration-300">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path>
                            </svg>
                        </button>
                    </div>
                    {% endif %}

                    <!-- Контент статті -->
                    <div class="p-4 sm:p-6 md:p-8">
                        <!-- Заголовок -->
                        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4 leading-tight">
                            {{ article.title }}
                        </h1>

                        <!-- Мета-інформація -->
                        <div class="flex flex-wrap items-center gap-2 sm:gap-3 text-xs sm:text-sm text-gray-500 dark:text-gray-400 mb-6">
                            <span class="flex items-center">
                                <svg class="w-3 h-3 sm:w-4 sm:h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                </svg>
                                <time datetime="{{ article.publishedAt|date('Y-m-d') }}">
                                    {{ article.publishedAt|date('d.m.Y H:i') }}
                                </time>
                            </span>
                            <span class="flex items-center">
                                <svg class="w-3 h-3 sm:w-4 sm:h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                </svg>
                                {{ article.views }} переглядів
                            </span>
                            <span class="flex items-center">
                                <svg class="w-3 h-3 sm:w-4 sm:h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                                {{ article.readingTime }} хв читання
                            </span>
                            {% if article.category %}
                            <a href="{{ path('app_category_show', {'slug': article.category.slug}) }}" 
                               class="inline-flex items-center px-2 py-1 rounded-full bg-blue-600 text-white text-xs font-medium hover:bg-blue-700 transition-colors duration-200">
                                <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path>
                                </svg>
                                {{ article.category.name }}
                            </a>
                            {% endif %}
                        </div>

                        
                        <!-- Основний текст -->
                <div class="ck-content prose prose-base sm:prose-lg dark:prose-invert max-w-none mb-8 
                  prose-headings:font-bold prose-h1:text-2xl sm:prose-h1:text-3xl prose-h2:text-xl sm:prose-h2:text-2xl prose-h3:text-lg sm:prose-h3:text-xl
                  prose-a:text-blue-600 dark:prose-a:text-blue-400 hover:prose-a:text-blue-700
                  prose-blockquote:border-l-4 prose-blockquote:border-blue-500
                  prose-blockquote:bg-gray-50 dark:prose-blockquote:bg-gray-800
                  prose-blockquote:italic prose-blockquote:py-2 prose-blockquote:px-4
                  prose-blockquote:before:content-['"'] prose-blockquote:before:text-4xl prose-blockquote:before:text-blue-500/30 prose-blockquote:before:absolute prose-blockquote:before:-top-1 prose-blockquote:before:left-2
                  prose-blockquote:relative
                  prose-table:border prose-table:border-gray-300 dark:prose-table:border-gray-600
                  prose-th:bg-gray-100 dark:prose-th:bg-gray-700 prose-th:p-2 sm:prose-th:p-3
                  prose-td:p-2 sm:prose-td:p-3 prose-img:rounded-lg prose-img:shadow-md
                  prose-code:bg-gray-100 dark:prose-code:bg-gray-700 prose-code:px-1 prose-code:rounded
                  prose-pre:bg-gray-800 prose-pre:text-white prose-pre:overflow-x-auto
                  prose-blockquote:before:content-none article-content">
                {{ article.content|raw }}
                </div>
                        <!-- Голосування -->
                        <div class="bg-gray-50 dark:bg-gray-700/50 rounded-xl p-4 sm:p-6 flex flex-col items-center shadow-sm mb-6 border border-gray-200 dark:border-gray-600">
                            <p class="text-gray-600 dark:text-gray-300 font-medium mb-4 text-sm sm:text-base">
                                Сподобалась стаття?
                            </p>

                            {% if app.user %}
                            <form id="voteFormCompact" data-article-id="{{ article.id }}" class="w-full max-w-xs">
                                <input type="hidden" name="_token" value="{{ csrf_token('vote' ~ article.id) }}">
                                <div class="flex gap-3 sm:gap-4 justify-center">
                                    <button 
                                        type="button"
                                        id="likeBtn"
                                        class="flex items-center gap-1 sm:gap-2 px-4 sm:px-6 py-1.5 sm:py-2 rounded-full bg-green-500 text-white hover:bg-green-600 active:scale-95 transition-all duration-200 font-semibold shadow-md text-xs sm:text-sm"
                                    >
                                        <svg class="w-3 h-3 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5"></path>
                                        </svg>
                                        <span id="likeCount">{{ voteInfo.likes }}</span>
                                    </button>

                                    <button 
                                        type="button"
                                        id="dislikeBtn"
                                        class="flex items-center gap-1 sm:gap-2 px-4 sm:px-6 py-1.5 sm:py-2 rounded-full bg-red-500 text-white hover:bg-red-600 active:scale-95 transition-all duration-200 font-semibold shadow-md text-xs sm:text-sm"
                                    >
                                        <svg class="w-3 h-3 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14H5.236a2 2 0 01-1.789-2.894l3.5-7A2 2 0 018.736 3h4.018a2 2 0 01.485.06l3.76.94m-7 10v5a2 2 0 002 2h.096c.5 0 .905-.405.905-.904 0-.715.211-1.413.608-2.008L17 13V4m-7 10h2m5-10h2a2 2 0 012 2v6a2 2 0 01-2 2h-2.5"></path>
                                        </svg>
                                        <span id="dislikeCount">{{ voteInfo.dislikes }}</span>
                                    </button>
                                </div>
                            </form>
                            {% else %}
                            <div class="flex gap-3 sm:gap-4">
                                <div class="flex items-center gap-1 sm:gap-2 px-4 sm:px-6 py-1.5 sm:py-2 rounded-full bg-gray-200 dark:bg-gray-600 text-gray-700 dark:text-gray-300 font-semibold shadow-md text-xs sm:text-sm">
                                    <svg class="w-3 h-3 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5"></path>
                                    </svg>
                                    {{ voteInfo.likes }}
                                </div>
                                <div class="flex items-center gap-1 sm:gap-2 px-4 sm:px-6 py-1.5 sm:py-2 rounded-full bg-gray-200 dark:bg-gray-600 text-gray-700 dark:text-gray-300 font-semibold shadow-md text-xs sm:text-sm">
                                    <svg class="w-3 h-3 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14H5.236a2 2 0 01-1.789-2.894l3.5-7A2 2 0 018.736 3h4.018a2 2 0 01.485.06l3.76.94m-7 10v5a2 2 0 002 2h.096c.5 0 .905-.405.905-.904 0-.715.211-1.413.608-2.008L17 13V4m-7 10h2m5-10h2a2 2 0 012 2v6a2 2 0 01-2 2h-2.5"></path>
                                    </svg>
                                    {{ voteInfo.dislikes }}
                                </div>
                            </div>
                            <a href="{{ path('app_login') }}" class="text-xs sm:text-sm text-blue-600 dark:text-blue-400 hover:underline mt-2">
                                Увійдіть, щоб оцінити
                            </a>
                            {% endif %}
                        </div>

                        <!-- Теги -->
                        {% if article.tags|length > 0 %}
                        <div class="mb-6">
                            <h3 class="text-base sm:text-lg font-semibold text-gray-900 dark:text-white mb-3 flex items-center">
                                <svg class="w-4 h-4 sm:w-5 sm:h-5 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                                </svg>
                                Теги
                            </h3>
                            <div class="flex flex-wrap gap-1.5 sm:gap-2">
                                {% for tag in article.tags %}
                                <a href="{{ path('app_tag_show', {'slug': tag.slug}) }}" 
                                   class="inline-flex items-center px-2 py-0.5 sm:px-3 sm:py-1 rounded-full bg-gradient-to-r from-cyan-500 to-teal-500 text-white text-[10px] sm:text-xs font-semibold hover:from-cyan-600 hover:to-teal-600 transition-all duration-200 shadow hover:shadow-md hover:scale-105">
                                    <svg class="w-2 h-2 sm:w-3 sm:h-3 mr-0.5 sm:mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"></path>
                                    </svg>
                                    {{ tag.name }}
                                </a>
                                {% endfor %}
                            </div>
                        </div>
                        {% endif %}

                        <!-- Поділитися -->
                        <div class="mb-6">
                            <h3 class="text-base sm:text-lg font-semibold text-gray-900 dark:text-white mb-3 flex items-center">
                                <svg class="w-4 h-4 sm:w-5 sm:h-5 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path>
                                </svg>
                                Поділитися
                            </h3>
                            <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
                                <!-- Facebook -->
                                <a href="https://www.facebook.com/sharer/sharer.php?u={{ app.request.uri|url_encode }}" 
                                   target="_blank"
                                   class="inline-flex items-center px-2.5 py-1.5 sm:px-3 sm:py-2 rounded-lg text-xs sm:text-sm shadow-md transition-all duration-300 hover:scale-105 group
                                          bg-[#1877f2] text-white hover:bg-[#166fe5]
                                          dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600 dark:hover:text-white
                                          border border-[#1877f2] dark:border-gray-600">
                                    <svg class="w-3 h-3 sm:w-4 sm:h-4 mr-1 sm:mr-2 transition-transform duration-300 group-hover:rotate-12" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                                    </svg>
                                    <span class="hidden sm:inline">Facebook</span>
                                </a>

                                <!-- Telegram -->
                                <a href="https://t.me/share/url?url={{ app.request.uri|url_encode }}&text={{ article.title|url_encode }}" 
                                   target="_blank"
                                   class="inline-flex items-center px-2.5 py-1.5 sm:px-3 sm:py-2 rounded-lg text-xs sm:text-sm shadow-md transition-all duration-300 hover:scale-105 group
                                          bg-[#0088cc] text-white hover:bg-[#0077b5]
                                          dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600 dark:hover:text-white
                                          border border-[#0088cc] dark:border-gray-600">
                                    <svg class="w-3 h-3 sm:w-4 sm:h-4 mr-1 sm:mr-2 transition-transform duration-300 group-hover:rotate-12" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
                                    </svg>
                                    <span>Telegram</span>
                                </a>

                                <!-- X (Twitter) -->
                                <a href="https://twitter.com/intent/tweet?url={{ app.request.uri|url_encode }}&text={{ article.title|url_encode }}" 
                                   target="_blank"
                                   class="inline-flex items-center px-2.5 py-1.5 sm:px-3 sm:py-2 rounded-lg text-xs sm:text-sm shadow-md transition-all duration-300 hover:scale-105 group
                                          bg-black text-white hover:bg-gray-800
                                          dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600 dark:hover:text-white
                                          border border-black dark:border-gray-600">
                                    <svg class="w-3 h-3 sm:w-4 sm:h-4 mr-1 sm:mr-2 transition-transform duration-300 group-hover:rotate-12" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
                                    </svg>
                                    <span class="hidden sm:inline">X</span>
                                </a>

                                <!-- LinkedIn -->
                                <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ app.request.uri|url_encode }}" 
                                   target="_blank"
                                   class="inline-flex items-center px-2.5 py-1.5 sm:px-3 sm:py-2 rounded-lg text-xs sm:text-sm shadow-md transition-all duration-300 hover:scale-105 group
                                          bg-gray-100 text-gray-700 hover:bg-gray-200 hover:text-gray-900
                                          dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600 dark:hover:text-white
                                          border border-gray-300 dark:border-gray-600">
                                    <svg class="w-3 h-3 sm:w-4 sm:h-4 mr-1 sm:mr-2 transition-transform duration-300 group-hover:rotate-12" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                                    </svg>
                                    <span class="hidden sm:inline">LinkedIn</span>
                                </a>

                                <!-- WhatsApp -->
                                <a href="https://wa.me/?text={{ article.title|url_encode }}%20{{ app.request.uri|url_encode }}" 
                                   target="_blank"
                                   class="inline-flex items-center px-2.5 py-1.5 sm:px-3 sm:py-2 rounded-lg text-xs sm:text-sm shadow-md transition-all duration-300 hover:scale-105 group
                                          bg-green-500 text-white hover:bg-green-600
                                          dark:bg-gray-700 dark:text-green-400 dark:hover:bg-gray-600 dark:hover:text-green-300
                                          border border-green-500 dark:border-gray-600">
                                    <svg class="w-3 h-3 sm:w-4 sm:h-4 mr-1 sm:mr-2 transition-transform duration-300 group-hover:rotate-12" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                                    </svg>
                                    <span class="hidden sm:inline">WhatsApp</span>
                                </a>

                                <!-- Копіювати -->
                                <button onclick="copyToClipboard()"
                                        class="inline-flex items-center px-2.5 py-1.5 sm:px-3 sm:py-2 rounded-lg text-xs sm:text-sm shadow-md transition-all duration-300 hover:scale-105 group
                                               bg-gray-600 text-white hover:bg-gray-700
                                               dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600 dark:hover:text-white
                                               border border-gray-600 dark:border-gray-600">
                                    <svg class="w-3 h-3 sm:w-4 sm:h-4 mr-1 sm:mr-2 transition-transform duration-300 group-hover:rotate-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
