    `;
    
    return div;
}

// ============================================
// 9. ОНОВЛЕННЯ ЛІЧИЛЬНИКА
// ============================================

function updateCommentCount() {
    const countSpan = document.getElementById('comment-count');
    if (!countSpan) return;
    
    const commentsList = document.getElementById('comments-list');
    if (!commentsList) return;
    
    const commentItems = commentsList.querySelectorAll('.comment-item');
    countSpan.textContent = commentItems.length;
}

// ============================================
// 10. СОРТУВАННЯ
// ============================================

function initCommentSorting() {
    const sortSelect = document.getElementById('commentSort');
    const commentsList = document.getElementById('comments-list');
    
    if (!sortSelect || !commentsList) return;
    
    sortSelect.addEventListener('change', function() {
        const comments = Array.from(commentsList.querySelectorAll('.comment-item'));
        if (comments.length === 0) return;
        
        const sortBy = this.value;
        
        comments.sort((a, b) => {
            const dateA = parseInt(a.dataset.created) || 0;
            const dateB = parseInt(b.dataset.created) || 0;
            const likesA = parseInt(a.dataset.likes) || 0;
            const likesB = parseInt(b.dataset.likes) || 0;
            
            if (sortBy === 'newest') return dateB - dateA;
            if (sortBy === 'oldest') return dateA - dateB;
            if (sortBy === 'likes') return likesB - likesA;
            return 0;
        });
        
        comments.forEach(comment => {
            commentsList.appendChild(comment);
        });
        
        comments.forEach((comment, index) => {
            setTimeout(() => {
                comment.style.transition = 'all 0.3s ease';
                comment.style.opacity = '1';
                comment.style.transform = 'translateX(0)';
            }, index * 50);
        });
    });
}

// ============================================
// 11. ЗАВАНТАЖЕННЯ БІЛЬШЕ
// ============================================

function initLoadMoreComments() {
    const loadMoreBtn = document.getElementById('load-more-comments');
    if (!loadMoreBtn) return;
    
    let page = 1;
    
    loadMoreBtn.addEventListener('click', function() {
        page++;
        const articleId = document.querySelector('[data-article-id]')?.dataset.articleId;
        
        if (!articleId) {
            showNotification('ID статті не знайдено', 'error');
            return;
        }
        
        const originalText = this.innerHTML;
        this.innerHTML = `
            <svg class="animate-spin h-5 w-5" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            Завантаження...
        `;
        this.disabled = true;
        
        fetch(`/article/${articleId}/comments?page=${page}`, {
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success && data.comments && data.comments.length > 0) {
                const commentsList = document.getElementById('comments-list');
                data.comments.forEach(comment => {
                    const element = createCommentElement(comment);
                    commentsList.appendChild(element);
                });
                updateCommentCount();
                if (data.hasMore === false) {
                    this.style.display = 'none';
                }
            } else {
                this.style.display = 'none';
            }
        })
        .catch(error => {
            console.error('❌ Error loading comments:', error);
            showNotification('Помилка завантаження коментарів', 'error');
        })
        .finally(() => {
            this.innerHTML = originalText;
            this.disabled = false;
        });
    });
}


// ============================================
// ЛАЙК КОМЕНТАРЯ (ЧЕРЕЗ FORMDATA)
// ============================================

window.likeComment = function(commentId) {
    const button = document.querySelector(`.comment-like-btn[data-comment-id="${commentId}"]`);
    if (!button) return;
    
    const svg = button.querySelector('svg');
    const countSpan = button.querySelector('span:last-child');
    
    // Анімація
    button.classList.add('scale-125');
    setTimeout(() => button.classList.remove('scale-125'), 300);
    
    // Формуємо дані
    const formData = new FormData();
    formData.append('action', 'like');
    
    fetch(`/article/comment/${commentId}/vote`, {
        method: 'POST',
        body: formData,
        headers: {
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            countSpan.textContent = data.likes;
            
            if (data.userVote === 'like') {
                svg.classList.add('text-red-500');
                svg.setAttribute('fill', 'currentColor');
            } else {
                svg.classList.remove('text-red-500');
                svg.setAttribute('fill', 'none');
            }
            
            const commentItem = document.querySelector(`.comment-item[data-comment-id="${commentId}"]`);
            if (commentItem) {
                commentItem.dataset.likes = data.likes;
            }
            
            showNotification(data.message || 'Оцінку оновлено', 'success');
        }
    })
    .catch(error => {
        console.error('❌ Помилка:', error);
        showNotification('Помилка при оцінці коментаря', 'error');
    });
};
// ============================================
// 13. ВІДПОВІДЬ
// ============================================

window.replyToComment = function(commentId, authorName) {
    if (!quillInstance) return;
    
    const text = `@${authorName}, `;
    const range = quillInstance.getSelection(true);
    quillInstance.insertText(range.index, text);
    quillInstance.setSelection(range.index + text.length);
    quillInstance.focus();
    
    const form = document.getElementById('comment-form');
    if (form) {
        form.scrollIntoView({ behavior: 'smooth', block: 'center' });
        form.classList.add('animate-pulse');
        setTimeout(() => form.classList.remove('animate-pulse'), 1000);
    }
};


/// ============================================
// 14.ВИДАЛЕННЯ КОМЕНТАРЯ (ПОВНА ВЕРСІЯ)
// ============================================

window.deleteComment = function(commentId) {
    if (!confirm('Ви впевнені, що хочете видалити цей коментар?')) {
        return;
    }
    
    const commentElement = document.querySelector(`.comment-item[data-comment-id="${commentId}"]`);
    if (!commentElement) {
        showNotification('Коментар не знайдено', 'error');
        return;
    }
    
    // Отримуємо CSRF токен
    let csrfToken = commentElement.dataset.csrfToken;
    
    if (!csrfToken) {
        const formToken = document.querySelector('#comment-form input[name="_token"]');
        if (formToken) {
            csrfToken = formToken.value;
        }
    }
    
    if (!csrfToken) {
        const metaToken = document.querySelector('meta[name="csrf-token"]');
        if (metaToken) {
            csrfToken = metaToken.content;
        }
    }
    
    if (!csrfToken) {
        showNotification('CSRF токен не знайдено', 'error');
        return;
    }
    
    // Анімація видалення
    commentElement.style.transition = 'all 0.3s ease';
    commentElement.style.opacity = '0';
    commentElement.style.transform = 'scale(0.9)';
    
    const formData = new FormData();
    formData.append('_token', csrfToken);
    
    fetch(`/article/comment/${commentId}/delete`, {
        method: 'POST',
        body: formData,
        headers: {
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(response => {
        if (!response.ok) {
            return response.text().then(text => {
                throw new Error(text);
            });
        }
        return response.json();
    })
    .then(data => {
        if (data.success) {
            commentElement.remove();
            updateCommentCount();
            
            const commentsList = document.getElementById('comments-list');
            if (commentsList && commentsList.querySelectorAll('.comment-item').length === 0) {
                showEmptyCommentsMessage();
            }
            
            showNotification(data.message || 'Коментар видалено', 'success');
        } else {
            showNotification(data.message || 'Помилка при видаленні', 'error');
            commentElement.style.opacity = '1';
            commentElement.style.transform = 'scale(1)';
        }
    })
    .catch(error => {
        console.error('❌ Помилка:', error);
        showNotification('Помилка: ' + error.message, 'error');
        commentElement.style.opacity = '1';
        commentElement.style.transform = 'scale(1)';
    });
};

// ============================================
// 15. ПОВІДОМЛЕННЯ "НЕМАЄ КОМЕНТАРІВ"
// ============================================

function showEmptyCommentsMessage() {
    const commentsList = document.getElementById('comments-list');
    if (!commentsList) return;
    
    commentsList.innerHTML = `
        <div class="text-center py-16 bg-gradient-to-br from-gray-50 to-gray-100 dark:from-gray-900 dark:to-gray-800 rounded-2xl border border-gray-200 dark:border-gray-800" id="empty-comments">
            <svg class="w-20 h-20 text-gray-400 dark:text-gray-600 mx-auto mb-4 animate-bounce" 
                 fill="none" 
                 stroke="currentColor" 
                 viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
            </svg>
            <h4 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">
                Ще немає коментарів
            </h4>
            <p class="text-gray-600 dark:text-gray-400 text-lg">
                Будьте першим, хто залишить коментар!
            </p>
        </div>
    `;
}

// ============================================
// 16. СПОВІЩЕННЯ
// ============================================

function showNotification(message, type = 'info') {
    if (window.app && typeof window.app.notify === 'function') {
        window.app.notify(message, type);
        return;
    }
    
    const oldNotifications = document.querySelectorAll('.custom-notification');
    oldNotifications.forEach(n => n.remove());
    
    const colors = {
        success: 'bg-green-500',
        error: 'bg-red-500',
        warning: 'bg-yellow-500',
        info: 'bg-blue-500'
    };
    
    const icons = {
        success: '✓',
        error: '✕',
        warning: '⚠',
        info: 'ℹ'
    };
    
    const notification = document.createElement('div');
    notification.className = `custom-notification fixed top-4 right-4 z-50 ${colors[type] || colors.info} text-white px-6 py-4 rounded-lg shadow-2xl transform transition-all duration-500 translate-x-full max-w-md flex items-start gap-3`;
    notification.innerHTML = `
        <span class="text-xl font-bold">${icons[type] || 'ℹ'}</span>
        <span class="flex-1">${message}</span>
        <button class="text-white hover:text-gray-200 transition" onclick="this.parentElement.remove()">✕</button>
    `;
    
    document.body.appendChild(notification);
    
    setTimeout(() => {
        notification.classList.remove('translate-x-full');
        notification.classList.add('translate-x-0');
    }, 10);
    
    setTimeout(() => {
        notification.classList.remove('translate-x-0');
        notification.classList.add('translate-x-full');
        setTimeout(() => {
            notification.remove();
        }, 500);
    }, 5000);
}

console.log('✅ Коментарі з Quill + Emoji + AJAX успішно завантажено!');
</script>