{% extends 'base.html.twig' %}

{% block title %}Статті категорії - Новинний портал{% endblock %}

{% block body %}
    <div class="container mx-auto px-4 py-8">
        <div class="mb-8">
            <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-4">Статті категорії</h1>
            <p class="text-gray-600 dark:text-gray-400">Перегляньте всі наші публікації</p>
        </div>

        {% if pagination|length > 0 %}
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {% for article in pagination %}
                    <article class="bg-white dark:bg-gray-800 rounded-lg shadow-md overflow-hidden hover:shadow-xl dark:shadow-gray-700/30 transition dark:border dark:border-gray-700">
                      {% if article.coverImage %}
                      <img src="{{ vich_uploader_asset(article, 'coverImageFile') }}" 
                       alt="{{ article.title }}" 
                                 class="w-full h-48 object-cover">
                        {% else %}
                            <div class="w-full h-48 bg-gradient-to-br from-gray-100 to-gray-200 dark:from-gray-700 dark:to-gray-800 flex items-center justify-center">
                                <i class="fas fa-newspaper text-4xl text-gray-400 dark:text-gray-500"></i>
                            </div>
                        {% endif %}
                        <div class="p-6">
                            <div class="flex items-center mb-2">
                                {% if article.category %}
                                    <span class="bg-blue-100 dark:bg-blue-900/30 text-blue-800 dark:text-blue-300 text-xs font-medium px-2.5 py-0.5 rounded">
                                        {{ article.category.name }}
                                    </span>
                                {% endif %}
                                <span class="text-gray-500 dark:text-gray-400 text-sm ml-2">
                                    {{ article.publishedAt|date('d.m.Y') }}
                                </span>
                            </div>
                            <h3 class="text-xl font-bold mb-3">
                                <a href="{{ path('app_article_show', {slug: article.slug}) }}" 
                                   class="text-gray-800 dark:text-gray-200 hover:text-blue-600 dark:hover:text-blue-400 transition">
                                    {{ article.title }}
                                </a>
                            </h3>
                            <p class="text-gray-600 dark:text-gray-400 mb-4">
                                {{ article.excerpt|slice(0, 120) }}...
                            </p>
                            <div class="flex justify-between items-center">
                                <div class="flex space-x-2">
                                    {% for tag in article.tags|slice(0, 2) %}
                                        <span class="bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-300 text-xs px-2 py-1 rounded">
                                            {{ tag.name }}
                                        </span>
                                    {% endfor %}
                                    {% if article.tags|length > 2 %}
                                        <span class="bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-300 text-xs px-2 py-1 rounded">
                                            +{{ article.tags|length - 2 }}
                                        </span>
                                    {% endif %}
                                </div>
                                <span class="text-gray-500 dark:text-gray-400 text-sm flex items-center gap-1">
                                    <i class="fas fa-eye text-xs"></i>
                                    {{ article.views }}
                                </span>
                            </div>
                        </div>
                    </article>
                {% endfor %}
            </div>

            <!-- Пагінація -->
            {% if pagination|length > 0 and pagination.totalItemCount > pagination.getItemNumberPerPage() %}
                <div class="mt-12">
                    {{ knp_pagination_render(pagination) }}
                </div>
            {% endif %}
        {% else %}
            <div class="text-center py-12">
                <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-gray-100 dark:bg-gray-800 mb-4">
                    <i class="fas fa-newspaper text-gray-400 dark:text-gray-500 text-2xl"></i>
                </div>
                <h3 class="text-xl font-semibold text-gray-700 dark:text-gray-300 mb-2">Статтей поки немає в цій катаегорії.</h3>
                <p class="text-gray-500 dark:text-gray-400">Спробуйте перевірити пізніше</p>
            </div>
        {% endif %}
    </div>
{% endblock %}