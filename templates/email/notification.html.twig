{# templates/email/notification.html.twig #}

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ notification.title }}</title>
    <style>
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            line-height: 1.6;
            color: #1e293b;
            background-color: #f8fafc;
            margin: 0;
            padding: 0;
        }
        .container {
            max-width: 600px;
            margin: 20px auto;
            background-color: #ffffff;
            border-radius: 16px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            overflow: hidden;
        }
        .header {
            background: linear-gradient(135deg, #0ea5e9 0%, #3b82f6 100%);
            padding: 30px 20px;
            text-align: center;
        }
        .header h1 {
            color: white;
            margin: 0;
            font-size: 24px;
            font-weight: 600;
        }
        .content {
            padding: 30px 20px;
        }
        .notification-type {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 9999px;
            font-size: 12px;
            font-weight: 600;
            margin-bottom: 20px;
        }
        .type-info {
            background-color: #e0f2fe;
            color: #0284c7;
        }
        .type-success {
            background-color: #dcfce7;
            color: #16a34a;
        }
        .type-warning {
            background-color: #fef9c3;
            color: #ca8a04;
        }
        .type-error {
            background-color: #fee2e2;
            color: #dc2626;
        }
        .title {
            font-size: 20px;
            font-weight: 600;
            color: #0f172a;
            margin-bottom: 16px;
        }
        .message {
            color: #334155;
            margin-bottom: 24px;
        }
        .button {
            display: inline-block;
            background: linear-gradient(135deg, #0ea5e9 0%, #3b82f6 100%);
            color: white;
            text-decoration: none;
            padding: 12px 24px;
            border-radius: 12px;
            font-weight: 500;
            margin-top: 20px;
        }
        .footer {
            padding: 20px;
            text-align: center;
            background-color: #f1f5f9;
            color: #64748b;
            font-size: 14px;
        }
        .stats {
            background-color: #f8fafc;
            padding: 16px;
            border-radius: 12px;
            margin-top: 24px;
        }
        .stat-item {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
        }
        .divider {
            border-top: 1px solid #e2e8f0;
            margin: 20px 0;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>{{ site_name }}</h1>
        </div>
        
        <div class="content">
            <div class="notification-type type-{{ notification.type }}">
                {% if notification.type == 'info' %}ℹ️ Інформація
                {% elseif notification.type == 'success' %}✅ Успіх
                {% elseif notification.type == 'warning' %}⚠️ Попередження
                {% elseif notification.type == 'error' %}❌ Помилка
                {% endif %}
            </div>
            
            <div class="title">{{ notification.title }}</div>
            
            {% if notification.message %}
                <div class="message">{{ notification.message|nl2br }}</div>
            {% endif %}
            
            {% if notification.data %}
                <div class="stats">
                    <h3 style="margin-top: 0; font-size: 16px;">Деталі:</h3>
                    {% for key, value in notification.data %}
                        <div class="stat-item">
                            <span style="color: #64748b;">{{ key|capitalize }}:</span>
                            <span style="color: #0f172a; font-weight: 500;">{{ value }}</span>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
            
            {% if notification.link %}
                <div style="text-align: center;">
                    <a href="{{ notification.link }}" class="button">Переглянути</a>
                </div>
            {% endif %}
            
            <div class="divider"></div>
            
            <p style="color: #64748b; font-size: 14px;">
                Шановний(а) <strong>{{ user.username }}</strong>,<br>
                Ви отримали це повідомлення, тому що підписані на сповіщення на сайті {{ site_name }}.
            </p>
        </div>
        
        <div class="footer">
            <p>&copy; {{ "now"|date('Y') }} {{ site_name }}. Всі права захищено.</p>
            <p style="margin-top: 10px;">
                <a href="{{ url('user_notification_settings') }}" style="color: #0ea5e9;">Налаштування сповіщень</a>
            </p>
        </div>
    </div>
</body>
</html>