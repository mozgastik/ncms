{# templates/security/login.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}Увійти - Новинний портал{% endblock %}

{% block body %}
<div class="min-h-screen flex items-center justify-center bg-gradient-to-b from-gray-50 to-white dark:from-gray-900 dark:to-gray-950 py-12 px-4 sm:px-6 lg:px-8">
    
    <!-- Декоративні елементи -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none">
        <div class="absolute -top-40 -right-40 w-80 h-80 bg-blue-500/5 dark:bg-blue-500/10 rounded-full blur-3xl"></div>
        <div class="absolute -bottom-40 -left-40 w-80 h-80 bg-purple-500/5 dark:bg-purple-500/10 rounded-full blur-3xl"></div>
    </div>

    <div class="max-w-md w-full space-y-8 relative z-10">
        <!-- Логотип -->
        <div class="text-center">
            <div class="flex justify-center">
                <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-blue-500 to-purple-600 dark:from-blue-400 dark:to-purple-400 flex items-center justify-center shadow-2xl">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-10 h-10 text-white">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                    </svg>
                </div>
            </div>
            <h2 class="mt-6 text-center text-3xl font-extrabold text-gray-900 dark:text-white">
                Увійти в акаунт
            </h2>
            <p class="mt-2 text-center text-sm text-gray-600 dark:text-gray-400">
                Або
                <a href="{{ path('app_register') }}" class="font-medium text-blue-600 hover:text-blue-500 dark:text-blue-400 dark:hover:text-blue-300 transition-colors">
                    зареєструвати новий акаунт
                </a>
            </p>
        </div>
        
        <!-- Форма (склоподібний дизайн) -->
        <div class="backdrop-blur-xl bg-white/70 dark:bg-gray-900/70 py-8 px-6 shadow-2xl rounded-2xl border border-white/30 dark:border-gray-700/30 sm:px-10">
            <form class="space-y-6" action="{{ path('app_login') }}" method="POST">
                {% if error %}
                    <div class="bg-red-500/10 dark:bg-red-500/20 backdrop-blur-sm border border-red-200/30 dark:border-red-800/30 text-red-700 dark:text-red-400 px-4 py-3 rounded-xl relative flex items-center gap-3" role="alert">
                        <i class="fas fa-exclamation-circle"></i>
                        <span class="block sm:inline">{{ error.messageKey|trans(error.messageData, 'security') }}</span>
                    </div>
                {% endif %}
                
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                
                <!-- Email -->
                <div class="space-y-2">
                    <label for="username" class="block text-sm font-medium text-gray-700 dark:text-gray-300">
                        <i class="fas fa-envelope mr-2 text-blue-500 dark:text-blue-400"></i>
                        Email
                    </label>
                    <div class="relative">
                        <input id="username" 
                               name="_username" 
                               type="email" 
                               autocomplete="email" 
                               required 
                               value="{{ last_username }}"
                               placeholder="your@email.com"
                               class="w-full px-4 py-3 bg-white/50 dark:bg-gray-800/50 backdrop-blur-sm border border-gray-200/50 dark:border-gray-700/50 rounded-xl text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500/50 focus:border-transparent transition-all">
                    </div>
                </div>

                <!-- Пароль -->
                <div class="space-y-2">
                    <label for="password" class="block text-sm font-medium text-gray-700 dark:text-gray-300">
                        <i class="fas fa-lock mr-2 text-blue-500 dark:text-blue-400"></i>
                        Пароль
                    </label>
                    <div class="relative">
                        <input id="password" 
                               name="_password" 
                               type="password" 
                               autocomplete="current-password" 
                               required
                               placeholder="••••••••"
                               class="w-full px-4 py-3 bg-white/50 dark:bg-gray-800/50 backdrop-blur-sm border border-gray-200/50 dark:border-gray-700/50 rounded-xl text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500/50 focus:border-transparent transition-all">
                    </div>
                </div>

                <!-- Remember me & Forgot password -->
                <div class="flex items-center justify-between">
                    <div class="flex items-center">
                        <input id="remember_me" 
                               name="_remember_me" 
                               type="checkbox"
                               class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 dark:border-gray-600 rounded bg-white/50 dark:bg-gray-800/50 backdrop-blur-sm">
                        <label for="remember_me" class="ml-2 block text-sm text-gray-900 dark:text-gray-300">
                            Запам'ятати мене
                        </label>
                    </div>

                    <div class="text-sm">
                        <a href="{{ path('app_reset_password_request') }}" class="font-medium text-blue-600 hover:text-blue-500 dark:text-blue-400 dark:hover:text-blue-300 transition-colors">
                            Забули пароль?
                        </a>
                    </div>
                </div>

                <!-- Submit button (без бліка) -->
                <div>
                    <button type="submit" 
                            class="w-full py-3 px-4 bg-gradient-to-r from-blue-500 to-purple-600 dark:from-blue-500 dark:to-purple-500 text-white font-medium rounded-xl shadow-lg hover:shadow-xl hover:scale-[1.02] active:scale-95 transition-all duration-300">
                        <span class="flex items-center justify-center gap-2">
                            <i class="fas fa-sign-in-alt"></i>
                            Увійти
                        </span>
                    </button>
                </div>
            </form>

            <!-- Social login -->
            <div class="mt-6">
                <div class="relative">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t border-white/30 dark:border-gray-700/30"></div>
                    </div>
                    <div class="relative flex justify-center text-sm">
                        <span class="px-2 bg-white/70 dark:bg-gray-900/70 backdrop-blur-sm text-gray-500 dark:text-gray-400">
                            Або увійти через
                        </span>
                    </div>
                </div>

                <div class="mt-6 grid grid-cols-2 gap-3">
                    <!-- Facebook -->
                    <a href="{{ path('connect_facebook_start') }}" 
                       class="group relative w-full inline-flex justify-center py-3 px-4 border border-white/30 dark:border-gray-700/30 rounded-xl shadow-lg bg-white/50 dark:bg-gray-800/50 backdrop-blur-sm text-gray-700 dark:text-gray-300 hover:bg-white/80 dark:hover:bg-gray-800/80 hover:shadow-xl hover:scale-[1.02] active:scale-95 transition-all duration-300 overflow-hidden">
                        <span class="relative flex items-center gap-2">
                            <i class="fab fa-facebook-f text-blue-600 dark:text-blue-400 text-lg"></i>
                            <span class="sr-only">Facebook</span>
                        </span>
                    </a>

                    <!-- Google -->
                    <a href="{{ path('connect_google_start') }}" 
                       class="group relative w-full inline-flex justify-center py-3 px-4 border border-white/30 dark:border-gray-700/30 rounded-xl shadow-lg bg-white/50 dark:bg-gray-800/50 backdrop-blur-sm text-gray-700 dark:text-gray-300 hover:bg-white/80 dark:hover:bg-gray-800/80 hover:shadow-xl hover:scale-[1.02] active:scale-95 transition-all duration-300 overflow-hidden">
                        <span class="relative flex items-center gap-2">
                            <i class="fab fa-google text-red-600 dark:text-red-400 text-lg"></i>
                            <span class="sr-only">Google</span>
                        </span>
                    </a>
                </div>
            </div>

            <!-- Register link for mobile -->
            <div class="mt-6 text-center md:hidden">
                <p class="text-sm text-gray-600 dark:text-gray-400">
                    Ще немає акаунту?
                    <a href="{{ path('app_register') }}" class="font-medium text-blue-600 hover:text-blue-500 dark:text-blue-400 dark:hover:text-blue-300 transition-colors">
                        Зареєструватися
                    </a>
                </p>
            </div>
        </div>

        <!-- Additional info -->
        <div class="text-center text-xs text-gray-500 dark:text-gray-400 backdrop-blur-sm bg-white/30 dark:bg-gray-900/30 py-3 px-4 rounded-xl border border-white/20 dark:border-gray-700/20">
            <div class="flex items-center justify-center gap-2">
                <i class="fas fa-shield-alt text-green-500"></i>
                <span>Захищено SSL шифруванням • Ваші дані в безпеці</span>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
/* Додаткові стилі для склоподібного ефекту */
.backdrop-blur-xl {
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
}

/* Анімація для декоративних елементів */
@keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-20px); }
}

.absolute.-top-40 {
    animation: float 8s ease-in-out infinite;
}

.absolute.-bottom-40 {
    animation: float 8s ease-in-out infinite;
    animation-delay: 1s;
}
</style>
{% endblock %}