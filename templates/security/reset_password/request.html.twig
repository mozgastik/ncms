{% extends 'base.html.twig' %}

{% block title %}Відновлення пароля{% endblock %}

{% block body %}
<div class="min-h-[80vh] flex items-center justify-center px-4 bg-gray-50 dark:bg-gray-950">
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl p-8 max-w-md w-full">
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-4 text-center">
            Відновлення пароля
        </h1>
        <p class="text-gray-600 dark:text-gray-400 mb-6 text-center text-sm">
            Введіть ваш email, і ми надішлемо посилання для скидання пароля.
        </p>

        {{ form_start(form, {'attr': {'class': 'space-y-4'}}) }}
            <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Email</label>
                {{ form_widget(form.mail, {
                    'attr': {
                        'class': 'w-full px-4 py-2.5 rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:ring-2 focus:ring-blue-500/50 focus:border-transparent transition-all',
                        'placeholder': 'example@email.com'
                    }
                }) }}
                {{ form_errors(form.mail) }}
            </div>

            <button type="submit" class="w-full py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl transition-colors duration-200">
                Надіслати посилання
            </button>
        {{ form_end(form) }}

        <div class="mt-6 text-center">
            <a href="{{ path('app_login') }}" class="text-sm text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400">
                ← Повернутися до входу
            </a>
        </div>
    </div>
</div>
{% endblock %}