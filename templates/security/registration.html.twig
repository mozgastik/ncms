{# templates/registration/index.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}Реєстрація - Новинний портал{% endblock %}

{% block body %}
<div class="min-h-screen flex items-center justify-center bg-gradient-to-b from-gray-50 to-white dark:from-gray-900 dark:to-gray-950 py-12 px-4 sm:px-6 lg:px-8">
    
    <!-- Декоративні елементи -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none">
        <div class="absolute -top-40 -right-40 w-80 h-80 bg-blue-500/5 dark:bg-blue-500/10 rounded-full blur-3xl"></div>
        <div class="absolute -bottom-40 -left-40 w-80 h-80 bg-purple-500/5 dark:bg-purple-500/10 rounded-full blur-3xl"></div>
    </div>

    <div class="max-w-2xl w-full space-y-8 relative z-10">
        <!-- Заголовок -->
        <div class="text-center">
            <div class="flex justify-center">
                <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-blue-500 to-purple-600 dark:from-blue-400 dark:to-purple-400 flex items-center justify-center shadow-2xl">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-10 h-10 text-white">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M18 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0ZM3 17.25v.75a3 3 0 0 0 3 3h12a3 3 0 0 0 3-3v-.75M6 10.5h.001v.008H6v-.008ZM10.5 10.5h.001v.008H10.5v-.008ZM15 10.5h.001v.008H15v-.008Z" />
                    </svg>
                </div>
            </div>
            <h2 class="mt-6 text-center text-3xl font-extrabold text-gray-900 dark:text-white">
                Створення облікового запису
            </h2>
            <p class="mt-2 text-center text-sm text-gray-600 dark:text-gray-400">
                Або
                <a href="{{ path('app_login') }}" class="font-medium text-blue-600 hover:text-blue-500 dark:text-blue-400 dark:hover:text-blue-300 transition-colors">
                    увійти в існуючий акаунт
                </a>
            </p>
        </div>
        
        <!-- Форма (склоподібний дизайн) -->
        <div class="backdrop-blur-xl bg-white/70 dark:bg-gray-900/70 py-8 px-6 shadow-2xl rounded-2xl border border-white/30 dark:border-gray-700/30 sm:px-10">
            {{ form_start(registrationForm, {'attr': {'class': 'space-y-6'}}) }}
            
            {% if registrationForm.vars.errors|length > 0 %}
                <div class="bg-red-500/10 dark:bg-red-500/20 backdrop-blur-sm border border-red-200/30 dark:border-red-800/30 text-red-700 dark:text-red-400 px-4 py-3 rounded-xl relative flex items-center gap-3">
                    <i class="fas fa-exclamation-circle"></i>
                    <span class="block sm:inline">{{ form_errors(registrationForm) }}</span>
                </div>
            {% endif %}
            
            <!-- Ім'я користувача та Email в сітці -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Ім'я користувача -->
                <div class="space-y-2">
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">
                        <i class="fas fa-user mr-2 text-blue-500 dark:text-blue-400"></i>
                        Ім'я користувача*
                    </label>
                    {{ form_widget(registrationForm.username, {
                        'attr': {
                            'class': 'w-full px-4 py-3 bg-white/50 dark:bg-gray-800/50 backdrop-blur-sm border border-gray-200/50 dark:border-gray-700/50 rounded-xl text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500/50 focus:border-transparent transition-all',
                            'placeholder': 'john_doe'
                        }
                    }) }}
                    <p class="text-xs text-gray-500 dark:text-gray-400">Лише латинські літери, цифри та _</p>
                    <div class="text-sm text-red-500">{{ form_errors(registrationForm.username) }}</div>
                </div>
                
                <!-- Email -->
                <div class="space-y-2">
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">
                        <i class="fas fa-envelope mr-2 text-blue-500 dark:text-blue-400"></i>
                        Email адреса*
                    </label>
                    {{ form_widget(registrationForm.mail, {
                        'attr': {
                            'class': 'w-full px-4 py-3 bg-white/50 dark:bg-gray-800/50 backdrop-blur-sm border border-gray-200/50 dark:border-gray-700/50 rounded-xl text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500/50 focus:border-transparent transition-all',
                            'placeholder': 'example@email.com'
                        }
                    }) }}
                    <div class="text-sm text-red-500">{{ form_errors(registrationForm.mail) }}</div>
                </div>
            </div>
            
            <!-- Повне ім'я -->
            <div class="space-y-2">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">
                    <i class="fas fa-id-card mr-2 text-blue-500 dark:text-blue-400"></i>
                    Повне ім'я
                </label>
                {{ form_widget(registrationForm.fullName, {
                    'attr': {
                        'class': 'w-full px-4 py-3 bg-white/50 dark:bg-gray-800/50 backdrop-blur-sm border border-gray-200/50 dark:border-gray-700/50 rounded-xl text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500/50 focus:border-transparent transition-all',
                        'placeholder': 'Іван Петренко'
                    }
                }) }}
                <div class="text-sm text-red-500">{{ form_errors(registrationForm.fullName) }}</div>
            </div>
            
            <!-- Дата народження -->
            <div class="space-y-2 max-w-xs">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">
                    <i class="fas fa-cake-candles mr-2 text-blue-500 dark:text-blue-400"></i>
                    Дата народження
                </label>
                {{ form_widget(registrationForm.birthDate, {
                    'attr': {
                        'class': 'w-full px-4 py-3 bg-white/50 dark:bg-gray-800/50 backdrop-blur-sm border border-gray-200/50 dark:border-gray-700/50 rounded-xl text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500/50 focus:border-transparent transition-all'
                    }
                }) }}
                <div class="text-sm text-red-500">{{ form_errors(registrationForm.birthDate) }}</div>
            </div>
            
            <!-- Пароль -->
            <div class="space-y-2">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">
                    <i class="fas fa-lock mr-2 text-blue-500 dark:text-blue-400"></i>
                    Пароль*
                </label>
                <div class="relative">
                    {{ form_widget(registrationForm.plainPassword.first, {
                        'attr': {
                            'class': 'w-full px-4 py-3 bg-white/50 dark:bg-gray-800/50 backdrop-blur-sm border border-gray-200/50 dark:border-gray-700/50 rounded-xl text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500/50 focus:border-transparent transition-all pr-12',
                            'placeholder': '••••••••'
                        }
                    }) }}
                </div>
                <div class="text-sm text-red-500">{{ form_errors(registrationForm.plainPassword.first) }}</div>
            </div>
            
            <!-- Вимоги до паролю -->
            <div class="bg-gray-50/50 dark:bg-gray-800/50 backdrop-blur-sm p-4 rounded-xl border border-gray-200/50 dark:border-gray-700/50">
                <p class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Вимоги до паролю:</p>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-2 text-sm password-requirements">
                    <div class="flex items-center gap-2">
                        <span class="w-5 h-5 flex items-center justify-center text-xs rounded-full border-2 border-gray-300 dark:border-gray-600 requirement-length">○</span>
                        <span class="text-gray-600 dark:text-gray-400">Мінімум 6 символів</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="w-5 h-5 flex items-center justify-center text-xs rounded-full border-2 border-gray-300 dark:border-gray-600 requirement-lower">○</span>
                        <span class="text-gray-600 dark:text-gray-400">Хоча б одна мала літера</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="w-5 h-5 flex items-center justify-center text-xs rounded-full border-2 border-gray-300 dark:border-gray-600 requirement-upper">○</span>
                        <span class="text-gray-600 dark:text-gray-400">Хоча б одна велика літера</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="w-5 h-5 flex items-center justify-center text-xs rounded-full border-2 border-gray-300 dark:border-gray-600 requirement-digit">○</span>
                        <span class="text-gray-600 dark:text-gray-400">Хоча б одна цифра</span>
                    </div>
                </div>
            </div>
            
            <!-- Повтор пароля -->
            <div class="space-y-2">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">
                    <i class="fas fa-lock mr-2 text-blue-500 dark:text-blue-400"></i>
                    Повторіть пароль*
                </label>
                <div class="relative">
                    {{ form_widget(registrationForm.plainPassword.second, {
                        'attr': {
                            'class': 'w-full px-4 py-3 bg-white/50 dark:bg-gray-800/50 backdrop-blur-sm border border-gray-200/50 dark:border-gray-700/50 rounded-xl text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500/50 focus:border-transparent transition-all pr-12',
                            'placeholder': '••••••••'
                        }
                    }) }}
                </div>
                <div class="text-sm text-red-500">{{ form_errors(registrationForm.plainPassword.second) }}</div>
            </div>
            
            <!-- Умови використання -->
            <div class="bg-white/30 dark:bg-gray-800/30 backdrop-blur-sm p-4 rounded-xl border border-white/20 dark:border-gray-700/20">
                <div class="flex items-start">
                    <div class="flex items-center h-5">
                        {{ form_widget(registrationForm.agreeTerms, {
                            'attr': {
                                'class': 'w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500 bg-white/50 dark:bg-gray-800/50'
                            }
                        }) }}
                    </div>
                    <div class="ml-3 text-sm">
                        {{ form_label(registrationForm.agreeTerms, 'Я погоджуюсь з умовами', {
                            'label_attr': {'class': 'font-medium text-gray-700 dark:text-gray-300'}
                        }) }}
                        <p class="text-gray-500 dark:text-gray-400 mt-1">
                            Реєструючись, ви погоджуєтесь з нашими 
                            <a href="#" class="text-blue-600 hover:text-blue-500 dark:text-blue-400 dark:hover:text-blue-300 transition-colors">Умовами використання</a> 
                            та 
                            <a href="#" class="text-blue-600 hover:text-blue-500 dark:text-blue-400 dark:hover:text-blue-300 transition-colors">Політикою конфіденційності</a>.
                        </p>
                    </div>
                </div>
                <div class="text-sm text-red-500">{{ form_errors(registrationForm.agreeTerms) }}</div>
            </div>
            
            <!-- Кнопка реєстрації -->
            <div class="pt-4">
                <button type="submit" 
                        class="w-full py-3 px-4 bg-gradient-to-r from-blue-500 to-purple-600 dark:from-blue-500 dark:to-purple-500 text-white font-medium rounded-xl shadow-lg hover:shadow-xl hover:scale-[1.02] active:scale-95 transition-all duration-300">
                    <span class="flex items-center justify-center gap-2">
                        <i class="fas fa-user-plus"></i>
                        Зареєструватися
                    </span>
                </button>
            </div>
            
            {{ form_end(registrationForm) }}
            
            <!-- Соціальна реєстрація -->
            <div class="mt-8 pt-6 border-t border-white/30 dark:border-gray-700/30">
                <div class="text-center mb-4">
                    <span class="px-4 py-1 bg-white/50 dark:bg-gray-800/50 backdrop-blur-sm text-sm text-gray-500 dark:text-gray-400 rounded-full">
                        Або зареєструватися через
                    </span>
                </div>
                
                <div class="grid grid-cols-2 gap-3">
                    <a href="#" 
                       class="group relative w-full inline-flex justify-center py-3 px-4 border border-white/30 dark:border-gray-700/30 rounded-xl shadow-lg bg-white/50 dark:bg-gray-800/50 backdrop-blur-sm text-gray-700 dark:text-gray-300 hover:bg-white/80 dark:hover:bg-gray-800/80 hover:shadow-xl hover:scale-[1.02] active:scale-95 transition-all duration-300">
                        <span class="flex items-center gap-2">
                            <i class="fab fa-facebook-f text-blue-600 dark:text-blue-400 text-lg"></i>
                            <span class="text-sm font-medium">Facebook</span>
                        </span>
                    </a>
                    
                    <a href="#" 
                       class="group relative w-full inline-flex justify-center py-3 px-4 border border-white/30 dark:border-gray-700/30 rounded-xl shadow-lg bg-white/50 dark:bg-gray-800/50 backdrop-blur-sm text-gray-700 dark:text-gray-300 hover:bg-white/80 dark:hover:bg-gray-800/80 hover:shadow-xl hover:scale-[1.02] active:scale-95 transition-all duration-300">
                        <span class="flex items-center gap-2">
                            <i class="fab fa-google text-red-600 dark:text-red-400 text-lg"></i>
                            <span class="text-sm font-medium">Google</span>
                        </span>
                    </a>
                </div>
            </div>
            
            <!-- Переваги реєстрації -->
            <div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-4 text-center">
                <div class="flex items-center justify-center gap-2">
                    <i class="fas fa-comment text-blue-500 dark:text-blue-400"></i>
                    <span class="text-sm text-gray-600 dark:text-gray-400">Залишати коментарі</span>
                </div>
                <div class="flex items-center justify-center gap-2">
                    <i class="fas fa-star text-yellow-500 dark:text-yellow-400"></i>
                    <span class="text-sm text-gray-600 dark:text-gray-400">Додавати в обране</span>
                </div>
                <div class="flex items-center justify-center gap-2">
                    <i class="fas fa-bell text-green-500 dark:text-green-400"></i>
                    <span class="text-sm text-gray-600 dark:text-gray-400">Отримувати сповіщення</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Скрипти та стилі -->
{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Перемикання видимості пароля
    const passwordFields = document.querySelectorAll('input[type="password"]');
    
    passwordFields.forEach(field => {
        const wrapper = field.parentElement;
        wrapper.style.position = 'relative';
        
        const toggle = document.createElement('span');
        toggle.innerHTML = '<i class="fas fa-eye"></i>';
        toggle.className = 'absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 cursor-pointer z-10';
        toggle.style.right = '1rem';
        
        toggle.addEventListener('click', function() {
            const type = field.getAttribute('type') === 'password' ? 'text' : 'password';
            field.setAttribute('type', type);
            this.innerHTML = type === 'password' ? '<i class="fas fa-eye"></i>' : '<i class="fas fa-eye-slash"></i>';
        });
        
        wrapper.appendChild(toggle);
    });
    
    // Валідація пароля в реальному часі
    const passwordInput = document.querySelector('input[name="registration_form[plainPassword][first]"]');
    
    if (passwordInput) {
        const requirements = document.querySelectorAll('.requirement-length, .requirement-lower, .requirement-upper, .requirement-digit');
        
        passwordInput.addEventListener('input', function() {
            const value = this.value;
            
            // Перевірка довжини
            const lengthCheck = document.querySelector('.requirement-length');
            if (value.length >= 6) {
                lengthCheck.textContent = '✓';
                lengthCheck.classList.add('text-green-500', 'border-green-500');
                lengthCheck.classList.remove('border-gray-300', 'dark:border-gray-600');
            } else {
                lengthCheck.textContent = '○';
                lengthCheck.classList.remove('text-green-500', 'border-green-500');
                lengthCheck.classList.add('border-gray-300', 'dark:border-gray-600');
            }
            
            // Перевірка малої літери
            const lowerCheck = document.querySelector('.requirement-lower');
            if (/[a-z]/.test(value)) {
                lowerCheck.textContent = '✓';
                lowerCheck.classList.add('text-green-500', 'border-green-500');
                lowerCheck.classList.remove('border-gray-300', 'dark:border-gray-600');
            } else {
                lowerCheck.textContent = '○';
                lowerCheck.classList.remove('text-green-500', 'border-green-500');
                lowerCheck.classList.add('border-gray-300', 'dark:border-gray-600');
            }
            
            // Перевірка великої літери
            const upperCheck = document.querySelector('.requirement-upper');
            if (/[A-Z]/.test(value)) {
                upperCheck.textContent = '✓';
                upperCheck.classList.add('text-green-500', 'border-green-500');
                upperCheck.classList.remove('border-gray-300', 'dark:border-gray-600');
            } else {
                upperCheck.textContent = '○';
                upperCheck.classList.remove('text-green-500', 'border-green-500');
                upperCheck.classList.add('border-gray-300', 'dark:border-gray-600');
            }
            
            // Перевірка цифри
            const digitCheck = document.querySelector('.requirement-digit');
            if (/\d/.test(value)) {
                digitCheck.textContent = '✓';
                digitCheck.classList.add('text-green-500', 'border-green-500');
                digitCheck.classList.remove('border-gray-300', 'dark:border-gray-600');
            } else {
                digitCheck.textContent = '○';
                digitCheck.classList.remove('text-green-500', 'border-green-500');
                digitCheck.classList.add('border-gray-300', 'dark:border-gray-600');
            }
        });
    }
});
</script>
{% endblock %}
{% endblock %}