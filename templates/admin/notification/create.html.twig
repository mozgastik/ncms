{% extends 'admin/base.html.twig' %}

{% block title %}Нове сповіщення{% endblock %}

{% block body %}
<main class="flex-1 p-2 sm:p-3 md:p-4 lg:p-6">
    <div class="max-w-3xl mx-auto">
        {# Заголовок #}
        <div class="flex items-center justify-between mb-6">
            <div>
                <h1 class="text-2xl font-bold text-(--color-surface-900) dark:text-(--color-surface-100)">
                    ✉️ Нове сповіщення
                </h1>
                <p class="text-(--color-surface-500) dark:text-(--color-surface-400) text-sm mt-1">
                    Створіть повідомлення для користувачів
                </p>
            </div>
            <a href="{{ path('admin_notification_index') }}" 
               class="text-sm text-(--color-surface-600) dark:text-(--color-surface-400) hover:text-(--color-primary-600) dark:hover:text-(--color-primary-400) transition-colors">
                ← Назад до списку
            </a>
        </div>

        {# Форма #}
        <div class="bg-(--color-surface-0) dark:bg-(--color-surface-800) rounded-2xl shadow-(--shadow-md) border border-(--color-surface-200) dark:border-(--color-surface-700) p-6">
            {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

            <div>
                <label class="block text-sm font-medium text-(--color-surface-700) dark:text-(--color-surface-300) mb-2">{{ form.title.vars.label|default('Заголовок') }}</label>
                {{ form_widget(form.title, {'attr': {'class': 'w-full px-4 py-2.5 rounded-xl border border-(--color-surface-300) dark:border-(--color-surface-600) bg-(--color-surface-0) dark:bg-(--color-surface-800) text-(--color-surface-900) dark:text-(--color-surface-100) focus:ring-2 focus:ring-(--color-primary-500)/50 focus:border-(--color-primary-500) transition-all'}}) }}
                {{ form_errors(form.title) }}
            </div>

            <div>
                <label class="block text-sm font-medium text-(--color-surface-700) dark:text-(--color-surface-300) mb-2">{{ form.message.vars.label|default('Повідомлення') }}</label>
                {{ form_widget(form.message, {'attr': {'class': 'w-full px-4 py-2.5 rounded-xl border border-(--color-surface-300) dark:border-(--color-surface-600) bg-(--color-surface-0) dark:bg-(--color-surface-800) text-(--color-surface-900) dark:text-(--color-surface-100) focus:ring-2 focus:ring-(--color-primary-500)/50 focus:border-(--color-primary-500) transition-all', 'rows': 5}}) }}
                {{ form_errors(form.message) }}
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-medium text-(--color-surface-700) dark:text-(--color-surface-300) mb-2">{{ form.type.vars.label|default('Тип') }}</label>
                    {{ form_widget(form.type, {'attr': {'class': 'w-full px-4 py-2.5 rounded-xl border border-(--color-surface-300) dark:border-(--color-surface-600) bg-(--color-surface-0) dark:bg-(--color-surface-800) text-(--color-surface-900) dark:text-(--color-surface-100) focus:ring-2 focus:ring-(--color-primary-500)/50 focus:border-(--color-primary-500) transition-all'}}) }}
                </div>
                <div>
                    <label class="block text-sm font-medium text-(--color-surface-700) dark:text-(--color-surface-300) mb-2">{{ form.target.vars.label|default('Отримувачі') }}</label>
                    {{ form_widget(form.target, {'attr': {'class': 'w-full px-4 py-2.5 rounded-xl border border-(--color-surface-300) dark:border-(--color-surface-600) bg-(--color-surface-0) dark:bg-(--color-surface-800) text-(--color-surface-900) dark:text-(--color-surface-100) focus:ring-2 focus:ring-(--color-primary-500)/50 focus:border-(--color-primary-500) transition-all'}}) }}
                </div>
            </div>

            <div class="flex justify-end pt-4 border-t border-(--color-surface-200) dark:border-(--color-surface-700)">
                <button type="submit" class="px-6 py-3 bg-(--gradient-primary) text-(--color-surface-0) font-semibold rounded-xl hover:shadow-lg hover-scale transition-all duration-(--transition-base)">
                    💾 Створити сповіщення
                </button>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
</main>
{% endblock %}