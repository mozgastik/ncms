{# templates/admin/notification/index.html.twig #}

{% extends 'admin/base.html.twig' %}

{% block title %}Сповіщення{% endblock %}

{% block body %}
<div class="min-h-screen bg-surface-50 dark:bg-surface-950" 
     x-data="notificationsPage()"
     x-init="init()">
    
    <div class="max-w-4xl mx-auto px-4 py-8">
        <!-- Заголовок -->
        <div class="flex items-center justify-between mb-8">
            <div>
                <h1 class="text-2xl lg:text-3xl font-bold text-surface-900 dark:text-surface-100 flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-primary-500 to-primary-600 flex items-center justify-center">
                        <i class="fas fa-bell text-white"></i>
                    </div>
                    Сповіщення
                </h1>
                <p class="text-surface-500 dark:text-surface-400 mt-2">
                    Усі сповіщення вашого акаунта
                </p>
            </div>
            
            <button 
                @click="markAllAsRead()"
                x-show="unreadCount > 0"
                class="inline-flex items-center gap-2 px-4 py-2 bg-surface-0 dark:bg-surface-900 border border-surface-200 dark:border-surface-700 rounded-xl text-surface-700 dark:text-surface-300 hover:bg-surface-50 dark:hover:bg-surface-800 transition">
                <i class="fas fa-check-double"></i>
                <span>Прочитати всі</span>
            </button>
        </div>

        <!-- Таби -->
        <div class="flex gap-2 mb-6 p-1 bg-surface-100 dark:bg-surface-800 rounded-2xl w-fit">
            <button 
                @click="filter = 'all'"
                :class="filter === 'all' ? 'bg-surface-0 dark:bg-surface-900 shadow-lg text-primary-600' : 'text-surface-600 dark:text-surface-400'"
                class="px-6 py-2 rounded-xl font-medium transition">
                Усі
                <span class="ml-2 text-xs" x-text="totalCount"></span>
            </button>
            <button 
                @click="filter = 'unread'"
                :class="filter === 'unread' ? 'bg-surface-0 dark:bg-surface-900 shadow-lg text-primary-600' : 'text-surface-600 dark:text-surface-400'"
                class="px-6 py-2 rounded-xl font-medium transition">
                Непрочитані
                <span class="ml-2 text-xs" x-text="unreadCount"></span>
            </button>
        </div>

        <!-- Список сповіщень -->
        <div class="bg-surface-0 dark:bg-surface-900 rounded-2xl shadow-lg border border-surface-200 dark:border-surface-800 overflow-hidden">
            <template x-if="loading">
                <div class="flex justify-center items-center py-20">
                    <div class="loader"></div>
                </div>
            </template>

            <template x-if="!loading && filteredItems.length === 0">
                <div class="text-center py-20">
                    <div class="inline-flex items-center justify-center w-20 h-20 bg-surface-100 dark:bg-surface-800 rounded-full mb-6">
                        <i class="fas fa-bell-slash text-3xl text-surface-400 dark:text-surface-500"></i>
                    </div>
                    <h3 class="text-lg font-semibold text-surface-900 dark:text-surface-100 mb-2">
                        Немає сповіщень
                    </h3>
                    <p class="text-surface-500 dark:text-surface-400">
                        Відпочивайте, все спокійно
                    </p>
                </div>
            </template>

            <template x-if="!loading && filteredItems.length > 0">
                <div class="divide-y divide-surface-200 dark:divide-surface-800">
                    <template x-for="item in filteredItems" :key="item.id">
                        <div 
                            @click="markAsRead(item)"
                            :class="{
                                'bg-primary-50/50 dark:bg-primary-900/10': !item.readAt,
                                'opacity-70': item.readAt
                            }"
                            class="flex items-start gap-4 p-6 hover:bg-surface-50 dark:hover:bg-surface-800/50 transition cursor-pointer group"
                        >
                            <!-- Іконка -->
                            <div 
                                :class="notificationBgClass(item.type)"
                                class="w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0">
                                <i :class="notificationIconClass(item.type)" class="fas text-lg"></i>
                            </div>
                            
                            <!-- Контент -->
                            <div class="flex-1 min-w-0">
                                <div class="flex items-start justify-between gap-4 mb-1">
                                    <h3 class="text-base font-semibold text-surface-900 dark:text-surface-100"
                                        x-text="item.title">
                                    </h3>
                                    <span x-show="!item.readAt" 
                                          class="px-2 py-1 bg-primary-100 dark:bg-primary-900/30 text-primary-600 dark:text-primary-400 text-xs font-medium rounded-full whitespace-nowrap">
                                        Нове
                                    </span>
                                </div>
                                
                                <p x-show="item.message" 
                                   class="text-sm text-surface-600 dark:text-surface-400 mb-3"
                                   x-text="item.message">
                                </p>
                                
                                <div class="flex items-center gap-4 text-xs">
                                    <span class="text-surface-500 dark:text-surface-500" 
                                          x-text="timeAgo(item.createdAt)">
                                    </span>
                                    
                                    <a x-show="item.link" 
                                       :href="item.link"
                                       @click.stop
                                       class="inline-flex items-center gap-1 text-primary-600 dark:text-primary-400 hover:underline">
                                        <span>Переглянути</span>
                                        <i class="fas fa-arrow-right text-[10px]"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </template>
                </div>
            </template>
        </div>
    </div>
</div>

<script>
function notificationsPage() {
    return {
        filter: 'all',
        loading: false,
        items: [],
        unreadCount: {{ unreadCount|default(0) }}, // ← Додано default
        totalCount: {{ notifications|length|default(0) }}, // ← Додано default
        
        get filteredItems() {
            if (this.filter === 'unread') {
                return this.items.filter(item => !item.readAt);
            }
            return this.items;
        },
        
        init() {
            this.load();
        },
        
        load() {
            this.loading = true;
            
            fetch('{{ path('api_notifications_index') }}')
                .then(res => res.json())
                .then(data => {
                    this.items = data.items;
                    this.unreadCount = data.unreadCount;
                    this.totalCount = data.total;
                    this.loading = false;
                })
                .catch(() => {
                    this.loading = false;
                });
        },
        
        markAsRead(item) {
            if (item.readAt) return;
            
            fetch(`/api/notifications/${item.id}/read`, { method: 'POST' })
                .then(res => res.json())
                .then(data => {
                    item.readAt = new Date().toISOString();
                    this.unreadCount = data.unreadCount;
                });
        },
        
        markAllAsRead() {
            fetch('{{ path('api_notifications_read_all') }}', { method: 'POST' })
                .then(res => res.json())
                .then(() => {
                    this.items.forEach(item => {
                        item.readAt = new Date().toISOString();
                    });
                    this.unreadCount = 0;
                });
        },
        
        timeAgo(date) {
            const diff = Math.floor((new Date() - new Date(date)) / 1000);
            if (diff < 60) return 'щойно';
            if (diff < 3600) return `${Math.floor(diff / 60)} хв тому`;
            if (diff < 86400) return `${Math.floor(diff / 3600)} год тому`;
            if (diff < 2592000) return `${Math.floor(diff / 86400)} дн тому`;
            return new Date(date).toLocaleDateString('uk-UA');
        },
        
        notificationIconClass(type) {
            const icons = {
                'success': 'fa-check-circle text-success-600 dark:text-success-400',
                'warning': 'fa-exclamation-triangle text-warning-600 dark:text-warning-400',
                'error': 'fa-times-circle text-danger-600 dark:text-danger-400',
                'info': 'fa-info-circle text-primary-600 dark:text-primary-400'
            };
            return icons[type] || icons.info;
        },
        
        notificationBgClass(type) {
            const bg = {
                'success': 'bg-success-100 dark:bg-success-900/30',
                'warning': 'bg-warning-100 dark:bg-warning-900/30',
                'error': 'bg-danger-100 dark:bg-danger-900/30',
                'info': 'bg-primary-100 dark:bg-primary-900/30'
            };
            return bg[type] || bg.info;
        }
    }
}
</script>
{% endblock %}