{# templates/quote/of_the_day.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Цитата дня - {{ quote.author }}{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <!-- Header -->
    <div class="text-center mb-12">
        <h1 class="text-4xl font-bold text-gray-800 mb-4">
            <i class="fas fa-star text-yellow-500 mr-2"></i>
            Цитата дня
            <i class="fas fa-star text-yellow-500 ml-2"></i>
        </h1>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            Найкраща цитата, обрана спеціально для вас сьогодні
        </p>
        <div class="mt-4 text-gray-500">
            <i class="far fa-calendar-alt mr-2"></i>
            {{ "now"|date("d.m.Y") }}
        </div>
    </div>

    <!-- Main Quote -->
    <div class="max-w-4xl mx-auto">
        <div class="bg-gradient-to-r from-yellow-50 to-orange-50 rounded-3xl shadow-2xl p-8 md:p-12 mb-8">
            <div class="flex items-start">
                <div class="flex-shrink-0 text-yellow-500 mr-6">
                    <i class="fas fa-quote-left text-5xl"></i>
                </div>
                <div class="flex-1">
                    <blockquote class="text-2xl md:text-3xl italic text-gray-800 leading-relaxed mb-8">
                        {{ quote.content }}
                    </blockquote>
                    
                    <div class="border-t border-yellow-200 pt-8">
                        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
                            <div>
                                <p class="text-2xl font-bold text-gray-800">
                                    — {{ quote.author }}
                                </p>
                                {% if quote.source %}
                                    <p class="text-lg text-gray-600 mt-2">
                                        {{ quote.source }}
                                    </p>
                                {% endif %}
                                {% if quote.category %}
                                    <span class="inline-block mt-4 px-4 py-2 text-sm bg-yellow-100 text-yellow-800 rounded-full font-medium">
                                        {{ quote.category }}
                                    </span>
                                {% endif %}
                            </div>
                            
                            <div class="flex items-center space-x-4">
                                <div class="text-center">
                                    <div class="text-3xl font-bold text-gray-800">{{ quote.views }}</div>
                                    <div class="text-sm text-gray-500">переглядів</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="bg-white rounded-2xl shadow-lg p-8 mb-8">
            <h2 class="text-2xl font-bold text-gray-800 mb-6 text-center">Поділитись цитатою</h2>
            
            <div class="flex flex-wrap justify-center gap-4 mb-8">
                <button onclick="shareQuote('{{ quote.content|slice(0, 100) }}...', '{{ quote.author }}', '{{ path('app_quote_show', {'id': quote.id}) }}')"
                        class="inline-flex items-center px-6 py-3 bg-blue-600 text-white rounded-xl hover:bg-blue-700 transition shadow-lg">
                    <i class="fas fa-share-alt mr-3"></i>
                    Поділитись
                </button>
                
                <a href="{{ path('api_quote_of_the_day') }}" 
                   target="_blank"
                   class="inline-flex items-center px-6 py-3 bg-green-600 text-white rounded-xl hover:bg-green-700 transition shadow-lg">
                    <i class="fas fa-code mr-3"></i>
                    JSON API
                </a>
                
                <button onclick="getRandomQuote()"
                        class="inline-flex items-center px-6 py-3 bg-purple-600 text-white rounded-xl hover:bg-purple-700 transition shadow-lg">
                    <i class="fas fa-random mr-3"></i>
                    Випадкова цитата
                </button>
            </div>

            <div class="text-center text-gray-600">
                <p class="mb-4">Скопіюйте посилання на цитату:</p>
                <div class="flex items-center justify-center">
                    <input type="text" 
                           readonly 
                           value="{{ absolute_url(path('app_quote_show', {'id': quote.id})) }}"
                           class="w-full max-w-lg px-4 py-3 border border-gray-300 rounded-l-xl focus:outline-none focus:ring-2 focus:ring-blue-500"
                           id="quote-url">
                    <button onclick="copyQuoteUrl()"
                            class="px-6 py-3 bg-gray-800 text-white rounded-r-xl hover:bg-gray-900 transition">
                        <i class="fas fa-copy"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Additional Info -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
            <div class="bg-white rounded-2xl shadow-lg p-8">
                <h3 class="text-xl font-bold text-gray-800 mb-4 flex items-center">
                    <i class="fas fa-info-circle text-blue-500 mr-3"></i>
                    Про цитату
                </h3>
                <dl class="space-y-4">
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Дата створення</dt>
                        <dd class="text-gray-900">{{ quote.createdAt|date('d.m.Y H:i') }}</dd>
                    </div>
                    {% if quote.updatedAt %}
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Дата оновлення</dt>
                        <dd class="text-gray-900">{{ quote.updatedAt|date('d.m.Y H:i') }}</dd>
                    </div>
                    {% endif %}
                    {% if quote.displayDate %}
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Дата показу</dt>
                        <dd class="text-gray-900">{{ quote.displayDate|date('d.m.Y') }}</dd>
                    </div>
                    {% endif %}
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Статус</dt>
                        <dd class="text-gray-900">
                            {% if quote.isActive %}
                                <span class="px-3 py-1 text-sm bg-green-100 text-green-800 rounded-full">
                                    Активна
                                </span>
                            {% else %}
                                <span class="px-3 py-1 text-sm bg-gray-100 text-gray-800 rounded-full">
                                    Неактивна
                                </span>
                            {% endif %}
                        </dd>
                    </div>
                </dl>
            </div>

            <div class="bg-white rounded-2xl shadow-lg p-8">
                <h3 class="text-xl font-bold text-gray-800 mb-4 flex items-center">
                    <i class="fas fa-calendar-day text-green-500 mr-3"></i>
                    Цитати дня
                </h3>
                <p class="text-gray-600 mb-6">
                    Щодня ми обираємо для вас особливу цитату, щоб надихнути та подати гарний настрій на цілий день.
                </p>
                <div class="space-y-4">
                    <a href="{{ path('app_quote_index') }}"
                       class="flex items-center justify-between p-4 bg-blue-50 rounded-xl hover:bg-blue-100 transition group">
                        <div class="flex items-center">
                            <i class="fas fa-quote-left text-blue-500 mr-4"></i>
                            <span class="font-medium text-gray-800 group-hover:text-blue-600">Всі цитати</span>
                        </div>
                        <i class="fas fa-chevron-right text-gray-400 group-hover:text-blue-500"></i>
                    </a>
                    
                    <a href="{{ path('app_popular_quotes') }}"
                       class="flex items-center justify-between p-4 bg-orange-50 rounded-xl hover:bg-orange-100 transition group">
                        <div class="flex items-center">
                            <i class="fas fa-fire text-orange-500 mr-4"></i>
                            <span class="font-medium text-gray-800 group-hover:text-orange-600">Популярні цитати</span>
                        </div>
                        <i class="fas fa-chevron-right text-gray-400 group-hover:text-orange-500"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Navigation -->
        <div class="flex flex-col sm:flex-row justify-between items-center gap-6">
            <a href="{{ path('app_quote_show', {'id': quote.id}) }}"
               class="inline-flex items-center px-8 py-4 bg-white border-2 border-blue-500 text-blue-600 rounded-xl hover:bg-blue-50 transition shadow-lg">
                <i class="fas fa-external-link-alt mr-3"></i>
                Детальна сторінка цитати
            </a>
            
            <div class="flex space-x-4">
                <a href="{{ path('app_quote_index') }}"
                   class="inline-flex items-center px-8 py-4 bg-blue-600 text-white rounded-xl hover:bg-blue-700 transition shadow-lg">
                    <i class="fas fa-list mr-3"></i>
                    Всі цитати
                </a>
                
                <a href="{{ path('app_homepage') }}"
                   class="inline-flex items-center px-8 py-4 bg-gray-800 text-white rounded-xl hover:bg-gray-900 transition shadow-lg">
                    <i class="fas fa-home mr-3"></i>
                    На головну
                </a>
            </div>
        </div>
    </div>
</div>

<script>
function shareQuote(content, author, url) {
    const fullUrl = window.location.origin + url;
    const text = encodeURIComponent(content + ' — ' + author);
    
    if (navigator.share) {
        navigator.share({
            title: 'Цитата дня: ' + author,
            text: content + ' — ' + author,
            url: fullUrl,
        });
    } else {
        // Fallback для браузерів без Web Share API
        const shareUrl = `https://twitter.com/intent/tweet?text=${text}&url=${encodeURIComponent(fullUrl)}`;
        window.open(shareUrl, '_blank', 'width=600,height=400');
    }
}

function copyQuoteUrl() {
    const urlInput = document.getElementById('quote-url');
    urlInput.select();
    urlInput.setSelectionRange(0, 99999); // Для мобільних пристроїв
    
    navigator.clipboard.writeText(urlInput.value).then(() => {
        // Показуємо повідомлення про успіх
        const button = event.target.closest('button');
        const originalHTML = button.innerHTML;
        button.innerHTML = '<i class="fas fa-check"></i>';
        button.classList.remove('bg-gray-800');
        button.classList.add('bg-green-600');
        
        setTimeout(() => {
            button.innerHTML = originalHTML;
            button.classList.remove('bg-green-600');
            button.classList.add('bg-gray-800');
        }, 2000);
    });
}

function getRandomQuote() {
    fetch('{{ path('api_random_quote') }}')
        .then(response => response.json())
        .then(data => {
            if (data.error) {
                alert(data.error);
                return;
            }
            
            // Показуємо модальне вікно з випадковою цитатою
            showRandomQuoteModal(data);
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Не вдалося отримати випадкову цитату');
        });
}

function showRandomQuoteModal(quote) {
    // Створюємо модальне вікно
    const modal = document.createElement('div');
    modal.className = 'fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4';
    modal.innerHTML = `
        <div class="bg-white rounded-2xl shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
            <div class="p-8">
                <div class="flex justify-between items-center mb-6">
                    <h3 class="text-2xl font-bold text-gray-800">
                        <i class="fas fa-random text-purple-500 mr-2"></i>
                        Випадкова цитата
                    </h3>
                    <button onclick="this.closest('.fixed').remove()"
                            class="text-gray-400 hover:text-gray-600 text-2xl">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                
                <div class="bg-purple-50 rounded-xl p-6 mb-6">
                    <div class="flex items-start">
                        <div class="flex-shrink-0 text-purple-500 mr-4">
                            <i class="fas fa-quote-left text-3xl"></i>
                        </div>
                        <div class="flex-1">
                            <blockquote class="text-xl italic text-gray-700 mb-6">
                                ${quote.content}
                            </blockquote>
                            <p class="text-lg font-bold text-gray-800 text-right">
                                — ${quote.author}
                            </p>
                            ${quote.source ? `<p class="text-gray-600 text-right mt-2">${quote.source}</p>` : ''}
                            ${quote.category ? `<div class="mt-4 text-center"><span class="px-3 py-1 text-sm bg-purple-100 text-purple-800 rounded-full">${quote.category}</span></div>` : ''}
                        </div>
                    </div>
                </div>
                
                <div class="flex justify-center space-x-4">
                    <a href="/quote/${quote.id}"
                       class="inline-flex items-center px-6 py-3 bg-blue-600 text-white rounded-xl hover:bg-blue-700 transition">
                        <i class="fas fa-external-link-alt mr-2"></i>
                        Відкрити сторінку
                    </a>
                    <button onclick="this.closest('.fixed').remove(); getRandomQuote()"
                            class="inline-flex items-center px-6 py-3 bg-purple-600 text-white rounded-xl hover:bg-purple-700 transition">
                        <i class="fas fa-redo mr-2"></i>
                        Ще одна
                    </button>
                </div>
            </div>
        </div>
    `;
    
    document.body.appendChild(modal);
    
    // Закриваємо модальне вікно при кліку на затемнений фон
    modal.addEventListener('click', (e) => {
        if (e.target === modal) {
            modal.remove();
        }
    });
}
</script>
{% endblock %}