{% extends 'admin/base.html.twig' %}

{% block title %}Редагувати цитату - Адмін панель{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8 max-w-4xl">
    <!-- Header -->
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-3xl font-bold text-gray-800">
                <i class="fas fa-edit mr-2"></i>Редагувати цитату
            </h1>
            <p class="text-gray-600 mt-2">Автор: {{ quote.author }}</p>
        </div>
        <div class="flex space-x-3">
            <a href="{{ path('admin_quote_index') }}" 
               class="inline-flex items-center px-4 py-2 bg-gray-600 text-white rounded-lg hover:bg-gray-700 transition">
                <i class="fas fa-arrow-left mr-2"></i>Назад до списку
            </a>
            <a href="{{ path('admin_quote_show', {'id': quote.id}) }}" 
               class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition">
                <i class="fas fa-eye mr-2"></i>Переглянути
            </a>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-md overflow-hidden">
        <div class="bg-yellow-600 px-6 py-4">
            <h2 class="text-lg font-semibold text-white">Форма редагування</h2>
        </div>
        <div class="p-6">
            {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
            
            <div class="space-y-4">
                {{ form_row(form.content, {
                    'label': 'Текст цитати *',
                    'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent'}
                }) }}
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    {{ form_row(form.author, {
                        'label': 'Автор *',
                        'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent'}
                    }) }}
                    
                    {{ form_row(form.category, {
                        'label': 'Категорія',
                        'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent'}
                    }) }}
                </div>
                
                {{ form_row(form.source, {
                    'label': 'Джерело',
                    'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent'}
                }) }}
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    {{ form_row(form.displayDate, {
                        'label': 'Дата показу',
                        'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent'}
                    }) }}
                    
                    <div class="flex items-center pt-6">
                        {{ form_widget(form.isActive, {
                            'attr': {'class': 'h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500'}
                        }) }}
                        {{ form_label(form.isActive, 'Активна', {
                            'label_attr': {'class': 'ml-2 text-sm text-gray-700'}
                        }) }}
                    </div>
                </div>
            </div>

            <div class="flex justify-end space-x-4 pt-6 border-t border-gray-200">
                <a href="{{ path('admin_quote_index') }}" 
                   class="inline-flex items-center px-6 py-3 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition">
                    Скасувати
                </a>
                <button type="submit" 
                        class="inline-flex items-center px-6 py-3 bg-yellow-600 text-white rounded-lg hover:bg-yellow-700 transition">
                    <i class="fas fa-save mr-2"></i>Зберегти зміни
                </button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>

    <!-- Preview -->
    <div class="mt-8 bg-gray-50 rounded-xl p-6">
        <h3 class="text-lg font-semibold text-gray-800 mb-4">Попередній перегляд</h3>
        <div class="bg-white rounded-lg p-6 shadow-sm">
            <blockquote class="text-lg italic text-gray-700 border-l-4 border-blue-500 pl-6 py-4">
                {{ quote.content }}
                <footer class="text-right mt-4 text-gray-600 not-italic">
                    — {{ quote.author }}
                    {% if quote.source %}
                        <cite class="text-sm text-gray-500 block mt-1">{{ quote.source }}</cite>
                    {% endif %}
                </footer>
            </blockquote>
            <div class="mt-4 flex items-center justify-between">
                <div class="text-sm text-gray-500">
                    {% if quote.category %}
                        <span class="px-2 py-1 bg-blue-100 text-blue-800 rounded-full">
                            {{ quote.category }}
                        </span>
                    {% endif %}
                    <span class="ml-3">
                        <i class="far fa-eye mr-1"></i>
                        {{ quote.views }} переглядів
                    </span>
                </div>
                <div class="text-sm text-gray-500">
                    {% if quote.displayDate %}
                        Дата показу: {{ quote.displayDate|date('d.m.Y') }}
                    {% else %}
                        Дата показу: не призначено
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <!-- Info Box -->
    <div class="mt-8 bg-blue-50 border border-blue-200 rounded-xl p-6">
        <div class="flex">
            <div class="flex-shrink-0">
                <i class="fas fa-info-circle text-blue-400 text-xl"></i>
            </div>
            <div class="ml-3">
                <h3 class="text-sm font-medium text-blue-800">Інформація</h3>
                <div class="mt-2 text-sm text-blue-700">
                    <ul class="list-disc pl-5 space-y-1">
                        <li>Поля позначені * є обов'язковими для заповнення</li>
                        <li>Дата показу вказується, якщо хочете призначити цитату на конкретну дату</li>
                        <li>Якщо дата показу не вказана, цитата може бути обрана випадковим чином</li>
                        <li>Неактивні цитати не відображаються на сайті</li>
                        <li>Після редагування цитата знову потрапить в загальний розподіл</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}