{% extends 'admin/base.html.twig' %}

{% block title %}Керування цитатами{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-3xl font-bold text-gray-800">
                <i class="fas fa-quote-left mr-2"></i>Цитати
            </h1>
            <p class="text-gray-600 mt-2">Керування цитатами дня</p>
        </div>
        <a href="{{ path('admin_quote_new') }}" 
           class="inline-flex items-center px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition">
            <i class="fas fa-plus mr-2"></i>Додати цитату
        </a>
    </div>

    <!-- Фільтри -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-6">
        <div class="flex flex-wrap gap-4">
            <a href="{{ path('admin_quote_index', {'status': 'all'}) }}" 
               class="px-4 py-2 rounded-lg {{ current_status == 'all' ? 'bg-blue-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200' }}">
                Всі
            </a>
            <a href="{{ path('admin_quote_index', {'status': 'active'}) }}" 
               class="px-4 py-2 rounded-lg {{ current_status == 'active' ? 'bg-green-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200' }}">
                Активні
            </a>
            <a href="{{ path('admin_quote_index', {'status': 'inactive'}) }}" 
               class="px-4 py-2 rounded-lg {{ current_status == 'inactive' ? 'bg-gray-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200' }}">
                Неактивні
            </a>
        </div>
    </div>

    <!-- Таблиця цитат -->
    <div class="bg-white rounded-xl shadow-md overflow-hidden">
        {% if quotes|length > 0 %}
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                Цитата
                            </th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                Автор
                            </th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                Категорія
                            </th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                Статус
                            </th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                Дата показу
                            </th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                                Дії
                            </th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        {% for quote in quotes %}
                        <tr class="hover:bg-gray-50 transition">
                            <td class="px-6 py-4">
                                <div class="text-sm text-gray-900 max-w-xs">
                                    {{ quote.getShortContent(60) }}
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">
                                {{ quote.author }}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                {% if quote.category %}
                                    <span class="px-2 py-1 text-xs bg-blue-100 text-blue-800 rounded-full">
                                        {{ quote.category }}
                                    </span>
                                {% else %}
                                    <span class="text-gray-400">—</span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                {% if quote.isActive %}
                                    <span class="px-2 py-1 text-xs font-medium bg-green-100 text-green-800 rounded-full">
                                        Активна
                                    </span>
                                {% else %}
                                    <span class="px-2 py-1 text-xs font-medium bg-gray-100 text-gray-800 rounded-full">
                                        Неактивна
                                    </span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                {% if quote.displayDate %}
                                    {{ quote.displayDate|date('d.m.Y') }}
                                {% else %}
                                    <span class="text-gray-400">—</span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                <div class="flex justify-end space-x-2">
                                    <a href="{{ path('admin_quote_show', {'id': quote.id}) }}" 
                                       class="inline-flex items-center px-3 py-1 bg-blue-100 text-blue-700 rounded hover:bg-blue-200 transition"
                                       title="Переглянути">
                                        <i class="fas fa-eye mr-1 text-xs"></i>
                                    </a>
                                    <a href="{{ path('admin_quote_edit', {'id': quote.id}) }}" 
                                       class="inline-flex items-center px-3 py-1 bg-yellow-100 text-yellow-700 rounded hover:bg-yellow-200 transition"
                                       title="Редагувати">
                                        <i class="fas fa-edit mr-1 text-xs"></i>
                                    </a>
                                    <form method="post" 
                                          action="{{ path('admin_quote_toggle_active', {'id': quote.id}) }}" 
                                          class="inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('toggle-active' ~ quote.id) }}">
                                        <button type="submit" 
                                                class="inline-flex items-center px-3 py-1 {{ quote.isActive ? 'bg-gray-100 text-gray-700 hover:bg-gray-200' : 'bg-green-100 text-green-700 hover:bg-green-200' }} rounded transition"
                                                title="{{ quote.isActive ? 'Деактивувати' : 'Активувати' }}">
                                            <i class="fas {{ quote.isActive ? 'fa-eye-slash' : 'fa-eye' }} mr-1 text-xs"></i>
                                        </button>
                                    </form>
                                    <form method="post" 
                                          action="{{ path('admin_quote_delete', {'id': quote.id}) }}" 
                                          onsubmit="return confirm('Ви впевнені, що хочете видалити цю цитату?');"
                                          class="inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ quote.id) }}">
                                        <button type="submit" 
                                                class="inline-flex items-center px-3 py-1 bg-red-100 text-red-700 rounded hover:bg-red-200 transition"
                                                title="Видалити">
                                            <i class="fas fa-trash mr-1 text-xs"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="text-center py-12">
                <div class="text-gray-300 mb-4">
                    <i class="fas fa-quote-left text-5xl"></i>
                </div>
                <h3 class="text-lg font-medium text-gray-700 mb-2">Цитат поки немає</h3>
                <p class="text-gray-500 mb-6">Додайте першу цитату, щоб почати роботу.</p>
                <a href="{{ path('admin_quote_new') }}" 
                   class="inline-flex items-center px-6 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 transition">
                    <i class="fas fa-plus mr-2"></i>Додати цитату
                </a>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}