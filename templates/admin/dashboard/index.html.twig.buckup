{% extends 'admin/base.html.twig' %}

{% block title %}Дашборд - Адмін панель{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50">
    <!-- Header -->
    <header class="bg-white shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center py-4">
                <div>
                    <h1 class="text-2xl font-bold text-gray-900">Панель управління</h1>
                    <p class="text-sm text-gray-500 mt-1">{{ "now"|date("d.m.Y H:i") }}</p>
                </div>
                <div class="flex items-center space-x-4">
                    <a href="{{ path('admin_article_new') }}" 
                       class="inline-flex items-center px-4 py-2 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                        </svg>
                        Нова стаття
                    </a>
                </div>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Статистика -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
            <!-- Статті -->
            <div class="bg-gradient-to-r from-blue-500 to-blue-600 rounded-xl shadow-lg p-6 text-white">
                <div class="flex justify-between items-center">
                    <div>
                        <p class="text-blue-100 text-sm font-medium">Статті</p>
                        <h3 class="text-3xl font-bold mt-2">{{ total_articles }}</h3>
                        <p class="text-blue-100 text-sm mt-1">Опубліковано: {{ publishedCount }}</p>
                    </div>
                    <div class="bg-blue-400/20 p-3 rounded-lg">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
                        </svg>
                    </div>
                </div>
            </div>

            <!-- Категорії -->
            <div class="bg-gradient-to-r from-green-500 to-green-600 rounded-xl shadow-lg p-6 text-white">
                <div class="flex justify-between items-center">
                    <div>
                        <p class="text-green-100 text-sm font-medium">Категорії</p>
                        <h3 class="text-3xl font-bold mt-2">{{ total_categories }}</h3>
                        <p class="text-green-100 text-sm mt-1">Активних</p>
                    </div>
                    <div class="bg-green-400/20 p-3 rounded-lg">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path>
                        </svg>
                    </div>
                </div>
            </div>

            <!-- Коментарі -->
            <div class="bg-gradient-to-r from-amber-500 to-amber-600 rounded-xl shadow-lg p-6 text-white">
                <div class="flex justify-between items-center">
                    <div>
                        <p class="text-amber-100 text-sm font-medium">Коментарі</p>
                        <h3 class="text-3xl font-bold mt-2">{{ total_comments }}</h3>
                        <p class="text-amber-100 text-sm mt-1">На модерації: {{ pending_comments }}</p>
                    </div>
                    <div class="bg-amber-400/20 p-3 rounded-lg">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path>
                        </svg>
                    </div>
                </div>
            </div>

            <!-- Користувачі -->
            <div class="bg-gradient-to-r from-cyan-500 to-cyan-600 rounded-xl shadow-lg p-6 text-white">
                <div class="flex justify-between items-center">
                    <div>
                        <p class="text-cyan-100 text-sm font-medium">Користувачі</p>
                        <h3 class="text-3xl font-bold mt-2">{{ total_users }}</h3>
                        <p class="text-cyan-100 text-sm mt-1">Активних</p>
                    </div>
                    <div class="bg-cyan-400/20 p-3 rounded-lg">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5 4.75V21m0 0h-7m7 0h7"></path>
                        </svg>
                    </div>
                </div>
            </div>
        </div>

        <!-- Основний контент -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Останні статті -->
            <div class="lg:col-span-2">
                <div class="bg-white rounded-xl shadow-sm border border-gray-200">
                    <div class="px-6 py-4 border-b border-gray-200">
                        <div class="flex justify-between items-center">
                            <div>
                                <h2 class="text-lg font-semibold text-gray-800">Останні статті</h2>
                                <p class="text-sm text-gray-500 mt-1">Нещодавно створені та оновлені статті</p>
                            </div>
                            <a href="{{ path('admin_article_index') }}" class="text-sm text-blue-600 hover:text-blue-900 font-medium">
                                Всі статті →
                            </a>
                        </div>
                    </div>
                    <div class="p-6">
                        <div class="overflow-x-auto">
                            <table class="min-w-full divide-y divide-gray-200">
                                <thead>
                                    <tr class="bg-gray-50">
                                        <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">#</th>
                                        <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Заголовок</th>
                                        <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Категорія</th>
                                        <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Дата</th>
                                        <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Статус</th>
                                        <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Дії</th>
                                    </tr>
                                </thead>
                                <tbody class="bg-white divide-y divide-gray-200">
                                    {% if recent_articles is not empty %}
                                        {% for article in recent_articles %}
                                            <tr class="hover:bg-gray-50 transition-colors">
                                                <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-900">{{ loop.index }}</td>
                                                <td class="px-4 py-4">
                                                    <div class="text-sm font-medium text-gray-900 truncate max-w-xs">{{ article.title }}</div>
                                                    <div class="text-xs text-gray-500 mt-1">{{ article.excerpt|default('')|slice(0, 50) }}...</div>
                                                </td>
                                                <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-900">
                                                    {% if article.category %}
                                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                                            {{ article.category.name }}
                                                        </span>
                                                    {% else %}
                                                        <span class="text-gray-400">—</span>
                                                    {% endif %}
                                                </td>
                                                <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-900">
                                                    {{ article.createdAt|date('d.m.Y') }}
                                                </td>
                                                <td class="px-4 py-4 whitespace-nowrap">
                                                    {% if article.isPublished %}
                                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                                            Опубліковано
                                                        </span>
                                                    {% else %}
                                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800">
                                                            Чернетка
                                                        </span>
                                                    {% endif %}
                                                </td>
                                                <td class="px-4 py-4 whitespace-nowrap text-sm font-medium space-x-2">
                                                    <a href="{{ path('admin_article_edit', {'id': article.id}) }}" 
                                                       class="text-blue-600 hover:text-blue-900" title="Редагувати">
                                                        <svg class="w-4 h-4 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                                        </svg>
                                                    </a>
                                                    <a href="{{ path('app_article_show', {'slug': article.slug}) }}" 
                                                       target="_blank"
                                                       class="text-green-600 hover:text-green-900" title="Перегляд">
                                                        <svg class="w-4 h-4 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                                        </svg>
                                                    </a>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    {% else %}
                                        <tr>
                                            <td colspan="6" class="px-4 py-12 text-center">
                                                <div class="text-gray-400 mb-4">
                                                    <svg class="w-16 h-16 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
                                                    </svg>
                                                </div>
                                                <h3 class="text-lg font-medium text-gray-700 mb-2">Немає статей</h3>
                                                <p class="text-gray-500 mb-4">Створіть першу статтю для початку роботи</p>
                                                <a href="{{ path('admin_article_new') }}" 
                                                   class="inline-flex items-center px-4 py-2 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition">
                                                    Створити першу статтю
                                                </a>
                                            </td>
                                        </tr>
                                    {% endif %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Бічна панель -->
            <div class="space-y-6">
                <!-- Останні коментарі -->
                <div class="bg-white rounded-xl shadow-sm border border-gray-200">
                    <div class="px-6 py-4 border-b border-gray-200">
                        <div class="flex justify-between items-center">
                            <div>
                                <h2 class="text-lg font-semibold text-gray-800">Останні коментарі</h2>
                                <p class="text-sm text-gray-500 mt-1">Нещодавно додані коментарі</p>
                            </div>
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800">
                                {{ pending_comments }} очікують
                            </span>
                        </div>
                    </div>
                    <div class="p-6">
                        {% if recent_comments is not empty %}
                            <div class="space-y-4">
                                {% for comment in recent_comments %}
                                    <div class="border-b border-gray-100 pb-4 last:border-0 last:pb-0">
                                        <div class="flex justify-between items-start mb-2">
                                            <div>
                                                <p class="text-sm font-medium text-gray-900">{{ comment.authorName|default('Анонім') }}</p>
                                                <p class="text-xs text-gray-500">{{ comment.createdAt|date('d.m.Y H:i') }}</p>
                                            </div>
                                            {% if comment.isApproved %}
                                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                                    Схвалено
                                                </span>
                                            {% else %}
                                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800">
                                                    На модерації
                                                </span>
                                            {% endif %}
                                        </div>
                                        <p class="text-sm text-gray-700 mb-2">{{ comment.content|slice(0, 80) }}...</p>
                                        {% if comment.article %}
                                            <p class="text-xs text-gray-500">До статті: 
                                                <a href="{{ path('app_article_show', {'slug': comment.article.slug}) }}" 
                                                   class="font-medium text-blue-600 hover:text-blue-900">
                                                    {{ comment.article.title|slice(0, 30) }}{{ comment.article.title|length > 30 ? '...' : '' }}
                                                </a>
                                            </p>
                                        {% endif %}
                                    </div>
                                {% endfor %}
                            </div>
                            <div class="mt-4 text-center">
                                <a href="{{ path('admin_comment_index') }}" class="text-sm text-blue-600 hover:text-blue-900 font-medium">
                                    Переглянути всі коментарі →
                                </a>
                            </div>
                        {% else %}
                            <div class="text-center py-8">
                                <div class="text-gray-400 mb-4">
                                    <svg class="w-12 h-12 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path>
                                    </svg>
                                </div>
                                <h3 class="text-sm font-medium text-gray-700 mb-1">Немає коментарів</h3>
                                <p class="text-xs text-gray-500">Коментарі з'являться тут</p>
                            </div>
                        {% endif %}
                    </div>
                </div>

                <!-- Швидкі дії -->
                <div class="bg-white rounded-xl shadow-sm border border-gray-200">
                    <div class="px-6 py-4 border-b border-gray-200">
                        <h2 class="text-lg font-semibold text-gray-800">Швидкі дії</h2>
                    </div>
                    <div class="p-6">
                        <div class="space-y-3">
                            <a href="{{ path('admin_article_new') }}" 
                               class="flex items-center justify-center w-full px-4 py-3 bg-blue-50 text-blue-700 font-medium rounded-lg hover:bg-blue-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition group">
                                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                                </svg>
                                Нова стаття
                            </a>
                            
                            {% if total_categories < 5 %}
                                <a href="{{ path('admin_category_new') }}" 
                                   class="flex items-center justify-center w-full px-4 py-3 bg-green-50 text-green-700 font-medium rounded-lg hover:bg-green-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition group">
                                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 13h6m-3-3v6m5 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                    </svg>
                                    Нова категорія
                                </a>
                            {% endif %}
                            
                            <a href="{{ path('app_home') }}" 
                               class="flex items-center justify-center w-full px-4 py-3 bg-gray-50 text-gray-700 font-medium rounded-lg hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition group">
                                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                                </svg>
                                Перейти на сайт
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Інформація про систему -->
                <div class="bg-white rounded-xl shadow-sm border border-gray-200">
                    <div class="px-6 py-4 border-b border-gray-200">
                        <h2 class="text-lg font-semibold text-gray-800">Інформація</h2>
                    </div>
                    <div class="p-6">
                        <ul class="space-y-4">
                            <li class="flex items-center">
                                <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-blue-100 flex items-center justify-center">
                                    <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                    </svg>
                                </div>
                                <div class="ml-3">
                                    <p class="text-sm font-medium text-gray-900">Користувач</p>
                                    <p class="text-sm text-gray-500">{{ app.user.email }}</p>
                                </div>
                            </li>
                            
                            <li class="flex items-center">
                                <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-green-100 flex items-center justify-center">
                                    <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                    </svg>
                                </div>
                                <div class="ml-3">
                                    <p class="text-sm font-medium text-gray-900">Дата</p>
                                    <p class="text-sm text-gray-500">{{ "now"|date("d.m.Y") }}</p>
                                </div>
                            </li>
                            
                            <li class="flex items-center">
                                <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-amber-100 flex items-center justify-center">
                                    <svg class="w-4 h-4 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                    </svg>
                                </div>
                                <div class="ml-3">
                                    <p class="text-sm font-medium text-gray-900">Статті сьогодні</p>
                                    <p class="text-sm text-gray-500">{{ today_articles }} додано</p>
                                </div>
                            </li>
                            
                            <li class="flex items-center">
                                <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-cyan-100 flex items-center justify-center">
                                    <svg class="w-4 h-4 text-cyan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                                    </svg>
                                </div>
                                <div class="ml-3">
                                    <p class="text-sm font-medium text-gray-900">Статистика</p>
                                    <p class="text-sm text-gray-500">{{ total_articles }} статей, {{ total_categories }} категорій</p>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>
{% endblock %}