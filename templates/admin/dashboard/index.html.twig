{% extends 'admin/base.html.twig' %}

{% block title %}Панель керування{% endblock %}

{% block body %}
<div class="min-h-screen bg-surface-50 dark:bg-surface-950">
    <div class="container mx-auto px-4 py-8">
        <!-- Header -->
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-surface-900 dark:text-surface-100">Панель керування</h1>
            <p class="text-surface-600 dark:text-surface-400 mt-2">Статистика та аналітика вашого сайту</p>
        </div>

        <!-- Statistics Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
            <!-- Total Articles -->
            <div class="bg-surface-0 dark:bg-surface-900 rounded-xl shadow-md dark:shadow-surface-800/20 p-6 border-l-4 border-primary-500 dark:border-primary-400">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-surface-500 dark:text-surface-400 uppercase tracking-wider">Всього статей</p>
                        <p class="text-3xl font-bold text-surface-900 dark:text-surface-100 mt-2">{{ total_articles }}</p>
                        <div class="mt-3 space-y-1">
                            <div class="flex items-center text-sm">
                                <div class="w-3 h-3 rounded-full bg-success-500 dark:bg-success-400 mr-2"></div>
                                <span class="text-surface-600 dark:text-surface-400">Опубліковано: {{ published_articles }}</span>
                            </div>
                            <div class="flex items-center text-sm">
                                <div class="w-3 h-3 rounded-full bg-warning-500 dark:bg-warning-400 mr-2"></div>
                                <span class="text-surface-600 dark:text-surface-400">На модерації: {{ pending_articles }}</span>
                            </div>
                        </div>
                    </div>
                    <div class="p-3 bg-primary-50 dark:bg-primary-900/30 rounded-lg">
                        <i class="fas fa-newspaper text-primary-600 dark:text-primary-400 text-2xl"></i>
                    </div>
                </div>
            </div>

            <!-- Categories -->
            <div class="bg-surface-0 dark:bg-surface-900 rounded-xl shadow-md dark:shadow-surface-800/20 p-6 border-l-4 border-success-500 dark:border-success-400">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-surface-500 dark:text-surface-400 uppercase tracking-wider">Категорії</p>
                        <p class="text-3xl font-bold text-surface-900 dark:text-surface-100 mt-2">{{ total_categories }}</p>
                        <p class="text-sm text-surface-500 dark:text-surface-400 mt-3">Організація контенту</p>
                    </div>
                    <div class="p-3 bg-success-50 dark:bg-success-900/30 rounded-lg">
                        <i class="fas fa-folder text-success-600 dark:text-success-400 text-2xl"></i>
                    </div>
                </div>
            </div>

            <!-- Comments -->
            <div class="bg-surface-0 dark:bg-surface-900 rounded-xl shadow-md dark:shadow-surface-800/20 p-6 border-l-4 border-info-500 dark:border-info-400">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-surface-500 dark:text-surface-400 uppercase tracking-wider">Коментарі</p>
                        <p class="text-3xl font-bold text-surface-900 dark:text-surface-100 mt-2">{{ total_comments }}</p>
                        <div class="mt-3 space-y-1">
                            <div class="flex items-center text-sm">
                                <div class="w-3 h-3 rounded-full bg-success-500 dark:bg-success-400 mr-2"></div>
                                <span class="text-surface-600 dark:text-surface-400">Схвалено: {{ approved_comments }}</span>
                            </div>
                            <div class="flex items-center text-sm">
                                <div class="w-3 h-3 rounded-full bg-warning-500 dark:bg-warning-400 mr-2"></div>
                                <span class="text-surface-600 dark:text-surface-400">Очікують: {{ pending_comments }}</span>
                            </div>
                        </div>
                    </div>
                    <div class="p-3 bg-info-50 dark:bg-info-900/30 rounded-lg">
                        <i class="fas fa-comments text-info-600 dark:text-info-400 text-2xl"></i>
                    </div>
                </div>
            </div>

            <!-- Users -->
            <div class="bg-surface-0 dark:bg-surface-900 rounded-xl shadow-md dark:shadow-surface-800/20 p-6 border-l-4 border-warning-500 dark:border-warning-400">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-surface-500 dark:text-surface-400 uppercase tracking-wider">Користувачі</p>
                        <p class="text-3xl font-bold text-surface-900 dark:text-surface-100 mt-2">{{ total_users }}</p>
                        <p class="text-sm text-surface-500 dark:text-surface-400 mt-3">Зареєстровані користувачі</p>
                    </div>
                    <div class="p-3 bg-warning-50 dark:bg-warning-900/30 rounded-lg">
                        <i class="fas fa-users text-warning-600 dark:text-warning-400 text-2xl"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Article Status & Priority -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
            <!-- Article Status -->
            <div class="bg-surface-0 dark:bg-surface-900 rounded-xl shadow-md dark:shadow-surface-800/20 p-6">
                <h2 class="text-xl font-bold text-surface-900 dark:text-surface-100 mb-6 flex items-center">
                    <i class="fas fa-chart-bar mr-3 text-primary-600 dark:text-primary-400"></i>
                    Статуси статей
                </h2>
                <div class="grid grid-cols-2 gap-4">
                    <!-- Drafts -->
                    <div class="bg-warning-50 dark:bg-warning-900/20 rounded-lg p-4">
                        <div class="flex items-center">
                            <div class="w-10 h-10 rounded-full bg-warning-100 dark:bg-warning-900/40 flex items-center justify-center mr-3">
                                <i class="fas fa-edit text-warning-700 dark:text-warning-400"></i>
                            </div>
                            <div>
                                <p class="text-sm text-surface-600 dark:text-surface-400">Чернетки</p>
                                <p class="text-2xl font-bold text-surface-900 dark:text-surface-100">{{ draft_articles }}</p>
                            </div>
                        </div>
                    </div>

                    <!-- Pending -->
                    <div class="bg-primary-50 dark:bg-primary-900/20 rounded-lg p-4">
                        <div class="flex items-center">
                            <div class="w-10 h-10 rounded-full bg-primary-100 dark:bg-primary-900/40 flex items-center justify-center mr-3">
                                <i class="fas fa-clock text-primary-700 dark:text-primary-400"></i>
                            </div>
                            <div>
                                <p class="text-sm text-surface-600 dark:text-surface-400">На модерації</p>
                                <p class="text-2xl font-bold text-surface-900 dark:text-surface-100">{{ pending_articles }}</p>
                            </div>
                        </div>
                    </div>

                    <!-- Published -->
                    <div class="bg-success-50 dark:bg-success-900/20 rounded-lg p-4">
                        <div class="flex items-center">
                            <div class="w-10 h-10 rounded-full bg-success-100 dark:bg-success-900/40 flex items-center justify-center mr-3">
                                <i class="fas fa-check text-success-700 dark:text-success-400"></i>
                            </div>
                            <div>
                                <p class="text-sm text-surface-600 dark:text-surface-400">Опубліковано</p>
                                <p class="text-2xl font-bold text-surface-900 dark:text-surface-100">{{ published_articles }}</p>
                            </div>
                        </div>
                    </div>

                    <!-- Archived -->
                    <div class="bg-surface-100 dark:bg-surface-800 rounded-lg p-4">
                        <div class="flex items-center">
                            <div class="w-10 h-10 rounded-full bg-surface-200 dark:bg-surface-700 flex items-center justify-center mr-3">
                                <i class="fas fa-archive text-surface-700 dark:text-surface-400"></i>
                            </div>
                            <div>
                                <p class="text-sm text-surface-600 dark:text-surface-400">Архів</p>
                                <p class="text-2xl font-bold text-surface-900 dark:text-surface-100">{{ archived_articles }}</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Article Priority -->
            <div class="bg-surface-0 dark:bg-surface-900 rounded-xl shadow-md dark:shadow-surface-800/20 p-6">
                <h2 class="text-xl font-bold text-surface-900 dark:text-surface-100 mb-6 flex items-center">
                    <i class="fas fa-flag mr-3 text-danger-600 dark:text-danger-400"></i>
                    Пріоритети статей
                </h2>
                <div class="space-y-4">
                    <!-- High Priority -->
                    <div class="flex items-center justify-between p-4 bg-danger-50 dark:bg-danger-900/20 rounded-lg">
                        <div class="flex items-center">
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-danger-100 dark:bg-danger-900/40 text-danger-800 dark:text-danger-400">
                                Високий
                            </span>
                        </div>
                        <span class="text-2xl font-bold text-surface-900 dark:text-surface-100">{{ high_priority_articles }}</span>
                    </div>

                    <!-- Medium Priority -->
                    <div class="flex items-center justify-between p-4 bg-warning-50 dark:bg-warning-900/20 rounded-lg">
                        <div class="flex items-center">
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-warning-100 dark:bg-warning-900/40 text-warning-800 dark:text-warning-400">
                                Середній
                            </span>
                        </div>
                        <span class="text-2xl font-bold text-surface-900 dark:text-surface-100">{{ medium_priority_articles }}</span>
                    </div>

                    <!-- Low Priority -->
                    <div class="flex items-center justify-between p-4 bg-success-50 dark:bg-success-900/20 rounded-lg">
                        <div class="flex items-center">
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-success-100 dark:bg-success-900/40 text-success-800 dark:text-success-400">
                                Низький
                            </span>
                        </div>
                        <span class="text-2xl font-bold text-surface-900 dark:text-surface-100">{{ low_priority_articles }}</span>
                    </div>

                    {% if no_priority_articles > 0 %}
                    <!-- No Priority -->
                    <div class="flex items-center justify-between p-4 bg-surface-100 dark:bg-surface-800 rounded-lg">
                        <div class="flex items-center">
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-surface-200 dark:bg-surface-700 text-surface-800 dark:text-surface-400">
                                Без пріоритету
                            </span>
                        </div>
                        <span class="text-2xl font-bold text-surface-900 dark:text-surface-100">{{ no_priority_articles }}</span>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Recent Articles -->
        <div class="bg-surface-0 dark:bg-surface-900 rounded-xl shadow-md dark:shadow-surface-800/20 p-6 mb-8">
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-xl font-bold text-surface-900 dark:text-surface-100 flex items-center">
                    <i class="fas fa-history mr-3 text-primary-600 dark:text-primary-400"></i>
                    Останні статті
                </h2>
                <a href="{{ path('admin_articles') }}" 
                   class="inline-flex items-center px-4 py-2 bg-primary-600 hover:bg-primary-700 dark:bg-primary-500 dark:hover:bg-primary-600 text-white font-medium rounded-lg transition duration-200">
                    Всі статті
                    <i class="fas fa-arrow-right ml-2"></i>
                </a>
            </div>

            <div class="overflow-x-auto rounded-lg border border-surface-200 dark:border-surface-700">
                <table class="min-w-full divide-y divide-surface-200 dark:divide-surface-700">
                    <thead class="bg-surface-50 dark:bg-surface-800">
                        <tr>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-surface-500 dark:text-surface-400 uppercase tracking-wider">ID</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-surface-500 dark:text-surface-400 uppercase tracking-wider">Заголовок</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-surface-500 dark:text-surface-400 uppercase tracking-wider">Статус</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-surface-500 dark:text-surface-400 uppercase tracking-wider">Категорія</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-surface-500 dark:text-surface-400 uppercase tracking-wider">Автор</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-surface-500 dark:text-surface-400 uppercase tracking-wider">Дата</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-surface-500 dark:text-surface-400 uppercase tracking-wider">Дії</th>
                        </tr>
                    </thead>
                    <tbody class="bg-surface-0 dark:bg-surface-900 divide-y divide-surface-200 dark:divide-surface-800">
                        {% for article in recent_articles %}
                        <tr class="hover:bg-surface-50 dark:hover:bg-surface-800 transition duration-150">
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-surface-900 dark:text-surface-100">{{ article.id }}</td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <a href="{{ path('admin_article_edit', {id: article.id}) }}" 
                                   class="text-primary-600 dark:text-primary-400 hover:text-primary-800 dark:hover:text-primary-300 font-medium">
                                    {{ article.title|slice(0, 50) }}{% if article.title|length > 50 %}...{% endif %}
                                </a>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium {{ article.getStatusColor(article.status) }}">
                                    {{ article_statuses|filter(v => v == article.status)|keys|first }}
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                {% if article.category %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-primary-100 dark:bg-primary-900/30 text-primary-800 dark:text-primary-400">
                                        {{ article.category.name }}
                                    </span>
                                {% else %}
                                    <span class="text-sm text-surface-500 dark:text-surface-400">Без категорії</span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-surface-600 dark:text-surface-400">
                                {{ article.author ? article.author.username : 'Без автора' }}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-surface-600 dark:text-surface-400">
                                {{ article.createdAt|date('d.m.Y H:i') }}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                <div class="flex items-center space-x-2">
                                    <a href="{{ path('app_article_show', {slug: article.slug}) }}" 
                                       target="_blank"
                                       class="inline-flex items-center p-2 text-primary-600 dark:text-primary-400 hover:text-primary-800 dark:hover:text-primary-300 hover:bg-primary-50 dark:hover:bg-primary-900/20 rounded-lg transition"
                                       title="Переглянути">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="{{ path('admin_article_edit', {id: article.id}) }}" 
                                       class="inline-flex items-center p-2 text-warning-600 dark:text-warning-400 hover:text-warning-800 dark:hover:text-warning-300 hover:bg-warning-50 dark:hover:bg-warning-900/20 rounded-lg transition"
                                       title="Редагувати">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="7" class="px-6 py-8 text-center">
                                <div class="text-surface-400 dark:text-surface-600">
                                    <i class="fas fa-newspaper text-4xl mb-3"></i>
                                    <p class="text-lg font-medium text-surface-500 dark:text-surface-400">Статті відсутні</p>
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Comments & Pending Articles -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Recent Comments -->
            <div class="bg-surface-0 dark:bg-surface-900 rounded-xl shadow-md dark:shadow-surface-800/20 p-6">
                <h2 class="text-xl font-bold text-surface-900 dark:text-surface-100 mb-6 flex items-center">
                    <i class="fas fa-comment-dots mr-3 text-info-600 dark:text-info-400"></i>
                    Останні коментарі
                </h2>
                
                {% if recent_comments|length > 0 %}
                <div class="space-y-4">
                    {% for comment in recent_comments %}
                    <div class="border border-surface-200 dark:border-surface-800 rounded-lg p-4 hover:border-info-300 dark:hover:border-info-700 transition duration-150">
                        <div class="flex items-start justify-between mb-3">
                            <div class="flex items-center">
                                <div class="w-8 h-8 rounded-full bg-info-100 dark:bg-info-900/30 flex items-center justify-center mr-3">
                                    <i class="fas fa-user text-info-700 dark:text-info-400 text-sm"></i>
                                </div>
                                <div>
                                    <h4 class="font-medium text-surface-900 dark:text-surface-100">{{ comment.authorName ?? comment.user.username ?? 'Анонім' }}</h4>
                                    <p class="text-xs text-surface-500 dark:text-surface-400">{{ comment.createdAt|date('d.m.Y H:i') }}</p>
                                </div>
                            </div>
                            <a href="{{ path('admin_comment_index') }}" 
                               class="inline-flex items-center p-2 text-info-600 dark:text-info-400 hover:text-info-800 dark:hover:text-info-300 hover:bg-info-50 dark:hover:bg-info-900/20 rounded-lg transition"
                               title="Управління коментарями">
                                <i class="fas fa-cog"></i>
                            </a>
                        </div>
                        
                        <p class="text-sm text-surface-600 dark:text-surface-400 mb-2">
                            <i class="fas fa-newspaper text-xs mr-1"></i>
                            До статті: 
                            <a href="{{ path('app_article_show', {slug: comment.article.slug}) }}" 
                               target="_blank"
                               class="text-primary-600 dark:text-primary-400 hover:text-primary-800 dark:hover:text-primary-300">
                                {{ comment.article.title|slice(0, 30) }}...
                            </a>
                        </p>
                        
                        <p class="text-surface-700 dark:text-surface-300 text-sm mb-3 line-clamp-2">{{ comment.content|slice(0, 100) }}{% if comment.content|length > 100 %}...{% endif %}</p>
                        
                        <div class="flex items-center justify-between">
                            <div class="flex items-center space-x-2">
                                <span class="{{ comment.isApproved ? 'bg-success-100 dark:bg-success-900/30 text-success-800 dark:text-success-400' : 'bg-warning-100 dark:bg-warning-900/30 text-warning-800 dark:text-warning-400' }} inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium">
                                    {{ comment.isApproved ? 'Схвалено' : 'На модерації' }}
                                </span>
                                {% if comment.isSpam %}
                                <span class="bg-danger-100 dark:bg-danger-900/30 text-danger-800 dark:text-danger-400 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium">
                                    Спам
                                </span>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
                {% else %}
                <div class="text-center py-8">
                    <div class="text-surface-300 dark:text-surface-700 mb-3">
                        <i class="fas fa-comments text-4xl"></i>
                    </div>
                    <p class="text-surface-600 dark:text-surface-400">Коментарі відсутні</p>
                </div>
                {% endif %}
            </div>

            <!-- Pending Articles for Review -->
            <div class="bg-surface-0 dark:bg-surface-900 rounded-xl shadow-md dark:shadow-surface-800/20 p-6">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-xl font-bold text-surface-900 dark:text-surface-100 flex items-center">
                        <i class="fas fa-clipboard-check mr-3 text-warning-600 dark:text-warning-400"></i>
                        Статті на модерації
                    </h2>
                    {% if pending_review_articles|length > 0 %}
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-warning-100 dark:bg-warning-900/30 text-warning-800 dark:text-warning-400">
                        {{ pending_review_articles|length }}
                    </span>
                    {% endif %}
                </div>
                
                {% if pending_review_articles|length > 0 %}
                <div class="space-y-4">
                    {% for article in pending_review_articles %}
                    <div class="border border-warning-200 dark:border-warning-800 rounded-lg p-4 bg-warning-50 dark:bg-warning-900/20 hover:border-warning-300 dark:hover:border-warning-700 transition duration-150">
                        <div class="flex items-start justify-between">
                            <div class="flex-1">
                                <h4 class="font-medium text-surface-900 dark:text-surface-100 mb-1">
                                    <a href="{{ path('admin_article_edit', {id: article.id}) }}" 
                                       class="hover:text-primary-600 dark:hover:text-primary-400 transition">
                                        {{ article.title|slice(0, 50) }}{% if article.title|length > 50 %}...{% endif %}
                                    </a>
                                </h4>
                                <div class="text-xs text-surface-600 dark:text-surface-400 space-y-1">
                                    <div class="flex items-center">
                                        <i class="fas fa-user mr-1"></i>
                                        Автор: {{ article.author ? article.author.username : 'Без автора' }}
                                    </div>
                                    <div class="flex items-center">
                                        <i class="fas fa-calendar mr-1"></i>
                                        Створено: {{ article.createdAt|date('d.m.Y H:i') }}
                                    </div>
                                </div>
                            </div>
                            <a href="{{ path('admin_article_edit', {id: article.id}) }}" 
                               class="ml-4 inline-flex items-center px-3 py-2 bg-warning-100 dark:bg-warning-900/40 text-warning-800 dark:text-warning-400 font-medium rounded-lg hover:bg-warning-200 dark:hover:bg-warning-900/60 transition duration-200">
                                <i class="fas fa-check mr-2"></i>
                                Перевірити
                            </a>
                        </div>
                    </div>
                    {% endfor %}
                </div>
                {% else %}
                <div class="text-center py-8">
                    <div class="text-success-300 dark:text-success-700 mb-3">
                        <i class="fas fa-check-circle text-4xl"></i>
                    </div>
                    <p class="text-surface-600 dark:text-surface-400">Немає статей, що потребують модерації</p>
                    <p class="text-sm text-surface-500 dark:text-surface-500 mt-1">Всі статті оброблені</p>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}