{% extends 'admin/base.html.twig' %}

{% block title %}Редагування: {{ video.title }}{% endblock %}

{% block body %}
<div class="content-container py-6 max-w-3xl mx-auto">
    <!-- Заголовок -->
    <div class="flex items-center gap-4 mb-6">
        <a href="{{ path('admin_video_index') }}" 
           class="w-10 h-10 rounded-lg glass-light flex items-center justify-center hover:scale-110 transition-transform">
            <i class="fas fa-arrow-left text-red-500"></i>
        </a>
        <div>
            <h1 class="text-2xl font-bold gradient-text">Редагування відео</h1>
            <p class="text-surface-600 dark:text-surface-400">{{ video.title }}</p>
        </div>
    </div>

    <!-- Попередній перегляд -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
        <div class="md:col-span-1">
            <div class="glass-light rounded-xl p-4 border border-surface-200/50 dark:border-surface-700/50">
                <h3 class="font-semibold mb-3 flex items-center gap-2">
                    <i class="fas fa-eye text-red-500"></i>
                    <span>Попередній перегляд</span>
                </h3>
                
                <div class="aspect-video rounded-lg overflow-hidden bg-black mb-3">
                    {% if video.embedUrl %}
                        <iframe class="w-full h-full" src="{{ video.embedUrl }}" frameborder="0" allowfullscreen></iframe>
                    {% elseif video.thumbnail %}
                        <img src="{{ video.thumbnail }}" alt="" class="w-full h-full object-cover">
                    {% else %}
                        <div class="w-full h-full bg-gradient-to-br from-gray-800 to-gray-900 flex items-center justify-center">
                            <svg class="w-12 h-12 text-white/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                        </div>
                    {% endif %}
                </div>
                
                <div class="space-y-2 text-sm">
                    <div class="flex justify-between">
                        <span class="text-surface-500">Джерело:</span>
                        <span class="font-medium {{ video.providerColor }}">{{ video.source|capitalize }}</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-surface-500">Перегляди:</span>
                        <span class="font-medium">{{ video.views }}</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-surface-500">Лайки:</span>
                        <span class="font-medium">{{ video.likes }}</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-surface-500">Тривалість:</span>
                        <span class="font-medium">{{ video.formattedDuration }}</span>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="md:col-span-2">
            <div class="glass-light rounded-xl p-6 border border-surface-200/50 dark:border-surface-700/50">
                {% include 'admin/video/_form.html.twig' with {form: form, video: video} %}
            </div>
        </div>
    </div>
</div>
{% endblock %}