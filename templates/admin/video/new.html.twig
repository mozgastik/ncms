{% extends 'admin/base.html.twig' %}

{% block title %}Додати нове відео{% endblock %}

{% block body %}
<div class="content-container py-6 max-w-3xl mx-auto">
    <!-- Заголовок -->
    <div class="flex items-center gap-4 mb-6">
        <a href="{{ path('admin_video_index') }}" 
           class="w-10 h-10 rounded-lg glass-light flex items-center justify-center hover:scale-110 transition-transform">
            <i class="fas fa-arrow-left text-red-500"></i>
        </a>
        <div>
            <h1 class="text-2xl font-bold gradient-text">Додати нове відео</h1>
            <p class="text-surface-600 dark:text-surface-400">Вставте посилання з YouTube, Vimeo або завантажте файл</p>
        </div>
    </div>

    <!-- Форма -->
    <div class="glass-light rounded-xl p-6 border border-surface-200/50 dark:border-surface-700/50">
        {% include 'admin/video/_form.html.twig' with {form: form, video: null} %}
    </div>
</div>
{% endblock %}