{{ form_start(form, {'attr': {'class': 'space-y-6', 'novalidate': 'novalidate'}}) }}
    
    {% if not form.vars.valid %}
        <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-4 mb-6">
            <div class="flex items-center gap-3 text-red-600 dark:text-red-400 mb-2">
                <i class="fas fa-exclamation-circle"></i>
                <span class="font-semibold">Помилки у формі</span>
            </div>
            {{ form_errors(form) }}
        </div>
    {% endif %}

    <!-- Основна інформація -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
            {{ form_label(form.title, null, {'label_attr': {'class': 'block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1'}}) }}
            {{ form_widget(form.title, {'attr': {'class': 'w-full px-4 py-2 rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:ring-2 focus:ring-red-500/50 focus:border-transparent transition-all'}}) }}
            {{ form_errors(form.title, {'attr': {'class': 'text-sm text-red-500 mt-1'}}) }}
        </div>
        
        <div>
            {{ form_label(form.source, null, {'label_attr': {'class': 'block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1'}}) }}
            {{ form_widget(form.source, {'attr': {'class': 'w-full px-4 py-2 rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:ring-2 focus:ring-red-500/50 focus:border-transparent transition-all'}}) }}
            {{ form_errors(form.source) }}
        </div>
    </div>

    <!-- URL -->
    <div>
        {{ form_label(form.url, null, {'label_attr': {'class': 'block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1'}}) }}
        <div class="relative">
            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-surface-400">
                <i class="fas fa-link"></i>
            </span>
            {{ form_widget(form.url, {'attr': {
                'class': 'w-full pl-12 pr-4 py-2 rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:ring-2 focus:ring-red-500/50 focus:border-transparent transition-all',
                'placeholder': 'https://youtube.com/watch?v=...'
            }}) }}
        </div>
        {{ form_errors(form.url) }}
        <p class="text-xs text-surface-500 mt-1">Підтримуються YouTube, Vimeo, Rutube</p>
    </div>

    <!-- Опис -->
    <div>
        {{ form_label(form.description, null, {'label_attr': {'class': 'block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1'}}) }}
        {{ form_widget(form.description, {'attr': {
            'class': 'w-full px-4 py-2 rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:ring-2 focus:ring-red-500/50 focus:border-transparent transition-all',
            'rows': 5,
            'placeholder': 'Опис відео...'
        }}) }}
        {{ form_errors(form.description) }}
    </div>

    <!-- Категорія та теги -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
            {{ form_label(form.category, null, {'label_attr': {'class': 'block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1'}}) }}
            {{ form_widget(form.category, {'attr': {'class': 'w-full px-4 py-2 rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:ring-2 focus:ring-red-500/50 focus:border-transparent transition-all'}}) }}
            {{ form_errors(form.category) }}
        </div>
        
        <div>
            {{ form_label(form.tags, null, {'label_attr': {'class': 'block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1'}}) }}
            {{ form_widget(form.tags, {'attr': {
                'class': 'w-full px-4 py-2 rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:ring-2 focus:ring-red-500/50 focus:border-transparent transition-all',
                'placeholder': 'теги, через, кому'
            }}) }}
            {{ form_errors(form.tags) }}
        </div>
    </div>

    <!-- Налаштування публікації -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
            {{ form_label(form.publishedAt, null, {'label_attr': {'class': 'block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1'}}) }}
            {{ form_widget(form.publishedAt, {'attr': {'class': 'w-full px-4 py-2 rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:ring-2 focus:ring-red-500/50 focus:border-transparent transition-all'}}) }}
            {{ form_errors(form.publishedAt) }}
        </div>
        
        <div>
            {{ form_label(form.language, null, {'label_attr': {'class': 'block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1'}}) }}
            {{ form_widget(form.language, {'attr': {'class': 'w-full px-4 py-2 rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:ring-2 focus:ring-red-500/50 focus:border-transparent transition-all'}}) }}
            {{ form_errors(form.language) }}
        </div>
    </div>

    <!-- Чекбокси -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="flex items-center gap-2">
            {{ form_widget(form.isPublished) }}
            {{ form_label(form.isPublished, 'Опубліковано') }}
        </div>
        
        <div class="flex items-center gap-2">
            {{ form_widget(form.isFeatured) }}
            {{ form_label(form.isFeatured, 'Рекомендоване') }}
        </div>
        
        <div class="flex items-center gap-2">
            {{ form_widget(form.allowComments) }}
            {{ form_label(form.allowComments, 'Дозволити коментарі') }}
        </div>
    </div>

    <!-- Кнопки -->
    <div class="flex justify-end gap-3 pt-6 border-t border-surface-200 dark:border-surface-700">
        <a href="{{ path('admin_video_index') }}" 
           class="px-6 py-2 rounded-lg glass-light hover:bg-surface-100 dark:hover:bg-surface-800 transition-colors">
            Скасувати
        </a>
        
        <button type="submit" 
                class="px-8 py-2 bg-gradient-to-r from-red-500 to-purple-600 text-white rounded-lg hover:scale-105 hover:shadow-xl transition-all duration-300 flex items-center gap-2">
            <i class="fas fa-save"></i>
            <span>{{ video and video.id ? 'Оновити' : 'Зберегти' }}</span>
        </button>
    </div>

{{ form_end(form) }}