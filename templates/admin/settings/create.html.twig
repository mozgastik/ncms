{# templates/admin/settings/create.html.twig #}
{% extends 'admin/base.html.twig' %}

{% block title %}Створення налаштування{% endblock %}

{% block body %}
<div class="content-container py-6 max-w-2xl mx-auto">
    {# Заголовок #}
    <div class="flex items-center gap-4 mb-6">
        <a href="{{ path('admin_settings_index') }}" 
           class="w-10 h-10 rounded-lg glass-light flex items-center justify-center hover:scale-110 transition-transform">
            <i class="fas fa-arrow-left text-primary-500"></i>
        </a>
        <div>
            <h1 class="text-2xl font-bold gradient-text">Створення нового налаштування</h1>
            <p class="text-surface-600 dark:text-surface-400">Додайте нове налаштування для сайту</p>
        </div>
    </div>

    {# Форма #}
    <div class="glass-light rounded-xl p-6 border border-surface-200/50 dark:border-surface-700/50">
        {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
            
            {# Виведення помилок форми #}
            {{ form_errors(form) }}
            
            {# Поле settingKey #}
            <div class="space-y-2">
                {{ form_label(form.settingKey, 'Ключ налаштування', {'label_attr': {'class': 'block text-sm font-medium text-surface-700 dark:text-surface-300'}}) }}
                {{ form_widget(form.settingKey, {
                    'attr': {
                        'class': 'w-full px-4 py-2 rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:ring-2 focus:ring-primary-500/50 focus:border-transparent transition-all',
                        'placeholder': 'site_name, items_per_page, facebook_url...'
                    }
                }) }}
                {{ form_help(form.settingKey, {'help_attr': {'class': 'text-xs text-surface-500'}}) }}
                {{ form_errors(form.settingKey, {'attr': {'class': 'text-sm text-danger-500'}}) }}
                <p class="text-xs text-surface-400">Тільки маленькі літери, цифри та підкреслення</p>
            </div>
            
            {# Поле label #}
            <div class="space-y-2">
                {{ form_label(form.label, 'Назва', {'label_attr': {'class': 'block text-sm font-medium text-surface-700 dark:text-surface-300'}}) }}
                {{ form_widget(form.label, {
                    'attr': {
                        'class': 'w-full px-4 py-2 rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:ring-2 focus:ring-primary-500/50 focus:border-transparent transition-all',
                        'placeholder': 'Назва сайту, Елементів на сторінці...'
                    }
                }) }}
                {{ form_errors(form.label) }}
            </div>
            
            {# Поле type #}
            <div class="space-y-2">
                {{ form_label(form.type, 'Тип', {'label_attr': {'class': 'block text-sm font-medium text-surface-700 dark:text-surface-300'}}) }}
                {{ form_widget(form.type, {
                    'attr': {
                        'class': 'w-full px-4 py-2 rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:ring-2 focus:ring-primary-500/50 focus:border-transparent transition-all'
                    }
                }) }}
                {{ form_errors(form.type) }}
            </div>
            
            {# Поле settingGroup #}
            <div class="space-y-2">
                {{ form_label(form.settingGroup, 'Група', {'label_attr': {'class': 'block text-sm font-medium text-surface-700 dark:text-surface-300'}}) }}
                {{ form_widget(form.settingGroup, {
                    'attr': {
                        'class': 'w-full px-4 py-2 rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:ring-2 focus:ring-primary-500/50 focus:border-transparent transition-all',
                        'placeholder': 'general, appearance, social, seo...'
                    }
                }) }}
                {{ form_errors(form.settingGroup) }}
                <p class="text-xs text-surface-400">Група для групування налаштувань</p>
            </div>
            
            {# Поле description #}
            <div class="space-y-2">
                {{ form_label(form.description, 'Опис', {'label_attr': {'class': 'block text-sm font-medium text-surface-700 dark:text-surface-300'}}) }}
                {{ form_widget(form.description, {
                    'attr': {
                        'class': 'w-full px-4 py-2 rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:ring-2 focus:ring-primary-500/50 focus:border-transparent transition-all',
                        'placeholder': 'Короткий опис що це налаштування робить...',
                        'rows': 3
                    }
                }) }}
                {{ form_errors(form.description) }}
            </div>
            
            {# Поле value (початкове значення) #}
            <div class="space-y-2">
                {{ form_label(form.value, 'Початкове значення', {'label_attr': {'class': 'block text-sm font-medium text-surface-700 dark:text-surface-300'}}) }}
                {{ form_widget(form.value, {
                    'attr': {
                        'class': 'w-full px-4 py-2 rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:ring-2 focus:ring-primary-500/50 focus:border-transparent transition-all',
                        'placeholder': 'Значення за замовчуванням'
                    }
                }) }}
                {{ form_errors(form.value) }}
            </div>
            
            {# Додаткові опції #}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="flex items-center gap-2">
                    {{ form_widget(form.isRequired) }}
                    {{ form_label(form.isRequired, 'Обов\'язкове') }}
                </div>
                
                <div class="flex items-center gap-2">
                    {{ form_widget(form.isPublic) }}
                    {{ form_label(form.isPublic, 'Публічне (доступне через API)') }}
                </div>
                
                <div class="flex items-center gap-2">
                    {{ form_widget(form.isVisible) }}
                    {{ form_label(form.isVisible, 'Видиме') }}
                </div>
                
                <div class="flex items-center gap-2">
                    {{ form_widget(form.isReadonly) }}
                    {{ form_label(form.isReadonly, 'Тільки читання') }}
                </div>
            </div>
            
            {# Поле sortOrder #}
            <div class="space-y-2">
                {{ form_label(form.sortOrder, 'Порядок сортування', {'label_attr': {'class': 'block text-sm font-medium text-surface-700 dark:text-surface-300'}}) }}
                {{ form_widget(form.sortOrder, {
                    'attr': {
                        'class': 'w-full px-4 py-2 rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:ring-2 focus:ring-primary-500/50 focus:border-transparent transition-all'
                    }
                }) }}
                {{ form_errors(form.sortOrder) }}
            </div>
            
            {# Кнопки #}
            <div class="flex justify-end gap-3 pt-4 border-t border-surface-200 dark:border-surface-700">
                <a href="{{ path('admin_settings_index') }}" 
                   class="px-6 py-2 rounded-lg glass-light hover:bg-surface-100 dark:hover:bg-surface-800 transition-colors">
                    Скасувати
                </a>
                <button type="submit" 
                        class="px-6 py-2 bg-gradient-to-r from-primary-500 to-purple-600 text-white rounded-lg hover:scale-105 hover:shadow-xl transition-all duration-300 flex items-center gap-2">
                    <i class="fas fa-save"></i>
                    <span>Створити налаштування</span>
                </button>
            </div>
            
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}