{% if setting.readonly %}
    <div class="w-full px-4 py-2 bg-surface-100 dark:bg-surface-800/50 rounded-lg text-surface-600 dark:text-surface-400 border border-surface-200 dark:border-surface-700">
        {% if setting.value is null or setting.value is empty %}
            <span class="italic">Не встановлено</span>
        {% else %}
            {{ setting.value }}
        {% endif %}
    </div>
{% else %}
    {% if setting.type == 'boolean' %}
        <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" 
                   name="settings[{{ setting.settingKey }}]" 
                   class="sr-only peer"
                   value="1"
                   {{ setting.getBooleanValue() }}
            <div class="w-11 h-6 bg-surface-300 dark:bg-surface-600 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-surface-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary-500"></div>
            <span class="ml-3 text-sm text-surface-600 dark:text-surface-400">
                {{ setting.booleanValue ? 'Так' : 'Ні' }}
            </span>
        </label>

    {% elseif setting.type == 'color' %}
        <div class="flex items-center gap-3">
            <input type="color" 
                   name="settings[{{ setting.settingKey }}]" 
                   value="{{ setting.value }}" 
                   class="w-12 h-10 rounded border border-surface-200 dark:border-surface-700 cursor-pointer">
            <span class="text-sm text-surface-500">{{ setting.value }}</span>
        </div>

    {% elseif setting.type == 'textarea' or setting.type == 'editor' or setting.type == 'code' %}
        <textarea name="settings[{{ setting.settingKey }}]" 
                  rows="5"
                  placeholder="{{ setting.placeholder }}"
                  maxlength="{{ setting.maxLength }}"
                  class="w-full px-4 py-2 rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:ring-2 focus:ring-primary-500/50 focus:border-transparent transition-all font-mono">{{ setting.value }}</textarea>
        
        {% if setting.maxLength %}
            <div class="text-right text-xs text-surface-400 mt-1">
                <span class="char-counter">{{ setting.value|length }}</span>/{{ setting.maxLength }}
            </div>
        {% endif %}

    {% elseif setting.type == 'integer' or setting.type == 'float' %}
        <input type="number" 
               name="settings[{{ setting.settingKey }}]" 
               value="{{ setting.value }}" 
               min="{{ setting.minValue }}"
               max="{{ setting.maxValue }}"
               step="{{ setting.type == 'float' ? '0.01' : '1' }}"
               placeholder="{{ setting.placeholder }}"
               class="w-full px-4 py-2 rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:ring-2 focus:ring-primary-500/50 focus:border-transparent transition-all">
        
        {% if setting.minValue is not null or setting.maxValue is not null %}
            <p class="text-xs text-surface-400 mt-1">
                {% if setting.minValue is not null %}мін: {{ setting.minValue }}{% endif %}
                {% if setting.maxValue is not null %}{% if setting.minValue is not null %}, {% endif %}макс: {{ setting.maxValue }}{% endif %}
            </p>
        {% endif %}

    {% elseif setting.type == 'email' %}
        <input type="email" 
               name="settings[{{ setting.settingKey }}]" 
               value="{{ setting.value }}" 
               placeholder="{{ setting.placeholder }}"
               class="w-full px-4 py-2 rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:ring-2 focus:ring-primary-500/50 focus:border-transparent transition-all">

    {% elseif setting.type == 'url' %}
        <input type="url" 
               name="settings[{{ setting.settingKey }}]" 
               value="{{ setting.value }}" 
               placeholder="{{ setting.placeholder }}"
               class="w-full px-4 py-2 rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:ring-2 focus:ring-primary-500/50 focus:border-transparent transition-all">

    {% elseif setting.type == 'choice' %}
        <select name="settings[{{ setting.settingKey }}]" 
                class="w-full px-4 py-2 rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:ring-2 focus:ring-primary-500/50 focus:border-transparent transition-all">
            <option value="">-- {{ setting.placeholder|default('Оберіть варіант') }} --</option>
            {% for option in setting.options %}
                <option value="{{ option }}" {{ setting.value == option ? 'selected' : '' }}>
                    {{ option }}
                </option>
            {% endfor %}
        </select>

    {% elseif setting.type == 'date' %}
        <input type="date" 
               name="settings[{{ setting.settingKey }}]" 
               value="{{ setting.value }}" 
               class="w-full px-4 py-2 rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:ring-2 focus:ring-primary-500/50 focus:border-transparent transition-all">

    {% elseif setting.type == 'datetime' %}
        <input type="datetime-local" 
               name="settings[{{ setting.settingKey }}]" 
               value="{{ setting.value }}" 
               class="w-full px-4 py-2 rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:ring-2 focus:ring-primary-500/50 focus:border-transparent transition-all">

    {% elseif setting.type == 'json' %}
        <textarea name="settings[{{ setting.settingKey }}]" 
                  rows="8"
                  placeholder="{{ setting.placeholder|default('{}') }}"
                  class="w-full px-4 py-2 rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:ring-2 focus:ring-primary-500/50 focus:border-transparent transition-all font-mono text-sm">{{ setting.value }}</textarea>

    {% elseif setting.type == 'array' %}
        <textarea name="settings[{{ setting.settingKey }}]" 
                  rows="4"
                  placeholder="{{ setting.placeholder|default('елемент1,елемент2,елемент3') }}"
                  class="w-full px-4 py-2 rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:ring-2 focus:ring-primary-500/50 focus:border-transparent transition-all font-mono text-sm">{{ setting.value }}</textarea>

    {% else %}
        <input type="text" 
               name="settings[{{ setting.settingKey }}]" 
               value="{{ setting.value }}" 
               placeholder="{{ setting.placeholder }}"
               maxlength="{{ setting.maxLength }}"
               class="w-full px-4 py-2 rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:ring-2 focus:ring-primary-500/50 focus:border-transparent transition-all">
        
        {% if setting.maxLength %}
            <div class="text-right text-xs text-surface-400 mt-1">
                <span class="char-counter">{{ setting.value|length }}</span>/{{ setting.maxLength }}
            </div>
        {% endif %}
    {% endif %}
{% endif %}

<script>
    // Лічильник символів
    document.querySelectorAll('[maxlength]').forEach(input => {
        const counter = input.closest('div')?.querySelector('.char-counter');
        if (counter) {
            input.addEventListener('input', () => {
                counter.textContent = input.value.length;
            });
        }
    });
</script>