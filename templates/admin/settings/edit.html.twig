{% extends 'base.html.twig' %}

{% block title %}Редагування: {{ setting.label }}{% endblock %}

{% block body %}
<div class="content-container py-6 max-w-2xl">
    <div class="flex items-center gap-4 mb-6">
        <a href="{{ path('admin_settings_index') }}" 
           class="w-10 h-10 rounded-lg glass-light flex items-center justify-center hover:scale-110 transition-transform">
            <i class="fas fa-arrow-left text-primary-500"></i>
        </a>
        <div>
            <h1 class="text-2xl font-bold gradient-text">Редагування налаштування</h1>
            <p class="text-surface-600 dark:text-surface-400">{{ setting.label }}</p>
        </div>
    </div>

    <div class="glass-light rounded-xl p-6 border border-surface-200/50 dark:border-surface-700/50">
        {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
            
            {% if setting.isSystem %}
                <div class="bg-warning-500/10 border border-warning-500/30 rounded-lg p-4 mb-6">
                    <div class="flex items-start gap-3">
                        <i class="fas fa-exclamation-triangle text-warning-500 mt-1"></i>
                        <div>
                            <p class="font-medium text-warning-700 dark:text-warning-400">Системне налаштування</p>
                            <p class="text-sm text-surface-600 dark:text-surface-400">
                                Це системне налаштування. Будьте обережні при його зміні.
                            </p>
                        </div>
                    </div>
                </div>
            {% endif %}

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1">
                        Ключ
                    </label>
                    <div class="px-4 py-2 bg-surface-100 dark:bg-surface-800 rounded-lg font-mono text-sm">
                        {{ setting.settingKey }}
                    </div>
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1">
                        Тип
                    </label>
                    <div class="px-4 py-2 bg-surface-100 dark:bg-surface-800 rounded-lg text-sm">
                        {{ setting.typeLabel }}
                    </div>
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1">
                        Група
                    </label>
                    <div class="px-4 py-2 bg-surface-100 dark:bg-surface-800 rounded-lg text-sm">
                        {{ setting.group|capitalize }}
                    </div>
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1">
                        Позиція
                    </label>
                    <div class="px-4 py-2 bg-surface-100 dark:bg-surface-800 rounded-lg text-sm">
                        {{ setting.sortOrder }}
                    </div>
                </div>
            </div>

            <hr class="border-surface-200 dark:border-surface-700">

            {{ form_widget(form.value, {
                'attr': {
                    'class': 'w-full px-4 py-2 rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:ring-2 focus:ring-primary-500/50 focus:border-transparent transition-all'
                }
            }) }}

            <div class="grid grid-cols-2 gap-4 pt-4">
                <div class="space-y-2">
                    <div class="flex items-center gap-2">
                        <span class="text-sm text-surface-500">Створено:</span>
                        <span class="text-sm">{{ setting.createdAt|date('d.m.Y H:i') }}</span>
                    </div>
                    {% if setting.updatedAt %}
                        <div class="flex items-center gap-2">
                            <span class="text-sm text-surface-500">Оновлено:</span>
                            <span class="text-sm">{{ setting.updatedAt|date('d.m.Y H:i') }}</span>
                        </div>
                    {% endif %}
                    {% if setting.updatedBy %}
                        <div class="flex items-center gap-2">
                            <span class="text-sm text-surface-500">Ким:</span>
                            <span class="text-sm">{{ setting.updatedBy }}</span>
                        </div>
                    {% endif %}
                </div>
                
                <div class="flex justify-end gap-3">
                    <a href="{{ path('admin_settings_index') }}" 
                       class="px-6 py-2 rounded-lg glass-light hover:bg-surface-100 dark:hover:bg-surface-800 transition-colors">
                        Скасувати
                    </a>
                    <button type="submit" 
                            class="px-6 py-2 bg-gradient-to-r from-primary-500 to-purple-600 text-white rounded-lg hover:scale-105 transition-all duration-300">
                        <i class="fas fa-save mr-2"></i>Зберегти
                    </button>
                </div>
            </div>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}