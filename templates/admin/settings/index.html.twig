{% extends 'admin/base.html.twig' %}

{% block title %}Налаштування сайту{% endblock %}

{% block body %}
<div class="content-container py-6">
    {# Заголовок та дії #}
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
        <div>
            <h1 class="text-2xl font-bold gradient-text">Налаштування сайту</h1>
            <p class="text-surface-600 dark:text-surface-400 mt-1">
                Керуйте всіма параметрами вашого сайту
            </p>
        </div>
        
        <div class="flex gap-3">
            <a href="{{ path('admin_settings_create') }}" 
               class="px-4 py-2 bg-gradient-to-r from-primary-500 to-purple-600 text-white rounded-lg hover:scale-105 transition-all duration-300 flex items-center gap-2 shadow-md hover:shadow-xl">
                <i class="fas fa-plus"></i>
                <span>Додати налаштування</span>
            </a>
            
            <div class="relative" x-data="{ open: false }">
                <button @click="open = !open"
                        class="px-4 py-2 glass-light rounded-lg hover:bg-surface-100 dark:hover:bg-surface-800 transition-colors flex items-center gap-2 border border-surface-200/50 dark:border-surface-700/50">
                    <i class="fas fa-ellipsis-v"></i>
                </button>
                
                <div x-show="open"
                     @click.outside="open = false"
                     x-cloak
                     x-transition:enter="transition ease-out duration-200"
                     x-transition:enter-start="opacity-0 scale-95"
                     x-transition:enter-end="opacity-100 scale-100"
                     x-transition:leave="transition ease-in duration-150"
                     x-transition:leave-start="opacity-100 scale-100"
                     x-transition:leave-end="opacity-0 scale-95"
                     class="absolute right-0 mt-2 w-48 glass-light rounded-lg shadow-xl border border-surface-200/50 dark:border-surface-700/50 overflow-hidden z-50">
                    
                    <a href="{{ path('api_settings_public') }}" target="_blank"
                       class="flex items-center gap-2 px-4 py-2 hover:bg-surface-100 dark:hover:bg-surface-800 transition-colors w-full text-left group">
                        <i class="fas fa-api text-sm text-primary-500 group-hover:scale-110 transition-transform"></i>
                        <span class="text-sm">API публічні</span>
                    </a>
                    
                    <div class="border-t border-surface-200/50 dark:border-surface-700/50"></div>
                    
                    <button onclick="clearCache()"
                            class="flex items-center gap-2 px-4 py-2 hover:bg-surface-100 dark:hover:bg-surface-800 transition-colors w-full text-left group">
                        <i class="fas fa-eraser text-sm text-warning-500 group-hover:scale-110 transition-transform"></i>
                        <span class="text-sm">Очистити кеш</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    {# Форма масового оновлення #}
    <form method="post" action="{{ path('admin_settings_batch_update') }}">
        {# Список груп налаштувань #}
        <div class="space-y-6">
            {% for group, data in grouped_settings %}
                <div class="glass-light rounded-xl overflow-hidden border border-surface-200/50 dark:border-surface-700/50">
                    {# Заголовок групи #}
                    <div class="px-6 py-4 bg-gradient-to-r from-primary-500/10 to-purple-500/10 border-b border-surface-200/50 dark:border-surface-700/50 flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <h2 class="text-lg font-semibold text-surface-800 dark:text-surface-200">
                                {{ data.name }}
                            </h2>
                            <span class="px-2 py-1 bg-surface-200/50 dark:bg-surface-700/50 rounded-full text-xs font-medium">
                                {{ data.settings|length }} {{ data.settings|length == 1 ? 'налаштування' : 'налаштувань' }}
                            </span>
                        </div>
                        <button type="button" 
                                class="text-surface-500 hover:text-primary-500 transition-colors toggle-group p-1 hover:bg-surface-200/50 dark:hover:bg-surface-700/50 rounded-lg"
                                data-group="{{ group }}">
                            <i class="fas fa-chevron-up"></i>
                        </button>
                    </div>
                    
                    {# Тіло групи #}
                    <div class="p-6 space-y-6 group-{{ group }}">
                        {% for setting in data.settings %}
                            <div class="grid grid-cols-1 md:grid-cols-4 gap-4 items-start hover:bg-surface-100/50 dark:hover:bg-surface-800/50 p-4 rounded-lg transition-colors -mx-4">
                                {# Ліва частина - інформація про налаштування #}
                                <div class="space-y-1">
                                    <label class="font-medium text-surface-800 dark:text-surface-200 flex items-center gap-2">
                                        {% if setting.icon %}
                                            <i class="{{ setting.icon }} text-primary-500"></i>
                                        {% endif %}
                                        {{ setting.label }}
                                        {% if setting.isRequired %}
                                            <span class="text-danger-500" title="Обов'язкове">*</span>
                                        {% endif %}
                                    </label>
                                    
                                    {% if setting.description %}
                                        <p class="text-xs text-surface-500">{{ setting.description }}</p>
                                    {% endif %}
                                    
                                    <div class="flex items-center gap-2 mt-1">
                                        <span class="text-xs bg-surface-200/50 dark:bg-surface-700/50 px-2 py-0.5 rounded-full font-mono">
                                            {{ setting.settingKey }}
                                        </span>
                                        
                                        {% if setting.isPublic %}
                                            <span class="text-xs bg-primary-500/10 text-primary-600 dark:text-primary-400 px-2 py-0.5 rounded-full" title="Публічне">
                                                <i class="fas fa-globe text-xs mr-1"></i>API
                                            </span>
                                        {% endif %}
                                        
                                        {% if setting.isSystem %}
                                            <span class="text-xs bg-warning-500/10 text-warning-600 dark:text-warning-400 px-2 py-0.5 rounded-full" title="Системне">
                                                <i class="fas fa-cog text-xs mr-1"></i>Системне
                                            </span>
                                        {% endif %}
                                    </div>
                                </div>
                                
                                {# Права частина - поле вводу #}
                                <div class="md:col-span-3">
                                    {% include 'admin/settings/_field.html.twig' with {setting: setting} %}
                                    
                                    {# Кнопки дій #}
                                    <div class="flex justify-end mt-2 gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                                        <a href="{{ path('admin_settings_edit', {'id': setting.id}) }}" 
                                           class="text-xs bg-primary-500/10 text-primary-600 dark:text-primary-400 hover:bg-primary-500/20 px-3 py-1.5 rounded-lg transition-colors flex items-center gap-1"
                                           title="Редагувати">
                                            <i class="fas fa-edit text-xs"></i>
                                            <span>Редагувати</span>
                                        </a>
                                        
                                        {% if not setting.isSystem %}
                                            <button type="button" 
                                                    onclick="deleteSetting({{ setting.id }}, '{{ setting.label }}')"
                                                    class="text-xs bg-danger-500/10 text-danger-600 dark:text-danger-400 hover:bg-danger-500/20 px-3 py-1.5 rounded-lg transition-colors flex items-center gap-1"
                                                    title="Видалити">
                                                <i class="fas fa-trash text-xs"></i>
                                                <span>Видалити</span>
                                            </button>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                            
                            {% if not loop.last %}
                                <hr class="border-surface-200/50 dark:border-surface-700/50">
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>
            {% else %}
                {# Якщо немає налаштувань #}
                <div class="glass-light rounded-xl p-12 text-center border border-surface-200/50 dark:border-surface-700/50">
                    <div class="text-6xl mb-4 opacity-30">⚙️</div>
                    <h3 class="text-xl font-semibold text-surface-700 dark:text-surface-300 mb-2">Немає налаштувань</h3>
                    <p class="text-surface-500 dark:text-surface-400 mb-6">Почніть з додавання першого налаштування</p>
                    <a href="{{ path('admin_settings_create') }}" 
                       class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-primary-500 to-purple-600 text-white rounded-lg hover:scale-105 transition-all duration-300">
                        <i class="fas fa-plus"></i>
                        <span>Додати налаштування</span>
                    </a>
                </div>
            {% endfor %}
        </div>

        {# Кнопки збереження #}
        {% if grouped_settings is not empty %}
        <div class="mt-8 flex justify-end gap-4 sticky bottom-6">
            <button type="reset" 
                    class="px-6 py-2 rounded-lg glass-light hover:bg-surface-100 dark:hover:bg-surface-800 transition-colors border border-surface-200/50 dark:border-surface-700/50 flex items-center gap-2">
                <i class="fas fa-undo"></i>
                <span>Скинути</span>
            </button>
            <button type="submit" 
                    class="px-8 py-2 bg-gradient-to-r from-primary-500 to-purple-600 text-white rounded-lg hover:scale-105 hover:shadow-xl transition-all duration-300 flex items-center gap-2 shadow-lg">
                <i class="fas fa-save"></i>
                <span>Зберегти всі зміни</span>
            </button>
        </div>
        {% endif %}
    </form>
</div>

{# Форма для видалення #}
<form id="delete-form" method="post" style="display: none;">
    <input type="hidden" name="_token" value="">
</form>

{% endblock %}

{% block javascripts %}
{{ parent() }}

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Тогл груп
        document.querySelectorAll('.toggle-group').forEach(button => {
            button.addEventListener('click', () => {
                const group = button.dataset.group;
                const content = document.querySelector(`.group-${group}`);
                const icon = button.querySelector('i');
                
                if (content) {
                    content.classList.toggle('hidden');
                    icon.classList.toggle('fa-chevron-up');
                    icon.classList.toggle('fa-chevron-down');
                    
                    // Зберігаємо стан в localStorage
                    const collapsedGroups = JSON.parse(localStorage.getItem('collapsedGroups') || '[]');
                    const groupIndex = collapsedGroups.indexOf(group);
                    
                    if (content.classList.contains('hidden')) {
                        if (groupIndex === -1) collapsedGroups.push(group);
                    } else {
                        if (groupIndex !== -1) collapsedGroups.splice(groupIndex, 1);
                    }
                    
                    localStorage.setItem('collapsedGroups', JSON.stringify(collapsedGroups));
                }
            });
        });

        // Відновлюємо стан груп з localStorage
        const collapsedGroups = JSON.parse(localStorage.getItem('collapsedGroups') || '[]');
        collapsedGroups.forEach(group => {
            const content = document.querySelector(`.group-${group}`);
            const button = document.querySelector(`[data-group="${group}"]`);
            
            if (content && button) {
                content.classList.add('hidden');
                const icon = button.querySelector('i');
                icon.classList.remove('fa-chevron-up');
                icon.classList.add('fa-chevron-down');
            }
        });

        // Додаткові фічі
        addFieldFeatures();
    });

    // Функція для видалення налаштування
    function deleteSetting(id, label) {
        if (confirm(`Ви впевнені, що хочете видалити налаштування "${label}"?`)) {
            const form = document.getElementById('delete-form');
            form.action = `/admin/settings/delete/${id}`;
            form.querySelector('input[name="_token"]').value = '{{ csrf_token('delete') }}';
            form.submit();
        }
    }

    // Функція для очищення кешу
    function clearCache() {
        if (confirm('Очистити кеш налаштувань?')) {
            fetch('/admin/settings/clear-cache', {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Content-Type': 'application/json'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showNotification('success', 'Кеш налаштувань очищено');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showNotification('error', 'Помилка при очищенні кешу');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showNotification('error', 'Помилка при очищенні кешу');
            });
        }
    }

    // Функція для показу сповіщень
    function showNotification(type, message) {
        const notification = document.createElement('div');
        notification.className = `fixed top-4 right-4 z-50 px-6 py-3 rounded-lg shadow-xl transform transition-all duration-300 translate-y-0 opacity-100 ${
            type === 'success' ? 'bg-green-500' : 'bg-red-500'
        } text-white`;
        notification.innerHTML = `
            <div class="flex items-center gap-3">
                <i class="fas ${type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle'} text-xl"></i>
                <span>${message}</span>
            </div>
        `;
        
        document.body.appendChild(notification);
        
        setTimeout(() => {
            notification.style.opacity = '0';
            notification.style.transform = 'translateY(-20px)';
            setTimeout(() => notification.remove(), 300);
        }, 3000);
    }

    // Додаткові фічі для полів
    function addFieldFeatures() {
        // Додаємо індикатори змін
        document.querySelectorAll('.setting-field').forEach(field => {
            const originalValue = field.value;
            
            field.addEventListener('change', function() {
                if (this.value !== originalValue) {
                    this.classList.add('border-warning-500', 'ring-warning-500/20');
                    const indicator = document.createElement('span');
                    indicator.className = 'absolute -top-2 -right-2 w-4 h-4 bg-warning-500 rounded-full flex items-center justify-center';
                    indicator.innerHTML = '<i class="fas fa-pencil-alt text-white text-[8px]"></i>';
                    
                    const wrapper = this.closest('.md\\:col-span-3');
                    if (wrapper && !wrapper.querySelector('.change-indicator')) {
                        wrapper.style.position = 'relative';
                        indicator.classList.add('change-indicator');
                        wrapper.appendChild(indicator);
                    }
                }
            });
        });
    }
</script>

<style>
/* Анімації для сповіщень */
@keyframes slideIn {
    from {
        transform: translateX(100%);
        opacity: 0;
    }
    to {
        transform: translateX(0);
        opacity: 1;
    }
}

.notification {
    animation: slideIn 0.3s ease-out forwards;
}

/* Стилі для змінених полів */
.setting-field.border-warning-500 {
    transition: border-color 0.3s ease;
}

/* Індикатор змін */
.change-indicator {
    animation: pulse 2s infinite;
}

@keyframes pulse {
    0%, 100% {
        transform: scale(1);
    }
    50% {
        transform: scale(1.1);
    }
}

/* Стилі для sticky кнопок */
.sticky {
    position: sticky;
    bottom: 1.5rem;
    z-index: 40;
    background: transparent;
}
</style>
{% endblock %}