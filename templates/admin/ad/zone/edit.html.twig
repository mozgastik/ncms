{% extends 'admin/base.html.twig' %}

{% block title %}Редагування зони - {{ zone.name }} - Адмін панель{% endblock %}

{% block body %}
<main class="flex-1 p-2 sm:p-3 md:p-4 lg:p-6">
    <div class="max-w-2xl mx-auto">
        <div class="flex items-center justify-between mb-6">
            <h1 class="text-2xl font-bold text-(--color-surface-900) dark:text-(--color-surface-100)">
                Редагування зони «{{ zone.name }}»
            </h1>
            <a href="{{ path('admin_ad_zone_index') }}" class="text-sm text-(--color-surface-600) dark:text-(--color-surface-400) hover:text-(--color-primary-600) dark:hover:text-(--color-primary-400)">
                ← Назад до списку
            </a>
        </div>

        <div class="bg-(--color-surface-0) dark:bg-(--color-surface-800) rounded-xl shadow-(--shadow-md) border border-(--color-surface-200) dark:border-(--color-surface-700) p-6">
            {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

            <div>
                <label class="block text-sm font-medium text-(--color-surface-700) dark:text-(--color-surface-300) mb-2">{{ form.name.vars.label|default('Назва') }}</label>
                {{ form_widget(form.name, {'attr': {'class': 'w-full px-4 py-2.5 rounded-xl border border-(--color-surface-300) dark:border-(--color-surface-600) bg-(--color-surface-0) dark:bg-(--color-surface-800) text-(--color-surface-900) dark:text-(--color-surface-100) focus:ring-2 focus:ring-(--color-primary-500)/50 focus:border-(--color-primary-500) transition-all'}}) }}
                {{ form_errors(form.name) }}
            </div>

            <div>
                <label class="block text-sm font-medium text-(--color-surface-700) dark:text-(--color-surface-300) mb-2">{{ form.code.vars.label|default('Унікальний код') }}</label>
                {{ form_widget(form.code, {'attr': {'class': 'w-full px-4 py-2.5 rounded-xl border border-(--color-surface-300) dark:border-(--color-surface-600) bg-(--color-surface-0) dark:bg-(--color-surface-800) text-(--color-surface-900) dark:text-(--color-surface-100) focus:ring-2 focus:ring-(--color-primary-500)/50 focus:border-(--color-primary-500) transition-all'}}) }}
                {{ form_errors(form.code) }}
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-medium text-(--color-surface-700) dark:text-(--color-surface-300) mb-2">{{ form.width.vars.label|default('Ширина') }}</label>
                    {{ form_widget(form.width, {'attr': {'class': 'w-full px-4 py-2.5 rounded-xl border border-(--color-surface-300) dark:border-(--color-surface-600) bg-(--color-surface-0) dark:bg-(--color-surface-800) text-(--color-surface-900) dark:text-(--color-surface-100) focus:ring-2 focus:ring-(--color-primary-500)/50 focus:border-(--color-primary-500) transition-all'}}) }}
                </div>
                <div>
                    <label class="block text-sm font-medium text-(--color-surface-700) dark:text-(--color-surface-300) mb-2">{{ form.height.vars.label|default('Висота') }}</label>
                    {{ form_widget(form.height, {'attr': {'class': 'w-full px-4 py-2.5 rounded-xl border border-(--color-surface-300) dark:border-(--color-surface-600) bg-(--color-surface-0) dark:bg-(--color-surface-800) text-(--color-surface-900) dark:text-(--color-surface-100) focus:ring-2 focus:ring-(--color-primary-500)/50 focus:border-(--color-primary-500) transition-all'}}) }}
                </div>
            </div>

            <div class="flex items-center gap-4 pt-4 border-t border-(--color-surface-200) dark:border-(--color-surface-700)">
                <div class="flex items-center gap-2">
                    {{ form_widget(form.isActive, {'attr': {'class': 'rounded border-(--color-surface-300) text-(--color-primary-600) focus:ring-(--color-primary-500)'}}) }}
                    <label class="text-sm text-(--color-surface-700) dark:text-(--color-surface-300)">{{ form.isActive.vars.label|default('Активна') }}</label>
                </div>
            </div>

            <div class="flex justify-end pt-4">
                <button type="submit" class="px-6 py-3 bg-(--gradient-primary) text-(--color-surface-0) font-semibold rounded-xl hover:shadow-lg hover-scale transition-all duration-(--transition-base)">
                    💾 Оновити зону
                </button>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
</main>
{% endblock %}