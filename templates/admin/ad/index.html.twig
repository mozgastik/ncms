{# templates/admin/ad/index.html.twig #}
{% extends 'admin/base.html.twig' %}

{% block title %}Рекламні банери - Адмін панель{% endblock %}

{% block body %}
<main class="flex-1 p-2 sm:p-3 md:p-4 lg:p-6"
      x-data="adListManager()"
      x-init="init()"
      x-cloak>

    <!-- Flash Messages -->
    <template x-for="flash in flashes" :key="flash.id">
        <div class="fixed top-2 sm:top-4 right-2 sm:right-4 px-3 py-2 sm:px-4 sm:py-3 rounded-lg shadow-lg z-50 animate-fade-in max-w-[calc(100vw-1rem)] sm:max-w-md"
             :class="flash.type === 'success' ? 'bg-green-100 text-green-800 border border-green-200' : 'bg-red-100 text-red-800 border border-red-200'">
            <div class="flex items-center gap-2">
                <i class="fas" :class="flash.type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle'"></i>
                <span class="font-medium text-xs sm:text-sm flex-1" x-text="flash.message"></span>
                <button @click="removeFlash(flash.id)" class="ml-1 sm:ml-2 text-current hover:opacity-70">
                    <i class="fas fa-times text-xs"></i>
                </button>
            </div>
        </div>
    </template>

    <!-- Header -->
    <div class="mb-3 sm:mb-4 md:mb-6">
        <div class="flex flex-col gap-2 sm:gap-3 md:gap-4">
            <div>
                <h1 class="text-lg sm:text-xl md:text-2xl lg:text-3xl font-bold text-(--color-surface-900) dark:text-(--color-surface-100)">
                    Рекламні банери
                </h1>
                <p class="text-(--color-surface-500) dark:text-(--color-surface-400) text-xs sm:text-sm mt-0.5">
                    Загальна кількість: <span x-text="ads.length"></span>
                </p>
            </div>
            <div class="flex items-center gap-2">
                <a href="{{ path('admin_ad_new') }}"
                   class="inline-flex items-center gap-2 px-4 py-2 bg-(--gradient-primary) text-(--color-surface-0) rounded-lg hover:shadow-lg hover-scale transition-all duration-(--transition-base) text-sm font-medium">
                    <i class="fas fa-plus"></i> Додати банер
                </a>
                <a href="{{ path('admin_ad_zone_index') }}"
                   class="inline-flex items-center gap-2 px-4 py-2 bg-(--color-surface-100) dark:bg-(--color-surface-800) text-(--color-surface-700) dark:text-(--color-surface-300) rounded-lg hover:bg-(--color-surface-200) dark:hover:bg-(--color-surface-700) transition-all duration-(--transition-base) text-sm font-medium">
                    <i class="fas fa-th-large"></i> Зони
                </a>
            </div>
        </div>
    </div>

    <!-- Ads Table -->
    <div class="bg-(--color-surface-0) dark:bg-(--color-surface-800) rounded-xl shadow-(--shadow-md) border border-(--color-surface-200) dark:border-(--color-surface-700) overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-(--color-surface-200) dark:divide-(--color-surface-700)">
                <thead class="bg-(--color-surface-50) dark:bg-(--color-surface-900)/50">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-(--color-surface-500) dark:text-(--color-surface-400) uppercase tracking-wider">Назва</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-(--color-surface-500) dark:text-(--color-surface-400) uppercase tracking-wider">Тип</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-(--color-surface-500) dark:text-(--color-surface-400) uppercase tracking-wider">Зона</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-(--color-surface-500) dark:text-(--color-surface-400) uppercase tracking-wider">Пріоритет</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-(--color-surface-500) dark:text-(--color-surface-400) uppercase tracking-wider">Статус</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-(--color-surface-500) dark:text-(--color-surface-400) uppercase tracking-wider">Дії</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-(--color-surface-200) dark:divide-(--color-surface-700)">
                    {% for ad in ads %}
                    <tr class="hover:bg-(--color-surface-50) dark:hover:bg-(--color-surface-800)/50 transition-colors">
                        <td class="px-4 py-4">
                            <div class="flex items-start gap-3">
                                {% if ad.type == 'image' and ad.image %}
                                <img src="{{ ad.image }}" alt="{{ ad.title }}" class="flex-shrink-0 h-10 w-16 rounded-md object-cover border border-(--color-surface-200) dark:border-(--color-surface-600)">
                                {% else %}
                                <div class="flex-shrink-0 h-10 w-16 rounded-md bg-(--color-surface-100) dark:bg-(--color-surface-700) flex items-center justify-center text-(--color-surface-400) dark:text-(--color-surface-500)">
                                    <i class="fas fa-ad text-lg"></i>
                                </div>
                                {% endif %}
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-medium text-(--color-surface-900) dark:text-(--color-surface-100) truncate">{{ ad.title }}</p>
                                    <p class="text-xs text-(--color-surface-500) dark:text-(--color-surface-400) mt-0.5 truncate max-w-[200px]">
                                        {% if ad.type == 'image' and ad.link %}<i class="fas fa-link mr-1"></i> {{ ad.link }}{% elseif ad.type != 'image' %}{{ ad.code|slice(0, 50) }}{% endif %}
                                    </p>
                                </div>
                            </div>
                        </td>
                        <td class="px-4 py-4 whitespace-nowrap">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium 
                                {{ ad.type == 'image' ? 'bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-400' : 
                                   ad.type == 'html' ? 'bg-purple-100 text-purple-800 dark:bg-purple-900/30 dark:text-purple-400' : 
                                   'bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-400' }}">
                                {{ ad.type == 'image' ? 'Зображення' : ad.type == 'html' ? 'HTML' : 'Скрипт' }}
                            </span>
                        </td>
                        <td class="px-4 py-4 whitespace-nowrap">
                            <span class="text-sm text-(--color-surface-700) dark:text-(--color-surface-300)">
                                {{ ad.zone.name ?? ad.zone.code }}
                            </span>
                        </td>
                        <td class="px-4 py-4 whitespace-nowrap text-sm text-(--color-surface-700) dark:text-(--color-surface-300)">
                            {{ ad.priority }}
                        </td>
                        <td class="px-4 py-4 whitespace-nowrap">
                            {% if ad.isActive %}
                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400">
                                <i class="fas fa-circle text-[8px]"></i> Активний
                            </span>
                            {% else %}
                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800 dark:bg-gray-700/50 dark:text-gray-400">
                                <i class="fas fa-circle text-[8px]"></i> Неактивний
                            </span>
                            {% endif %}
                        </td>
                        <td class="px-4 py-4 whitespace-nowrap">
                            <div class="flex items-center gap-2">
                                <a href="{{ path('admin_ad_edit', {id: ad.id}) }}"
                                   class="w-8 h-8 rounded-lg flex items-center justify-center text-(--color-surface-600) dark:text-(--color-surface-400) hover:text-(--color-primary-600) dark:hover:text-(--color-primary-400) hover:bg-(--color-primary-50) dark:hover:bg-(--color-primary-900)/20 transition-colors"
                                   title="Редагувати">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form method="post" action="{{ path('admin_ad_delete', {id: ad.id}) }}"
                                      onsubmit="return confirm('Видалити банер «{{ ad.title }}»?')"
                                      class="inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ ad.id) }}">
                                    <button type="submit"
                                            class="w-8 h-8 rounded-lg flex items-center justify-center text-red-600 dark:text-red-400 hover:text-red-800 dark:hover:text-red-300 hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors"
                                            title="Видалити">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="6" class="px-6 py-12 text-center text-(--color-surface-500) dark:text-(--color-surface-400)">
                            <div class="flex flex-col items-center">
                                <i class="fas fa-ad text-4xl text-(--color-surface-300) dark:text-(--color-surface-600) mb-3"></i>
                                <p class="text-lg font-medium">Немає жодного банера</p>
                                <p class="text-sm mt-1">Створіть перший рекламний банер</p>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</main>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
function adListManager() {
    return {
        ads: {{ ads|length }},
        flashes: [],
        init() {
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    this.addFlash('{{ label }}', '{{ message|e('js') }}');
                {% endfor %}
            {% endfor %}
        },
        addFlash(type, message) {
            const id = Date.now();
            this.flashes.push({ id, type, message });
            setTimeout(() => this.removeFlash(id), 5000);
        },
        removeFlash(id) {
            this.flashes = this.flashes.filter(f => f.id !== id);
        }
    }
}
</script>
{% endblock %}