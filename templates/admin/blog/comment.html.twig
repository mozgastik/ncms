{% extends 'admin/base.html.twig' %}

{% block title %}Модерація коментарів{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Заголовок -->
    <div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-3xl font-bold text-gray-900 dark:text-white flex items-center gap-3">
                <span class="bg-gradient-to-br from-blue-500 to-indigo-500 p-2 rounded-xl shadow-lg">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                    </svg>
                </span>
                Модерація коментарів
            </h1>
            <nav class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 mt-2">
                <a href="{{ path('admin_dashboard') }}" class="hover:text-blue-600 dark:hover:text-blue-400">Головна</a>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
                <a href="{{ path('admin_blog_index') }}" class="hover:text-blue-600 dark:hover:text-blue-400">Блоги</a>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
                <span class="text-gray-700 dark:text-gray-300 font-medium">Коментарі</span>
            </nav>
        </div>

        <div class="flex items-center gap-3">
            <!-- Блок статистики -->
            <div class="flex gap-2">
                <a href="{{ path('admin_blog_comments_index', {'status': 'pending'}) }}" 
                   class="px-3 py-2 bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-400 rounded-lg text-sm font-medium hover:bg-yellow-200 dark:hover:bg-yellow-800 transition-colors {{ currentStatus == 'pending' ? 'ring-2 ring-yellow-500' : '' }}">
                    Очікує: {{ stats.pending }}
                </a>
                <a href="{{ path('admin_blog_comments_index', {'status': 'approved'}) }}" 
                   class="px-3 py-2 bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 rounded-lg text-sm font-medium hover:bg-green-200 dark:hover:bg-green-800 transition-colors {{ currentStatus == 'approved' ? 'ring-2 ring-green-500' : '' }}">
                    Схвалено: {{ stats.approved }}
                </a>
                <a href="{{ path('admin_blog_comments_index', {'status': 'spam'}) }}" 
                   class="px-3 py-2 bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400 rounded-lg text-sm font-medium hover:bg-red-200 dark:hover:bg-red-800 transition-colors {{ currentStatus == 'spam' ? 'ring-2 ring-red-500' : '' }}">
                    Спам: {{ stats.spam }}
                </a>
            </div>
        </div>
    </div>

    <!-- Пошук і фільтри -->
    <div class="mb-6 flex flex-col sm:flex-row gap-4">
        <form method="get" action="{{ path('admin_blog_comments_index') }}" class="flex-1">
            <div class="flex gap-2">
                <input type="hidden" name="status" value="{{ currentStatus }}">
                <div class="flex-1 relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                        </svg>
                    </div>
                    <input type="text" 
                           name="search" 
                           value="{{ search }}"
                           placeholder="Пошук за текстом або автором..." 
                           class="w-full pl-10 pr-4 py-2 bg-gray-50 dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-lg text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                <button type="submit" 
                        class="px-4 py-2 bg-blue-500 hover:bg-blue-600 text-white rounded-lg transition-colors">
                    Пошук
                </button>
                {% if search %}
                    <a href="{{ path('admin_blog_comments_index', {'status': currentStatus}) }}" 
                       class="px-4 py-2 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-200 transition-colors">
                        Скинути
                    </a>
                {% endif %}
            </div>
        </form>

        <!-- Масові дії -->
        <form method="post" action="{{ path('admin_blog_comment_bulk') }}" id="bulkForm">
            <input type="hidden" name="_token" value="{{ csrf_token('bulk-action') }}">
            <div class="flex gap-2">
                <select name="action" class="px-3 py-2 bg-gray-50 dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-lg text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <option value="approve">Схвалити вибрані</option>
                    <option value="reject">Відхилити вибрані</option>
                    <option value="spam">Позначити спамом</option>
                    <option value="delete">Видалити вибрані</option>
                </select>
                <button type="submit" 
                        class="px-4 py-2 bg-purple-500 hover:bg-purple-600 text-white rounded-lg transition-colors"
                        onclick="return confirm('Ви впевнені?')">
                    Застосувати
                </button>
            </div>
        </form>
    </div>

    {% if pagination|length > 0 %}
        <!-- Список коментарів -->
        <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-xl overflow-hidden border border-gray-200 dark:border-gray-800">
            <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-800">
                <thead class="bg-gray-50 dark:bg-gray-800">
                    <tr>
                        <th class="px-6 py-3 text-left">
                            <input type="checkbox" 
                                   class="select-all w-5 h-5 rounded border-gray-300 dark:border-gray-700 text-blue-600 focus:ring-blue-500"
                                   onclick="toggleAll(this)">
                        </th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                            Коментар
                        </th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                            Автор
                        </th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                            Блог
                        </th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                            Статус
                        </th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                            Дата
                        </th>
                        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                            Дії
                        </th>
                    </tr>
                </thead>
                <tbody class="bg-white dark:bg-gray-900 divide-y divide-gray-200 dark:divide-gray-800">
                    {% for comment in pagination %}
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors" data-comment-id="{{ comment.id }}">
                            <td class="px-6 py-4">
                                <input type="checkbox" 
                                       name="comments[]" 
                                       value="{{ comment.id }}"
                                       form="bulkForm"
                                       class="comment-checkbox w-5 h-5 rounded border-gray-300 dark:border-gray-700 text-blue-600 focus:ring-blue-500">
                            </td>
                            <td class="px-6 py-4">
                                <div class="max-w-md">
                                    <p class="text-gray-900 dark:text-white whitespace-pre-line line-clamp-3">
                                        {{ comment.content }}
                                    </p>
                                    {% if comment.parent %}
                                        <div class="mt-2 text-xs text-gray-500 dark:text-gray-400">
                                            <i class="fas fa-reply mr-1"></i>
                                            Відповідь на коментар #{{ comment.parent.id }}
                                        </div>
                                    {% endif %}
                                    {% if comment.replies|length > 0 %}
                                        <div class="mt-2">
                                            <span class="text-xs bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 px-2 py-1 rounded-full">
                                                {{ comment.replies|length }} відповідей
                                            </span>
                                        </div>
                                    {% endif %}
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex items-center">
                                    <div class="flex-shrink-0">
                                        <img src="https://ui-avatars.com/api/?name={{ comment.displayName|url_encode }}&background=3b82f6&color=fff&bold=true" 
                                             class="w-8 h-8 rounded-full"
                                             alt="">
                                    </div>
                                    <div class="ml-3">
                                        <div class="text-sm font-medium text-gray-900 dark:text-white">
                                            {{ comment.displayName }}
                                        </div>
                                        <div class="text-xs text-gray-500 dark:text-gray-400">
                                            {% if comment.user %}
                                                <span class="text-green-600">Авторизований</span>
                                            {% else %}
                                                <span class="text-yellow-600">Гість</span>
                                            {% endif %}
                                            {% if comment.authorIp %}
                                                • IP: {{ comment.authorIp }}
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <a href="{{ path('admin_blog_review', {'id': comment.blogPost.id}) }}" 
                                   class="text-blue-600 hover:text-blue-900 dark:hover:text-blue-400">
                                    {{ comment.blogPost.title|slice(0, 30) }}...
                                </a>
                            </td>
                            <td class="px-6 py-4">
                                {% if comment.isSpam %}
                                    <span class="px-3 py-1 bg-red-100 dark:bg-red-900/30 text-red-600 dark:text-red-400 text-xs font-medium rounded-full">
                                        Спам
                                    </span>
                                {% elseif comment.isApproved %}
                                    <span class="px-3 py-1 bg-green-100 dark:bg-green-900/30 text-green-600 dark:text-green-400 text-xs font-medium rounded-full">
                                        Схвалено
                                    </span>
                                {% else %}
                                    <span class="px-3 py-1 bg-yellow-100 dark:bg-yellow-900/30 text-yellow-600 dark:text-yellow-400 text-xs font-medium rounded-full">
                                        Очікує
                                    </span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400">
                                {{ comment.createdAt|date('d.m.Y H:i') }}
                                {% if comment.updatedAt %}
                                    <br><span class="text-xs">(ред. {{ comment.updatedAt|date('d.m.Y H:i') }})</span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    {% if not comment.isApproved and not comment.isSpam %}
                                        <form method="post" action="{{ path('admin_blog_comment_approve', {'id': comment.id}) }}" class="inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('approve' ~ comment.id) }}">
                                            <button type="submit" 
                                                    class="p-2 text-green-600 hover:text-green-900 dark:hover:text-green-400 transition-colors"
                                                    title="Схвалити">
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                                </svg>
                                            </button>
                                        </form>
                                    {% endif %}
                                    
                                    {% if not comment.isSpam %}
                                        <form method="post" action="{{ path('admin_blog_comment_mark_spam', {'id': comment.id}) }}" class="inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('spam' ~ comment.id) }}">
                                            <button type="submit" 
                                                    class="p-2 text-yellow-600 hover:text-yellow-900 dark:hover:text-yellow-400 transition-colors"
                                                    title="Позначити спамом">
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                                                </svg>
                                            </button>
                                        </form>
                                    {% endif %}
                                    
                                    <form method="post" action="{{ path('admin_blog_comment_delete', {'id': comment.id}) }}" 
                                          class="inline" 
                                          onsubmit="return confirm('Ви впевнені, що хочете видалити цей коментар?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ comment.id) }}">
                                        <button type="submit" 
                                                class="p-2 text-red-600 hover:text-red-900 dark:hover:text-red-400 transition-colors"
                                                title="Видалити">
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                            </svg>
                                        </button>
                                    </form>
                                    
                                    <button onclick="openReplyModal({{ comment.id }}, '{{ comment.displayName|escape('js') }}')"
                                            class="p-2 text-blue-600 hover:text-blue-900 dark:hover:text-blue-400 transition-colors"
                                            title="Відповісти">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/>
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <!-- Пагінація -->
        <div class="mt-8">
            {{ knp_pagination_render(pagination) }}
        </div>
    {% else %}
        <!-- Немає коментарів -->
        <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-xl p-12 text-center border border-gray-200 dark:border-gray-800">
            <div class="w-24 h-24 mx-auto bg-gradient-to-br from-gray-200 to-gray-300 dark:from-gray-700 dark:to-gray-600 rounded-full flex items-center justify-center mb-6">
                <svg class="w-12 h-12 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-3">Немає коментарів</h3>
            <p class="text-gray-600 dark:text-gray-400 text-lg">
                {{ currentStatus == 'pending' ? 'Немає коментарів, що очікують модерації' : 'Немає коментарів для відображення' }}
            </p>
        </div>
    {% endif %}
</div>

<!-- Модальне вікно для відповіді -->
<div id="replyModal" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 hidden items-center justify-center">
    <div class="bg-white dark:bg-gray-900 rounded-2xl max-w-2xl w-full mx-4 p-6" onclick="event.stopPropagation()">
        <div class="flex justify-between items-center mb-4">
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white flex items-center gap-2">
                <svg class="w-6 h-6 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/>
                </svg>
                Відповісти на коментар
            </h3>
            <button onclick="closeReplyModal()" class="text-gray-500 hover:text-gray-700 dark:hover:text-gray-300">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>
        
        <div id="originalComment" class="mb-4 p-4 bg-gray-50 dark:bg-gray-800 rounded-xl">
            <p class="text-sm text-gray-600 dark:text-gray-400">
                <span class="font-medium text-gray-900 dark:text-white" id="replyAuthor"></span> написав:
            </p>
            <p class="text-gray-900 dark:text-white mt-2" id="replyContent"></p>
        </div>
        
        <form id="replyForm" method="post">
            <input type="hidden" name="_token" id="replyToken" value="">
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                    Ваша відповідь
                </label>
                <textarea name="content" 
                          id="replyContentInput"
                          rows="4" 
                          class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
                          placeholder="Напишіть відповідь..."
                          required></textarea>
            </div>
            
            <div class="flex justify-end gap-3">
                <button type="button" 
                        onclick="closeReplyModal()"
                        class="px-4 py-2 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-200 transition-colors">
                    Скасувати
                </button>
                <button type="submit" 
                        class="px-4 py-2 bg-gradient-to-r from-blue-500 to-purple-600 text-white rounded-lg hover:shadow-lg transition-all">
                    Надіслати відповідь
                </button>
            </div>
        </form>
    </div>
</div>

<!-- JavaScript -->
<script>
function toggleAll(checkbox) {
    const checkboxes = document.querySelectorAll('.comment-checkbox');
    checkboxes.forEach(cb => cb.checked = checkbox.checked);
}

function openReplyModal(commentId, authorName) {
    const modal = document.getElementById('replyModal');
    const form = document.getElementById('replyForm');
    const authorSpan = document.getElementById('replyAuthor');
    const tokenInput = document.getElementById('replyToken');
    
    form.action = `/admin/blog/comments/${commentId}/reply`;
    authorSpan.textContent = authorName;
    tokenInput.value = '{{ csrf_token('reply') }}'.replace('reply', 'reply' + commentId);
    
    // Завантажити оригінальний коментар
    fetch(`/admin/blog/comments/${commentId}/content`)
        .then(response => response.json())
        .then(data => {
            document.getElementById('replyContent').textContent = data.content;
        });
    
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
}

function closeReplyModal() {
    const modal = document.getElementById('replyModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = 'auto';
    document.getElementById('replyContentInput').value = '';
}

// Закриття по Escape
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        closeReplyModal();
    }
});

// Закриття по кліку на фон
document.getElementById('replyModal').addEventListener('click', function(e) {
    if (e.target === this) {
        closeReplyModal();
    }
});

// Оновлення статистики
function refreshStats() {
    fetch('{{ path('admin_blog_comment_stats') }}')
        .then(response => response.json())
        .then(data => {
            document.querySelectorAll('[data-stat]').forEach(el => {
                const stat = el.dataset.stat;
                if (data[stat] !== undefined) {
                    el.textContent = data[stat];
                }
            });
        });
}

// Оновлюємо статистику кожні 30 секунд
setInterval(refreshStats, 30000);
</script>

<!-- Стилі -->
<style>
.line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

/* Анімація для модального вікна */
#replyModal.flex {
    animation: fadeIn 0.2s ease-out;
}

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: scale(0.95);
    }
    to {
        opacity: 1;
        transform: scale(1);
    }
}

/* Стилі для пагінації */
.pagination {
    @apply flex items-center gap-2;
}

.pagination li {
    @apply inline-block;
}

.pagination a, .pagination span {
    @apply px-4 py-2 bg-white dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors;
}

.pagination .active span {
    @apply bg-gradient-to-r from-blue-500 to-purple-600 text-white border-transparent;
}

.pagination .disabled span {
    @apply opacity-50 cursor-not-allowed;
}
</style>
{% endblock %}