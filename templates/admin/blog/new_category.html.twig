{% extends 'admin/base.html.twig' %}

{% block title %}Створення нової категорії{% endblock %}

{% block body %}
<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Заголовок -->
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white flex items-center gap-3">
            <span class="bg-gradient-to-br from-green-500 to-emerald-500 p-2 rounded-xl shadow-lg">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
            </span>
            Нова категорія
        </h1>
        
        <!-- Хлібні крихти -->
        <nav class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 mt-2">
            <a href="{{ path('admin_dashboard') }}" class="hover:text-blue-600 dark:hover:text-blue-400">Головна</a>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
            <a href="{{ path('admin_blog_index') }}" class="hover:text-blue-600 dark:hover:text-blue-400">Блоги</a>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
            <a href="{{ path('admin_blog_category_index') }}" class="hover:text-blue-600 dark:hover:text-blue-400">Категорії</a>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
            <span class="text-gray-700 dark:text-gray-300 font-medium">Нова категорія</span>
        </nav>
    </div>

    <!-- Форма -->
    <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-xl p-8 border border-gray-200 dark:border-gray-800">
        {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
        
        <!-- Назва категорії -->
        <div>
            {{ form_label(form.name, null, {
                'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2'}
            }) }}
            {{ form_widget(form.name, {
                'attr': {
                    'class': 'w-full px-4 py-3 bg-gray-50 dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-transparent transition-all'
                }
            }) }}
            {{ form_errors(form.name) }}
        </div>

        <!-- Slug (URL) -->
        <div>
            {{ form_label(form.slug, 'Slug (URL)', {
                'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2'}
            }) }}
            {{ form_widget(form.slug, {
                'attr': {
                    'class': 'w-full px-4 py-3 bg-gray-50 dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-transparent transition-all font-mono',
                    'placeholder': 'наприклад: novini-ukrainy'
                }
            }) }}
            {{ form_errors(form.slug) }}
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">
                <i class="fas fa-info-circle mr-1"></i>
                Використовується в URL. Тільки малі літери, цифри та дефіси.
            </p>
        </div>

        <!-- Опис -->
        <div>
            {{ form_label(form.description, null, {
                'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2'}
            }) }}
            {{ form_widget(form.description, {
                'attr': {
                    'class': 'w-full px-4 py-3 bg-gray-50 dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-transparent transition-all',
                    'rows': 4,
                    'placeholder': 'Введіть опис категорії (необов\'язково)'
                }
            }) }}
            {{ form_errors(form.description) }}
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">
                <i class="fas fa-info-circle mr-1"></i>
                Короткий опис категорії (максимум 1000 символів)
            </p>
        </div>

        <!-- Порядок сортування та активність -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                {{ form_label(form.sortOrder, 'Порядок сортування', {
                    'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2'}
                }) }}
                {{ form_widget(form.sortOrder, {
                    'attr': {
                        'class': 'w-full px-4 py-3 bg-gray-50 dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-transparent transition-all',
                        'placeholder': '0',
                        'min': 0
                    }
                }) }}
                {{ form_errors(form.sortOrder) }}
                <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">
                    <i class="fas fa-info-circle mr-1"></i>
                    Менше число = вище в списку
                </p>
            </div>

            <div class="flex items-start pt-6">
                <div class="flex items-center h-5">
                    {{ form_widget(form.isActive, {
                        'attr': {
                            'class': 'w-5 h-5 rounded border-gray-300 dark:border-gray-700 text-blue-600 focus:ring-blue-500'
                        }
                    }) }}
                </div>
                <div class="ml-3">
                    {{ form_label(form.isActive, 'Активна категорія', {
                        'label_attr': {'class': 'text-sm font-medium text-gray-700 dark:text-gray-300 cursor-pointer'}
                    }) }}
                    <p class="text-sm text-gray-500 dark:text-gray-400">
                        <i class="fas fa-info-circle mr-1"></i>
                        Неактивні категорії не відображаються на сайті
                    </p>
                </div>
            </div>
        </div>

        <!-- Батьківська категорія -->
        <div>
            {{ form_label(form.parent, 'Батьківська категорія', {
                'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2'}
            }) }}
            {{ form_widget(form.parent, {
                'attr': {
                    'class': 'w-full px-4 py-3 bg-gray-50 dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-transparent transition-all'
                }
            }) }}
            {{ form_errors(form.parent) }}
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">
                <i class="fas fa-info-circle mr-1"></i>
                Якщо вибрано, ця категорія буде підкатегорією
            </p>
        </div>

        <!-- Приклад відображення -->
        <div class="mt-6 p-4 bg-gray-50 dark:bg-gray-800 rounded-xl">
            <h4 class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-3 flex items-center gap-2">
                <svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                </svg>
                Попередній перегляд
            </h4>
            <div class="flex items-center gap-3 flex-wrap" id="preview">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center">
                    <span class="text-white font-bold text-lg" id="preview-letter">К</span>
                </div>
                <span class="font-medium text-gray-900 dark:text-white" id="preview-name">Назва категорії</span>
                <span class="px-2 py-1 bg-green-100 dark:bg-green-900/30 text-green-600 dark:text-green-400 text-xs rounded-full" id="preview-status">
                    Активна
                </span>
            </div>
        </div>

        <!-- Кнопки -->
        <div class="flex justify-end gap-3 pt-6 border-t border-gray-200 dark:border-gray-800">
            <a href="{{ path('admin_blog_category_index') }}" 
               class="px-6 py-3 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 font-semibold rounded-xl hover:bg-gray-200 dark:hover:bg-gray-700 transition-all duration-300">
                Скасувати
            </a>
            <button type="submit" 
                    class="px-6 py-3 bg-gradient-to-r from-blue-500 to-purple-600 text-white font-semibold rounded-xl hover:shadow-lg hover:scale-105 transition-all duration-300">
                Створити категорію
            </button>
        </div>

        {{ form_end(form) }}
    </div>
</div>

<!-- JavaScript для прев'ю -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    const nameInput = document.getElementById('{{ form.name.vars.id }}');
    const isActiveInput = document.getElementById('{{ form.isActive.vars.id }}');
    const parentSelect = document.getElementById('{{ form.parent.vars.id }}');
    
    const previewName = document.getElementById('preview-name');
    const previewLetter = document.getElementById('preview-letter');
    const previewStatus = document.getElementById('preview-status');
    
    function updatePreview() {
        // Оновлюємо назву
        const name = nameInput.value.trim();
        previewName.textContent = name || 'Назва категорії';
        previewLetter.textContent = (name || 'К').charAt(0).toUpperCase();
        
        // Оновлюємо статус активності
        if (isActiveInput && isActiveInput.checked) {
            previewStatus.textContent = 'Активна';
            previewStatus.className = 'px-2 py-1 bg-green-100 dark:bg-green-900/30 text-green-600 dark:text-green-400 text-xs rounded-full';
        } else {
            previewStatus.textContent = 'Неактивна';
            previewStatus.className = 'px-2 py-1 bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 text-xs rounded-full';
        }
    }
    
    if (nameInput) {
        nameInput.addEventListener('input', updatePreview);
    }
    
    if (isActiveInput) {
        isActiveInput.addEventListener('change', updatePreview);
    }
    
    // Початкове оновлення
    updatePreview();
});
</script>

<!-- Додаткові стилі для форми -->
<style>
/* Стилі для випадаючого списку батьківських категорій */
select option[data-level="1"] {
    padding-left: 20px;
    font-style: italic;
}

select option[data-level="2"] {
    padding-left: 40px;
    font-style: italic;
    font-size: 0.95em;
}

select option[data-level="3"] {
    padding-left: 60px;
    font-style: italic;
    font-size: 0.9em;
    color: #666;
}

/* Стилі для помилок */
.form-error {
    color: #ef4444;
    font-size: 0.875rem;
    margin-top: 0.25rem;
}

/* Анімація для кнопки */
button[type="submit"]:hover svg {
    transform: translateX(4px);
    transition: transform 0.3s ease;
}
</style>
{% endblock %}