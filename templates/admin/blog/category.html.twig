{% extends 'admin/base.html.twig' %}

{% block title %}Управління категоріями блогів{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Заголовок -->
    <div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-3xl font-bold text-gray-900 dark:text-white flex items-center gap-3">
                <span class="bg-gradient-to-br from-purple-500 to-pink-500 p-2 rounded-xl shadow-lg">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                    </svg>
                </span>
                Категорії блогів
            </h1>
            <nav class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 mt-2">
                <a href="{{ path('admin_dashboard') }}" class="hover:text-blue-600 dark:hover:text-blue-400">Головна</a>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
                <a href="{{ path('admin_blog_index') }}" class="hover:text-blue-600 dark:hover:text-blue-400">Блоги</a>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
                <span class="text-gray-700 dark:text-gray-300 font-medium">Категорії</span>
            </nav>
        </div>
        
        <div class="flex items-center gap-3">
            <!-- Масове видалення -->
            {% if pagination|length > 0 %}
            <button type="button" 
                    onclick="openBulkDeleteModal()"
                    class="inline-flex items-center gap-2 px-4 py-2.5 bg-gradient-to-r from-red-500 to-rose-600 text-white rounded-xl hover:shadow-lg hover:scale-105 transition-all duration-300 disabled:opacity-50 disabled:cursor-not-allowed"
                    id="bulkDeleteBtn"
                    disabled>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                </svg>
                <span>Масове видалення</span>
                <span id="selectedCount" class="bg-white/20 px-2 py-0.5 rounded-full text-xs hidden">0</span>
            </button>
            {% endif %}
            
            <a href="{{ path('admin_blog_category_new') }}" 
               class="inline-flex items-center gap-2 px-4 py-2.5 bg-gradient-to-r from-blue-500 to-purple-600 text-white rounded-xl hover:shadow-lg hover:scale-105 transition-all duration-300">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                <span>Додати категорію</span>
            </a>
        </div>
    </div>

    {% if pagination|length > 0 %}
        <!-- Сітка категорій -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {% for category in pagination %}
                <div class="category-card bg-white dark:bg-gray-900 rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 border border-gray-200 dark:border-gray-800 overflow-hidden group" 
                     data-category-id="{{ category.id }}">
                    
                    <div class="p-6">
                        <!-- Заголовок з чекбоксом -->
                        <div class="flex items-start justify-between mb-4">
                            <div class="flex items-center gap-3">
                                <input type="checkbox" 
                                       class="category-checkbox w-5 h-5 rounded-lg border-2 border-gray-300 dark:border-gray-700 text-blue-600 focus:ring-blue-500 transition-all"
                                       value="{{ category.id }}"
                                       onchange="updateBulkDeleteButton()">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center">
                                        <span class="text-white font-bold text-lg">{{ category.name|first|upper }}</span>
                                    </div>
                                    <div>
                                        <h3 class="font-bold text-gray-900 dark:text-white text-lg">
                                            {{ category.name }}
                                            {% if not category.isActive %}
                                                <span class="ml-2 px-2 py-0.5 bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 text-xs rounded-full">
                                                    Неактивна
                                                </span>
                                            {% endif %}
                                        </h3>
                                        <div class="flex items-center gap-2 text-xs text-gray-500 dark:text-gray-400">
                                            <span>ID: {{ category.id }}</span>
                                            <span>•</span>
                                            <span>Порядок: {{ category.sortOrder }}</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Статус активності -->
                            <button onclick="toggleCategory({{ category.id }})" 
                                    class="toggle-active px-3 py-1 rounded-full text-xs font-medium transition-colors
                                           {% if category.isActive %}
                                               bg-green-100 dark:bg-green-900/30 text-green-600 dark:text-green-400 hover:bg-green-200 dark:hover:bg-green-800
                                           {% else %}
                                               bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 hover:bg-gray-200 dark:hover:bg-gray-700
                                           {% endif %}">
                                {{ category.isActive ? 'Активна' : 'Неактивна' }}
                            </button>
                        </div>
                        
                        <!-- Опис -->
                        {% if category.description %}
                            <p class="text-gray-600 dark:text-gray-400 text-sm mb-4 line-clamp-2">
                                {{ category.description }}
                            </p>
                        {% endif %}
                        
                        <!-- Slug -->
                        <div class="mb-4 p-2 bg-gray-50 dark:bg-gray-800 rounded-lg">
                            <span class="text-xs text-gray-500 dark:text-gray-400 block mb-1">Slug:</span>
                            <code class="text-sm text-blue-600 dark:text-blue-400 font-mono">{{ category.slug }}</code>
                        </div>
                        
                        <!-- Ієрархія -->
                        {% if category.parent %}
                            <div class="mb-4 flex items-center gap-2 text-sm">
                                <span class="text-gray-500 dark:text-gray-400">Батьківська:</span>
                                <span class="px-2 py-1 bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 rounded-lg text-xs">
                                    {{ category.parent.name }}
                                </span>
                            </div>
                        {% endif %}
                        
                        {% if category.blogCategories|length > 0 %}
                            <div class="mb-4">
                                <span class="text-sm text-gray-500 dark:text-gray-400 block mb-2">Підкатегорії:</span>
                                <div class="flex flex-wrap gap-2">
                                    {% for child in category.blogCategories %}
                                        <span class="px-2 py-1 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 rounded-lg text-xs">
                                            {{ child.name }}
                                        </span>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}
                        
                        <!-- Дії -->
                        <div class="flex items-center justify-between pt-4 border-t border-gray-200 dark:border-gray-800">
                            <div class="flex items-center gap-2">
                                <a href="{{ path('admin_blog_category_edit', {'id': category.id}) }}" 
                                   class="p-2 text-gray-500 hover:text-green-600 dark:hover:text-green-400 transition-colors"
                                   title="Редагувати">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                    </svg>
                                </a>
                            </div>
                            
                            {% if category.blogCategories|length == 0 %}
                                <form method="post" action="{{ path('admin_blog_category_delete', {'id': category.id}) }}" 
                                      onsubmit="return confirm('Ви впевнені, що хочете видалити цю категорію?');"
                                      class="inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ category.id) }}">
                                    <button type="submit" 
                                            class="p-2 text-gray-500 hover:text-red-600 dark:hover:text-red-400 transition-colors"
                                            title="Видалити">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                        </svg>
                                    </button>
                                </form>
                            {% else %}
                                <span class="p-2 text-gray-400 cursor-not-allowed" title="Неможливо видалити: категорія має підкатегорії">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>
                                    </svg>
                                </span>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
        
        <!-- Пагінація -->
        <div class="mt-8">
            {{ knp_pagination_render(pagination) }}
        </div>
    {% else %}
        <!-- Немає категорій -->
        <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-xl p-12 text-center border border-gray-200 dark:border-gray-800">
            <div class="w-24 h-24 mx-auto bg-gradient-to-br from-purple-500 to-pink-500 rounded-full flex items-center justify-center mb-6">
                <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-3">Ще немає категорій</h3>
            <p class="text-gray-600 dark:text-gray-400 mb-6 text-lg">Створіть першу категорію для блогів</p>
            <a href="{{ path('admin_blog_category_new') }}" 
               class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-blue-500 to-purple-600 text-white font-semibold rounded-xl hover:shadow-lg hover:scale-105 transition-all duration-300">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                <span>Створити категорію</span>
            </a>
        </div>
    {% endif %}
</div>

<!-- Модальне вікно для масового видалення -->
<div id="bulkDeleteModal" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 hidden items-center justify-center">
    <div class="bg-white dark:bg-gray-900 rounded-2xl max-w-md w-full mx-4 p-6" onclick="event.stopPropagation()">
        <div class="flex justify-between items-center mb-4">
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white flex items-center gap-2">
                <svg class="w-6 h-6 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                </svg>
                Масове видалення
            </h3>
            <button onclick="closeBulkDeleteModal()" class="text-gray-500 hover:text-gray-700 dark:hover:text-gray-300">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>
        
        <form id="bulkDeleteForm" method="post" action="{{ path('admin_blog_category_bulk_delete') }}">
            <div class="mb-4">
                <p class="text-gray-600 dark:text-gray-400 mb-3">
                    Ви впевнені, що хочете видалити <span id="bulkDeleteCount" class="font-semibold text-gray-900 dark:text-white">0</span> вибраних категорій?
                </p>
                <p class="text-sm text-amber-600 dark:text-amber-400 bg-amber-50 dark:bg-amber-900/20 p-3 rounded-lg">
                    <strong>Увага:</strong> Категорії, які мають підкатегорії, не будуть видалені.
                </p>
            </div>
            
            <div id="selectedCategoriesList" class="max-h-40 overflow-y-auto mb-4 p-3 bg-gray-50 dark:bg-gray-800 rounded-lg text-sm">
                <!-- Список вибраних категорій буде додано через JavaScript -->
            </div>
            
            <input type="hidden" name="_token" value="{{ csrf_token('bulk-delete') }}">
            
            <div class="flex gap-3">
                <button type="button" 
                        onclick="closeBulkDeleteModal()"
                        class="flex-1 px-4 py-3 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 font-semibold rounded-xl hover:bg-gray-200 dark:hover:bg-gray-700 transition-all duration-300">
                    Скасувати
                </button>
                <button type="submit" 
                        class="flex-1 px-4 py-3 bg-gradient-to-r from-red-500 to-rose-600 text-white font-semibold rounded-xl hover:shadow-lg hover:scale-105 transition-all duration-300">
                    Видалити
                </button>
            </div>
        </form>
    </div>
</div>

<!-- JavaScript -->
<script>
let selectedCategories = [];

function updateBulkDeleteButton() {
    const checkboxes = document.querySelectorAll('.category-checkbox:checked');
    const bulkBtn = document.getElementById('bulkDeleteBtn');
    const selectedSpan = document.getElementById('selectedCount');
    
    selectedCategories = Array.from(checkboxes).map(cb => ({
        id: cb.value,
        name: cb.closest('.category-card').querySelector('h3').textContent.trim().replace(/\s+\(.*\)$/, '')
    }));
    
    if (selectedCategories.length > 0) {
        bulkBtn.disabled = false;
        selectedSpan.textContent = selectedCategories.length;
        selectedSpan.classList.remove('hidden');
    } else {
        bulkBtn.disabled = true;
        selectedSpan.classList.add('hidden');
    }
}

function openBulkDeleteModal() {
    if (selectedCategories.length === 0) return;
    
    const modal = document.getElementById('bulkDeleteModal');
    const countSpan = document.getElementById('bulkDeleteCount');
    const listDiv = document.getElementById('selectedCategoriesList');
    
    countSpan.textContent = selectedCategories.length;
    
    // Показуємо список вибраних категорій
    listDiv.innerHTML = '<p class="font-medium mb-2">Вибрані категорії:</p>' + 
        selectedCategories.map(c => 
            `<div class="flex items-center gap-2 py-1">
                <span class="w-2 h-2 bg-blue-500 rounded-full"></span>
                <span>${c.name}</span>
            </div>`
        ).join('');
    
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
}

function closeBulkDeleteModal() {
    const modal = document.getElementById('bulkDeleteModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = 'auto';
}

function toggleCategory(categoryId) {
    fetch(`/admin/blog/categories/${categoryId}/toggle`, {
        method: 'POST',
        headers: {
            'X-Requested-With': 'XMLHttpRequest',
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            location.reload();
        }
    });
}

// Закриття по Escape
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        closeBulkDeleteModal();
    }
});

// Закриття по кліку на фон
document.getElementById('bulkDeleteModal').addEventListener('click', function(e) {
    if (e.target === this) {
        closeBulkDeleteModal();
    }
});

// Анімація появи
document.addEventListener('DOMContentLoaded', function() {
    const cards = document.querySelectorAll('.category-card');
    cards.forEach((card, index) => {
        setTimeout(() => {
            card.classList.add('animate-fade-in');
        }, index * 100);
    });
});
</script>

<!-- Стилі -->
<style>
@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.animate-fade-in {
    animation: fadeIn 0.5s ease-out forwards;
}

.line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

/* Стилі для пагінації */
.pagination {
    @apply flex items-center gap-2;
}

.pagination li {
    @apply inline-block;
}

.pagination a, .pagination span {
    @apply px-4 py-2 bg-white dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors;
}

.pagination .active span {
    @apply bg-gradient-to-r from-blue-500 to-purple-600 text-white border-transparent;
}

.pagination .disabled span {
    @apply opacity-50 cursor-not-allowed;
}
</style>
{% endblock %}