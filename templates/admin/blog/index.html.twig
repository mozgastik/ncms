{% extends 'admin/base.html.twig' %}

{% block title %}Управління блогами{% endblock %}

{% block body %}
<div class="p-4 sm:p-6 lg:p-8">
    <!-- Заголовок і хлібні крихти -->
    <div class="mb-6">
        <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white">Управління блогами</h1>
        <nav class="flex mt-2" aria-label="Breadcrumb">
            <ol class="inline-flex items-center space-x-1 md:space-x-3">
                <li class="inline-flex items-center">
                    <a href="{{ path('admin_dashboard') }}" class="inline-flex items-center text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                        </svg>
                        Головна
                    </a>
                </li>
                <li aria-current="page">
                    <div class="flex items-center">
                        <svg class="w-4 h-4 text-gray-400 dark:text-gray-600 mx-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                        <span class="text-sm font-medium text-gray-500 dark:text-gray-400">Блоги</span>
                    </div>
                </li>
            </ol>
        </nav>
    </div>

    <!-- Статистика -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        <!-- Всього блогів -->
        <div class="bg-gradient-to-r from-blue-500 to-blue-600 dark:from-blue-600 dark:to-blue-700 rounded-xl shadow-lg overflow-hidden transform hover:scale-[1.02] transition-all duration-300">
            <div class="p-5">
                <div class="flex justify-between items-center">
                    <div>
                        <p class="text-blue-100 dark:text-blue-200 text-sm font-medium">Всього блогів</p>
                        <p class="text-white text-2xl font-bold mt-1">{{ stats.total }}</p>
                    </div>
                    <div class="bg-blue-400/20 dark:bg-blue-500/20 p-3 rounded-lg backdrop-blur-sm">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
                        </svg>
                    </div>
                </div>
            </div>
            <a href="{{ path('admin_blog_index') }}" class="block bg-blue-600 dark:bg-blue-700 hover:bg-blue-700 dark:hover:bg-blue-800 transition-colors px-5 py-3 text-center text-white text-sm font-medium">
                <div class="flex items-center justify-center gap-2">
                    <span>Переглянути</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                </div>
            </a>
        </div>

        <!-- Опубліковано -->
        <div class="bg-gradient-to-r from-green-500 to-green-600 dark:from-green-600 dark:to-green-700 rounded-xl shadow-lg overflow-hidden transform hover:scale-[1.02] transition-all duration-300">
            <div class="p-5">
                <div class="flex justify-between items-center">
                    <div>
                        <p class="text-green-100 dark:text-green-200 text-sm font-medium">Опубліковано</p>
                        <p class="text-white text-2xl font-bold mt-1">{{ stats.published }}</p>
                    </div>
                    <div class="bg-green-400/20 dark:bg-green-500/20 p-3 rounded-lg backdrop-blur-sm">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                    </div>
                </div>
            </div>
            <a href="{{ path('admin_blog_index', {'status': 'published'}) }}" class="block bg-green-600 dark:bg-green-700 hover:bg-green-700 dark:hover:bg-green-800 transition-colors px-5 py-3 text-center text-white text-sm font-medium">
                <div class="flex items-center justify-center gap-2">
                    <span>Переглянути</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                </div>
            </a>
        </div>

        <!-- На модерації -->
        <div class="bg-gradient-to-r from-yellow-500 to-yellow-600 dark:from-yellow-600 dark:to-yellow-700 rounded-xl shadow-lg overflow-hidden transform hover:scale-[1.02] transition-all duration-300">
            <div class="p-5">
                <div class="flex justify-between items-center">
                    <div>
                        <p class="text-yellow-100 dark:text-yellow-200 text-sm font-medium">На модерації</p>
                        <p class="text-white text-2xl font-bold mt-1">{{ stats.pending }}</p>
                    </div>
                    <div class="bg-yellow-400/20 dark:bg-yellow-500/20 p-3 rounded-lg backdrop-blur-sm">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                    </div>
                </div>
            </div>
            <a href="{{ path('admin_blog_moderation') }}" class="block bg-yellow-600 dark:bg-yellow-700 hover:bg-yellow-700 dark:hover:bg-yellow-800 transition-colors px-5 py-3 text-center text-white text-sm font-medium">
                <div class="flex items-center justify-center gap-2">
                    <span>Перевірити</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                </div>
            </a>
        </div>

        <!-- Відхилено -->
        <div class="bg-gradient-to-r from-red-500 to-red-600 dark:from-red-600 dark:to-red-700 rounded-xl shadow-lg overflow-hidden transform hover:scale-[1.02] transition-all duration-300">
            <div class="p-5">
                <div class="flex justify-between items-center">
                    <div>
                        <p class="text-red-100 dark:text-red-200 text-sm font-medium">Відхилено</p>
                        <p class="text-white text-2xl font-bold mt-1">{{ stats.rejected }}</p>
                    </div>
                    <div class="bg-red-400/20 dark:bg-red-500/20 p-3 rounded-lg backdrop-blur-sm">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                    </div>
                </div>
            </div>
            <a href="{{ path('admin_blog_index', {'status': 'rejected'}) }}" class="block bg-red-600 dark:bg-red-700 hover:bg-red-700 dark:hover:bg-red-800 transition-colors px-5 py-3 text-center text-white text-sm font-medium">
                <div class="flex items-center justify-center gap-2">
                    <span>Переглянути</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                </div>
            </a>
        </div>
    </div>

    <!-- Панель дій -->
    <div class="bg-white dark:bg-gray-900 rounded-xl shadow-lg overflow-hidden mb-6 border border-gray-200 dark:border-gray-800">
        <!-- Заголовок панелі -->
        <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-800">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div class="flex items-center">
                    <svg class="w-5 h-5 text-gray-500 dark:text-gray-400 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M3 14h18M3 18h18M3 6h18"/>
                    </svg>
                    <h2 class="text-lg font-semibold text-gray-800 dark:text-white">Всі блоги</h2>
                </div>
                <div class="flex flex-wrap gap-2">
                    <a href="{{ path('admin_blog_moderation') }}" class="inline-flex items-center px-4 py-2 bg-yellow-500 hover:bg-yellow-600 dark:bg-yellow-600 dark:hover:bg-yellow-700 text-white font-medium rounded-lg transition-colors shadow-md hover:shadow-lg transform hover:scale-105 duration-300">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        Модерація ({{ stats.pending }})
                    </a>
                    
                    <a href="{{ path('admin_blog_comments_index') }}" class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-blue-500 to-indigo-600 hover:from-blue-600 hover:to-indigo-700 dark:from-blue-600 dark:to-indigo-700 text-white font-medium rounded-xl shadow-md hover:shadow-lg transform hover:scale-105 transition-all duration-300">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                        </svg>
                        <span>Коментарі</span>
                        {% if stats.pending is defined and stats.pending > 0 %}
                            <span class="ml-2 px-2 py-0.5 bg-white/20 text-white text-xs rounded-full">
                                {{ stats.pending }}
                            </span>
                        {% endif %}
                    </a>

                    <a href="{{ path('admin_blog_stats') }}" class="inline-flex items-center px-4 py-2 bg-blue-500 hover:bg-blue-600 dark:bg-blue-600 dark:hover:bg-blue-700 text-white font-medium rounded-lg transition-colors shadow-md hover:shadow-lg transform hover:scale-105 duration-300">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                        </svg>
                        Статистика
                    </a>

                    <a href="{{ path('admin_blog_category_index') }}" class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-green-500 to-emerald-600 hover:from-green-600 hover:to-emerald-700 dark:from-green-600 dark:to-emerald-700 text-white font-medium rounded-xl shadow-md hover:shadow-lg transform hover:scale-105 transition-all duration-300">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
                        </svg>
                        Категорії
                    </a>

                    {% if path('admin_blog_tags') is defined %}
                        <a href="{{ path('admin_blog_tags') }}" class="inline-flex items-center px-4 py-2 bg-gray-500 hover:bg-gray-600 dark:bg-gray-600 dark:hover:bg-gray-700 text-white font-medium rounded-lg transition-colors shadow-md hover:shadow-lg transform hover:scale-105 duration-300">
                            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l5 5a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-5-5A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
                            </svg>
                            Теги
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Фільтри -->
        <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-800/50">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <!-- Статус -->
                <div>
                    <select id="statusFilter" class="w-full px-3 py-2 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-lg text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors">
                        <option value="">Всі статуси</option>
                        <option value="draft">Чернетки</option>
                        <option value="pending">На модерації</option>
                        <option value="published">Опубліковані</option>
                        <option value="rejected">Відхилені</option>
                    </select>
                </div>

                <!-- Пошук -->
                <div>
                    <div class="relative">
                        <input type="text" id="searchInput" placeholder="Пошук за заголовком..." 
                               class="w-full pl-10 pr-3 py-2 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-lg text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors">
                        <svg class="w-5 h-5 absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                        </svg>
                    </div>
                </div>

                <!-- Дата -->
                <div>
                    <div class="flex gap-2">
                        <input type="date" id="dateFilter" 
                               class="flex-1 px-3 py-2 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-lg text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors">
                        <button id="clearFilters" class="px-3 py-2 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors group">
                            <svg class="w-5 h-5 text-gray-600 dark:text-gray-400 group-hover:text-gray-900 dark:group-hover:text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                            </svg>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Контент -->
        <div class="p-6">
            <!-- Таблиця -->
            <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-800">
                <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-800" id="blogsTable">
                    <thead class="bg-gray-50 dark:bg-gray-800/80">
                        <tr>
                            <th class="w-12 px-4 py-3">
                                <input type="checkbox" id="selectAll" class="w-4 h-4 text-blue-600 bg-white dark:bg-gray-900 border-gray-300 dark:border-gray-700 rounded focus:ring-blue-500">
                            </th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Заголовок</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Автор</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Статус</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Переглядів</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Дата</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Дії</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white dark:bg-gray-900 divide-y divide-gray-200 dark:divide-gray-800">
                        {% for post in pagination %}
                            <tr class="hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors" 
                                data-status="{{ post.status }}" 
                                data-date="{{ post.createdAt|date('Y-m-d') }}" 
                                data-title="{{ post.title|lower }}">
                                
                                <!-- Чекбокс -->
                                <td class="px-4 py-4">
                                    <input type="checkbox" value="{{ post.id }}" 
                                           class="blog-checkbox w-4 h-4 text-blue-600 bg-white dark:bg-gray-900 border-gray-300 dark:border-gray-700 rounded focus:ring-blue-500">
                                </td>

                                <!-- Заголовок -->
                                <td class="px-4 py-4">
                                    <div class="flex items-center gap-3">
                                        {% if post.images|length > 0 %}
                                            <div class="flex-shrink-0">
                                                <img src="{{ asset('uploads/blogs/' ~ post.images.first.filename) }}" 
                                                     class="w-10 h-10 rounded-lg object-cover ring-2 ring-gray-200 dark:ring-gray-800"
                                                     alt="{{ post.title }}">
                                            </div>
                                        {% else %}
                                            <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-gradient-to-br from-gray-200 to-gray-300 dark:from-gray-700 dark:to-gray-800 flex items-center justify-center">
                                                <svg class="w-5 h-5 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a1 1 0 01-1-1V5a1 1 0 011-1h14a1 1 0 011 1v14a1 1 0 01-1 1zM7 8v8h10V8H7z"/>
                                                </svg>
                                            </div>
                                        {% endif %}
                                        <div class="min-w-0">
                                            <p class="font-medium text-gray-900 dark:text-white truncate max-w-xs">
                                                {{ post.title|slice(0, 60) }}{% if post.title|length > 60 %}...{% endif %}
                                            </p>
                                            <div class="flex flex-wrap gap-1 mt-1">
                                                {% if post.category %}
                                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 dark:bg-blue-900/30 text-blue-800 dark:text-blue-300">
                                                        {{ post.category.name }}
                                                    </span>
                                                {% endif %}
                                                {% if post.isFeatured %}
                                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-yellow-100 dark:bg-yellow-900/30 text-yellow-800 dark:text-yellow-300">
                                                        <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
                                                        </svg>
                                                        Рекомендовано
                                                    </span>
                                                {% endif %}
                                                {% if post.isBreaking %}
                                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 dark:bg-red-900/30 text-red-800 dark:text-red-300">
                                                        <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                                                        </svg>
                                                        Новина
                                                    </span>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Автор -->
                                <td class="px-4 py-4">
                                    <div class="flex items-center gap-2">
                                        <div class="flex-shrink-0">
                                            <div class="w-8 h-8 rounded-full bg-gradient-to-r from-blue-400 to-blue-600 dark:from-blue-500 dark:to-blue-700 flex items-center justify-center text-white text-xs font-medium shadow-md">
                                                {{ post.author.username|first|upper }}
                                            </div>
                                        </div>
                                        <span class="text-sm text-gray-900 dark:text-white">{{ post.author.username }}</span>
                                    </div>
                                </td>

                                <!-- Статус -->
                                <td class="px-4 py-4">
                                    {% set statusClasses = {
                                        'published': 'bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-300',
                                        'pending': 'bg-yellow-100 dark:bg-yellow-900/30 text-yellow-800 dark:text-yellow-300',
                                        'draft': 'bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-300',
                                        'rejected': 'bg-red-100 dark:bg-red-900/30 text-red-800 dark:text-red-300'
                                    } %}
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium {{ statusClasses[post.status] }}">
                                        {% if post.status == 'draft' %}
                                            Чернетка
                                        {% elseif post.status == 'pending' %}
                                            На модерації
                                        {% elseif post.status == 'published' %}
                                            Опубліковано
                                        {% else %}
                                            Відхилено
                                        {% endif %}
                                    </span>
                                </td>

                                <!-- Статистика -->
                                <td class="px-4 py-4">
                                    <div class="flex items-center gap-4">
                                        <div class="flex items-center gap-1">
                                            <svg class="w-4 h-4 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
