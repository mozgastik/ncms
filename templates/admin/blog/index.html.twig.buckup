{% extends 'admin/base.html.twig' %}

{% block title %}Управління блогами{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <h1 class="mt-4">Управління блогами</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="{{ path('admin_dashboard') }}">Головна</a></li>
        <li class="breadcrumb-item active">Блоги</li>
    </ol>

    <!-- Статистика -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card bg-primary text-white mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fs-5 fw-bold">{{ stats.total }}</div>
                            <div>Всього блогів</div>
                        </div>
                        <i class="fas fa-blog fa-2x"></i>
                    </div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                    <a class="small text-white stretched-link" href="{{ path('admin_blog_index') }}">Переглянути</a>
                    <div class="small text-white"><i class="fas fa-angle-right"></i></div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-success text-white mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fs-5 fw-bold">{{ stats.published }}</div>
                            <div>Опубліковано</div>
                        </div>
                        <i class="fas fa-check-circle fa-2x"></i>
                    </div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                    <a class="small text-white stretched-link" href="{{ path('admin_blog_index', {'status': 'published'}) }}">Переглянути</a>
                    <div class="small text-white"><i class="fas fa-angle-right"></i></div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-warning text-white mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fs-5 fw-bold">{{ stats.pending }}</div>
                            <div>На модерації</div>
                        </div>
                        <i class="fas fa-hourglass-half fa-2x"></i>
                    </div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                    <a class="small text-white stretched-link" href="{{ path('admin_blog_moderation') }}">Перевірити</a>
                    <div class="small text-white"><i class="fas fa-angle-right"></i></div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-danger text-white mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fs-5 fw-bold">{{ stats.rejected }}</div>
                            <div>Відхилено</div>
                        </div>
                        <i class="fas fa-times-circle fa-2x"></i>
                    </div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                    <a class="small text-white stretched-link" href="{{ path('admin_blog_index', {'status': 'rejected'}) }}">Переглянути</a>
                    <div class="small text-white"><i class="fas fa-angle-right"></i></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Панель дій -->
    <div class="card mb-4">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <i class="fas fa-table me-1"></i>
                    <strong>Всі блоги</strong>
                </div>
                <div class="btn-group">
                    <a href="{{ path('admin_blog_moderation') }}" class="btn btn-warning">
                        <i class="fas fa-hourglass-half me-2"></i>Модерація ({{ stats.pending }})
                    </a>
                    <a href="{{ path('admin_blog_stats') }}" class="btn btn-info">
                        <i class="fas fa-chart-bar me-2"></i>Статистика
                    </a>
                    <a href="{{ path('admin_blog_categories') }}" class="btn btn-secondary">
                        <i class="fas fa-folder me-2"></i>Категорії
                    </a>
                    <a href="{{ path('admin_blog_tags') }}" class="btn btn-secondary">
                        <i class="fas fa-tags me-2"></i>Теги
                    </a>
                </div>
            </div>
        </div>
        <div class="card-body">
            <!-- Фільтри -->
            <div class="row mb-3">
                <div class="col-md-4">
                    <select class="form-select" id="statusFilter">
                        <option value="">Всі статуси</option>
                        <option value="draft">Чернетки</option>
                        <option value="pending">На модерації</option>
                        <option value="published">Опубліковані</option>
                        <option value="rejected">Відхилені</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <input type="text" class="form-control" id="searchInput" placeholder="Пошук за заголовком...">
                </div>
                <div class="col-md-4">
                    <div class="input-group">
                        <input type="date" class="form-control" id="dateFilter">
                        <button class="btn btn-outline-secondary" type="button" id="clearFilters">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Таблиця блогів -->
            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="blogsTable">
                    <thead>
                        <tr>
                            <th width="40">
                                <input type="checkbox" id="selectAll">
                            </th>
                            <th>Заголовок</th>
                            <th>Автор</th>
                            <th>Статус</th>
                            <th>Переглядів</th>
                            <th>Дата</th>
                            <th>Дії</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for post in pagination %}
                            <tr data-status="{{ post.status }}" data-date="{{ post.createdAt|date('Y-m-d') }}" data-title="{{ post.title|lower }}">
                                <td>
                                    <input type="checkbox" class="blog-checkbox" value="{{ post.id }}">
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        {% if post.images|length > 0 %}
                                            <div class="flex-shrink-0 me-2">
                                                <img src="{{ asset('uploads/blogs/' ~ post.images.first.filename) }}" 
                                                     class="rounded" 
                                                     width="40" 
                                                     height="40"
                                                     alt=""
                                                     style="object-fit: cover;">
                                            </div>
                                        {% endif %}
                                        <div class="flex-grow-1">
                                            <strong>{{ post.title|slice(0, 60) }}{% if post.title|length > 60 %}...{% endif %}</strong>
                                            <div class="small text-muted">
                                                {% if post.category %}
                                                    <span class="badge bg-light text-dark">{{ post.category.name }}</span>
                                                {% endif %}
                                                {% if post.isFeatured %}
                                                    <span class="badge bg-warning">Рекомендовано</span>
                                                {% endif %}
                                                {% if post.isBreaking %}
                                                    <span class="badge bg-danger">Новина</span>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="flex-shrink-0 me-2">
                                            <img src="https://ui-avatars.com/api/?name={{ post.author.username }}" 
                                                 class="rounded-circle" 
                                                 width="30" 
                                                 height="30"
                                                 alt="{{ post.author.username }}">
                                        </div>
                                        <div class="flex-grow-1">
                                            {{ post.author.username }}
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-{{ post.status == 'published' ? 'success' : (post.status == 'pending' ? 'warning' : (post.status == 'rejected' ? 'danger' : 'secondary')) }}">
                                        {{ post.status == 'draft' ? 'Чернетка' : 
                                           (post.status == 'pending' ? 'На модерації' : 
                                           (post.status == 'published' ? 'Опубліковано' : 'Відхилено')) }}
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <i class="fas fa-eye me-1 text-muted"></i>
                                        {{ post.viewCount }}
                                        <i class="fas fa-thumbs-up ms-3 me-1 text-muted"></i>
                                        {{ post.getLikeCount() }}
                                    </div>
                                </td>
                                <td>
                                    <div class="small">
                                        {{ post.createdAt|date('d.m.Y') }}<br>
                                        <span class="text-muted">{{ post.createdAt|date('H:i') }}</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a href="{{ path('blog_show', {'slug': post.slug}) }}" 
                                           target="_blank" 
                                           class="btn btn-outline-success" 
                                           title="Переглянути на сайті">
                                            <i class="fas fa-external-link-alt"></i>
                                        </a>
                                        <a href="{{ path('admin_blog_review', {'id': post.id}) }}" 
                                           class="btn btn-outline-warning" 
                                           title="Модерація">
                                            <i class="fas fa-gavel"></i>
                                        </a>
                                        <button type="button" 
                                                class="btn btn-outline-info dropdown-toggle" 
                                                data-bs-toggle="dropdown"
                                                title="Швидкі дії">
                                            <i class="fas fa-cog"></i>
                                        </button>
                                        <ul class="dropdown-menu">
                                            {% if post.status == 'published' %}
                                                <li>
                                                    <a class="dropdown-item" href="#" onclick="togglePublish({{ post.id }})">
                                                        <i class="fas fa-eye-slash me-2"></i>Приховати
                                                    </a>
                                                </li>
                                            {% else %}
                                                <li>
                                                    <a class="dropdown-item" href="#" onclick="togglePublish({{ post.id }})">
                                                        <i class="fas fa-eye me-2"></i>Опублікувати
                                                    </a>
                                                </li>
                                            {% endif %}
                                            <li>
                                                <a class="dropdown-item" href="#" onclick="toggleFeature({{ post.id }})">
                                                    <i class="fas fa-star me-2"></i>
                                                    {{ post.isFeatured ? 'Зняти рекомендацію' : 'Рекомендувати' }}
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item" href="#" onclick="toggleBreaking({{ post.id }})">
                                                    <i class="fas fa-bolt me-2"></i>
                                                    {{ post.isBreaking ? 'Зняти новину' : 'Позначити новиною' }}
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <button type="button" 
                                                        class="dropdown-item text-danger" 
                                                        data-bs-toggle="modal" 
                                                        data-bs-target="#deleteModal{{ post.id }}">
                                                    <i class="fas fa-trash me-2"></i>Видалити
                                                </button>
                                            </li>
                                        </ul>
                                    </div>

                                    <!-- Модальне вікно для видалення -->
                                    <div class="modal fade" id="deleteModal{{ post.id }}" tabindex="-1">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title">Видалити блог</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <p>Видалити блог <strong>"{{ post.title }}"</strong>?</p>
                                                    <p class="text-danger">
                                                        <i class="fas fa-exclamation-triangle me-2"></i>
                                                        Будуть видалені всі коментарі, зображення та статистика.
                                                    </p>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Скасувати</button>
                                                    <form method="post" action="{{ path('admin_blog_delete', {'id': post.id}) }}">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ post.id) }}">
                                                        <button type="submit" class="btn btn-danger">
                                                            <i class="fas fa-trash me-2"></i>Видалити
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" class="text-center py-4">
                                    <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                                    <h5>Блогів не знайдено</h5>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <!-- Пагінація -->
            <div class="d-flex justify-content-between align-items-center mt-3">
                <div>
                    <div class="btn-group" id="bulkActions">
                        <button type="button" class="btn btn-outline-secondary" disabled>
                            <span id="selectedCount">0</span> вибрано
                        </button>
                        <button type="button" class="btn btn-outline-success" onclick="bulkAction('approve')">
                            <i class="fas fa-check me-2"></i>Схвалити
                        </button>
                        <button type="button" class="btn btn-outline-danger" onclick="bulkAction('reject')">
                            <i class="fas fa-times me-2"></i>Відхилити
                        </button>
                        <button type="button" class="btn btn-outline-warning" onclick="bulkAction('feature')">
                            <i class="fas fa-star me-2"></i>Рекомендувати
                        </button>
                        <button type="button" class="btn btn-outline-dark" onclick="bulkAction('delete')">
                            <i class="fas fa-trash me-2"></i>Видалити
                        </button>
                    </div>
                </div>
                <div>
                    {{ knp_pagination_render(pagination) }}
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Додаткові скрипти -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Фільтрація
    const statusFilter = document.getElementById('statusFilter');
    const searchInput = document.getElementById('searchInput');
    const dateFilter = document.getElementById('dateFilter');
    const clearFilters = document.getElementById('clearFilters');
    const blogsTable = document.getElementById('blogsTable');
    const rows = blogsTable.querySelectorAll('tbody tr');

    function filterRows() {
        const status = statusFilter.value;
        const search = searchInput.value.toLowerCase();
        const date = dateFilter.value;

        rows.forEach(row => {
            const rowStatus = row.getAttribute('data-status');
            const rowTitle = row.getAttribute('data-title');
            const rowDate = row.getAttribute('data-date');

            let show = true;

            if (status && rowStatus !== status) {
                show = false;
            }

            if (search && !rowTitle.includes(search)) {
                show = false;
            }

            if (date && rowDate !== date) {
                show = false;
            }

            row.style.display = show ? '' : 'none';
        });
    }

    statusFilter.addEventListener('change', filterRows);
    searchInput.addEventListener('input', filterRows);
    dateFilter.addEventListener('change', filterRows);
    clearFilters.addEventListener('click', function() {
        statusFilter.value = '';
        searchInput.value = '';
        dateFilter.value = '';
        filterRows();
    });

    // Масове виділення
    const selectAll = document.getElementById('selectAll');
    const checkboxes = document.querySelectorAll('.blog-checkbox');
    const selectedCount = document.getElementById('selectedCount');

    function updateSelectedCount() {
        const selected = document.querySelectorAll('.blog-checkbox:checked').length;
        selectedCount.textContent = selected;
        
        // Активуємо/деактивуємо кнопки масових дій
        const bulkActionButtons = document.querySelectorAll('#bulkActions button:not(:first-child)');
        bulkActionButtons.forEach(button => {
            button.disabled = selected === 0;
        });
    }

    selectAll.addEventListener('change', function() {
        checkboxes.forEach(checkbox => {
            checkbox.checked = this.checked;
        });
        updateSelectedCount();
    });

    checkboxes.forEach(checkbox => {
        checkbox.addEventListener('change', updateSelectedCount);
    });

    // Відміна виділення всіх, якщо зняли один чекбокс
    checkboxes.forEach(checkbox => {
        checkbox.addEventListener('change', function() {
            if (!this.checked) {
                selectAll.checked = false;
            }
        });
    });
});

// AJAX функції
async function togglePublish(postId) {
    if (confirm('Змінити статус публікації?')) {
        try {
            const response = await fetch(`/admin/blog/${postId}/toggle-publish`, {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });
            
            const data = await response.json();
            
            if (data.success) {
                location.reload();
            } else {
                alert('Помилка: ' + data.message);
            }
        } catch (error) {
            alert('Помилка мережі');
        }
    }
}

async function toggleFeature(postId) {
    try {
        const response = await fetch(`/admin/blog/${postId}/feature`, {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        });
        
        const data = await response.json();
        
        if (data.success) {
            location.reload();
        } else {
            alert('Помилка: ' + data.message);
        }
    } catch (error) {
        alert('Помилка мережі');
    }
}

async function toggleBreaking(postId) {
    try {
        const response = await fetch(`/admin/blog/${postId}/breaking`, {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        });
        
        const data = await response.json();
        
        if (data.success) {
            location.reload();
        } else {
            alert('Помилка: ' + data.message);
        }
    } catch (error) {
        alert('Помилка мережі');
    }
}

async function bulkAction(action) {
    const selectedIds = [];
    document.querySelectorAll('.blog-checkbox:checked').forEach(checkbox => {
        selectedIds.push(checkbox.value);
    });

    if (selectedIds.length === 0) {
        alert('Виберіть хоча б один блог');
        return;
    }

    let confirmMessage = '';
    switch (action) {
        case 'approve':
            confirmMessage = `Схвалити ${selectedIds.length} блогів?`;
            break;
        case 'reject':
            confirmMessage = `Відхилити ${selectedIds.length} блогів?`;
            break;
        case 'feature':
            confirmMessage = `Додати ${selectedIds.length} блогів до рекомендованих?`;
            break;
        case 'delete':
            confirmMessage = `Видалити ${selectedIds.length} блогів назавжди?`;
            break;
    }

    if (!confirm(confirmMessage + '\n\nЦю дію неможливо скасувати.')) {
        return;
    }

    try {
        const response = await fetch('/admin/blog/bulk-actions', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: new URLSearchParams({
                'ids': selectedIds,
                'action': action
            })
        });
        
        const data = await response.json();
        
        if (data.success) {
            alert(data.message);
            location.reload();
        } else {
            alert('Помилка: ' + (data.error || 'Невідома помилка'));
        }
    } catch (error) {
        alert('Помилка мережі');
    }
}
</script>
{% endblock %}