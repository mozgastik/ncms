{% extends 'admin/base.html.twig' %}

{% block title %}Модерація блогів | Адмін-панель{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Заголовок -->
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white flex items-center gap-3">
            <span class="bg-gradient-to-br from-yellow-500 to-orange-500 p-2 rounded-xl shadow-lg">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
            </span>
            Модерація блогів
        </h1>
        
        <!-- Хлібні крихти -->
        <nav class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 mt-2">
            <a href="{{ path('admin_dashboard') }}" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
                Головна
            </a>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
            <a href="{{ path('admin_blog_index') }}" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
                Блоги
            </a>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
            <span class="text-gray-700 dark:text-gray-300 font-medium">Модерація</span>
        </nav>
    </div>

    {% if pagination|length > 0 %}
        <!-- Інструкція для модераторів -->
        <div class="mb-8 bg-gradient-to-r from-yellow-50 to-amber-50 dark:from-yellow-900/20 dark:to-amber-900/20 border border-yellow-200 dark:border-yellow-800 rounded-2xl p-6 shadow-lg">
            <div class="flex gap-4">
                <div class="flex-shrink-0">
                    <div class="w-12 h-12 rounded-xl bg-yellow-100 dark:bg-yellow-900/30 flex items-center justify-center">
                        <svg class="w-6 h-6 text-yellow-600 dark:text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                    </div>
                </div>
                <div class="flex-1">
                    <h5 class="text-lg font-bold text-gray-900 dark:text-white mb-3">Інструкція для модераторів</h5>
                    <p class="text-gray-600 dark:text-gray-400 mb-3">Перевіряйте блоги на відповідність таким критеріям:</p>
                    <ul class="grid grid-cols-1 md:grid-cols-2 gap-2 text-sm text-gray-600 dark:text-gray-400">
                        <li class="flex items-center gap-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-yellow-500"></span>
                            Відсутність образливого або забороненого контенту
                        </li>
                        <li class="flex items-center gap-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-yellow-500"></span>
                            Дотримання авторських прав
                        </li>
                        <li class="flex items-center gap-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-yellow-500"></span>
                            Наявність корисного та якісного контенту
                        </li>
                        <li class="flex items-center gap-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-yellow-500"></span>
                            Відсутність реклами без дозволу
                        </li>
                        <li class="flex items-center gap-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-yellow-500"></span>
                            Відповідність тематиці сайту
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Список блогів на модерацію -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            {% for post in pagination %}
                <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-lg border-l-4 border-yellow-500 overflow-hidden hover:shadow-xl transition-all duration-300">
                    <!-- Заголовок картки -->
                    <div class="bg-gradient-to-r from-yellow-500 to-yellow-600 px-6 py-4 flex justify-between items-center">
                        <div class="flex items-center gap-2">
                            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                            <span class="font-bold text-white">Очікує модерації</span>
                        </div>
                        <span class="text-sm text-white/90 bg-white/20 px-3 py-1 rounded-full">
                            {{ post.createdAt|date('d.m.Y H:i') }}
                        </span>
                    </div>
                    
                    <!-- Тіло картки -->
                    <div class="p-6">
                        <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3 line-clamp-2">
                            {{ post.title }}
                        </h3>
                        
                        {% if post.excerpt %}
                            <p class="text-gray-600 dark:text-gray-400 mb-4 line-clamp-3">
                                {{ post.excerpt|slice(0, 200) }}{% if post.excerpt|length > 200 %}...{% endif %}
                            </p>
                        {% endif %}
                        
                        <!-- Статистика -->
                        <div class="grid grid-cols-3 gap-3 mb-4">
                            <div class="bg-gray-50 dark:bg-gray-800 rounded-xl p-3 text-center">
                                <div class="text-xl font-bold text-gray-900 dark:text-white">{{ post.readingTime }}</div>
                                <div class="text-xs text-gray-500 dark:text-gray-400">Хв читання</div>
                            </div>
                            <div class="bg-gray-50 dark:bg-gray-800 rounded-xl p-3 text-center">
                                <div class="text-xl font-bold text-gray-900 dark:text-white">{{ post.content|length }}</div>
                                <div class="text-xs text-gray-500 dark:text-gray-400">Символів</div>
                            </div>
                            <div class="bg-gray-50 dark:bg-gray-800 rounded-xl p-3 text-center">
                                <div class="text-xl font-bold text-gray-900 dark:text-white">{{ post.images|length }}</div>
                                <div class="text-xs text-gray-500 dark:text-gray-400">Зображень</div>
                            </div>
                        </div>
                        
                        <!-- Інформація про автора -->
                        <div class="flex items-center justify-between mb-4 p-3 bg-gray-50 dark:bg-gray-800 rounded-xl">
                            <div class="flex items-center gap-3">
                                <img src="https://ui-avatars.com/api/?name={{ post.author.username }}&background=3b82f6&color=fff&bold=true" 
                                     class="w-10 h-10 rounded-full ring-2 ring-blue-500"
                                     alt="{{ post.author.username }}">
                                <div>
                                    <div class="font-semibold text-gray-900 dark:text-white">{{ post.author.username }}</div>
                                    <div class="text-xs text-gray-500 dark:text-gray-400">
                                        {{ post.author.blogPosts|filter(p => p.isPublished())|length }} блогів
                                    </div>
                                </div>
                            </div>
                            
                            {% if post.category %}
                                <span class="px-3 py-1 bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 text-xs font-medium rounded-full">
                                    {{ post.category.name }}
                                </span>
                            {% endif %}
                        </div>
                        
                        <!-- Теги -->
                        {% if post.tags|length > 0 %}
                            <div class="mb-4">
                                <div class="flex flex-wrap gap-2">
                                    {% for tag in post.tags %}
                                        <span class="px-3 py-1 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 text-xs rounded-full">
                                            #{{ tag.name }}
                                        </span>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}
                        
                        <!-- Прев'ю зображень -->
                        {% if post.images|length > 0 %}
                            <div class="mb-4">
                                <div class="flex items-center gap-2 mb-2">
                                    <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                    </svg>
                                    <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Зображення</span>
                                </div>
                                <div class="flex flex-wrap gap-2">
                                    {% for image in post.images|slice(0, 3) %}
                                        <div class="relative group">
                                            <img src="{{ asset('uploads/blogs/' ~ image.filename) }}" 
                                                 class="w-20 h-20 rounded-lg object-cover cursor-pointer hover:scale-110 transition-transform duration-300"
                                                 alt=""
                                                 onclick="openImageModal('{{ asset('uploads/blogs/' ~ image.filename) }}', '{{ image.altText|default('') }}', '{{ image.caption|default('') }}')">
                                            <div class="absolute inset-0 bg-black/50 rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                                                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                                                </svg>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}
                        
                        <!-- Кнопки дій -->
                        <div class="flex flex-col gap-2 mt-4">
                            <a href="{{ path('admin_blog_review', {'id': post.id}) }}" 
                               class="inline-flex items-center justify-center gap-2 px-4 py-3 bg-gradient-to-r from-blue-500 to-purple-600 text-white font-semibold rounded-xl hover:shadow-lg hover:scale-[1.02] transition-all duration-300">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                                <span>Перевірити та прийняти рішення</span>
                            </a>
                            
                            <div class="grid grid-cols-2 gap-2">
                                <form method="post" action="{{ path('admin_blog_approve', {'id': post.id}) }}" class="w-full">
                                    <input type="hidden" name="notes" value="Блог відповідає вимогам">
                                    <input type="hidden" name="_token" value="{{ csrf_token('approve' ~ post.id) }}">
                                    <button type="submit" 
                                            class="w-full inline-flex items-center justify-center gap-2 px-4 py-3 bg-gradient-to-r from-green-500 to-emerald-600 text-white font-semibold rounded-xl hover:shadow-lg hover:scale-[1.02] transition-all duration-300">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                        </svg>
                                        <span>Схвалити</span>
                                    </button>
                                </form>
                                
                                <button type="button" 
                                        onclick="openRejectModal({{ post.id }}, '{{ post.title|escape('js') }}')"
                                        class="w-full inline-flex items-center justify-center gap-2 px-4 py-3 bg-gradient-to-r from-red-500 to-rose-600 text-white font-semibold rounded-xl hover:shadow-lg hover:scale-[1.02] transition-all duration-300">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                                    </svg>
                                    <span>Відхилити</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
        
        <!-- Пагінація -->
        <div class="mt-8">
            {{ knp_pagination_render(pagination) }}
        </div>
    {% else %}
        <!-- Немає блогів для модерації -->
        <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-xl p-12 text-center border border-gray-200 dark:border-gray-800">
            <div class="w-24 h-24 mx-auto bg-gradient-to-br from-green-500 to-emerald-600 rounded-full flex items-center justify-center mb-6">
                <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-3">Немає блогів для модерації</h3>
            <p class="text-gray-600 dark:text-gray-400 mb-6 text-lg">Всі блоги вже перевірені. Ви відмінно попрацювали!</p>
            <a href="{{ path('admin_blog_index') }}" 
               class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-blue-500 to-purple-600 text-white font-semibold rounded-xl hover:shadow-lg hover:scale-105 transition-all duration-300">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
                <span>Повернутися до всіх блогів</span>
            </a>
        </div>
    {% endif %}
</div>

<!-- Модальне вікно для перегляду зображень -->
<div id="image-modal" class="fixed inset-0 bg-black/90 z-50 hidden items-center justify-center" onclick="closeImageModal()">
    <button class="absolute top-4 right-4 text-white hover:text-gray-300 transition-colors" onclick="closeImageModal()">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
    </button>
    <img id="modal-image" src="" alt="" class="max-w-full max-h-[90vh] object-contain">
    <div id="modal-caption" class="absolute bottom-4 left-0 right-0 text-center text-white/90 text-sm bg-black/50 py-2 px-4 mx-auto max-w-2xl rounded-full">
        <!-- Caption will be inserted here -->
    </div>
</div>

<!-- Модальне вікно для відхилення -->
<div id="reject-modal" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 hidden items-center justify-center">
    <div class="bg-white dark:bg-gray-900 rounded-2xl max-w-md w-full mx-4 p-6" onclick="event.stopPropagation()">
        <div class="flex justify-between items-center mb-4">
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white flex items-center gap-2">
                <svg class="w-6 h-6 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
                Відхилити блог
            </h3>
            <button onclick="closeRejectModal()" class="text-gray-500 hover:text-gray-700 dark:hover:text-gray-300">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>
        
        <form id="reject-form" method="post" action="">
            <div class="mb-4">
                <p class="text-gray-600 dark:text-gray-400 mb-3">
                    Вкажіть причину відхилення блогу <span id="reject-post-title" class="font-semibold text-gray-900 dark:text-white"></span>:
                </p>
                <textarea name="notes" 
                          id="reject-reason"
                          rows="4" 
                          class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-red-500 dark:focus:ring-red-400 focus:border-transparent transition-all"
                          placeholder="Детально опишіть причину відхилення..."
                          required></textarea>
                <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">
                    Автор отримає цей коментар для виправлення помилок.
                </p>
            </div>
            
            <input type="hidden" name="_token" id="reject-token" value="">
            
            <div class="flex gap-3">
                <button type="button" 
                        onclick="closeRejectModal()"
                        class="flex-1 px-4 py-3 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 font-semibold rounded-xl hover:bg-gray-200 dark:hover:bg-gray-700 transition-all duration-300">
                    Скасувати
                </button>
                <button type="submit" 
                        class="flex-1 px-4 py-3 bg-gradient-to-r from-red-500 to-rose-600 text-white font-semibold rounded-xl hover:shadow-lg hover:scale-105 transition-all duration-300">
                    Відхилити блог
                </button>
            </div>
        </form>
    </div>
</div>

<!-- JavaScript -->
<script>
// Модальне вікно для зображень
function openImageModal(imageUrl, altText, caption) {
    const modal = document.getElementById('image-modal');
    const modalImg = document.getElementById('modal-image');
    const modalCaption = document.getElementById('modal-caption');
    
    modalImg.src = imageUrl;
    modalCaption.innerHTML = caption || altText || '';
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
}

function closeImageModal() {
    const modal = document.getElementById('image-modal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = 'auto';
}

// Модальне вікно для відхилення
function openRejectModal(postId, postTitle) {
    const modal = document.getElementById('reject-modal');
    const form = document.getElementById('reject-form');
    const titleSpan = document.getElementById('reject-post-title');
    const tokenInput = document.getElementById('reject-token');
    
    form.action = `/admin/blog/${postId}/reject`;
    titleSpan.textContent = `"${postTitle}"`;
    tokenInput.value = '{{ csrf_token('reject') }}'.replace('reject', 'reject' + postId);
    
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
}

function closeRejectModal() {
    const modal = document.getElementById('reject-modal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = 'auto';
}

// Закриття модальних вікон по Escape
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        closeImageModal();
        closeRejectModal();
    }
});

// Закриття по кліку на фон
document.getElementById('image-modal').addEventListener('click', function(e) {
    if (e.target === this) {
        closeImageModal();
    }
});

document.getElementById('reject-modal').addEventListener('click', function(e) {
    if (e.target === this) {
        closeRejectModal();
    }
});
</script>

<!-- Стилі -->
<style>
.line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

/* Анімації */
@keyframes fadeIn {
    from {
        opacity: 0;
        transform: scale(0.95);
    }
    to {
        opacity: 1;
        transform: scale(1);
    }
}

#reject-modal.flex,
#image-modal.flex {
    animation: fadeIn 0.2s ease-out;
}

/* Стилі для пагінації */
.pagination {
    @apply flex items-center gap-2;
}

.pagination li {
    @apply inline-block;
}

.pagination a, .pagination span {
    @apply px-4 py-2 bg-white dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors;
}

.pagination .active span {
    @apply bg-gradient-to-r from-blue-500 to-purple-600 text-white border-transparent;
}

.pagination .disabled span {
    @apply opacity-50 cursor-not-allowed;
}
</style>
{% endblock %}