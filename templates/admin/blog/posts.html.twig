{% extends 'admin/base.html.twig' %}

{% block title %}Блоги категорії "{{ category.name }}"{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Заголовок -->
    <div class="mb-8">
        <div class="flex items-center gap-3 mb-2">
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br flex items-center justify-center"
                 style="background: linear-gradient(135deg, {{ category.color|default('#3b82f6') }}, {{ category.color|default('#3b82f6') }}dd)">
                {% if category.icon %}
                    <i class="{{ category.icon }} text-white text-xl"></i>
                {% else %}
                    <span class="text-white font-bold text-xl">{{ category.name|first|upper }}</span>
                {% endif %}
            </div>
            <h1 class="text-3xl font-bold text-gray-900 dark:text-white">
                {{ category.name }}
            </h1>
        </div>
        
        {% if category.description %}
            <p class="text-gray-600 dark:text-gray-400 mb-4">{{ category.description }}</p>
        {% endif %}
        
        <!-- Хлібні крихти -->
        <nav class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400">
            <a href="{{ path('admin_dashboard') }}" class="hover:text-blue-600 dark:hover:text-blue-400">Головна</a>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
            <a href="{{ path('admin_blog_index') }}" class="hover:text-blue-600 dark:hover:text-blue-400">Блоги</a>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
            <a href="{{ path('admin_blog_category_index') }}" class="hover:text-blue-600 dark:hover:text-blue-400">Категорії</a>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
            <span class="text-gray-700 dark:text-gray-300 font-medium">{{ category.name }}</span>
        </nav>
    </div>

    {% if pagination|length > 0 %}
        <!-- Список блогів -->
        <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-xl overflow-hidden border border-gray-200 dark:border-gray-800">
            <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-800">
                <thead class="bg-gray-50 dark:bg-gray-800">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                            Назва
                        </th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                            Автор
                        </th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                            Статус
                        </th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                            Дата
                        </th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                            Перегляди
                        </th>
                        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                            Дії
                        </th>
                    </tr>
                </thead>
                <tbody class="bg-white dark:bg-gray-900 divide-y divide-gray-200 dark:divide-gray-800">
                    {% for post in pagination %}
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
                            <td class="px-6 py-4">
                                <div class="flex items-center">
                                    {% if post.featuredImage %}
                                        <img src="{{ asset('uploads/blogs/' ~ post.featuredImage.filename) }}" 
                                             class="w-10 h-10 rounded-lg object-cover mr-3"
                                             alt="">
                                    {% endif %}
                                    <div>
                                        <div class="font-medium text-gray-900 dark:text-white">
                                            {{ post.title }}
                                        </div>
                                        <div class="text-sm text-gray-500 dark:text-gray-400">
                                            {{ post.excerpt|slice(0, 50) }}...
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex items-center">
                                    <img src="https://ui-avatars.com/api/?name={{ post.author.username }}&size=32&background=3b82f6&color=fff" 
                                         class="w-8 h-8 rounded-full mr-2"
                                         alt="">
                                    <span class="text-sm text-gray-900 dark:text-white">{{ post.author.username }}</span>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                {% if post.status == 'published' %}
                                    <span class="px-3 py-1 bg-green-100 dark:bg-green-900/30 text-green-600 dark:text-green-400 text-xs font-medium rounded-full">
                                        Опубліковано
                                    </span>
                                {% elseif post.status == 'pending' %}
                                    <span class="px-3 py-1 bg-yellow-100 dark:bg-yellow-900/30 text-yellow-600 dark:text-yellow-400 text-xs font-medium rounded-full">
                                        На модерації
                                    </span>
                                {% elseif post.status == 'draft' %}
                                    <span class="px-3 py-1 bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 text-xs font-medium rounded-full">
                                        Чернетка
                                    </span>
                                {% elseif post.status == 'rejected' %}
                                    <span class="px-3 py-1 bg-red-100 dark:bg-red-900/30 text-red-600 dark:text-red-400 text-xs font-medium rounded-full">
                                        Відхилено
                                    </span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400">
                                {{ post.createdAt|date('d.m.Y H:i') }}
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400">
                                {{ post.viewCount }}
                            </td>
                            <td class="px-6 py-4 text-right">
                                <a href="{{ path('admin_blog_edit', {'id': post.id}) }}" 
                                   class="text-blue-600 hover:text-blue-900 dark:hover:text-blue-400 mr-3"
                                   title="Редагувати">
                                    <svg class="w-5 h-5 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                    </svg>
                                </a>
                                <a href="{{ path('blog_show', {'slug': post.slug}) }}" 
                                   target="_blank"
                                   class="text-gray-500 hover:text-gray-700 dark:hover:text-gray-300"
                                   title="Переглянути на сайті">
                                    <svg class="w-5 h-5 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                                    </svg>
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        
        <!-- Пагінація -->
        <div class="mt-8">
            {{ knp_pagination_render(pagination) }}
        </div>
    {% else %}
        <!-- Немає блогів -->
        <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-xl p-12 text-center border border-gray-200 dark:border-gray-800">
            <div class="w-24 h-24 mx-auto bg-gradient-to-br from-gray-200 to-gray-300 dark:from-gray-700 dark:to-gray-600 rounded-full flex items-center justify-center mb-6">
                <svg class="w-12 h-12 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a1 1 0 01-1-1V5a1 1 0 011-1h14a1 1 0 011 1v14a1 1 0 01-1 1zM7 8v8h10V8H7z"/>
                </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-3">Ще немає блогів</h3>
            <p class="text-gray-600 dark:text-gray-400 mb-6 text-lg">В цій категорії поки що немає блогів</p>
            <a href="{{ path('admin_blog_new') }}" 
               class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-blue-500 to-purple-600 text-white font-semibold rounded-xl hover:shadow-lg hover:scale-105 transition-all duration-300">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                <span>Створити новий блог</span>
            </a>
        </div>
    {% endif %}
    
    <!-- Кнопка повернення -->
    <div class="mt-6 text-center">
        <a href="{{ path('admin_blog_category_index') }}" 
           class="inline-flex items-center gap-2 px-4 py-2 text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            <span>Повернутися до списку категорій</span>
        </a>
    </div>
</div>
{% endblock %}