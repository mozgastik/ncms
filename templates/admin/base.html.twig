<!DOCTYPE html>
<html lang="uk" 
      x-data="app()" 
      x-init="init" 
      :class="[darkMode ? 'dark' : 'light']" 
      data-theme="light"
      class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <meta name="theme-color" content="#3b82f6" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#1e293b" media="(prefers-color-scheme: dark)">
    <meta name="csrf-token" content="{{ csrf_token('authenticate') }}">
    <title x-text="pageTitle">{% block title %}Новинний портал - Адмін{% endblock %}</title>
    
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
        <!-- Fonts & Icons -->
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@300;400;500&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
        <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0,1" />
    {% endblock %}
</head>
<body 
    x-cloak
    class="min-h-screen bg-surface-50 text-surface-900 font-sans antialiased dark:bg-surface-950 dark:text-surface-100 overflow-x-hidden"
    :class="{ 'animate-fade-in': initialized }"
>

    <!-- Прелоадер -->
    <div x-show="!initialized" 
         x-transition:leave="transition-opacity duration-300"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0"
         class="fixed inset-0 z-[9999] flex items-center justify-center bg-surface-0 dark:bg-surface-900">
        <div class="loader"></div>
    </div>

    <!-- Основний контейнер -->
    <div class="flex h-screen w-full overflow-hidden">
        <!-- Сайдбар -->
        <aside 
            id="sidebar"
            :style="`width: ${sidebarCollapsed && !isMobile ? '80px' : '256px'}`"
            :class="[
                isMobile ? (sidebarOpen ? 'translate-x-0' : '-translate-x-full') : 'translate-x-0',
                'fixed lg:sticky top-0 left-0 z-40 h-screen bg-surface-0 dark:bg-surface-950 border-r border-surface-200 dark:border-surface-800 shadow-xl lg:shadow-none transition-all duration-300 ease-smooth'
            ]"
        >     
            <!-- Overlay для мобільної версії -->
            <div 
                x-show="isMobile && sidebarOpen"
                x-transition:enter="transition-opacity duration-300"
                x-transition:enter-start="opacity-0"
                x-transition:enter-end="opacity-100"
                x-transition:leave="transition-opacity duration-300"
                x-transition:leave-start="opacity-100"
                x-transition:leave-end="opacity-0"
                @click="closeSidebar"
                class="fixed inset-0 bg-black/50 lg:hidden z-30"
            ></div>
            
            <!-- Контейнер сайдбару -->
            <div class="relative h-full flex flex-col">
                <!-- Кнопка згортання/розгортання (тільки десктоп) -->
                <button 
                    x-show="!isMobile"
                    @click="toggleSidebar"
                    :title="sidebarCollapsed ? 'Розгорнути меню' : 'Згорнути меню'"
                    class="absolute -right-3 top-6 z-50 w-6 h-6 flex items-center justify-center bg-white dark:bg-surface-800 border border-surface-200 dark:border-surface-700 rounded-full shadow-lg hover:shadow-xl hover-scale transition-all duration-200 focus-ring"
                >
                    <i :class="sidebarCollapsed ? 'fa-chevron-right' : 'fa-chevron-left'" class="fas text-surface-600 dark:text-surface-400 text-sm"></i>
                </button>

                <!-- Логотип -->
                <div class="p-4 lg:p-6 border-b border-surface-200 dark:border-surface-800" style="height: 77px;"> 
                    <a href="{{ path('admin_dashboard') }}" class="flex items-center" :class="!isMobile && sidebarCollapsed ? 'lg:justify-center' : 'lg:space-x-3'">
                        <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-primary-500 to-primary-600 flex items-center justify-center flex-shrink-0 shadow-md">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 text-white">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                            </svg>
                        </div>
                        <div x-show="!isMobile && !sidebarCollapsed" class="hidden lg:block ml-3">
                            <p class="text-xs text-surface-500 whitespace-nowrap">Адмін-панель</p>
                        </div>
                    </a>
                </div>
                
                <!-- Меню навігації -->
                <nav class="flex-1 p-4 space-y-6 overflow-y-auto scrollbar-thin">
                    <!-- Головне -->
                    <div class="space-y-2">
                        <div x-show="!isMobile && !sidebarCollapsed" class="px-3">
                            <p class="text-xs font-semibold text-surface-400 uppercase tracking-wider">Головне</p>
                        </div>
                        <div x-show="!isMobile && sidebarCollapsed" class="px-3 text-center hidden lg:block">
                            <p class="text-xs font-semibold text-surface-400 uppercase">●●●</p>
                        </div>
                        
                        <!-- Панель керування -->
                        <a href="{{ path('admin_dashboard') }}" 
                           @click="selected = 'dashboard'"
                           :class="[
                               selected === 'dashboard' ? 'bg-surface-100 dark:bg-surface-800 text-primary-600 dark:text-primary-400' : 'text-surface-700 dark:text-surface-300 hover:bg-surface-100 dark:hover:bg-surface-800 hover:text-primary-600 dark:hover:text-primary-400',
                               !isMobile && sidebarCollapsed ? 'lg:justify-center' : ''
                           ]"
                           class="flex items-center px-3 py-2 rounded-lg transition-colors duration-200">
                            <i class="fas fa-tachometer-alt w-5" :class="!isMobile && !sidebarCollapsed ? 'mr-3' : ''"></i>
                            <span x-show="!isMobile && !sidebarCollapsed" class="whitespace-nowrap">Панель керування</span>
                        </a>
                    </div>
                    
                    <!-- Управління контентом -->
                    <div class="space-y-2">
                        <div x-show="!isMobile && !sidebarCollapsed" class="px-3">
                            <p class="text-xs font-semibold text-surface-400 uppercase tracking-wider">Управління контентом</p>
                        </div>
                        <div x-show="!isMobile && sidebarCollapsed" class="px-3 text-center hidden lg:block">
                            <p class="text-xs font-semibold text-surface-400 uppercase">●●●</p>
                        </div>
                        
                        <!-- Статті -->
                        <a href="{{ path('admin_articles') }}" 
                           @click="selected = 'articles'"
                           :class="[
                               selected === 'articles' ? 'bg-surface-100 dark:bg-surface-800 text-primary-600 dark:text-primary-400' : 'text-surface-700 dark:text-surface-300 hover:bg-surface-100 dark:hover:bg-surface-800 hover:text-primary-600 dark:hover:text-primary-400',
                               !isMobile && sidebarCollapsed ? 'lg:justify-center' : ''
                           ]"
                           class="flex items-center px-3 py-2 rounded-lg transition-colors duration-200">
                            <i class="fas fa-newspaper w-5" :class="!isMobile && !sidebarCollapsed ? 'mr-3' : ''"></i>
                            <span x-show="!isMobile && !sidebarCollapsed" class="whitespace-nowrap">Статті</span>
                        </a>
                        <!-- Блог -->
                        {% if path('admin_blog_index') is defined %}
                        <a href="{{ path('admin_blog_index') }}" 
                           @click="selected = 'blog'"
                           :class="[
                               selected === 'blog' ? 'bg-surface-100 dark:bg-surface-800 text-primary-600 dark:text-primary-400' : 'text-surface-700 dark:text-surface-300 hover:bg-surface-100 dark:hover:bg-surface-800 hover:text-primary-600 dark:hover:text-primary-400',
                               !isMobile && sidebarCollapsed ? 'lg:justify-center' : ''
                           ]"
                           class="flex items-center px-3 py-2 rounded-lg transition-colors duration-200">
                            <i class="fas fa-blog w-5" :class="!isMobile && !sidebarCollapsed ? 'mr-3' : ''"></i>
                            <span x-show="!isMobile && !sidebarCollapsed" class="whitespace-nowrap">Блоги</span>
                        </a>
                        {% endif %}
                        <!-- Відео -->
                    <a href="{{ path('admin_video_index') }}"
                    @click="selected = 'videos'"
                    :class="[
                       selected === 'videos' 
                        ? 'bg-surface-100 dark:bg-surface-800 text-red-600 dark:text-red-400' 
                        : 'text-surface-700 dark:text-surface-300 hover:bg-surface-100 dark:hover:bg-surface-800 hover:text-red-600 dark:hover:text-red-400',
                        !isMobile && isidebarCollapsed ? 'lg:justify-center' : ''
                         ]" 
                    class="flex items-center px-3 py-2 rounded-lg transition-colors duration-200 group">
    
                    <i class="fas fa-video w-5" :class="!isMobile && !sidebarCollapsed ? 'mr-3' : ''"></i>
    
                    <span x-show="!isMobile && !sidebarCollapsed" 
                    class="whitespace-nowrap text-sm font-medium">
                    Відео
                    </span>
    
                    <!-- Бейдж з кількістю (опціонально) -->
                   <span x-show="!isMobile && !sidebarCollapsed && {{ videoCount|default(0) }} > 0"
                    class="ml-auto px-2 py-0.5 text-xs bg-red-100 dark:bg-red-900/30 text-red-600 dark:text-red-400 rounded-full">
                   {{ videoCount|default(0) }}
                    </span>
                    </a>

                        <!-- Категорії -->
                        <a href="{{ path('admin_category_index') }}" 
                           @click="selected = 'categories'"
                           :class="[
                               selected === 'categories' ? 'bg-surface-100 dark:bg-surface-800 text-primary-600 dark:text-primary-400' : 'text-surface-700 dark:text-surface-300 hover:bg-surface-100 dark:hover:bg-surface-800 hover:text-primary-600 dark:hover:text-primary-400',
                               !isMobile && sidebarCollapsed ? 'lg:justify-center' : ''
                           ]"
                           class="flex items-center px-3 py-2 rounded-lg transition-colors duration-200">
                            <i class="fas fa-folder w-5" :class="!isMobile && !sidebarCollapsed ? 'mr-3' : ''"></i>
                            <span x-show="!isMobile && !sidebarCollapsed" class="whitespace-nowrap">Категорії</span>
                        </a>
                        
                        <!-- Теги -->
                        <a href="{{ path('admin_tag_index') }}" 
                           @click="selected = 'tags'"
                           :class="[
                               selected === 'tags' ? 'bg-surface-100 dark:bg-surface-800 text-primary-600 dark:text-primary-400' : 'text-surface-700 dark:text-surface-300 hover:bg-surface-100 dark:hover:bg-surface-800 hover:text-primary-600 dark:hover:text-primary-400',
                               !isMobile && sidebarCollapsed ? 'lg:justify-center' : ''
                           ]"
                           class="flex items-center px-3 py-2 rounded-lg transition-colors duration-200">
                            <i class="fas fa-tags w-5" :class="!isMobile && !sidebarCollapsed ? 'mr-3' : ''"></i>
                            <span x-show="!isMobile && !sidebarCollapsed" class="whitespace-nowrap">Теги</span>
                        </a>
                        
                        <!-- Коментарі -->
                        <a href="{{ path('admin_comment_index') }}" 
                           @click="selected = 'comments'"
                           :class="[
                               selected === 'comments' ? 'bg-surface-100 dark:bg-surface-800 text-primary-600 dark:text-primary-400' : 'text-surface-700 dark:text-surface-300 hover:bg-surface-100 dark:hover:bg-surface-800 hover:text-primary-600 dark:hover:text-primary-400',
                               !isMobile && sidebarCollapsed ? 'lg:justify-center' : ''
                           ]"
                           class="flex items-center px-3 py-2 rounded-lg transition-colors duration-200 relative">
                            <i class="fas fa-comments w-5" :class="!isMobile && !sidebarCollapsed ? 'mr-3' : ''"></i>
                            <span x-show="!isMobile && !sidebarCollapsed" class="whitespace-nowrap">Коментарі</span>
                            {% if pending_comments is defined and pending_comments > 0 %}
                                <span x-show="!isMobile && !sidebarCollapsed" class="ml-auto bg-danger-500 text-white text-xs px-2 py-1 rounded-full animate-pulse-custom">
                                    {{ pending_comments }}
                                </span>
                                <span x-show="!isMobile && !sidebarCollapsed" class="absolute -top-1 -right-1 w-4 h-4 bg-danger-500 text-white text-xs flex items-center justify-center rounded-full lg:hidden">
                                    {{ pending_comments }}
                                </span>
                            {% endif %}
                        </a>
                    </div>
                    
                    <!-- Блоки та вміст -->
                    <div class="space-y-2">
                        <div x-show="!isMobile && !sidebarCollapsed" class="px-3">
                            <p class="text-xs font-semibold text-surface-400 uppercase tracking-wider">Модулі</p>
                        </div>
                        <div x-show="!isMobile && sidebarCollapsed" class="px-3 text-center hidden lg:block">
                            <p class="text-xs font-semibold text-surface-400 uppercase">●●●</p>
                        </div>
                        
                        
                        
                        <!-- Цитати -->
                        {% if path('admin_quote_index') is defined %}
                        <a href="{{ path('admin_quote_index') }}" 
                           @click="selected = 'quotes'"
                           :class="[
                               selected === 'quotes' ? 'bg-surface-100 dark:bg-surface-800 text-primary-600 dark:text-primary-400' : 'text-surface-700 dark:text-surface-300 hover:bg-surface-100 dark:hover:bg-surface-800 hover:text-primary-600 dark:hover:text-primary-400',
                               !isMobile && sidebarCollapsed ? 'lg:justify-center' : ''
                           ]"
                           class="flex items-center px-3 py-2 rounded-lg transition-colors duration-200">
                            <i class="fas fa-quote-right w-5" :class="!isMobile && !sidebarCollapsed ? 'mr-3' : ''"></i>
                            <span x-show="!isMobile && !sidebarCollapsed" class="whitespace-nowrap">Цитати</span>
                        </a>
                        {% endif %}
                        <!--  Реклама-->
                        {% if path ('admin_ad_index') is defined %}
                        <a href="{{ path('admin_ad_index') }}" 
                           @click="selected = 'ad'"
                           :class="[
                               selected === 'ad' ? 'bg-surface-100 dark:bg-surface-800 text-primary-600 dark:text-primary-400' : 'text-surface-700 dark:text-surface-300 hover:bg-surface-100 dark:hover:bg-surface-800 hover:text-primary-600 dark:hover:text-primary-400',
                               !isMobile && sidebarCollapsed ? 'lg:justify-center' : ''
                           ]"
                           class="flex items-center px-3 py-2 rounded-lg transition-colors duration-200">
                            <i class="fas fa-brands fa-adversal w-5" :class="!isMobile && !sidebarCollapsed ? 'mr-3' : ''"></i>
                            <span x-show="!isMobile && !sidebarCollapsed" class="whitespace-nowrap">Реклама</span>
                        </a>
                        {% endif %}
                        <!-- Слайдер -->
                        {% if path('admin_slider_index') is defined %}
                        <a href="{{ path('admin_slider_index') }}" 
                           @click="selected = 'slider'"
                           :class="[
                               selected === 'slider' ? 'bg-surface-100 dark:bg-surface-800 text-primary-600 dark:text-primary-400' : 'text-surface-700 dark:text-surface-300 hover:bg-surface-100 dark:hover:bg-surface-800 hover:text-primary-600 dark:hover:text-primary-400',
                               !isMobile && sidebarCollapsed ? 'lg:justify-center' : ''
                           ]"
                           class="flex items-center px-3 py-2 rounded-lg transition-colors duration-200">
                            <i class="fas fa-images w-5" :class="!isMobile && !sidebarCollapsed ? 'mr-3' : ''"></i>
                            <span x-show="!isMobile && !sidebarCollapsed" class="whitespace-nowrap">Слайдер</span>
                        </a>
                        {% endif %}

                        {% if path('admin_page_index') is defined %}
                        <a href="{{ path('admin_page_index') }}"
                        @click="selected = 'page'"
                           :class="[
                               selected === 'page' ? 'bg-surface-100 dark:bg-surface-800 text-primary-600 dark:text-primary-400' : 'text-surface-700 dark:text-surface-300 hover:bg-surface-100 dark:hover:bg-surface-800 hover:text-primary-600 dark:hover:text-primary-400',
                               !isMobile && sidebarCollapsed ? 'lg:justify-center' : ''
                           ]"
                           class="flex items-center px-3 py-2 rounded-lg transition-colors duration-200"> 
                        <i class="fas fa-file-alt w-5 " :class="!isMobile && !sidebarCollapsed ? 'mr-3' : ''"></i>
                        <span x-show="!isMobile && !sidebarCollapsed" class="whitespace-nowrap">Сторінки</span>
                         </a>
                         {% endif %}
                         
                        <!-- Галерея -->
                        {% if path('admin_gallery_index') is defined %}
                        <a href="{{ path('admin_gallery_index') }}" 
                           @click="selected = 'gallery'"
                           :class="[
                               selected === 'gallery' ? 'bg-surface-100 dark:bg-surface-800 text-primary-600 dark:text-primary-400' : 'text-surface-700 dark:text-surface-300 hover:bg-surface-100 dark:hover:bg-surface-800 hover:text-primary-600 dark:hover:text-primary-400',
                               !isMobile && sidebarCollapsed ? 'lg:justify-center' : ''
                           ]"
                           class="flex items-center px-3 py-2 rounded-lg transition-colors duration-200">
                            <i class="fas fa-photo-video w-5" :class="!isMobile && !sidebarCollapsed ? 'mr-3' : ''"></i>
                            <span x-show="!isMobile && !sidebarCollapsed" class="whitespace-nowrap">Галерея</span>
                        </a>
                        {% endif %}
                    </div>
                    
                    <!-- Система -->
                    <div class="space-y-2">
                        <div x-show="!isMobile && !sidebarCollapsed" class="px-3">
                            <p class="text-xs font-semibold text-surface-400 uppercase tracking-wider">Система</p>
                        </div>
                        <div x-show="!isMobile && sidebarCollapsed" class="px-3 text-center hidden lg:block">
                            <p class="text-xs font-semibold text-surface-400 uppercase">●●●</p>
                        </div>
                        
                        <!-- Користувачі -->
                        <a href="{{ path('admin_user_index') }}" 
                           @click="selected = 'users'"
                           :class="[
                               selected === 'users' ? 'bg-surface-100 dark:bg-surface-800 text-primary-600 dark:text-primary-400' : 'text-surface-700 dark:text-surface-300 hover:bg-surface-100 dark:hover:bg-surface-800 hover:text-primary-600 dark:hover:text-primary-400',
                               !isMobile && sidebarCollapsed ? 'lg:justify-center' : ''
                           ]"
                           class="flex items-center px-3 py-2 rounded-lg transition-colors duration-200">
                            <i class="fas fa-users w-5" :class="!isMobile && !sidebarCollapsed ? 'mr-3' : ''"></i>
                            <span x-show="!isMobile && !sidebarCollapsed" class="whitespace-nowrap">Користувачі</span>
                        </a>

                        {# Додати в секцію "Система" сайдбару #}
                      <a href="{{ path('admin_maintenance_index') }}" 
                      @click="selected = 'maintenance'"
                     :class="[
                      selected === 'maintenance' ? 'bg-(--color-surface-100) dark:bg-(--color-surface-800) text-(--color-primary-600) dark:text-(--color-primary-400)' : 'text-(--color-surface-700) dark:text-(--color-surface-300) hover:bg-(--color-surface-100) dark:hover:bg-(--color-surface-800) hover:text-(--color-primary-600) dark:hover:text-(--color-primary-400)',
                      !isMobile && sidebarCollapsed ? 'lg:justify-center' : ''
                        ]"
                       class="flex items-center px-3 py-2 rounded-lg transition-colors duration-(--transition-fast)">
                      <i class="fas fa-tools w-5" :class="!isMobile && !sidebarCollapsed ? 'mr-3' : ''"></i>
                      <span x-show="!isMobile && !sidebarCollapsed" class="whitespace-nowrap">Обслуговування</span>
                       </a>
                        
                        <!-- Налаштування -->
                        {% if path('admin_settings_index') is defined %}
                        <a href="{{ path('admin_settings_index') }}" 
                           @click="selected = 'settings'"
                           :class="[
                               selected === 'settings' ? 'bg-surface-100 dark:bg-surface-800 text-primary-600 dark:text-primary-400' : 'text-surface-700 dark:text-surface-300 hover:bg-surface-100 dark:hover:bg-surface-800 hover:text-primary-600 dark:hover:text-primary-400',
                               !isMobile && sidebarCollapsed ? 'lg:justify-center' : ''
                           ]"
                           class="flex items-center px-3 py-2 rounded-lg transition-colors duration-200">
                            <i class="fas fa-cog w-5" :class="!isMobile && !sidebarCollapsed ? 'mr-3' : ''"></i>
                            <span x-show="!isMobile && !sidebarCollapsed" class="whitespace-nowrap">Налаштування</span>
                        </a>
                        {% endif %}
                        
                        <!-- Статистика -->
                        {% if path('admin_stats') is defined %}
                        <a href="{{ path('admin_stats') }}" 
                           @click="selected = 'stats'"
                           :class="[
                               selected === 'stats' ? 'bg-surface-100 dark:bg-surface-800 text-primary-600 dark:text-primary-400' : 'text-surface-700 dark:text-surface-300 hover:bg-surface-100 dark:hover:bg-surface-800 hover:text-primary-600 dark:hover:text-primary-400',
                               !isMobile && sidebarCollapsed ? 'lg:justify-center' : ''
                           ]"
                           class="flex items-center px-3 py-2 rounded-lg transition-colors duration-200">
                            <i class="fas fa-chart-line w-5" :class="!isMobile && !sidebarCollapsed ? 'mr-3' : ''"></i>
                            <span x-show="!isMobile && !sidebarCollapsed" class="whitespace-nowrap">Статистика</span>
                        </a>
                        {% endif %}
                    </div>
                </nav>
                
                <!-- Інформація про користувача -->
                <div class="p-4 border-t border-surface-200 dark:border-surface-800">
                    <div class="flex items-center" :class="!isMobile && sidebarCollapsed ? 'lg:justify-center' : 'lg:space-x-3'">
                        <div class="w-10 h-10 rounded-full bg-gradient-to-br from-primary-500 to-primary-600 flex items-center justify-center flex-shrink-0 shadow-md">
                            <span class="text-white text-sm font-semibold">{{ app.user.username|first|upper }}</span>
                        </div>
                        <div x-show="!isMobile && !sidebarCollapsed" class="flex-1 min-w-0 hidden lg:block ml-3">
