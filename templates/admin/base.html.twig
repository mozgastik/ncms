                        {% block body %}{% endblock %}
                    </div>
                </div>
            </main>
        </div>
    </div>

    <!-- Кнопка "наверх" -->
    <button 
        x-show="showScrollTop"
        x-transition:enter="transition ease-out duration-300"
        x-transition:enter-start="opacity-0 scale-50"
        x-transition:enter-end="opacity-100 scale-100"
        x-transition:leave="transition ease-in duration-200"
        x-transition:leave-start="opacity-100 scale-100"
        x-transition:leave-end="opacity-0 scale-50"
        @click="scrollToTop"
        class="fixed bottom-6 right-6 w-12 h-12 bg-gradient-to-br from-primary-500 to-primary-600 text-white rounded-full shadow-lg hover:shadow-xl hover-scale flex items-center justify-center z-50 focus-ring interactive"
    >
        <i class="fas fa-arrow-up text-lg"></i>
    </button>

{% block javascripts %}
    {{ encore_entry_script_tags('app') }}
    <script>
        // Централізований стан
        function app() {
            return {
                // --- Тема ---
                darkMode: localStorage.getItem('theme') === 'dark' || 
                          (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches),
                
                // --- Ініціалізація ---
                initialized: false,
                
                // --- Заголовок сторінки ---
                pageTitle: 'Панель керування',
                pageSubtitle: 'Керування сайтом та контентом',
                
                // --- Скрол ---
                showScrollTop: false,
                
                // --- Сайдбар ---
                sidebarCollapsed: localStorage.getItem('sidebarCollapsed') === 'true',
                sidebarOpen: false,
                isMobile: window.innerWidth < 1024,
                selected: localStorage.getItem('selectedMenuItem') || 'dashboard',
                
                // --- Хедер ---
                scrolled: false,
                hidden: false,
                lastScroll: 0,
                scrollThreshold: 50,
                notificationsOpen: false,
                notifying: true,
                searchQuery: '',

                init() {
                    this.initialized = true;
                    
                    // Стежимо за темою
                    this.$watch('darkMode', value => {
                        this.applyTheme();
                    });
                    
                    // Стежимо за згортанням сайдбару
                    this.$watch('sidebarCollapsed', value => {
                        localStorage.setItem('sidebarCollapsed', value);
                    });
                    
                    // Стежимо за вибраним пунктом меню
                    this.$watch('selected', value => {
                        localStorage.setItem('selectedMenuItem', value);
                    });
                    
                    // Підлаштовуємось під розмір вікна
                    window.addEventListener('resize', () => {
                        this.isMobile = window.innerWidth < 1024;
                        if (!this.isMobile) {
                            this.sidebarOpen = false;
                            document.body.classList.remove('mobile-menu-open');
                        }
                    });
                    
                    // Скрол хедера
                    window.addEventListener('scroll', () => this.onScroll(), { passive: true });
                    
                    // Ініціалізуємо тему
                    this.applyTheme();
                },

                // ====== Тема ======
                toggleTheme() {
                    this.darkMode = !this.darkMode;
                },
                applyTheme() {
                    const root = document.documentElement;
                    if (this.darkMode) {
                        root.classList.add('dark');
                        localStorage.setItem('theme', 'dark');
                    } else {
                        root.classList.remove('dark');
                        localStorage.setItem('theme', 'light');
                    }
                },

                // ====== Скрол ======
                onScroll() {
                    const currentScroll = window.pageYOffset;
                    this.scrolled = currentScroll > 20;
                    
                    if (currentScroll > this.lastScroll && currentScroll > this.scrollThreshold) {
                        this.hidden = true;
                    } else {
                        this.hidden = false;
                    }
                    this.lastScroll = currentScroll;
                },
                handleScroll(e) {
                    if (e && e.target) {
                        this.showScrollTop = e.target.scrollTop > 300;
                    }
                },
                scrollToTop() {
                    const main = document.querySelector('main');
                    if (main) main.scrollTo({ top: 0, behavior: 'smooth' });
                },

                // ====== Сайдбар ======
                toggleSidebar() {
                    if (this.isMobile) {
                        this.sidebarOpen = !this.sidebarOpen;
                        document.body.classList.toggle('mobile-menu-open', this.sidebarOpen);
                    } else {
                        this.sidebarCollapsed = !this.sidebarCollapsed;
                    }
                },
                closeSidebar() {
                    this.sidebarOpen = false;
                    document.body.classList.remove('mobile-menu-open');
                },

                // ====== Пошук ======
                search() {
                    console.log('Search:', this.searchQuery);
                }
            }
        }
    </script>
{% endblock %}
</body>
</html>