{% extends 'admin/base.html.twig' %}

{% block title %}{{ page is defined ? 'Редагування' : 'Нова' }} сторінка – Адмін панель{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">
        {{ page is defined ? '✏️ Редагування сторінки' : '➕ Нова сторінка' }}
    </h1>

    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6">
        {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">{{ form.title.vars.label }}</label>
                    {{ form_widget(form.title, {'attr': {'class': 'w-full px-4 py-2.5 rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500/50 focus:border-transparent transition'}}) }}
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">{{ form.slug.vars.label }}</label>
                    {{ form_widget(form.slug, {'attr': {'class': 'w-full px-4 py-2.5 rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500/50 focus:border-transparent transition'}}) }}
                </div>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">{{ form.content.vars.label }}</label>
                {{ form_widget(form.content, {'attr': {'class': 'w-full px-4 py-2.5 rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500/50 focus:border-transparent transition', 'rows': 15}}) }}
            </div>
            <div class="border-t border-gray-200 dark:border-gray-700 pt-4">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">SEO</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">{{ form.metaTitle.vars.label }}</label>
                        {{ form_widget(form.metaTitle, {'attr': {'class': 'w-full px-4 py-2.5 rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500/50 focus:border-transparent transition'}}) }}
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">{{ form.metaKeywords.vars.label }}</label>
                        {{ form_widget(form.metaKeywords, {'attr': {'class': 'w-full px-4 py-2.5 rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500/50 focus:border-transparent transition'}}) }}
                    </div>
                </div>
                <div class="mt-4">
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">{{ form.metaDescription.vars.label }}</label>
                    {{ form_widget(form.metaDescription, {'attr': {'class': 'w-full px-4 py-2.5 rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500/50 focus:border-transparent transition', 'rows': 3}}) }}
                </div>
            </div>
            <div class="flex items-center gap-4 pt-4 border-t border-gray-200 dark:border-gray-700">
                <div class="flex items-center gap-2">
                    {{ form_widget(form.isPublished, {'attr': {'class': 'rounded border-gray-300 text-blue-600 focus:ring-blue-500'}}) }}
                    <label class="text-sm text-gray-700 dark:text-gray-300">{{ form.isPublished.vars.label }}</label>
                </div>
            </div>
            <div class="flex justify-end">
                <button type="submit" class="px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-xl transition-colors">
                    <i class="fas fa-save mr-2"></i>Зберегти
                </button>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}