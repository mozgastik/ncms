{% extends 'admin/base.html.twig' %}

{% block title %}Управління статтями - Адмін панель{% endblock %}

{% block body %}
<main class="flex-1 p-2 sm:p-3 md:p-4 lg:p-6" 
      x-data="articlesManager()" 
      x-init="init()"
      x-cloak>
    
    <!-- Flash Messages -->
    <template x-for="flash in flashes" :key="flash.id">
        <div class="fixed top-2 sm:top-4 right-2 sm:right-4 px-3 py-2 sm:px-4 sm:py-3 rounded-lg shadow-lg z-50 animate-fade-in max-w-[calc(100vw-1rem)] sm:max-w-md"
             :class="flash.type === 'success' ? 'bg-green-100 text-green-800 border border-green-200' : 'bg-red-100 text-red-800 border border-red-200'">
            <div class="flex items-center gap-2">
                <i class="fas" :class="flash.type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle'"></i>
                <span class="font-medium text-xs sm:text-sm flex-1" x-text="flash.message"></span>
                <button @click="removeFlash(flash.id)" class="ml-1 sm:ml-2 text-current hover:opacity-70">
                    <i class="fas fa-times text-xs"></i>
                </button>
            </div>
        </div>
    </template>

    <!-- Header -->
    <div class="mb-3 sm:mb-4 md:mb-6">
        <div class="flex flex-col gap-2 sm:gap-3 md:gap-4">
            <div>
                <h1 class="text-lg sm:text-xl md:text-2xl lg:text-3xl font-bold text-surface-900">Управління статтями</h1>
                <p class="text-surface-500 text-xs sm:text-sm mt-0.5">Загальна кількість: <span x-text="articles.length"></span></p>
            </div>
            <div class="flex flex-col xs:flex-row items-stretch xs:items-center gap-2 sm:gap-3">
                <div class="relative flex-1 min-w-0">
                    <input type="text" 
                           x-model="searchQuery"
                           @input="filterArticles()"
                           placeholder="Пошук статей..." 
                           class="w-full pl-8 sm:pl-9 md:pl-10 pr-3 py-2 text-xs sm:text-sm border border-surface-300 rounded-lg bg-surface-0 text-surface-900 placeholder-surface-400 focus:outline-none focus:ring-2 focus:ring-primary-500">
                    <i class="fas fa-search absolute left-3 top-1/2 transform -translate-y-1/2 text-surface-400 text-xs"></i>
                </div>
                <a href="{{ path('admin_article_new') }}" 
                   class="inline-flex items-center justify-center px-4 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-colors text-sm whitespace-nowrap">
                    <i class="fas fa-plus mr-2"></i> Створити
                </a>
            </div>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 xs:grid-cols-2 lg:grid-cols-4 gap-2 sm:gap-3 md:gap-4 mb-3 sm:mb-4 md:mb-6">
        <div class="bg-gradient-to-r from-blue-50 to-blue-100 border border-blue-200 rounded-xl p-3 sm:p-4 cursor-pointer transition-transform hover:scale-[1.02]"
             @click="filterByStatus(null)">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs sm:text-sm font-medium text-blue-800">Усі статті</p>
                    <p class="text-lg sm:text-xl md:text-2xl font-bold text-blue-900 mt-1" x-text="articles.length"></p>
                </div>
                <div class="bg-blue-200/50 p-2 sm:p-3 rounded-lg">
                    <i class="fas fa-newspaper text-blue-600"></i>
                </div>
            </div>
        </div>
        
        <div class="bg-gradient-to-r from-green-50 to-green-100 border border-green-200 rounded-xl p-3 sm:p-4 cursor-pointer transition-transform hover:scale-[1.02]"
             @click="filterByStatus('published')">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs sm:text-sm font-medium text-green-800">Опубліковано</p>
                    <p class="text-lg sm:text-xl md:text-2xl font-bold text-green-900 mt-1" x-text="getStatusCount('published')"></p>
                </div>
                <div class="bg-green-200/50 p-2 sm:p-3 rounded-lg">
                    <i class="fas fa-check-circle text-green-600"></i>
                </div>
            </div>
        </div>
        
        <div class="bg-gradient-to-r from-amber-50 to-amber-100 border border-amber-200 rounded-xl p-3 sm:p-4 cursor-pointer transition-transform hover:scale-[1.02]"
             @click="filterByStatus('draft')">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs sm:text-sm font-medium text-amber-800">Чернетки</p>
                    <p class="text-lg sm:text-xl md:text-2xl font-bold text-amber-900 mt-1" x-text="getStatusCount('draft')"></p>
                </div>
                <div class="bg-amber-200/50 p-2 sm:p-3 rounded-lg">
                    <i class="fas fa-edit text-amber-600"></i>
                </div>
            </div>
        </div>
        
        <div class="bg-gradient-to-r from-purple-50 to-purple-100 border border-purple-200 rounded-xl p-3 sm:p-4">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs sm:text-sm font-medium text-purple-800">Переглядів</p>
                    <p class="text-lg sm:text-xl md:text-2xl font-bold text-purple-900 mt-1" x-text="totalViews"></p>
                </div>
                <div class="bg-purple-200/50 p-2 sm:p-3 rounded-lg">
                    <i class="fas fa-eye text-purple-600"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Status Filter -->
    <div class="mb-3 sm:mb-4 md:mb-6 overflow-x-auto">
        <div class="flex gap-1.5 sm:gap-2 pb-2 min-w-max">
            <button @click="filterByStatus(null)" 
                    class="px-2.5 sm:px-3 py-1.5 text-xs sm:text-sm rounded-lg font-medium whitespace-nowrap transition-all"
                    :class="!currentStatus ? 'bg-primary-100 text-primary-800 border border-primary-200' : 'bg-surface-100 text-surface-700 hover:bg-surface-200 border border-surface-200'">
                <i class="fas fa-newspaper mr-1"></i>
                Усі (<span x-text="articles.length"></span>)
            </button>
            
            <button @click="filterByStatus('pending')" 
                    class="px-2.5 sm:px-3 py-1.5 text-xs sm:text-sm rounded-lg font-medium whitespace-nowrap transition-all"
                    :class="currentStatus === 'pending' ? 'bg-blue-100 text-blue-800 border border-blue-200' : 'bg-surface-100 text-surface-700 hover:bg-surface-200 border border-surface-200'">
                <i class="fas fa-clock mr-1"></i>
                На модерації (<span x-text="getStatusCount('pending')"></span>)
            </button>
            
            <button @click="filterByStatus('published')" 
                    class="px-2.5 sm:px-3 py-1.5 text-xs sm:text-sm rounded-lg font-medium whitespace-nowrap transition-all"
                    :class="currentStatus === 'published' ? 'bg-green-100 text-green-800 border border-green-200' : 'bg-surface-100 text-surface-700 hover:bg-surface-200 border border-surface-200'">
                <i class="fas fa-check-circle mr-1"></i>
                Опубліковані (<span x-text="getStatusCount('published')"></span>)
            </button>
            
            <button @click="filterByStatus('approved')" 
                    class="px-2.5 sm:px-3 py-1.5 text-xs sm:text-sm rounded-lg font-medium whitespace-nowrap transition-all"
                    :class="currentStatus === 'approved' ? 'bg-purple-100 text-purple-800 border border-purple-200' : 'bg-surface-100 text-surface-700 hover:bg-surface-200 border border-surface-200'">
                <i class="fas fa-thumbs-up mr-1"></i>
                Схвалені (<span x-text="getStatusCount('approved')"></span>)
            </button>
            
            <button @click="filterByStatus('draft')" 
                    class="px-2.5 sm:px-3 py-1.5 text-xs sm:text-sm rounded-lg font-medium whitespace-nowrap transition-all"
                    :class="currentStatus === 'draft' ? 'bg-amber-100 text-amber-800 border border-amber-200' : 'bg-surface-100 text-surface-700 hover:bg-surface-200 border border-surface-200'">
                <i class="fas fa-edit mr-1"></i>
                Чернетки (<span x-text="getStatusCount('draft')"></span>)
            </button>
            
            <button @click="filterByStatus('rejected')" 
                    class="px-2.5 sm:px-3 py-1.5 text-xs sm:text-sm rounded-lg font-medium whitespace-nowrap transition-all"
                    :class="currentStatus === 'rejected' ? 'bg-red-100 text-red-800 border border-red-200' : 'bg-surface-100 text-surface-700 hover:bg-surface-200 border border-surface-200'">
                <i class="fas fa-times-circle mr-1"></i>
                Відхилені (<span x-text="getStatusCount('rejected')"></span>)
            </button>
            
            <button @click="filterByStatus('archived')" 
                    class="px-2.5 sm:px-3 py-1.5 text-xs sm:text-sm rounded-lg font-medium whitespace-nowrap transition-all"
                    :class="currentStatus === 'archived' ? 'bg-gray-100 text-gray-800 border border-gray-200' : 'bg-surface-100 text-surface-700 hover:bg-surface-200 border border-surface-200'">
                <i class="fas fa-archive mr-1"></i>
                Архів (<span x-text="getStatusCount('archived')"></span>)
            </button>
        </div>
    </div>

    <!-- Loading State -->
    <div x-show="loading" class="flex items-center justify-center py-12">
        <div class="inline-flex items-center gap-3">
            <svg class="animate-spin h-8 w-8 text-primary-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <span class="text-gray-600 dark:text-gray-400 text-sm">Завантаження...</span>
        </div>
    </div>

    <!-- Articles List -->
    <div x-show="!loading && filteredArticles.length > 0" x-cloak>
        <!-- Mobile/Tablet Cards View -->
        <div class="block lg:hidden space-y-2 sm:space-y-3">
            <template x-for="article in filteredArticles" :key="article.id">
                <div class="bg-surface-0 rounded-xl border border-surface-200 shadow-sm p-3 sm:p-4">
                    <div class="flex justify-between items-start mb-2 sm:mb-3 gap-2">
                        <div class="flex-1 min-w-0">
                            <h3 class="font-medium text-surface-900 text-sm sm:text-base line-clamp-2" x-text="article.title"></h3>
                            <div class="flex items-center flex-wrap gap-1 sm:gap-2 mt-1">
                                <span class="inline-flex items-center text-xs text-surface-500">
                                    <i class="fas fa-hashtag text-xs mr-1"></i>
                                    <span x-text="article.id"></span>
                                </span>
                                <span class="inline-flex items-center text-xs text-surface-500" x-show="article.author">
                                    <i class="fas fa-user text-xs mr-1"></i>
                                    <span x-text="article.author?.username"></span>
                                </span>
                            </div>
                        </div>
                        <div class="flex-shrink-0">
                            <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full text-xs font-medium"
                                  :class="getStatusClass(article.status)">
                                <i :class="getStatusIcon(article.status)"></i>
                                <span class="hidden xs:inline" x-text="getStatusLabel(article.status)"></span>
                            </span>
                        </div>
                    </div>
                    
                    <div class="grid grid-cols-2 gap-2 mb-2">
                        <div>
                            <p class="text-xs text-surface-500 mb-0.5">Категорія</p>
                            <p class="text-sm font-medium text-surface-900 truncate" x-text="article.category?.name || '—'"></p>
                        </div>
                        <div>
                            <p class="text-xs text-surface-500 mb-0.5">Дата</p>
                            <p class="text-sm font-medium text-surface-900" x-text="formatDate(article.createdAt || article.publishedAt)"></p>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <p class="text-xs text-surface-500 line-clamp-2" x-text="article.excerpt?.substring(0, 80) || '—'"></p>
                    </div>
                    
                    <div class="flex flex-wrap items-center justify-between border-t border-surface-100 pt-2 gap-2">
                        <div class="flex items-center gap-1">
                            <a :href="'/article/' + article.slug" target="_blank" class="w-7 h-7 rounded-lg flex items-center justify-center text-surface-600 hover:text-primary-600 hover:bg-primary-50 transition-colors">
                                <i class="fas fa-external-link-alt text-xs"></i>
                            </a>
                            <a :href="'/admin/articles/' + article.id + '/edit'" class="w-7 h-7 rounded-lg flex items-center justify-center text-surface-600 hover:text-primary-600 hover:bg-primary-50 transition-colors">
                                <i class="fas fa-edit text-xs"></i>
                            </a>
                        </div>
                        
                        <div class="relative" x-data="{ open: false }">
                            <button @click="open = !open" class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-xs font-medium bg-surface-100 text-surface-800 hover:bg-surface-200 transition-colors">
                                <i class="fas fa-cog text-xs"></i>
                                <span class="hidden sm:inline">Дії</span>
                            </button>
                            <div x-show="open" @click.away="open = false" class="absolute right-0 mt-1 w-36 bg-surface-0 rounded-lg border border-surface-200 shadow-lg z-50 py-1">
                                <button @click="changeStatus(article.id, 'published', article.changeStatusToken); open = false" class="flex items-center gap-1.5 w-full px-3 py-1.5 text-xs text-surface-700 hover:bg-surface-100 transition-colors">
                                    <i class="fas fa-check-circle text-green-600"></i> Опублікувати
                                </button>
                                <button @click="changeStatus(article.id, 'pending', article.changeStatusToken); open = false" class="flex items-center gap-1.5 w-full px-3 py-1.5 text-xs text-surface-700 hover:bg-surface-100 transition-colors">
                                    <i class="fas fa-clock text-blue-600"></i> На модерацію
                                </button>
                                <button @click="changeStatus(article.id, 'draft', article.changeStatusToken); open = false" class="flex items-center gap-1.5 w-full px-3 py-1.5 text-xs text-surface-700 hover:bg-surface-100 transition-colors">
                                    <i class="fas fa-edit text-amber-600"></i> В чернетку
                                </button>
                                <button @click="changeStatus(article.id, 'archived', article.changeStatusToken); open = false" class="flex items-center gap-1.5 w-full px-3 py-1.5 text-xs text-surface-700 hover:bg-surface-100 transition-colors">
                                    <i class="fas fa-archive text-gray-600"></i> Архівувати
                                </button>
                                <div class="border-t my-1"></div>
                                <button @click="deleteArticle(article.id, article.deleteToken); open = false" class="flex items-center gap-1.5 w-full px-3 py-1.5 text-xs text-red-600 hover:bg-red-50 transition-colors">
                                    <i class="fas fa-trash"></i> Видалити
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </template>
        </div>
        
        <!-- Desktop Table -->
        <div class="hidden lg:block bg-surface-0 rounded-xl border border-surface-200 shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-surface-200">
                    <thead class="bg-surface-50">
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-surface-500">Стаття</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-surface-500">Категорія</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-surface-500">Дата</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-surface-500">Переглядів</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-surface-500">Статус</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-surface-500">Дії</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-surface-200">
                        <template x-for="article in filteredArticles" :key="article.id">
                            <tr class="hover:bg-surface-50 transition-colors">
                                <td class="px-4 py-4">
                                    <div class="flex items-start gap-3">
                                     <img x-show="article.coverImage" 
                                             :src="'/uploads/articles/' + article.coverImage" 
                                             class="flex-shrink-0 h-12 w-16 rounded-md object-cover"
                                             @error="article.coverImage = null">
                                             <img x-show="article.hasCoverImage" 
                                             :src="article.coverImageUrl" 
                                            class="flex-shrink-0 h-12 w-16 rounded-md object-cover"
                                            @error="article.hasCoverImage = false"
                                            loading="lazy">
                                        <div class="flex-1 min-w-0">
                                            <p class="text-sm font-medium text-surface-900 truncate" x-text="article.title"></p>
                                            <p class="text-xs text-surface-500 mt-1 truncate" x-text="article.excerpt?.substring(0, 50) || '—'"></p>
                                            <p class="text-xs text-surface-400 mt-1" x-show="article.author">
                                                <i class="fas fa-user mr-1"></i>
                                                <span x-text="article.author?.username"></span>
                                            </p>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-4 py-4">
                                    <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-medium bg-primary-100 text-primary-800" x-text="article.category?.name || 'Без категорії'"></span>
                                </td>
                                <td class="px-4 py-4 whitespace-nowrap">
                                    <div class="flex flex-col">
                                        <span class="text-sm" x-text="formatDate(article.createdAt || article.publishedAt)"></span>
                                        <span class="text-xs text-surface-400" x-text="formatTime(article.createdAt || article.publishedAt)"></span>
                                    </div>
                                </td>
                                <td class="px-4 py-4 whitespace-nowrap" x-text="article.views || 0"></td>
                                <td class="px-4 py-4 whitespace-nowrap">
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium"
                                          :class="getStatusClass(article.status)">
                                        <i :class="getStatusIcon(article.status)"></i>
                                        <span x-text="getStatusLabel(article.status)"></span>
                                    </span>
                                </td>
                                <td class="px-4 py-4 whitespace-nowrap">
                                    <div class="flex items-center gap-1">
                                        <a :href="'/article/' + article.slug" target="_blank" class="w-8 h-8 rounded-lg flex items-center justify-center text-surface-600 hover:text-primary-600 hover:bg-primary-50 transition-colors">
                                            <i class="fas fa-external-link-alt"></i>
                                        </a>
                                        <a :href="'/admin/articles/' + article.id + '/edit'" class="w-8 h-8 rounded-lg flex items-center justify-center text-surface-600 hover:text-primary-600 hover:bg-primary-50 transition-colors">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        
                                        <div class="relative" x-data="{ open: false }">
                                            <button @click="open = !open" class="w-8 h-8 rounded-lg flex items-center justify-center text-surface-600 hover:bg-surface-100 transition-colors">
                                                <i class="fas fa-ellipsis-v"></i>
                                            </button>
                                            <div x-show="open" @click.away="open = false" class="absolute right-0 mt-2 w-48 bg-surface-0 rounded-lg border border-surface-200 shadow-lg z-50 py-2">
                                                <button @click="changeStatus(article.id, 'published', article.changeStatusToken); open = false" class="flex items-center gap-2 w-full px-4 py-2 text-sm text-surface-700 hover:bg-surface-100">
                                                    <i class="fas fa-check-circle text-green-600"></i> Опублікувати
                                                </button>
                                                <button @click="changeStatus(article.id, 'pending', article.changeStatusToken); open = false" class="flex items-center gap-2 w-full px-4 py-2 text-sm text-surface-700 hover:bg-surface-100">
                                                    <i class="fas fa-clock text-blue-600"></i> На модерацію
                                                </button>
                                                <button @click="changeStatus(article.id, 'draft', article.changeStatusToken); open = false" class="flex items-center gap-2 w-full px-4 py-2 text-sm text-surface-700 hover:bg-surface-100">
                                                    <i class="fas fa-edit text-amber-600"></i> В чернетку
                                                </button>
                                                <button @click="changeStatus(article.id, 'archived', article.changeStatusToken); open = false" class="flex items-center gap-2 w-full px-4 py-2 text-sm text-surface-700 hover:bg-surface-100">
                                                    <i class="fas fa-archive text-gray-600"></i> Архівувати
                                                </button>
                                                <div class="border-t my-2"></div>
                                                <button @click="deleteArticle(article.id, article.deleteToken); open = false" class="flex items-center gap-2 w-full px-4 py-2 text-sm text-red-600 hover:bg-red-50">
                                                    <i class="fas fa-trash"></i> Видалити
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </template>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Пагінація -->
        <div x-show="totalPages > 1" class="px-4 py-3 border-t border-surface-200 bg-surface-50 rounded-b-xl">
            <div class="flex flex-col sm:flex-row items-center justify-between gap-3">
                <div class="text-xs sm:text-sm text-surface-500">
                    Показано <span class="font-medium" x-text="filteredArticles.length"></span> 
                    з <span class="font-medium" x-text="articles.length"></span> статей
                </div>
                
                <div class="flex flex-wrap items-center gap-1">
                    <button @click="currentPage = 1" 
                            :disabled="currentPage === 1"
                            class="px-3 py-1 text-sm rounded-lg transition disabled:opacity-50 disabled:cursor-not-allowed"
                            :class="currentPage === 1 ? 'bg-surface-100 text-surface-400' : 'bg-surface-100 text-surface-700 hover:bg-surface-200'">
                        <i class="fas fa-angle-double-left"></i>
                    </button>
                    
                    <button @click="currentPage--" 
                            :disabled="currentPage === 1"
                            class="px-3 py-1 text-sm rounded-lg transition disabled:opacity-50 disabled:cursor-not-allowed"
                            :class="currentPage === 1 ? 'bg-surface-100 text-surface-400' : 'bg-surface-100 text-surface-700 hover:bg-surface-200'">
                        <i class="fas fa-chevron-left"></i>
                    </button>
                    
                    <template x-for="page in getPageRange()" :key="page">
                        <button @click="currentPage = page" 
                                class="px-3 py-1 text-sm rounded-lg transition"
                                :class="page === currentPage ? 'bg-primary-600 text-white' : 'bg-surface-100 text-surface-700 hover:bg-surface-200'"
                                x-text="page">
                        </button>
                    </template>
                    
                    <button @click="currentPage++" 
                            :disabled="currentPage === totalPages"
                            class="px-3 py-1 text-sm rounded-lg transition disabled:opacity-50 disabled:cursor-not-allowed"
                            :class="currentPage === totalPages ? 'bg-surface-100 text-surface-400' : 'bg-surface-100 text-surface-700 hover:bg-surface-200'">
                        <i class="fas fa-chevron-right"></i>
                    </button>
                    
                    <button @click="currentPage = totalPages" 
                            :disabled="currentPage === totalPages"
                            class="px-3 py-1 text-sm rounded-lg transition disabled:opacity-50 disabled:cursor-not-allowed"
                            :class="currentPage === totalPages ? 'bg-surface-100 text-surface-400' : 'bg-surface-100 text-surface-700 hover:bg-surface-200'">
                        <i class="fas fa-angle-double-right"></i>
                    </button>
                    
                    <div class="ml-2">
                        <select x-model="itemsPerPage" 
                                @change="updatePagination()"
                                class="text-sm rounded-lg border border-surface-300 bg-surface-0 text-surface-700 px-2 py-1 focus:ring-2 focus:ring-primary-500 focus:border-transparent transition">
                            <option value="5">5</option>
                            <option value="10" selected>10</option>
                            <option value="15">15</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Empty State -->
    <div x-show="!loading && filteredArticles.length === 0" class="bg-surface-0 rounded-xl border-2 border-dashed border-surface-300 p-12 text-center">
        <i class="fas fa-newspaper text-5xl text-surface-400 mb-4"></i>
        <h3 class="text-xl font-semibold text-surface-900 mb-2" x-text="searchQuery ? 'Нічого не знайдено' : 'Немає статей'"></h3>
        <p class="text-surface-500 mb-6" x-text="searchQuery ? 'Спробуйте змінити пошуковий запит' : 'Створіть першу статтю, щоб почати публікувати контент'"></p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
            <a href="{{ path('admin_article_new') }}" class="inline-flex items-center gap-2 px-6 py-3 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-colors">
                <i class="fas fa-plus"></i> Створити статтю
            </a>
            <button x-show="searchQuery || currentStatus" 
                    @click="resetFilters()"
                    class="inline-flex items-center gap-2 px-6 py-3 bg-surface-200 text-surface-700 rounded-lg hover:bg-surface-300 transition-colors">
                <i class="fas fa-times"></i> Очистити фільтри
            </button>
        </div>
    </div>
</main>

<script>
function articlesManager() {
    return {
        articles: [],
        filteredArticles: [],
        currentStatus: null,
        searchQuery: '',
        totalViews: 0,
        flashes: [],
        loading: false,
        
        // Пагінація
        currentPage: 1,
        itemsPerPage: 10,
        totalPages: 1,
        
        init() {
            this.loadArticles();
        },
        
        async loadArticles() {
            this.loading = true;
            
            try {
                const response = await fetch('/admin/articles/api', {
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'application/json'
                    }
                });
                
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                
                const data = await response.json();
                
                this.articles = data.articles || [];
                this.filterArticles();
                this.calculateTotalViews();
                this.updatePagination();
            } catch (error) {
                console.error('Error loading articles:', error);
                this.addFlash('error', 'Помилка завантаження статей');
            } finally {
                this.loading = false;
            }
        },
        
        filterArticles() {
            let filtered = [...this.articles];
            
            if (this.currentStatus) {
                filtered = filtered.filter(a => a.status === this.currentStatus);
            }
            
            if (this.searchQuery) {
                const query = this.searchQuery.toLowerCase();
                filtered = filtered.filter(a => 
                    a.title.toLowerCase().includes(query) || 
                    (a.excerpt && a.excerpt.toLowerCase().includes(query)) ||
                    (a.category && a.category.name && a.category.name.toLowerCase().includes(query))
                );
            }
            
            this.filteredArticles = filtered;
            this.totalPages = Math.ceil(this.filteredArticles.length / this.itemsPerPage);
            if (this.currentPage > this.totalPages) {
                this.currentPage = 1;
            }
        },
        
        updatePagination() {
            this.totalPages = Math.ceil(this.filteredArticles.length / this.itemsPerPage);
            if (this.currentPage > this.totalPages) {
                this.currentPage = 1;
            }
        },
        
        getPageRange() {
            const range = [];
            const total = this.totalPages;
            const current = this.currentPage;
            const delta = 2;
            
            let left = current - delta;
            let right = current + delta;
            
            if (left < 1) {
                right += Math.abs(left) + 1;
                left = 1;
            }
            
            if (right > total) {
                left -= right - total;
                right = total;
            }
            
            if (left < 1) left = 1;
            
            for (let i = left; i <= right; i++) {
                range.push(i);
            }
            
            return range;
        },
        
        filterByStatus(status) {
            this.currentStatus = status;
            this.currentPage = 1;
            this.filterArticles();
        },
        
        resetFilters() {
            this.currentStatus = null;
            this.searchQuery = '';
            this.currentPage = 1;
            this.filterArticles();
        },
        
        getStatusCount(status) {
            return this.articles.filter(a => a.status === status).length;
        },
        
        calculateTotalViews() {
            this.totalViews = this.articles.reduce((sum, a) => sum + (a.views || 0), 0);
        },
        
        getStatusLabel(status) {
            const labels = {
                'published': 'Опубліковано',
                'draft': 'Чернетка',
                'pending': 'На модерації',
                'approved': 'Схвалено',
                'rejected': 'Відхилено',
                'archived': 'Архів'
            };
            return labels[status] || status;
        },
        
        getStatusClass(status) {
            const classes = {
                'published': 'bg-green-100 text-green-800',
                'draft': 'bg-amber-100 text-amber-800',
                'pending': 'bg-blue-100 text-blue-800',
                'approved': 'bg-purple-100 text-purple-800',
                'rejected': 'bg-red-100 text-red-800',
                'archived': 'bg-gray-100 text-gray-800'
            };
            return classes[status] || 'bg-gray-100 text-gray-800';
        },
        
        getStatusIcon(status) {
            const icons = {
                'published': 'fas fa-check-circle',
                'draft': 'fas fa-edit',
                'pending': 'fas fa-clock',
                'approved': 'fas fa-thumbs-up',
                'rejected': 'fas fa-times-circle',
                'archived': 'fas fa-archive'
            };
            return icons[status] || 'fas fa-circle';
        },
        
        formatDate(date) {
            if (!date) return '—';
            const d = new Date(date);
            return d.toLocaleDateString('uk-UA');
        },
        
        formatTime(date) {
            if (!date) return '—';
            const d = new Date(date);
            return d.toLocaleTimeString('uk-UA', { hour: '2-digit', minute: '2-digit' });
        },
        
        async changeStatus(articleId, newStatus, csrfToken) {
            const article = this.articles.find(a => a.id === articleId);
            if (!article) return;
            
            try {
                const response = await fetch(`/admin/articles/${articleId}/change-status/${newStatus}`, {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': csrfToken
                    },
                    body: JSON.stringify({
                        _token: csrfToken
                    })
                });
                
                const data = await response.json();
                
                if (data.success) {
                    const article = this.articles.find(a => a.id === articleId);
                    if (article) {
                        article.status = newStatus;
                        if (newStatus === 'published') {
                            article.publishedAt = new Date().toISOString();
                        }
                    }
                    this.filterArticles();
                    this.calculateTotalViews();
                    this.addFlash('success', data.message || 'Статус змінено');
                } else {
                    this.addFlash('error', data.message || 'Помилка зміни статусу');
                }
            } catch (error) {
                console.error('Error:', error);
                this.addFlash('error', 'Помилка мережі');
            }
        },
        
        async deleteArticle(articleId, csrfToken) {
            if (!confirm('Ви впевнені, що хочете видалити цю статтю?')) return;
            
            try {
                const response = await fetch(`/admin/articles/${articleId}/delete`, {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': csrfToken
                    },
                    body: JSON.stringify({
                        _token: csrfToken
                    })
                });
                
                const data = await response.json();
                
                if (data.success) {
                    this.articles = this.articles.filter(a => a.id !== articleId);
                    this.filterArticles();
                    this.calculateTotalViews();
                    this.addFlash('success', 'Статтю видалено');
                } else {
                    this.addFlash('error', data.message || 'Помилка видалення');
                }
            } catch (error) {
                console.error('Error:', error);
                this.addFlash('error', 'Помилка мережі');
            }
        },
        
        addFlash(type, message) {
            const id = Date.now();
            this.flashes.push({ id, type, message });
            setTimeout(() => this.removeFlash(id), 5000);
        },
        
        removeFlash(id) {
            this.flashes = this.flashes.filter(f => f.id !== id);
        }
    }
}
</script>

<style>
[x-cloak] { display: none !important; }
@keyframes fadeIn {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
}
.animate-fade-in { animation: fadeIn 0.3s ease-out; }
.line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}
</style>
{% endblock %}