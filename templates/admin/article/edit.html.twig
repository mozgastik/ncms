{# templates/admin/article/edit.html.twig #}
{% extends 'admin/base.html.twig' %}

{% block title %}{% if article.id %}Редагування новини{% else %}Створення новини{% endif %} - Адмін панель{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    [x-cloak] { display: none !important; }
    
    .form-section {
        background: white;
        border-radius: 1rem;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        border: 1px solid #e5e7eb;
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
    }
    .dark .form-section {
        background: #1f2937;
        border-color: #374151;
    }
    
    .form-section-title {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 1.25rem;
        font-weight: 600;
        color: #111827;
        margin-bottom: 1.25rem;
        padding-bottom: 0.75rem;
        border-bottom: 2px solid #e5e7eb;
    }
    .dark .form-section-title {
        color: #f9fafb;
        border-bottom-color: #374151;
    }
    
    .form-section-title i {
        color: #3b82f6;
    }
    
    .ql-editor {
        min-height: 400px;
        font-size: 16px;
        line-height: 1.6;
    }
    .ql-toolbar {
        border-radius: 0.5rem 0.5rem 0 0;
        background: #f9fafb;
        border-color: #e5e7eb;
    }
    .ql-container {
        border-radius: 0 0 0.5rem 0.5rem;
        font-family: inherit;
    }
    .dark .ql-toolbar {
        background: #1f2937;
        border-color: #374151;
    }
    .dark .ql-container {
        background: #111827;
        border-color: #374151;
    }
    .dark .ql-editor {
        color: #f3f4f6;
    }
    
    .image-upload-area {
        border: 2px dashed #3b82f6;
        border-radius: 1rem;
        transition: all 0.3s ease;
        background: linear-gradient(135deg, #f0f9ff, #e0f2fe);
        cursor: pointer;
    }
    .dark .image-upload-area {
        background: linear-gradient(135deg, #1e3a8a, #1e40af);
        border-color: #60a5fa;
    }
    .image-upload-area.drag-over {
        border-color: #1d4ed8;
        background: linear-gradient(135deg, #bae6fd, #7dd3fc);
        transform: translateY(-2px);
    }
    
    .preview-image {
        position: relative;
        overflow: hidden;
        border-radius: 0.75rem;
        border: 1px solid #e5e7eb;
        transition: all 0.3s;
        background: white;
    }
    .dark .preview-image {
        background: #1f2937;
        border-color: #374151;
    }
    .preview-image:hover {
        transform: scale(1.02);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    }
    .preview-image img {
        width: 100%;
        height: 160px;
        object-fit: cover;
    }
    .preview-overlay {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.6);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        opacity: 0;
        transition: opacity 0.3s;
    }
    .preview-image:hover .preview-overlay {
        opacity: 1;
    }
    
    .tag-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.375rem 0.875rem;
        background: linear-gradient(135deg, #3b82f6, #6366f1);
        color: white;
        border-radius: 9999px;
        font-size: 0.875rem;
        transition: all 0.2s;
    }
    .tag-badge:hover {
        transform: scale(1.05);
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
    }
    
    .progress-bar {
        height: 6px;
        background: #e5e7eb;
        border-radius: 3px;
        overflow: hidden;
    }
    .progress-fill {
        height: 100%;
        background: linear-gradient(90deg, #3b82f6, #8b5cf6);
        width: 0%;
        transition: width 0.3s ease;
    }
    
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(-10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in {
        animation: fadeIn 0.3s ease-out;
    }
</style>
{% endblock %}

{% block body %}
<div x-data="articleForm()" x-init="init()" x-cloak class="flex-1 p-4 lg:p-6">
    
    <!-- Flash Messages -->
    <template x-for="flash in flashes" :key="flash.id">
        <div class="fixed top-4 right-4 z-50 px-4 py-3 rounded-lg shadow-lg animate-fade-in max-w-md"
             :class="flash.type === 'success' ? 'bg-green-100 text-green-800 border border-green-200' : 'bg-red-100 text-red-800 border border-red-200'">
            <div class="flex items-center gap-3">
                <i :class="flash.type === 'success' ? 'fas fa-check-circle' : 'fas fa-exclamation-circle'"></i>
                <span class="font-medium flex-1" x-text="flash.message"></span>
                <button @click="removeFlash(flash.id)" class="hover:opacity-70">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        </div>
    </template>

    <!-- Header -->
    <div class="mb-6">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 mb-6">
            <div>
                <h1 class="text-2xl lg:text-3xl font-bold text-gray-900 dark:text-white">
                    <i class="fas fa-newspaper text-blue-600 mr-2"></i>
                    <span x-text="isEdit ? 'Редагування новини' : 'Створення новини'"></span>
                </h1>
                <p class="text-gray-600 dark:text-gray-400 mt-1" x-text="isEdit ? 'Оновіть інформацію про новину' : 'Заповніть форму для публікації нової новини'"></p>
            </div>
            <div class="flex flex-wrap gap-2">
                <a href="{{ path('admin_articles') }}" class="inline-flex items-center gap-2 px-4 py-2.5 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 font-medium rounded-lg hover:bg-gray-50 dark:hover:bg-gray-800 transition-all">
                    <i class="fas fa-arrow-left text-sm"></i> Назад до списку
                </a>
                <template x-if="isEdit && isPublished">
                    <a :href="'/article/' + slug" target="_blank" class="inline-flex items-center gap-2 px-4 py-2.5 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-all">
                        <i class="fas fa-external-link-alt text-sm"></i> Переглянути
                    </a>
                </template>
            </div>
        </div>
        
        <!-- Meta Info -->
        <template x-if="isEdit">
            <div class="flex flex-wrap items-center gap-4 p-4 bg-gray-50 dark:bg-gray-800 rounded-lg animate-fade-in">
                <span class="px-3 py-1 rounded-full text-xs font-semibold uppercase"
                      :class="statusClass">
                    <span x-text="statusLabel"></span>
                </span>
                <span class="text-sm text-gray-600 dark:text-gray-400">
                    <i class="far fa-calendar mr-1"></i> Створено: <span x-text="formatDate(createdAt)"></span>
                </span>
                <span class="text-sm text-gray-600 dark:text-gray-400">
                    <i class="fas fa-sync-alt mr-1"></i> Оновлено: <span x-text="formatDate(updatedAt)"></span>
                </span>
                <span class="text-sm text-gray-600 dark:text-gray-400 ml-auto">
                    <i class="fas fa-user-edit mr-1"></i> Автор: {{ article.author.username }}
                </span>
            </div>
        </template>
    </div>

    <!-- Main Form -->
    <form @submit.prevent="submitForm" id="articleForm" enctype="multipart/form-data" class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <!-- Left Column -->
        <div class="lg:col-span-2 space-y-6">
            
            <!-- Basic Info -->
            <div class="form-section">
                <div class="form-section-title">
                    <i class="fas fa-info-circle"></i> Основна інформація
                </div>
                <div class="space-y-5">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Заголовок новини *</label>
                        <input type="text" x-model="title" @input="generateSlug" 
                               class="w-full px-4 py-3 text-lg border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
                               placeholder="Введіть заголовок новини...">
                        <p class="mt-2 text-sm text-gray-500">Напишіть короткий та змістовний заголовок, який приверне увагу читачів</p>
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">URL-адреса (slug)</label>
                        <div class="relative">
                            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">/news/</span>
                            <input type="text" x-model="slug" 
                                   class="w-full pl-20 pr-3 py-2.5 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
                                   placeholder="avtomatychnyy-slug">
                        </div>
                        <p class="mt-2 text-sm text-gray-500">Залиште порожнім для автоматичного створення на основі заголовка</p>
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Короткий опис *</label>
                        <textarea x-model="excerpt" maxlength="200" rows="3"
                                  class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
                                  placeholder="Короткий опис новини (максимум 200 символів)..."></textarea>
                        <div class="flex justify-between mt-2">
                            <p class="text-sm text-gray-500">Цей текст відображатиметься на головній сторінці</p>
                            <span class="text-sm" :class="excerpt.length > 190 ? 'text-red-500 font-bold' : 'text-gray-500'" x-text="excerpt.length + '/200'"></span>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Content with Quill -->
            <div class="form-section">
                <div class="form-section-title">
                    <i class="fas fa-align-left"></i> Основний текст
                    <button type="button" @click="toggleFullscreen" class="ml-auto text-gray-500 hover:text-gray-700">
                        <i class="fas fa-expand-arrows-alt"></i>
                    </button>
                </div>
                <div id="quill-editor" style="min-height: 400px;"></div>
                <p class="mt-2 text-sm text-gray-500">Використовуйте редактор для форматування тексту. Для найкращого результату додавайте заголовки, списки та зображення.</p>
            </div>
            
            <!-- Images -->
            <div class="form-section">
                <div class="form-section-title">
                    <i class="fas fa-images"></i> Медіа
                </div>
                
                <!-- Upload Area -->
                <div class="image-upload-area rounded-xl p-8 text-center cursor-pointer transition-all"
                     @click="openFilePicker"
                     @dragover.prevent="dragOver = true"
                     @dragleave.prevent="dragOver = false"
                     @drop.prevent="handleDrop($event)"
                     :class="{'drag-over': dragOver}">
                    <input type="file" id="fileInput" class="hidden" accept="image/*" multiple @change="handleFileSelect($event)">
                    <div class="space-y-4">
                        <div class="mx-auto w-16 h-16 rounded-full bg-white/50 dark:bg-gray-800/50 flex items-center justify-center">
                            <i class="fas fa-cloud-upload-alt text-3xl text-blue-600"></i>
                        </div>
                        <div>
                            <p class="text-lg font-semibold text-gray-900 dark:text-white">Перетягніть зображення сюди</p>
                            <p class="text-sm text-gray-600 dark:text-gray-300 mt-1">або клікніть для вибору файлів</p>
                        </div>
                        <div class="text-xs text-gray-500 space-y-1">
                            <p><i class="fas fa-check text-green-500 mr-1"></i>PNG, JPG, WebP</p>
                            <p><i class="fas fa-check text-green-500 mr-1"></i>До 5MB кожне</p>
                            <p><i class="fas fa-check text-green-500 mr-1"></i>Рекомендовано 1200×630px</p>
                        </div>
                    </div>
                </div>
                
                <!-- Progress -->
                <div x-show="uploading" x-cloak class="mt-4">
                    <div class="flex justify-between text-sm mb-2">
                        <span class="text-gray-700 dark:text-gray-300 font-medium" x-text="uploadMessage"></span>
                        <span class="font-bold text-blue-600" x-text="uploadProgress + '%'"></span>
                    </div>
                    <div class="progress-bar">
                        <div class="progress-fill" :style="'width: ' + uploadProgress + '%'"></div>
                    </div>
                </div>
                
                <!-- Gallery -->
                <div x-show="uploadedImages.length > 0" x-cloak class="mt-6">
                    <h4 class="text-sm font-medium mb-3">Завантажені зображення</h4>
                    <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                        <template x-for="(image, index) in uploadedImages" :key="image.id">
                            <div class="preview-image group">
                                <img :src="image.url" :alt="image.name">
                                <div class="absolute top-2 left-2" x-show="coverImage === image.url">
                                    <span class="px-2 py-1 bg-green-500 text-white text-xs font-bold rounded-full">
                                        <i class="fas fa-star mr-1"></i>Головна
                                    </span>
                                </div>
                                <div class="preview-overlay">
                                    <button @click="setAsCover(image.url)" class="p-2 bg-blue-500 hover:bg-blue-600 text-white rounded-full transition" title="Встановити обкладинку">
                                        <i class="fas fa-star text-sm"></i>
                                    </button>
                                    <button @click="insertIntoEditor(image.url)" class="p-2 bg-green-500 hover:bg-green-600 text-white rounded-full transition" title="Вставити в текст">
                                        <i class="fas fa-plus text-sm"></i>
                                    </button>
                                    <button @click="removeImage(index)" class="p-2 bg-red-500 hover:bg-red-600 text-white rounded-full transition" title="Видалити">
                                        <i class="fas fa-trash text-sm"></i>
                                    </button>
                                </div>
                            </div>
                        </template>
                    </div>
                </div>
                
                <!-- Featured Image -->
                <div class="mt-6">
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Головне зображення *</label>
                    <input type="text" x-model="coverImage" 
                           class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
                           placeholder="https://example.com/image.jpg">
                    <p class="mt-2 text-sm text-gray-500">Введіть URL або виберіть з завантажених зображень</p>
                    
                    <!-- Cover Preview -->
                    <div x-show="coverImage" x-cloak class="mt-4 p-4 bg-blue-50 dark:bg-blue-900/20 rounded-lg">
                        <p class="text-sm font-medium text-blue-700 dark:text-blue-300 mb-2">Попередній перегляд обкладинки:</p>
                        <div class="relative inline-block">
                            <img :src="coverImage" class="w-48 h-28 object-cover rounded-lg border-2 border-blue-500">
                            <button @click="clearCoverImage" class="absolute -top-2 -right-2 bg-red-500 text-white rounded-full w-6 h-6 flex items-center justify-center text-xs hover:bg-red-600 transition">
                                ✕
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Right Column -->
        <div class="space-y-6">
            
            <!-- Category & Tags -->
            <div class="form-section">
                <div class="form-section-title">
                    <i class="fas fa-tags"></i> Категорія та теги
                </div>
                
                <div class="space-y-5">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Категорія *</label>
                        {{ form_widget(form.category, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500', 'x-model': 'categoryId'}}) }}
                        <a href="{{ path('admin_category_new') }}" target="_blank" class="inline-flex items-center gap-1 text-sm text-blue-600 hover:text-blue-700 mt-2">
                            <i class="fas fa-plus-circle"></i> Створити нову категорію
                        </a>
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Теги</label>
                        <div class="flex gap-2 mb-3">
                            <input type="text" x-model="newTag" @keyup.enter="addTag" placeholder="Введіть тег..." 
                                   class="flex-1 px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500">
                            <button type="button" @click="addTag" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition">
                                <i class="fas fa-plus"></i>
                            </button>
                        </div>
                        <div class="flex flex-wrap gap-2">
                            <template x-for="(tag, index) in selectedTags" :key="tag.id">
                                <span class="tag-badge">
                                    <span x-text="tag.name"></span>
                                    <button @click="removeTag(index)" class="hover:text-red-300 transition">
                                        <i class="fas fa-times text-xs"></i>
                                    </button>
                                </span>
                            </template>
                            <span x-show="selectedTags.length === 0" class="text-sm text-gray-500 italic">Додайте теги для кращої організації новин</span>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Publish Settings -->
            <div class="form-section">
                <div class="form-section-title">
                    <i class="fas fa-bullhorn"></i> Публікація
                </div>
                
                <div class="space-y-5">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Статус *</label>
                        <select x-model="status" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500">
                            <option value="draft">Чернетка</option>
                            <option value="pending">На модерації</option>
                            <option value="published">Опубліковано</option>
                            <option value="archived">Архів</option>
                        </select>
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Пріоритет</label>
                        <select x-model="priority" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500">
                            <option value="low">Низький</option>
                            <option value="medium">Середній</option>
                            <option value="high">Високий</option>
                        </select>
                    </div>
                    
                    <div class="flex items-center justify-between p-4 bg-gradient-to-r from-red-50 to-orange-50 dark:from-red-900/20 dark:to-orange-900/20 rounded-xl border border-red-200">
                        <div>
                            <div class="flex items-center gap-2 mb-1">
                                <i class="fas fa-bolt text-red-500"></i>
                                <label class="text-lg font-bold text-gray-900 dark:text-white cursor-pointer">Новина!</label>
                            </div>
                            <p class="text-sm text-gray-600 dark:text-gray-400">Позначити як спеціальну новину</p>
                        </div>
                        <div class="relative">
                            <input type="checkbox" x-model="isBreaking" class="sr-only peer">
                            <div class="w-14 h-8 flex items-center bg-gray-300 dark:bg-gray-600 rounded-full p-1 cursor-pointer peer-checked:bg-gradient-to-r peer-checked:from-red-500 peer-checked:to-orange-500 transition-all"
                                 :class="{'bg-gradient-to-r from-red-500 to-orange-500': isBreaking}">
                                <div class="bg-white w-6 h-6 rounded-full shadow-md transition-transform"
                                     :class="{'translate-x-6': isBreaking}"></div>
                            </div>
                        </div>
                    </div>
                    
                    <button type="submit" class="w-full py-4 bg-gradient-to-r from-blue-600 to-blue-700 text-white font-bold rounded-xl shadow-lg hover:shadow-xl hover:from-blue-700 hover:to-blue-800 transition-all transform hover:scale-[1.02] active:scale-95">
                        <i class="fas fa-paper-plane mr-2"></i>
                        <span x-text="isEdit ? 'Оновити новину' : 'Опублікувати новину'"></span>
                    </button>
                    
                    <button type="button" @click="saveAsDraft" class="w-full py-3 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 font-medium rounded-lg hover:bg-gray-50 dark:hover:bg-gray-800 transition-all">
                        <i class="fas fa-save mr-2"></i> Зберегти як чернетку
                    </button>
                </div>
            </div>
            
            <!-- Statistics -->
            <template x-if="isEdit">
                <div class="form-section">
                    <div class="form-section-title">
                        <i class="fas fa-chart-line"></i> Статистика
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div class="text-center p-4 bg-gray-50 dark:bg-gray-800 rounded-lg">
                            <div class="text-2xl font-bold text-gray-900 dark:text-white" x-text="views"></div>
                            <div class="text-xs text-gray-500 uppercase">Переглядів</div>
                        </div>
                        <div class="text-center p-4 bg-gray-50 dark:bg-gray-800 rounded-lg">
                            <div class="text-2xl font-bold text-gray-900 dark:text-white" x-text="readingTime"></div>
                            <div class="text-xs text-gray-500 uppercase">Хв читання</div>
                        </div>
                    </div>
                </div>
            </template>
        </div>
    </form>
</div>

<script>
function articleForm() {
    return {
        // Article data
        id: {{ article.id ?? 0 }},
        title: '{{ article.title|default('')|escape('js') }}',
        slug: '{{ article.slug|default('')|escape('js') }}',
        excerpt: '{{ article.excerpt|default('')|escape('js') }}',
        content: '{{ article.content|default('')|escape('js') }}',
        coverImage: '{{ article.coverImage|default('')|escape('js') }}',
        status: '{{ article.status|default('draft')|escape('js') }}',
        priority: '{{ article.priority|default('medium')|escape('js') }}',
        isBreaking: {{ article.isBreaking|default(false)|json_encode }},
        categoryId: '{{ article.category.id|default('') }}',
        views: {{ article.views|default(0) }},
        readingTime: {{ article.readingTime|default(5) }},
        createdAt: '{{ article.createdAt|default(null) ? article.createdAt|date('Y-m-d H:i:s') : null }}',
        updatedAt: '{{ article.updatedAt|default(null) ? article.updatedAt|date('Y-m-d H:i:s') : null }}',
        isPublished: '{{ article.status|default('') }}' === 'published',
        isEdit: {{ article.id ? true : false }},
        
        // UI state
        selectedTags: {{ article.tags|default([])|map(t => {id: t.id, name: t.name})|json_encode|raw }},
        newTag: '',
        uploadedImages: [],
        dragOver: false,
        uploading: false,
        uploadProgress: 0,
        uploadMessage: '',
        flashes: [],
        quill: null,
        
        // Computed
        get statusLabel() {
            const labels = {
                'published': 'Опубліковано',
                'draft': 'Чернетка',
                'pending': 'На модерації',
                'archived': 'Архів'
            };
            return labels[this.status] || this.status;
        },
        
        get statusClass() {
            const classes = {
                'published': 'bg-green-100 text-green-800',
                'draft': 'bg-yellow-100 text-yellow-800',
                'pending': 'bg-blue-100 text-blue-800',
                'archived': 'bg-gray-100 text-gray-800'
            };
            return classes[this.status] || 'bg-gray-100 text-gray-800';
        },
        
        // Methods
        init() {
            this.$nextTick(() => {
                this.initQuill();
                this.loadTags();
            });
        },
        
        initQuill() {
            const container = document.querySelector('#quill-editor');
            if (container) {
                this.quill = new Quill(container, {
                    theme: 'snow',
                    placeholder: 'Текст вашої новини...',
                    modules: {
                        toolbar: [
                            [{ 'header': [1, 2, 3, false] }],
                            ['bold', 'italic', 'underline', 'strike'],
                            ['blockquote', 'code-block'],
                            [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                            ['link', 'image'],
                            ['clean']
                        ]
                    }
                });
                
                if (this.content) {
                    this.quill.root.innerHTML = this.content;
                }
                
                this.quill.on('text-change', () => {
                    this.content = this.quill.root.innerHTML;
                });
            }
        },
        
        loadTags() {
            fetch('/admin/tags/api')
                .then(res => res.json())
                .then(data => {
                    this.allTags = data;
                })
                .catch(err => console.error('Error loading tags:', err));
        },
        
        generateSlug() {
            if (!this.slug && this.title) {
                const translit = {
                    'а':'a','б':'b','в':'v','г':'h','ґ':'g','д':'d','е':'e','є':'ye',
                    'ж':'zh','з':'z','и':'y','і':'i','ї':'yi','й':'y','к':'k','л':'l',
                    'м':'m','н':'n','о':'o','п':'p','р':'r','с':'s','т':'t','у':'u',
                    'ф':'f','х':'kh','ц':'ts','ч':'ch','ш':'sh','щ':'shch','ю':'yu','я':'ya'
                };
                this.slug = this.title.toLowerCase()
                    .split('')
                    .map(char => translit[char] || char)
                    .join('')
                    .replace(/[^a-z0-9-]/g, '-')
                    .replace(/-+/g, '-')
                    .replace(/^-|-$/g, '')
                    .substring(0, 100);
            }
        },
        
        addTag() {
            if (this.newTag.trim()) {
                this.selectedTags.push({
                    id: 'new_' + Date.now(),
                    name: this.newTag.trim()
                });
                this.newTag = '';
            }
        },
        
        removeTag(index) {
            this.selectedTags.splice(index, 1);
        },
        
        openFilePicker() {
            document.getElementById('fileInput').click();
        },
        
        async handleFileSelect(event) {
            const files = Array.from(event.target.files);
            await this.uploadFiles(files);
            event.target.value = '';
        },
        
        async handleDrop(event) {
            event.preventDefault();
            this.dragOver = false;
            const files = Array.from(event.dataTransfer.files);
            await this.uploadFiles(files);
        },
        
        async uploadFiles(files) {
            for (const file of files) {
                if (!file.type.startsWith('image/')) {
                    this.addFlash('error', 'Можна завантажувати тільки зображення');
                    continue;
                }
                if (file.size > 5 * 1024 * 1024) {
                    this.addFlash('error', `Файл ${file.name} занадто великий (макс. 5MB)`);
                    continue;
                }
                
                const reader = new FileReader();
                reader.onload = (e) => {
                    this.uploadedImages.push({
                        id: Date.now(),
                        url: e.target.result,
                        name: file.name
                    });
                };
                reader.readAsDataURL(file);
                
                this.uploading = true;
                this.uploadProgress = 0;
                this.uploadMessage = `Завантаження ${file.name}...`;
                
                for (let i = 0; i <= 100; i += 10) {
                    await new Promise(r => setTimeout(r, 30));
                    this.uploadProgress = i;
                }
                
                this.uploadMessage = '✅ Завантаження завершено!';
                setTimeout(() => {
                    this.uploading = false;
                }, 500);
            }
        },
        
        removeImage(index) {
            this.uploadedImages.splice(index, 1);
        },
        
        setAsCover(url) {
            this.coverImage = url;
        },
        
        clearCoverImage() {
            this.coverImage = '';
        },
        
        insertIntoEditor(url) {
            if (this.quill) {
                const range = this.quill.getSelection();
                this.quill.insertEmbed(range ? range.index : this.quill.getLength(), 'image', url);
            }
        },
        
        toggleFullscreen() {
            const editor = document.querySelector('.ql-container');
            if (editor) {
                editor.classList.toggle('ql-fullscreen');
                document.body.classList.toggle('overflow-hidden');
            }
        },
        
        async submitForm() {
            if (!this.title) {
                this.addFlash('error', 'Будь ласка, введіть заголовок новини');
                return;
            }
            if (!this.excerpt) {
                this.addFlash('error', 'Будь ласка, введіть короткий опис');
                return;
            }
            if (!this.content || this.content.length < 50) {
                this.addFlash('error', 'Текст новини має бути не менше 50 символів');
                return;
            }
            if (!this.coverImage) {
                this.addFlash('error', 'Будь ласка, додайте головне зображення');
                return;
            }
            if (!this.categoryId) {
                this.addFlash('error', 'Будь ласка, оберіть категорію');
                return;
            }
            
            const formData = new FormData();
            formData.append('title', this.title);
            formData.append('slug', this.slug);
            formData.append('excerpt', this.excerpt);
            formData.append('content', this.content);
            formData.append('coverImage', this.coverImage);
            formData.append('status', this.status);
            formData.append('priority', this.priority);
            formData.append('isBreaking', this.isBreaking ? 1 : 0);
            formData.append('category', this.categoryId);
            formData.append('tags', JSON.stringify(this.selectedTags.map(t => t.name)));
            
            try {
                const response = await fetch(this.isEdit ? `/admin/articles/${this.id}/edit` : '/admin/articles/new', {
                    method: 'POST',
                    body: formData,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                
                const data = await response.json();
                if (data.success) {
                    this.addFlash('success', data.message);
                    setTimeout(() => {
                        window.location.href = '/admin/articles';
                    }, 1500);
                } else {
                    this.addFlash('error', data.message || 'Помилка збереження');
                }
            } catch (error) {
                this.addFlash('error', 'Помилка мережі');
            }
        },
        
        saveAsDraft() {
            this.status = 'draft';
            this.submitForm();
        },
        
        addFlash(type, message) {
            const id = Date.now();
            this.flashes.push({ id, type, message });
            setTimeout(() => this.removeFlash(id), 5000);
        },
        
        removeFlash(id) {
            this.flashes = this.flashes.filter(f => f.id !== id);
        },
        
        formatDate(date) {
            if (!date) return '—';
            const d = new Date(date);
            return d.toLocaleDateString('uk-UA') + ' ' + d.toLocaleTimeString('uk-UA', { hour: '2-digit', minute: '2-digit' });
        }
    }
}
</script>

<style>
.ql-fullscreen {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    width: 100% !important;
    height: 100% !important;
    z-index: 9999 !important;
    background: white;
}
.dark .ql-fullscreen {
    background: #1f2937;
}
</style>
{% endblock %}