<aside 
    id="sidebar"
    x-data="{ 
        selected: localStorage.getItem('selectedMenuItem') || 'dashboard',
        isCollapsed: localStorage.getItem('sidebarCollapsed') === 'true'
    }"
    x-init="$watch('selected', value => localStorage.setItem('selectedMenuItem', value))"
    :class="[
        isCollapsed ? 'lg:w-[90px]' : 'lg:w-[256px]',
        sidebarToggle ? 'translate-x-0' : '-translate-x-full lg:translate-x-0'
    ]"
    class="sidebar fixed lg:sticky top-0 left-0 z-40 h-screen bg-surface-0 dark:bg-surface-900 border-r border-surface-200 dark:border-surface-800 shadow-xl lg:shadow-none transition-all duration-300 ease-in-out"
    @click.outside="window.innerWidth < 1024 ? sidebarToggle = false : null"
>
    <!-- Overlay для мобільної версії -->
    <div 
        id="sidebar-overlay" 
        class="fixed inset-0 bg-black/50 lg:hidden z-30 transition-opacity duration-300"
        :class="sidebarToggle ? 'block' : 'hidden'"
        @click="sidebarToggle = false"
    ></div>
    
    <!-- Контейнер сайдбару -->
    <div class="relative h-full flex flex-col">
        <!-- Кнопка згортання/розгортання -->
        <button 
            id="sidebar-toggle"
            @click="isCollapsed = !isCollapsed"
            :title="isCollapsed ? 'Розгорнути меню' : 'Згорнути меню'"
            class="absolute -right-3 top-6 z-50 w-6 h-6 flex items-center justify-center bg-white dark:bg-surface-800 border border-surface-200 dark:border-surface-700 rounded-full shadow-lg hover:shadow-xl hover:scale-110 transition-all duration-200 focus-ring hidden lg:flex"
        >
            <i :class="isCollapsed ? 'fa-chevron-right' : 'fa-chevron-left'" class="fas text-surface-600 dark:text-surface-400 text-sm"></i>
        </button>
        
        <!-- Логотип -->
        <div class="p-4 lg:p-6 border-b border-surface-200 dark:border-surface-800">
            <a href="{{ path('admin_dashboard') }}" class="flex items-center" :class="isCollapsed ? 'lg:justify-center' : 'lg:space-x-3'">
                <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-primary-500 to-primary-600 flex items-center justify-center flex-shrink-0 shadow-md">
                    <i class="fas fa-newspaper text-white"></i>
                </div>
                <div x-show="!isCollapsed" class="hidden lg:block">
                    <p class="text-xs text-surface-500 whitespace-nowrap">Адмін-панель</p>
                </div>
                <!-- Скорочений логотип для згорнутого стану -->
                <div x-show="isCollapsed" class="hidden lg:block">
                    <p class="text-xs text-surface-500">АП</p>
                </div>
            </a>
        </div>
        
        <!-- Меню навігації -->
        <nav class="flex-1 p-4 space-y-6 overflow-y-auto scrollbar-thin scrollbar-thumb-surface-300 dark:scrollbar-thumb-surface-700 scrollbar-track-transparent">
            
            <!-- Головне -->
            <div class="space-y-2">
                <div class="px-3" :class="isCollapsed ? 'lg:text-center' : ''">
                    <p x-show="!isCollapsed" class="text-xs font-semibold text-surface-400 uppercase tracking-wider">
                        Головне
                    </p>
                    <p x-show="isCollapsed" class="text-xs font-semibold text-surface-400 uppercase lg:block hidden">
                        ●●●
                    </p>
                </div>
                
                <!-- Панель керування -->
                <a href="{{ path('admin_dashboard') }}" 
                   @click="selected = 'dashboard'"
                   :class="[
                       selected === 'dashboard' ? 'bg-surface-100 dark:bg-surface-800 text-primary-600 dark:text-primary-400' : 'text-surface-700 dark:text-surface-300 hover:bg-surface-100 dark:hover:bg-surface-800 hover:text-primary-600 dark:hover:text-primary-400',
                       isCollapsed ? 'lg:justify-center' : ''
                   ]"
                   class="flex items-center px-3 py-2 rounded-lg transition-colors duration-200">
                    <i class="fas fa-tachometer-alt w-5" :class="!isCollapsed ? 'mr-3' : ''"></i>
                    <span x-show="!isCollapsed" class="whitespace-nowrap">
                        Панель керування
                    </span>
                </a>
            </div>
            
            <!-- Управління контентом -->
            <div class="space-y-2">
                <div class="px-3" :class="isCollapsed ? 'lg:text-center' : ''">
                    <p x-show="!isCollapsed" class="text-xs font-semibold text-surface-400 uppercase tracking-wider">
                        Управління контентом
                    </p>
                    <p x-show="isCollapsed" class="text-xs font-semibold text-surface-400 uppercase lg:block hidden">
                        ●●●
                    </p>
                </div>
                
                <!-- Статті -->
                <a href="{{ path('admin_article_index') }}" 
                   @click="selected = 'articles'"
                   :class="[
                       selected === 'articles' ? 'bg-surface-100 dark:bg-surface-800 text-primary-600 dark:text-primary-400' : 'text-surface-700 dark:text-surface-300 hover:bg-surface-100 dark:hover:bg-surface-800 hover:text-primary-600 dark:hover:text-primary-400',
                       isCollapsed ? 'lg:justify-center' : ''
                   ]"
                   class="flex items-center px-3 py-2 rounded-lg transition-colors duration-200">
                    <i class="fas fa-newspaper w-5" :class="!isCollapsed ? 'mr-3' : ''"></i>
                    <span x-show="!isCollapsed" class="whitespace-nowrap">
                        Статті
                    </span>
                </a>
                
                <!-- Категорії -->
                <a href="{{ path('admin_category_index') }}" 
                   @click="selected = 'categories'"
                   :class="[
                       selected === 'categories' ? 'bg-surface-100 dark:bg-surface-800 text-primary-600 dark:text-primary-400' : 'text-surface-700 dark:text-surface-300 hover:bg-surface-100 dark:hover:bg-surface-800 hover:text-primary-600 dark:hover:text-primary-400',
                       isCollapsed ? 'lg:justify-center' : ''
                   ]"
                   class="flex items-center px-3 py-2 rounded-lg transition-colors duration-200">
                    <i class="fas fa-folder w-5" :class="!isCollapsed ? 'mr-3' : ''"></i>
                    <span x-show="!isCollapsed" class="whitespace-nowrap">
                        Категорії
                    </span>
                </a>
                
                <!-- Теги -->
                <a href="{{ path('admin_tag_index') }}" 
                   @click="selected = 'tags'"
                   :class="[
                       selected === 'tags' ? 'bg-surface-100 dark:bg-surface-800 text-primary-600 dark:text-primary-400' : 'text-surface-700 dark:text-surface-300 hover:bg-surface-100 dark:hover:bg-surface-800 hover:text-primary-600 dark:hover:text-primary-400',
                       isCollapsed ? 'lg:justify-center' : ''
                   ]"
                   class="flex items-center px-3 py-2 rounded-lg transition-colors duration-200">
                    <i class="fas fa-tags w-5" :class="!isCollapsed ? 'mr-3' : ''"></i>
                    <span x-show="!isCollapsed" class="whitespace-nowrap">
                        Теги
                    </span>
                </a>
                
                <!-- Коментарі -->
                <a href="{{ path('admin_comment_index') }}" 
                   @click="selected = 'comments'"
                   :class="[
                       selected === 'comments' ? 'bg-surface-100 dark:bg-surface-800 text-primary-600 dark:text-primary-400' : 'text-surface-700 dark:text-surface-300 hover:bg-surface-100 dark:hover:bg-surface-800 hover:text-primary-600 dark:hover:text-primary-400',
                       isCollapsed ? 'lg:justify-center' : ''
                   ]"
                   class="flex items-center px-3 py-2 rounded-lg transition-colors duration-200 relative">
                    <i class="fas fa-comments w-5" :class="!isCollapsed ? 'mr-3' : ''"></i>
                    <span x-show="!isCollapsed" class="whitespace-nowrap">
                        Коментарі
                    </span>
                    {% if pending_comments is defined and pending_comments > 0 %}
                        <span x-show="!isCollapsed" class="ml-auto bg-danger-500 text-white text-xs px-2 py-1 rounded-full animate-pulse">
                            {{ pending_comments }}
                        </span>
                        <span x-show="isCollapsed" class="absolute -top-1 -right-1 w-4 h-4 bg-danger-500 text-white text-xs flex items-center justify-center rounded-full lg:hidden">
                            {{ pending_comments }}
                        </span>
                    {% endif %}
                </a>
            </div>
            
            <!-- Блоки та вміст -->
            <div class="space-y-2">
                <div class="px-3" :class="isCollapsed ? 'lg:text-center' : ''">
                    <p x-show="!isCollapsed" class="text-xs font-semibold text-surface-400 uppercase tracking-wider">
                        Блоки та вміст
                    </p>
                    <p x-show="isCollapsed" class="text-xs font-semibold text-surface-400 uppercase lg:block hidden">
                        ●●●
                    </p>
                </div>
                
                <!-- Блог -->
                {% if path('admin_blog_index') is defined %}
                <a href="{{ path('admin_blog_index') }}" 
                   @click="selected = 'blog'"
                   :class="[
                       selected === 'blog' ? 'bg-surface-100 dark:bg-surface-800 text-primary-600 dark:text-primary-400' : 'text-surface-700 dark:text-surface-300 hover:bg-surface-100 dark:hover:bg-surface-800 hover:text-primary-600 dark:hover:text-primary-400',
                       isCollapsed ? 'lg:justify-center' : ''
                   ]"
                   class="flex items-center px-3 py-2 rounded-lg transition-colors duration-200">
                    <i class="fas fa-blog w-5" :class="!isCollapsed ? 'mr-3' : ''"></i>
                    <span x-show="!isCollapsed" class="whitespace-nowrap">
                        Блог (Новини)
                    </span>
                </a>
                {% endif %}
                
                <!-- Цитати -->
                {% if path('admin_quote_index') is defined %}
                <a href="{{ path('admin_quote_index') }}" 
                   @click="selected = 'quotes'"
                   :class="[
                       selected === 'quotes' ? 'bg-surface-100 dark:bg-surface-800 text-primary-600 dark:text-primary-400' : 'text-surface-700 dark:text-surface-300 hover:bg-surface-100 dark:hover:bg-surface-800 hover:text-primary-600 dark:hover:text-primary-400',
                       isCollapsed ? 'lg:justify-center' : ''
                   ]"
                   class="flex items-center px-3 py-2 rounded-lg transition-colors duration-200">
                    <i class="fas fa-quote-right w-5" :class="!isCollapsed ? 'mr-3' : ''"></i>
                    <span x-show="!isCollapsed" class="whitespace-nowrap">
                        Цитати
                    </span>
                </a>
                {% endif %}
                
                <!-- Слайдер -->
                {% if path('admin_slider_index') is defined %}
                <a href="{{ path('admin_slider_index') }}" 
                   @click="selected = 'slider'"
                   :class="[
                       selected === 'slider' ? 'bg-surface-100 dark:bg-surface-800 text-primary-600 dark:text-primary-400' : 'text-surface-700 dark:text-surface-300 hover:bg-surface-100 dark:hover:bg-surface-800 hover:text-primary-600 dark:hover:text-primary-400',
                       isCollapsed ? 'lg:justify-center' : ''
                   ]"
                   class="flex items-center px-3 py-2 rounded-lg transition-colors duration-200">
                    <i class="fas fa-images w-5" :class="!isCollapsed ? 'mr-3' : ''"></i>
                    <span x-show="!isCollapsed" class="whitespace-nowrap">
                        Слайдер
                    </span>
                </a>
                {% endif %}
                
                <!-- Галерея -->
                {% if path('admin_gallery_index') is defined %}
                <a href="{{ path('admin_gallery_index') }}" 
                   @click="selected = 'gallery'"
                   :class="[
                       selected === 'gallery' ? 'bg-surface-100 dark:bg-surface-800 text-primary-600 dark:text-primary-400' : 'text-surface-700 dark:text-surface-300 hover:bg-surface-100 dark:hover:bg-surface-800 hover:text-primary-600 dark:hover:text-primary-400',
                       isCollapsed ? 'lg:justify-center' : ''
                   ]"
                   class="flex items-center px-3 py-2 rounded-lg transition-colors duration-200">
                    <i class="fas fa-photo-video w-5" :class="!isCollapsed ? 'mr-3' : ''"></i>
                    <span x-show="!isCollapsed" class="whitespace-nowrap">
                        Галерея
                    </span>
                </a>
                {% endif %}
            </div>
            
            <!-- Система -->
            <div class="space-y-2">
                <div class="px-3" :class="isCollapsed ? 'lg:text-center' : ''">
                    <p x-show="!isCollapsed" class="text-xs font-semibold text-surface-400 uppercase tracking-wider">
                        Система
                    </p>
                    <p x-show="isCollapsed" class="text-xs font-semibold text-surface-400 uppercase lg:block hidden">
                        ●●●
                    </p>
                </div>
                
                <!-- Користувачі -->
                <a href="{{ path('admin_user_index') }}" 
                   @click="selected = 'users'"
                   :class="[
                       selected === 'users' ? 'bg-surface-100 dark:bg-surface-800 text-primary-600 dark:text-primary-400' : 'text-surface-700 dark:text-surface-300 hover:bg-surface-100 dark:hover:bg-surface-800 hover:text-primary-600 dark:hover:text-primary-400',
                       isCollapsed ? 'lg:justify-center' : ''
                   ]"
                   class="flex items-center px-3 py-2 rounded-lg transition-colors duration-200">
                    <i class="fas fa-users w-5" :class="!isCollapsed ? 'mr-3' : ''"></i>
                    <span x-show="!isCollapsed" class="whitespace-nowrap">
                        Користувачі
                    </span>
                </a>
                
                <!-- Налаштування -->
                {% if path('admin_settings_index') is defined %}
                <a href="{{ path('admin_settings_index') }}" 
                   @click="selected = 'settings'"
                   :class="[
                       selected === 'settings' ? 'bg-surface-100 dark:bg-surface-800 text-primary-600 dark:text-primary-400' : 'text-surface-700 dark:text-surface-300 hover:bg-surface-100 dark:hover:bg-surface-800 hover:text-primary-600 dark:hover:text-primary-400',
                       isCollapsed ? 'lg:justify-center' : ''
                   ]"
                   class="flex items-center px-3 py-2 rounded-lg transition-colors duration-200">
                    <i class="fas fa-cog w-5" :class="!isCollapsed ? 'mr-3' : ''"></i>
                    <span x-show="!isCollapsed" class="whitespace-nowrap">
                        Налаштування
                    </span>
                </a>
                {% endif %}
                
                <!-- Статистика -->
                {% if path('admin_stats') is defined %}
                <a href="{{ path('admin_stats') }}" 
                   @click="selected = 'stats'"
                   :class="[
                       selected === 'stats' ? 'bg-surface-100 dark:bg-surface-800 text-primary-600 dark:text-primary-400' : 'text-surface-700 dark:text-surface-300 hover:bg-surface-100 dark:hover:bg-surface-800 hover:text-primary-600 dark:hover:text-primary-400',
                       isCollapsed ? 'lg:justify-center' : ''
                   ]"
                   class="flex items-center px-3 py-2 rounded-lg transition-colors duration-200">
                    <i class="fas fa-chart-line w-5" :class="!isCollapsed ? 'mr-3' : ''"></i>
                    <span x-show="!isCollapsed" class="whitespace-nowrap">
                        Статистика
                    </span>
                </a>
                {% endif %}
            </div>
        </nav>
        
        <!-- Інформація про користувача -->
        <div class="p-4 border-t border-surface-200 dark:border-surface-800">
            <div class="flex items-center" :class="isCollapsed ? 'lg:justify-center' : 'space-x-3'">
                <div class="w-10 h-10 rounded-full bg-gradient-to-br from-primary-500 to-primary-600 flex items-center justify-center flex-shrink-0 shadow-md">
                    <span class="text-white text-sm font-semibold">{{ app.user.username|first|upper }}</span>
                </div>
                <div x-show="!isCollapsed" class="flex-1 min-w-0 hidden lg:block">
                    <p class="text-sm font-medium text-surface-900 dark:text-surface-100 truncate">
                        {{ app.user.username }}
                    </p>
                    <p class="text-xs text-surface-500 truncate">Адміністратор</p>
                </div>
                <a x-show="!isCollapsed" href="{{ path('app_logout') }}" 
                   title="Вийти"
                   class="p-2 text-surface-500 hover:text-danger-600 hover:bg-danger-50 dark:hover:bg-danger-900/30 rounded-lg transition-colors flex-shrink-0 focus-ring hidden lg:block">
                    <i class="fas fa-sign-out-alt"></i>
                </a>
                <a x-show="isCollapsed" href="{{ path('app_logout') }}" 
                   title="Вийти"
                   class="p-2 text-surface-500 hover:text-danger-600 rounded-lg transition-colors flex-shrink-0 focus-ring hidden lg:block">
                    <i class="fas fa-sign-out-alt"></i>
                </a>
            </div>
        </div>
    </div>
</aside>

<!-- Додатковий JavaScript для синхронізації стану -->
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.store('sidebar', {
            toggle() {
                const sidebar = document.getElementById('sidebar');
                if (sidebar) {
                    const isCollapsed = Alpine.raw(sidebar.__x.$data.isCollapsed);
                    sidebar.__x.$data.isCollapsed = !isCollapsed;
                    localStorage.setItem('sidebarCollapsed', !isCollapsed);
                }
            }
        });
    });

    // Синхронізація з глобальним об'єктом AdminApp
    document.addEventListener('DOMContentLoaded', () => {
        if (window.adminApp && window.adminApp.sidebar) {
            const sidebarElement = document.getElementById('sidebar');
            if (sidebarElement && sidebarElement.__x) {
                // Синхронізуємо стан згортання
                sidebarElement.__x.$data.isCollapsed = localStorage.getItem('sidebarCollapsed') === 'true';
                
                // Оновлюємо глобальний об'єкт
                window.adminApp.sidebar.isCollapsed = sidebarElement.__x.$data.isCollapsed;
                window.adminApp.sidebar.collapse = () => {
                    sidebarElement.__x.$data.isCollapsed = true;
                };
                window.adminApp.sidebar.expand = () => {
                    sidebarElement.__x.$data.isCollapsed = false;
                };
            }
        }
    });
</script>

<!-- Стилі для анімацій -->
<style>
    .sidebar-transition {
        transition: width 0.3s ease-in-out, margin-left 0.3s ease-in-out, transform 0.3s ease-in-out;
    }
    
    /* Плавне приховування тексту */
    .sidebar span {
        transition: opacity 0.2s ease-in-out;
    }
    
    /* Іконки в згорнутому стані */
    .sidebar [x-show="isCollapsed"] i {
        margin-right: 0 !important;
    }
    
    /* Адаптація для мобільних */
    @media (max-width: 1023px) {
        .sidebar {
            width: 256px !important;
        }
        
        .sidebar [x-show="isCollapsed"] {
            display: none !important;
        }
    }
</style>
