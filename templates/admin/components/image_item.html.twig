<div class="relative group">
    <img src="{{ image.url }}" 
         alt="Image {{ loop.index }}"
         class="w-full h-32 object-cover rounded-lg border border-surface-200">
    <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-40 transition-all rounded-lg flex items-center justify-center opacity-0 group-hover:opacity-100">
        <div class="flex gap-2">
            <button type="button"
                    onclick="insertImageToEditor('{{ image.url }}')"
                    class="p-2 bg-white rounded-full hover:bg-surface-100 transition"
                    title="Вставити в редактор">
                <i class="fas fa-plus text-primary-600 text-sm"></i>
            </button>
            <button type="button"
                    onclick="copyImageUrl('{{ image.url }}')"
                    class="p-2 bg-white rounded-full hover:bg-surface-100 transition"
                    title="Копіювати URL">
                <i class="fas fa-copy text-surface-600 text-sm"></i>
            </button>
            <button type="button"
                    onclick="deleteImage('{{ image.id }}', this)"
                    class="p-2 bg-white rounded-full hover:bg-red-50 transition"
                    title="Видалити">
                <i class="fas fa-trash text-red-600 text-sm"></i>
            </button>
        </div>
    </div>
</div>