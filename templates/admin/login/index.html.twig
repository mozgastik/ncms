{% extends 'base.html.twig' %}

{% block title %}Вхід в адмін-панель{% endblock %}

{% block body %}
<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow">
                <div class="card-header bg-primary text-white text-center">
                    <h4 class="mb-0">
                        <i class="fas fa-lock me-2"></i> Адмін-панель
                    </h4>
                </div>
                <div class="card-body p-4">
                    <h5 class="card-title text-center mb-4">Вхід в систему</h5>
                    
                    {% if error %}
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            {{ error.messageKey|trans(error.messageData, 'security') }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endif %}
                    
                    <form method="post">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                        
                        <div class="mb-3">
                            <label for="username" class="form-label">Email</label>
                            <input type="email" value="{{ last_username }}" name="_username" id="username" 
                                   class="form-control" placeholder="admin@example.com" required autofocus>
                        </div>
                        
                        <div class="mb-3">
                            <label for="password" class="form-label">Пароль</label>
                            <input type="password" name="_password" id="password" 
                                   class="form-control" placeholder="••••••••" required>
                        </div>
                        
                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" id="remember_me" name="_remember_me">
                            <label class="form-check-label" for="remember_me">Запам'ятати мене</label>
                        </div>
                        
                        <div class="d-grid gap-2">
                            <button class="btn btn-primary btn-lg" type="submit">
                                <i class="fas fa-sign-in-alt me-2"></i> Увійти
                            </button>
                        </div>
                    </form>
                    
                    <hr class="my-4">
                    
                    <div class="text-center">
                        <a href="{{ path('app_home') }}" class="text-decoration-none">
                            <i class="fas fa-arrow-left me-1"></i> Повернутися на сайт
                        </a>
                    </div>
                </div>
                <div class="card-footer text-center text-muted small">
                    Новинний портал &copy; {{ "now"|date("Y") }}
                </div>
            </div>
            
            <div class="text-center mt-3">
                <p class="text-muted">
                    <small>Для тесту використовуйте:</small><br>
                    <strong>Email:</strong> mozgastik@gmail.com<br>
                    <strong>Пароль:</strong> influcid
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %}