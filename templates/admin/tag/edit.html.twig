{% extends 'base.html.twig' %}

{% block title %}Редагування тегу{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <!-- Заголовок -->
    <div class="mb-8">
        <div class="flex items-center justify-between mb-4">
            <div>
                <h1 class="text-3xl font-bold text-gray-800 dark:text-gray-100">Редагування тегу</h1>
                <p class="text-gray-600 dark:text-gray-400 mt-2">Редагування тегу "{{ tag.name }}"</p>
            </div>
            <a href="{{ path('admin_tag_index') }}" 
               class="inline-flex items-center px-4 py-2 bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 font-medium rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition duration-200">
                <i class="fas fa-arrow-left mr-2"></i>
                Назад до списку
            </a>
        </div>
    </div>

    <!-- Форма -->
    <div class="max-w-2xl mx-auto">
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-md p-6">
            {{ form_start(form) }}
            
            <div class="space-y-6">
                <div>
                    {{ form_label(form.name, 'Назва тегу', {
                        'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2'}
                    }) }}
                    {{ form_widget(form.name, {
                        'attr': {
                            'class': 'w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100'
                        }
                    }) }}
                    {{ form_errors(form.name) }}
                </div>
                
                <div>
                    {{ form_label(form.slug, 'URL-адреса (слаг)', {
                        'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2'}
                    }) }}
                    {{ form_widget(form.slug, {
                        'attr': {
                            'class': 'w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100'
                        }
                    }) }}
                    {{ form_errors(form.slug) }}
                </div>
                
                <div>
                    {{ form_label(form.description, 'Опис', {
                        'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2'}
                    }) }}
                    {{ form_widget(form.description, {
                        'attr': {
                            'class': 'w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100',
                            'rows': 4
                        }
                    }) }}
                    {{ form_errors(form.description) }}
                </div>
            </div>
            
            <div class="mt-8 pt-6 border-t border-gray-200 dark:border-gray-700">
                <div class="flex items-center justify-between">
                    <button type="submit" 
                            class="inline-flex items-center px-6 py-3 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition duration-200">
                        <i class="fas fa-save mr-2"></i>
                        Зберегти зміни
                    </button>
                    
                    <div class="flex items-center space-x-4">
                        <a href="{{ path('admin_tag_delete', {'id': tag.id}) }}" 
                           onclick="return confirm('Видалити тег? Всі статті будуть відв\'язані, але не видалені.');"
                           class="text-sm text-red-600 dark:text-red-400 hover:text-red-800 dark:hover:text-red-300 transition duration-200">
                            <i class="fas fa-trash mr-1"></i> Видалити
                        </a>
                        
                        <a href="{{ path('admin_tag_index') }}" 
                           class="text-sm text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200 transition duration-200">
                            Скасувати
                        </a>
                    </div>
                </div>
            </div>
            
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}