{% extends 'admin/base.html.twig' %}

{% block title %}Управління тегами{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <!-- Заголовок -->
    <div class="mb-8">
        <div class="flex items-center justify-between mb-4">
            <div>
                <h1 class="text-3xl font-bold text-gray-800 dark:text-gray-100">Управління тегами</h1>
                <p class="text-gray-600 dark:text-gray-400 mt-2">Створення та редагування тегів для статей</p>
            </div>
            <a href="{{ path('admin_tag_new') }}" 
               class="inline-flex items-center px-4 py-2 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition duration-200">
                <i class="fas fa-plus mr-2"></i>
                Новий тег
            </a>
        </div>
    </div>

    <!-- Список тегів -->
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-md overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
                <thead class="bg-gray-50 dark:bg-gray-700">
                    <tr>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                            ID
                        </th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                            Назва
                        </th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                            Слаг
                        </th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                            Кількість статей
                        </th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                            Дії
                        </th>
                    </tr>
                </thead>
                <tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700">
                    {% for tag in tags %}
                    <tr class="hover:bg-gray-50 dark:hover:bg-gray-700 transition duration-150">
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900 dark:text-gray-100">
                            {{ tag.id }}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="text-sm font-medium text-gray-900 dark:text-gray-100">
                                <a href="{{ path('admin_tag_show', {'id': tag.id}) }}" 
                                   class="text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300">
                                    {{ tag.name }}
                                </a>
                            </div>
                            {% if tag.description %}
                            <div class="text-sm text-gray-500 dark:text-gray-400 mt-1">
                                {{ tag.description|slice(0, 60) }}{% if tag.description|length > 60 %}...{% endif %}
                            </div>
                            {% endif %}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">
                            <code class="bg-gray-100 dark:bg-gray-700 px-2 py-1 rounded text-xs">{{ tag.slug }}</code>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-300">
                                {{ tag.articles|length }} статей
                            </span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                            <div class="flex items-center space-x-2">
                                <a href="{{ path('admin_tag_show', {'id': tag.id}) }}" 
                                   class="inline-flex items-center p-2 text-blue-600 hover:text-blue-800 hover:bg-blue-50 dark:hover:bg-blue-900/30 rounded-lg transition"
                                   title="Переглянути">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="{{ path('admin_tag_edit', {'id': tag.id}) }}" 
                                   class="inline-flex items-center p-2 text-yellow-600 hover:text-yellow-800 hover:bg-yellow-50 dark:hover:bg-yellow-900/30 rounded-lg transition"
                                   title="Редагувати">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form action="{{ path('admin_tag_delete', {'id': tag.id}) }}" 
                                      method="post" 
                                      class="inline"
                                      onsubmit="return confirm('Видалити тег? Всі статті будуть відв\'язані, але не видалені.');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ tag.id) }}">
                                    <button type="submit" 
                                            class="inline-flex items-center p-2 text-red-600 hover:text-red-800 hover:bg-red-50 dark:hover:bg-red-900/30 rounded-lg transition"
                                            title="Видалити">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="5" class="px-6 py-8 text-center">
                            <div class="text-gray-400 dark:text-gray-500">
                                <i class="fas fa-tags text-4xl mb-3"></i>
                                <p class="text-lg font-medium">Теги відсутні</p>
                                <p class="text-sm mt-1">Створіть перший тег</p>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}