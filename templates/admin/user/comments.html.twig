{# templates/user/comments.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Мої коментарі{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <!-- Header -->
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-800">
            <i class="fas fa-comments mr-2"></i>Мої коментарі
        </h1>
        <p class="text-gray-600 mt-2">Всі коментарі, які ви залишили на сайті</p>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <div class="bg-white rounded-xl shadow-md p-6">
            <div class="flex items-center">
                <div class="p-3 bg-blue-100 rounded-lg">
                    <i class="fas fa-comment text-blue-600 text-xl"></i>
                </div>
                <div class="ml-4">
                    <p class="text-sm text-gray-500">Всього коментарів</p>
                    <p class="text-2xl font-bold text-gray-800">{{ comments|length }}</p>
                </div>
            </div>
        </div>
        
        <div class="bg-white rounded-xl shadow-md p-6">
            <div class="flex items-center">
                <div class="p-3 bg-green-100 rounded-lg">
                    <i class="fas fa-check-circle text-green-600 text-xl"></i>
                </div>
                <div class="ml-4">
                    <p class="text-sm text-gray-500">Схвалені</p>
                    <p class="text-2xl font-bold text-gray-800">
                        {% set approvedComments = comments|filter(c => c.isApproved) %}
                        {{ approvedComments|length }}
                    </p>
                </div>
            </div>
        </div>
        
        <div class="bg-white rounded-xl shadow-md p-6">
            <div class="flex items-center">
                <div class="p-3 bg-yellow-100 rounded-lg">
                    <i class="fas fa-clock text-yellow-600 text-xl"></i>
                </div>
                <div class="ml-4">
                    <p class="text-sm text-gray-500">В очікуванні</p>
                    <p class="text-2xl font-bold text-gray-800">
                        {% set pendingComments = comments|filter(c => not c.isApproved) %}
                        {{ pendingComments|length }}
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-6">
        <div class="flex flex-wrap gap-4">
            <a href="{{ path('user_comments', {'status': 'all'}) }}" 
               class="px-4 py-2 rounded-lg {{ app.request.query.get('status', 'all') == 'all' ? 'bg-blue-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200' }}">
                Всі ({{ comments|length }})
            </a>
            <a href="{{ path('user_comments', {'status': 'approved'}) }}" 
               class="px-4 py-2 rounded-lg {{ app.request.query.get('status') == 'approved' ? 'bg-green-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200' }}">
                Схвалені ({{ approvedComments|length }})
            </a>
            <a href="{{ path('user_comments', {'status': 'pending'}) }}" 
               class="px-4 py-2 rounded-lg {{ app.request.query.get('status') == 'pending' ? 'bg-yellow-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200' }}">
                В очікуванні ({{ pendingComments|length }})
            </a>
        </div>
    </div>

    <!-- Comments List -->
    <div class="bg-white rounded-xl shadow-md overflow-hidden">
        {% if comments|length > 0 %}
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                Стаття
                            </th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                Коментар
                            </th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                Статус
                            </th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                Дата
                            </th>
                            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                                Дії
                            </th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        {% for comment in pagination %}
                        <tr class="hover:bg-gray-50 transition">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="flex items-center">
                                    <div class="flex-shrink-0 h-10 w-10">
                                        {% if comment.article.featuredImage %}
                                            <img class="h-10 w-10 rounded-lg object-cover" 
                                                 src="{{ asset('uploads/articles/' ~ comment.article.featuredImage) }}" 
                                                 alt="{{ comment.article.title }}">
                                        {% else %}
                                            <div class="h-10 w-10 rounded-lg bg-gray-200 flex items-center justify-center">
                                                <i class="fas fa-newspaper text-gray-400"></i>
                                            </div>
                                        {% endif %}
                                    </div>
                                    <div class="ml-4">
                                        <a href="{{ path('app_article_show', {'slug': comment.article.slug}) }}#comments" 
                                           class="text-sm font-medium text-blue-600 hover:text-blue-800">
                                            {{ comment.article.title|slice(0, 40) }}{{ comment.article.title|length > 40 ? '...' : '' }}
                                        </a>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="text-sm text-gray-900 max-w-xs">
                                    {{ comment.content|slice(0, 80) }}{{ comment.content|length > 80 ? '...' : '' }}
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                {% if comment.isApproved %}
                                    <span class="px-2 py-1 text-xs font-medium bg-green-100 text-green-800 rounded-full">
                                        <i class="fas fa-check-circle mr-1"></i>Схвалено
                                    </span>
                                {% else %}
                                    <span class="px-2 py-1 text-xs font-medium bg-yellow-100 text-yellow-800 rounded-full">
                                        <i class="fas fa-clock mr-1"></i>В очікуванні
                                    </span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                <i class="far fa-clock mr-1"></i>
                                {{ comment.createdAt|date('d.m.Y H:i') }}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                <div class="flex justify-end space-x-2">
                                    <a href="{{ path('app_article_show', {'slug': comment.article.slug}) }}#comment-{{ comment.id }}" 
                                       class="inline-flex items-center px-3 py-1 bg-blue-100 text-blue-700 rounded hover:bg-blue-200 transition"
                                       title="Переглянути">
                                        <i class="fas fa-eye mr-1 text-xs"></i>
                                    </a>
                                    {% if not comment.isApproved %}
                                    <a href="{{ path('user_comment_edit', {'id': comment.id}) }}" 
                                       class="inline-flex items-center px-3 py-1 bg-yellow-100 text-yellow-700 rounded hover:bg-yellow-200 transition"
                                       title="Редагувати">
                                        <i class="fas fa-edit mr-1 text-xs"></i>
                                    </a>
                                    <form method="post" 
                                          action="{{ path('user_comment_delete', {'id': comment.id}) }}" 
                                          onsubmit="return confirm('Ви впевнені, що хочете видалити цей коментар?');"
                                          class="inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ comment.id) }}">
                                        <button type="submit" 
                                                class="inline-flex items-center px-3 py-1 bg-red-100 text-red-700 rounded hover:bg-red-200 transition"
                                                title="Видалити">
                                            <i class="fas fa-trash mr-1 text-xs"></i>
                                        </button>
                                    </form>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            {% if pagination|length > 0 %}
            <div class="bg-gray-50 px-6 py-4 border-t border-gray-200">
                {{ knp_pagination_render(pagination) }}
            </div>
            {% endif %}
        {% else %}
            <div class="text-center py-12">
                <div class="text-gray-300 mb-4">
                    <i class="fas fa-comments text-5xl"></i>
                </div>
                <h3 class="text-lg font-medium text-gray-700 mb-2">Коментарів поки немає</h3>
                <p class="text-gray-500 mb-6">Ви ще не залишили жодного коментаря на сайті.</p>
                <a href="{{ path('app_article_index') }}" 
                   class="inline-flex items-center px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition">
                    <i class="fas fa-newspaper mr-2"></i>Перейти до статей
                </a>
            </div>
        {% endif %}
    </div>

    <!-- Quick Tips -->
    <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-blue-50 border border-blue-200 rounded-xl p-6">
            <div class="flex">
                <div class="flex-shrink-0">
                    <i class="fas fa-lightbulb text-blue-400 text-xl"></i>
                </div>
                <div class="ml-3">
                    <h3 class="text-sm font-medium text-blue-800">Поради</h3>
                    <div class="mt-2 text-sm text-blue-700">
                        <ul class="list-disc pl-5 space-y-1">
                            <li>Коментарі від авторизованих користувачів схвалюються автоматично</li>
                            <li>Коментарі від гостей проходять модерацію</li>
                            <li>Ви можете редагувати та видаляти коментарі, поки вони не схвалені</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="bg-green-50 border border-green-200 rounded-xl p-6">
            <div class="flex">
                <div class="flex-shrink-0">
                    <i class="fas fa-chart-line text-green-400 text-xl"></i>
                </div>
                <div class="ml-3">
                    <h3 class="text-sm font-medium text-green-800">Активність</h3>
                    <div class="mt-2 text-sm text-green-700">
                        <p>Ваші коментарі допомагають іншим користувачам та покращують якість контенту.</p>
                        <p class="mt-2 font-medium">Дякуємо за вашу активність!</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
// Автоматична прокрутка до коментаря при кліку на "Переглянути"
document.addEventListener('DOMContentLoaded', function() {
    const viewButtons = document.querySelectorAll('a[href*="#comment-"]');
    
    viewButtons.forEach(button => {
        button.addEventListener('click', function(e) {
            // Дозволяємо перехід по лінку
            // Прокрутка відбувається автоматично через якір
        });
    });
});
</script>
{% endblock %}