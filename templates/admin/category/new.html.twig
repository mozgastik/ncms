{% extends 'admin/base.html.twig' %}

{% block title %}Нова категорія{% endblock %}

{% block body %}
<div class="content-container py-6 max-w-3xl mx-auto">
    <!-- Заголовок -->
    <div class="flex items-center gap-4 mb-6">
        <a href="{{ path('admin_category_index') }}" 
           class="w-10 h-10 rounded-lg glass-light flex items-center justify-center hover:scale-110 transition-transform">
            <i class="fas fa-arrow-left text-primary-500"></i>
        </a>
        <div>
            <h1 class="text-2xl font-bold gradient-text">Нова категорія</h1>
            <p class="text-surface-600 dark:text-surface-400">Створення нової категорії контенту</p>
        </div>
    </div>

    <!-- Форма -->
    <div class="glass-light rounded-xl p-6 border border-surface-200/50 dark:border-surface-700/50">
        {{ include('admin/category/_form.html.twig') }}
    </div>
</div>
{% endblock %}