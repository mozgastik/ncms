{{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
    
    <!-- Основна інформація -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
            {{ form_label(form.name, null, {'label_attr': {'class': 'block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1'}}) }}
            {{ form_widget(form.name, {'attr': {'class': 'w-full px-4 py-2 rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:ring-2 focus:ring-primary-500/50'}}) }}
            {{ form_errors(form.name) }}
        </div>
        
        <div>
            {{ form_label(form.slug, null, {'label_attr': {'class': 'block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1'}}) }}
            <div class="relative">
                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-surface-400">/</span>
                {{ form_widget(form.slug, {'attr': {
                    'class': 'w-full pl-8 pr-4 py-2 rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:ring-2 focus:ring-primary-500/50',
                    'placeholder': 'category-slug'
                }}) }}
            </div>
            {{ form_errors(form.slug) }}
            <p class="text-xs text-surface-500 mt-1">{{ form_help(form.slug) }}</p>
        </div>
    </div>

    <!-- Опис -->
    <div>
        {{ form_label(form.description, null, {'label_attr': {'class': 'block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1'}}) }}
        {{ form_widget(form.description, {'attr': {
            'class': 'w-full px-4 py-2 rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:ring-2 focus:ring-primary-500/50',
            'rows': 4,
            'placeholder': 'Опис категорії...'
        }}) }}
        {{ form_errors(form.description) }}
    </div>

    <!-- Налаштування -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div>
            {{ form_label(form.type, null, {'label_attr': {'class': 'block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1'}}) }}
            {{ form_widget(form.type, {'attr': {'class': 'w-full px-4 py-2 rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:ring-2 focus:ring-primary-500/50'}}) }}
            {{ form_errors(form.type) }}
        </div>
        
        <div>
            {{ form_label(form.parent, null, {'label_attr': {'class': 'block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1'}}) }}
            {{ form_widget(form.parent, {'attr': {'class': 'w-full px-4 py-2 rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:ring-2 focus:ring-primary-500/50'}}) }}
            {{ form_errors(form.parent) }}
        </div>
        
        <div>
            {{ form_label(form.sortOrder, null, {'label_attr': {'class': 'block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1'}}) }}
            {{ form_widget(form.sortOrder, {'attr': {
                'class': 'w-full px-4 py-2 rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:ring-2 focus:ring-primary-500/50',
                'min': 0
            }}) }}
            {{ form_errors(form.sortOrder) }}
        </div>
    </div>

    <!-- Чекбокси -->
    <div class="flex gap-6">
        <div class="flex items-center gap-2">
            {{ form_widget(form.isActive) }}
            {{ form_label(form.isActive, 'Активна') }}
        </div>
        <div class="flex items-center gap-2">
            {{ form_widget(form.isVisible) }}
            {{ form_label(form.isVisible, 'Видима в меню') }}
        </div>
    </div>

    <!-- SEO блок -->
    <div class="border-t border-surface-200 dark:border-surface-700 pt-6">
        <h3 class="text-lg font-semibold mb-4 flex items-center gap-2">
            <i class="fas fa-chart-line text-primary-500"></i>
            <span>SEO налаштування</span>
        </h3>

        <div class="space-y-4">
            <div>
                {{ form_label(form.metaTitle, null, {'label_attr': {'class': 'block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1'}}) }}
                {{ form_widget(form.metaTitle, {'attr': {
                    'class': 'w-full px-4 py-2 rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:ring-2 focus:ring-primary-500/50',
                    'placeholder': 'Meta Title'
                }}) }}
            </div>

            <div>
                {{ form_label(form.metaDescription, null, {'label_attr': {'class': 'block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1'}}) }}
                {{ form_widget(form.metaDescription, {'attr': {
                    'class': 'w-full px-4 py-2 rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:ring-2 focus:ring-primary-500/50',
                    'rows': 3,
                    'placeholder': 'Meta Description'
                }}) }}
            </div>

            <div>
                {{ form_label(form.metaKeywords, null, {'label_attr': {'class': 'block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1'}}) }}
                {{ form_widget(form.metaKeywords, {'attr': {
                    'class': 'w-full px-4 py-2 rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:ring-2 focus:ring-primary-500/50',
                    'placeholder': 'ключові, слова, через, кому'
                }}) }}
            </div>
        </div>
    </div>

    <!-- Кнопки -->
    <div class="flex justify-end gap-3 pt-6 border-t border-surface-200 dark:border-surface-700">
        <a href="{{ path('admin_category_index') }}" 
           class="px-6 py-2 rounded-lg glass-light hover:bg-surface-100 dark:hover:bg-surface-800 transition-colors">
            Скасувати
        </a>
        <button type="submit" 
                class="px-6 py-2 bg-gradient-to-r from-primary-500 to-purple-600 text-white rounded-lg hover:scale-105 transition-all duration-300">
            <i class="fas fa-save mr-2"></i>{{ button_label|default('Зберегти') }}
        </button>
    </div>

{{ form_end(form) }}