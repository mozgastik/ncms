{% extends 'admin/base.html.twig' %}

{% block title %}Управління категоріями{% endblock %}

{% block body %}
<div class="content-container py-6">
    <!-- Заголовок -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
        <div>
            <h1 class="text-2xl font-bold gradient-text">Категорії</h1>
            <p class="text-surface-600 dark:text-surface-400 mt-1">
                Управління категоріями контенту
            </p>
        </div>
        
        <div class="flex gap-3">
            <a href="{{ path('admin_category_tree') }}" 
               class="px-4 py-2 glass-light rounded-lg hover:bg-surface-100 dark:hover:bg-surface-800 transition-colors flex items-center gap-2">
                <i class="fas fa-sitemap"></i>
                <span>Дерево категорій</span>
            </a>
            
            <a href="{{ path('admin_category_new') }}" 
               class="px-4 py-2 bg-gradient-to-r from-primary-500 to-purple-600 text-white rounded-lg hover:scale-105 transition-all duration-300 flex items-center gap-2">
                <i class="fas fa-plus"></i>
                <span>Додати категорію</span>
            </a>
        </div>
    </div>

    <!-- Фільтри -->
    <div class="glass-light rounded-xl p-4 mb-6 border border-surface-200/50 dark:border-surface-700/50">
        <form method="get" action="" class="flex flex-wrap gap-4">
            <div class="flex-1 min-w-[200px]">
                <div class="relative">
                    <span class="absolute left-4 top-1/2 -translate-y-1/2 text-surface-400">
                        <i class="fas fa-search"></i>
                    </span>
                    <input type="text" 
                           name="search" 
                           value="{{ filters.search }}"
                           placeholder="Пошук категорій..."
                           class="w-full pl-12 pr-4 py-2 rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:ring-2 focus:ring-primary-500/50">
                </div>
            </div>
            
            <div class="w-40">
                <select name="type" class="w-full px-4 py-2 rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800">
                    <option value="">Всі типи</option>
                    <option value="all" {{ filters.type == 'all' ? 'selected' : '' }}>Всі типи</option>
                    <option value="article" {{ filters.type == 'article' ? 'selected' : '' }}>Статті</option>
                    <option value="blog" {{ filters.type == 'blog' ? 'selected' : '' }}>Блоги</option>
                    <option value="video" {{ filters.type == 'video' ? 'selected' : '' }}>Відео</option>
                </select>
            </div>
            
            <div class="w-40">
                <select name="active" class="w-full px-4 py-2 rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800">
                    <option value="">Всі статуси</option>
                    <option value="1" {{ filters.active == '1' ? 'selected' : '' }}>Активні</option>
                    <option value="0" {{ filters.active == '0' ? 'selected' : '' }}>Неактивні</option>
                </select>
            </div>
            
            <button type="submit" class="px-6 py-2 bg-primary-500 text-white rounded-lg hover:bg-primary-600 transition-colors">
                <i class="fas fa-filter mr-2"></i>Фільтрувати
            </button>
            
            {% if filters.search or filters.type or filters.active %}
            <a href="{{ path('admin_category_index') }}" class="px-4 py-2 glass-light rounded-lg hover:bg-surface-100 transition-colors">
                <i class="fas fa-times mr-2"></i>Скинути
            </a>
            {% endif %}
        </form>
    </div>

    <!-- Таблиця категорій -->
    <div class="glass-light rounded-xl overflow-hidden border border-surface-200/50 dark:border-surface-700/50">
        <table class="w-full">
            <thead class="bg-surface-100 dark:bg-surface-800/50">
                <tr>
                    <th class="px-6 py-3 text-left text-sm font-semibold">Назва</th>
                    <th class="px-6 py-3 text-left text-sm font-semibold">Тип</th>
                    <th class="px-6 py-3 text-left text-sm font-semibold">Батько</th>
                    <th class="px-6 py-3 text-center text-sm font-semibold">Сортування</th>
                    <th class="px-6 py-3 text-center text-sm font-semibold">Статус</th>
                    <th class="px-6 py-3 text-center text-sm font-semibold">Дії</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-surface-200 dark:divide-surface-700">
                {% for category in categories %}
                <tr class="hover:bg-surface-50 dark:hover:bg-surface-800/30 transition-colors">
                    <td class="px-6 py-4">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-primary-500/20 to-purple-500/20 flex items-center justify-center">
                                {% if category.image %}
                      <span class="material-icons text-blue-400 text-xl">{{ category.image }}</span>
                      {% else %}
                      <span class="material-icons text-red-400 text-xl">folder</span>
                    {% endif %}
                            </div>
                            <div>
                                <div class="font-medium">{{ category.name }}</div>
                                <div class="text-xs text-surface-500">{{ category.slug }}</div>
                            </div>
                        </div>
                    </td>
                    <td class="px-6 py-4">
                        <span class="px-2 py-1 text-xs rounded-full 
                            {% if category.type == 'article' %}bg-blue-100 text-blue-600
                            {% elseif category.type == 'blog' %}bg-purple-100 text-purple-600
                            {% elseif category.type == 'video' %}bg-red-100 text-red-600
                            {% else %}bg-gray-100 text-gray-600{% endif %}">
                            {{ category.type }}
                        </span>
                    </td>
                    <td class="px-6 py-4">
                        {% if category.parent %}
                            <a href="{{ path('admin_category_edit', {'id': category.parent.id}) }}" 
                               class="text-primary-600 hover:underline">
                                {{ category.parent.name }}
                            </a>
                        {% else %}
                            <span class="text-surface-400">—</span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4 text-center">{{ category.sortOrder }}</td>
                    <td class="px-6 py-4 text-center">
                        <button onclick="toggleCategory({{ category.id }})" 
                                class="px-2 py-1 text-xs rounded-full transition-colors
                                {% if category.isActive %}
                                    bg-green-100 text-green-600 hover:bg-green-200
                                {% else %}
                                    bg-gray-100 text-gray-600 hover:bg-gray-200
                                {% endif %}">
                            {{ category.isActive ? 'Активна' : 'Неактивна' }}
                        </button>
                    </td>
                    <td class="px-6 py-4">
                        <div class="flex items-center justify-center gap-2">
                            <a href="{{ path('admin_category_edit', {'id': category.id}) }}" 
                               class="p-2 text-blue-600 hover:bg-blue-100 dark:hover:bg-blue-900/30 rounded-lg transition-colors"
                               title="Редагувати">
                                <i class="fas fa-edit"></i>
                            </a>
                            
                            <form method="post" action="{{ path('admin_category_delete', {'id': category.id}) }}" 
                                  onsubmit="return confirm('Видалити цю категорію?');" class="inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ category.id) }}">
                                <button type="submit" 
                                        class="p-2 text-red-600 hover:bg-red-100 dark:hover:bg-red-900/30 rounded-lg transition-colors"
                                        title="Видалити">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="6" class="px-6 py-12 text-center text-surface-500">
                        <i class="fas fa-folder-open text-4xl mb-3 opacity-30"></i>
                        <p>Категорії не знайдено</p>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <!-- Пагінація -->
    {% if pagination.pages > 1 %}
    <div class="mt-6 flex justify-center">
        <div class="flex gap-2">
            {% for i in 1..pagination.pages %}
                <a href="{{ path('admin_category_index', {page: i, search: filters.search, type: filters.type, active: filters.active}) }}" 
                   class="w-10 h-10 flex items-center justify-center rounded-lg transition-colors
                   {% if i == pagination.current %}
                       bg-gradient-to-r from-primary-500 to-purple-600 text-white
                   {% else %}
                       glass-light hover:bg-surface-100 dark:hover:bg-surface-800
                   {% endif %}">
                    {{ i }}
                </a>
            {% endfor %}
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
function toggleCategory(id) {
    fetch(`/admin/categories/${id}/toggle`, {
        method: 'POST',
        headers: {
            'X-Requested-With': 'XMLHttpRequest',
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            location.reload();
        }
    });
}
</script>
{% endblock %}