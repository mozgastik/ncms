{% extends 'admin/base.html.twig' %}

{% block title %}Редагування: {{ category.name }}{% endblock %}

{% block body %}
<div class="content-container py-6 max-w-3xl mx-auto">
    <!-- Заголовок -->
    <div class="flex items-center gap-4 mb-6">
        <a href="{{ path('admin_category_index') }}" 
           class="w-10 h-10 rounded-lg glass-light flex items-center justify-center hover:scale-110 transition-transform">
            <i class="fas fa-arrow-left text-primary-500"></i>
        </a>
        <div>
            <h1 class="text-2xl font-bold gradient-text">Редагування категорії</h1>
            <p class="text-surface-600 dark:text-surface-400">{{ category.name }}</p>
        </div>
    </div>

    <!-- Статистика категорії -->
    <div class="grid grid-cols-4 gap-4 mb-6">
        <div class="glass-light rounded-xl p-4 text-center">
            <div class="text-2xl font-bold text-primary-600">{{ category.articlesCount }}</div>
            <div class="text-sm text-surface-500">Статті</div>
        </div>
        <div class="glass-light rounded-xl p-4 text-center">
            <div class="text-2xl font-bold text-purple-600">{{ category.blogsCount }}</div>
            <div class="text-sm text-surface-500">Блоги</div>
        </div>
        <div class="glass-light rounded-xl p-4 text-center">
            <div class="text-2xl font-bold text-red-600">{{ category.videosCount }}</div>
            <div class="text-sm text-surface-500">Відео</div>
        </div>
        <div class="glass-light rounded-xl p-4 text-center">
            <div class="text-2xl font-bold text-green-600">{{ category.totalCount }}</div>
            <div class="text-sm text-surface-500">Всього</div>
        </div>
    </div>

    <!-- Форма -->
    <div class="glass-light rounded-xl p-6 border border-surface-200/50 dark:border-surface-700/50">
        {{ include('admin/category/_form.html.twig', {'button_label': 'Оновити'}) }}
    </div>

    <!-- Додаткова інформація -->
    <div class="mt-6 grid grid-cols-2 gap-6">
        <div class="glass-light rounded-xl p-4 border border-surface-200/50 dark:border-surface-700/50">
            <h3 class="font-semibold mb-3 flex items-center gap-2">
                <i class="fas fa-info-circle text-primary-500"></i>
                <span>Інформація</span>
            </h3>
            <dl class="space-y-2 text-sm">
                <div class="flex justify-between">
                    <dt class="text-surface-500">Створено:</dt>
                    <dd>{{ category.createdAt|date('d.m.Y H:i') }}</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="text-surface-500">Оновлено:</dt>
                    <dd>{{ category.updatedAt ? category.updatedAt|date('d.m.Y H:i') : '—' }}</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="text-surface-500">Автор:</dt>
                    <dd>{{ category.createdBy ? category.createdBy.username : '—' }}</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="text-surface-500">Рівень:</dt>
                    <dd>{{ category.level }}</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="text-surface-500">Повний шлях:</dt>
                    <dd class="text-right">{{ category.fullPath }}</dd>
                </div>
            </dl>
        </div>

        <div class="glass-light rounded-xl p-4 border border-surface-200/50 dark:border-surface-700/50">
            <h3 class="font-semibold mb-3 flex items-center gap-2">
                <i class="fas fa-sitemap text-purple-500"></i>
                <span>Підкатегорії</span>
            </h3>
            {% if category.children|length > 0 %}
                <ul class="space-y-2">
                    {% for child in category.children %}
                        <li class="flex items-center justify-between">
                            <a href="{{ path('admin_category_edit', {'id': child.id}) }}" 
                               class="text-primary-600 hover:underline">
                                {{ child.name }}
                            </a>
                            <span class="text-xs text-surface-500">{{ child.totalCount }} елементів</span>
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="text-surface-500 text-center py-4">Немає підкатегорій</p>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}