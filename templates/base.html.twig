<!DOCTYPE html>
<html lang="uk" class="light scroll-smooth" data-theme="light" x-data x-init="$el.classList.toggle('dark', localStorage.getItem('theme') === 'dark')">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{% block meta_description %}Сучасний новинний портал з актуальними новинами та статтями{% endblock %}">
    <meta name="keywords" content="{% block meta_keywords %}новини, статті, блог, інформація{% endblock %}">
    <meta name="author" content="Новинний портал">
    <meta name="theme-color" content="#3b82f6" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#1e293b" media="(prefers-color-scheme: dark)">
    <meta name="csrf-token" content="{{ csrf_token('authenticate') }}">
    <title>{% block title %}{{ settings.site_name }}{% endblock %}</title>

    <!-- Critical CSS -->
    <style>
        /* Стилі для приховування до завантаження Alpine */
        [x-cloak] { 
            display: none !important; 
        }
        
        /* Приховуємо весь контент до готовності Alpine */
        .alpine-loading {
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.3s ease, visibility 0.3s ease;
        }
        .alpine-ready {
            opacity: 1;
            visibility: visible;
        }
        
        /* Виправлення скролу хедера */
        #mainNavbar {
            transition-duration: 500ms !important;
        }
        #mainNavbar.header-hidden {
            transform: translateY(-100%);
        }

        /* Спінер для завантажувача */
        .spinner {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            background: conic-gradient(from 0deg, transparent, #3b82f6, #8b5cf6, #ec4899, transparent);
            animation: spin 1s linear infinite;
            position: relative;
        }
        .spinner::before {
            content: '';
            position: absolute;
            inset: 4px;
            background: white;
            border-radius: 50%;
        }
        .dark .spinner::before {
            background: #171717;
        }

        @keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        /* Анімація прогрес-бара */
        @keyframes progressShift {
            0% { background-position: 200% 0; }
            100% { background-position: 0 0; }
        }
        .animate-progress-bar {
            animation: progressShift 1.5s linear infinite;
            background-size: 200% 100%;
        }

        /* Плавна поява флеш-повідомлень */
        .flash-message {
            animation: fadeInRight 0.4s ease-out forwards;
            opacity: 0;
            transform: translateX(50px);
        }
        @keyframes fadeInRight {
            to { opacity: 1; transform: translateX(0); }
        }
        .flash-message.removing {
            animation: fadeOutRight 0.3s ease-in forwards;
        }
        @keyframes fadeOutRight {
            to { opacity: 0; transform: translateX(50px); }
        }

        /* Кнопка "наверх" – плавна поява */
        #back-to-top {
            transition: opacity 0.4s ease, transform 0.4s ease;
        }

        /* Додаткові стилі для плавного переходу */
        .weather-widget-loading {
            transition: opacity 0.3s ease;
        }
        
        /* Запобігаємо мерехтінню */
        .no-flash {
            opacity: 0;
        }
        .no-flash.ready {
            opacity: 1;
            transition: opacity 0.2s ease;
        }
    </style>

    <!-- Ініціалізація теми -->
    <script>
        (function() {
            try {
                const savedTheme = localStorage.getItem('theme');
                const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                const theme = savedTheme || (systemPrefersDark ? 'dark' : 'light');
                if (theme === 'dark') {
                    document.documentElement.classList.add('dark');
                }
            } catch (e) {}
        })();
    </script>

    <!-- Ініціалізація Alpine -->
    <script>
        // Позначаємо, що Alpine ще не готовий
        document.documentElement.classList.add('alpine-loading');
        
        // Коли Alpine готовий - прибираємо клас завантаження
        document.addEventListener('alpine:init', function() {
            document.documentElement.classList.remove('alpine-loading');
            document.documentElement.classList.add('alpine-ready');
        });
        
        // Якщо Alpine вже завантажений (для випадків коли скрипт виконується пізно)
        if (window.Alpine && window.Alpine.version) {
            document.documentElement.classList.remove('alpine-loading');
            document.documentElement.classList.add('alpine-ready');
        }
        
        // Запасний варіант - прибираємо клас через 1 секунду навіть якщо Alpine не завантажився
        setTimeout(function() {
            document.documentElement.classList.remove('alpine-loading');
            document.documentElement.classList.add('alpine-ready');
        }, 1000);
    </script>

    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}

    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
        <script src="https://cdn.jsdelivr.net/npm/lodash@4.17.21/lodash.min.js"></script>
        <script>
            // Утиліти
            const utils = {
                throttle: (func, limit) => {
                    let inThrottle;
                    return function(...args) {
                        if (!inThrottle) {
                            func.apply(this, args);
                            inThrottle = true;
                            setTimeout(() => inThrottle = false, limit);
                        }
                    };
                }
            };

            // Прогрес читання
            const readingProgress = {
                init() {
                    this.progressBar = document.querySelector('.reading-progress');
                    if (!this.progressBar) {
                        this.progressBar = document.createElement('div');
                        this.progressBar.className = 'reading-progress hidden';
                        document.body.appendChild(this.progressBar);
                    }
                    window.addEventListener('scroll', utils.throttle(() => this.updateProgress(), 50));
                },
                updateProgress() {
                    const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
                    const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
                    const scrolled = (winScroll / height) * 100;
                    if (scrolled > 5 && scrolled < 95) {
                        this.progressBar.classList.remove('hidden');
                        this.progressBar.style.transform = `scaleX(${scrolled / 100})`;
                    } else {
                        this.progressBar.classList.add('hidden');
                    }
                }
            };

            // Кнопка "наверх"
            window.addEventListener('DOMContentLoaded', () => {
                readingProgress.init();
                const backToTop = document.getElementById('back-to-top');
                if (backToTop) {
                    window.addEventListener('scroll', () => {
                        if (window.pageYOffset > 300) {
                            backToTop.classList.remove('opacity-0', 'translate-y-10');
                            backToTop.classList.add('opacity-100', 'translate-y-0');
                        } else {
                            backToTop.classList.remove('opacity-100', 'translate-y-0');
                            backToTop.classList.add('opacity-0', 'translate-y-10');
                        }
                    });
                    backToTop.addEventListener('click', () => {
                        window.scrollTo({ top: 0, behavior: 'smooth' });
                    });
                }
            });

            // Приховати завантажувач після повного завантаження сторінки
            window.addEventListener('load', () => {
                const loader = document.getElementById('global-loader');
                if (loader) {
                    loader.style.opacity = '0';
                    setTimeout(() => loader.style.display = 'none', 300);
                }
            });

            // Автоматичне закриття флеш-повідомлень через 5 секунд
            window.addEventListener('DOMContentLoaded', () => {
                document.querySelectorAll('.flash-message').forEach(msg => {
                    setTimeout(() => {
                        msg.classList.add('removing');
                        setTimeout(() => msg.remove(), 300);
                    }, 5000);
                });
            });
        </script>
    {% endblock %}

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0,1" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@300;400;500;600&display=swap" rel="stylesheet">

    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">

    <meta property="og:title" content="{% block og_title %}Новинний портал{% endblock %}">
    <meta property="og:description" content="{% block og_description %}Сучасний новинний портал з актуальними новинами та статтями{% endblock %}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ app.request.uri }}">
    <meta property="og:image" content="{% block og_image %}/images/og-image.jpg{% endblock %}">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{% block twitter_title %}Новинний портал{% endblock %}">
    <meta name="twitter:description" content="{% block twitter_description %}Сучасний новинний портал з актуальними новинами та статтями{% endblock %}">
    <meta name="twitter:image" content="{% block twitter_image %}/images/twitter-image.jpg{% endblock %}">

    {% block head_extra %}{% endblock %}
</head>
<body class="min-h-screen bg-[var(--color-surface-0)] text-[var(--color-surface-900)] font-sans antialiased dark:bg-[var(--color-surface-100)] dark:text-[var(--color-surface-950)] overflow-x-hidden">
    
    <!-- Loading Overlay -->
    <div id="global-loader"
         class="fixed inset-0 bg-white dark:bg-neutral-900 flex items-center justify-center z-50 transition-opacity duration-300"
         style="display: flex;">

        <div class="relative">
            <div class="relative bg-white/80 dark:bg-neutral-900/80 backdrop-blur-xl px-12 py-10 rounded-3xl shadow-2xl border-3 border-transparent bg-[linear-gradient(var(--tw-gradient-from),var(--tw-gradient-from))_padding-box,linear-gradient(45deg,#3b82f6,#8b5cf6,#ec4899)_border-box]">
                <div class="flex flex-col items-center">
                    <div class="spinner mb-6"></div>
                    <div class="text-center">
                        <h3 class="text-2xl font-bold mb-2 bg-linear-to-r from-blue-500 via-purple-500 to-pink-500 bg-clip-text text-transparent">AdNews.FUN</h3>
                        <p class="text-neutral-600 dark:text-neutral-400 font-medium animate-pulse" id="loader-text">
                            Завантаження<span class="loading-dots">...</span>
                        </p>
                    </div>
                    <div class="w-64 h-2 bg-neutral-200 dark:bg-neutral-700 rounded-full overflow-hidden mt-6">
                        <div class="h-full bg-linear-to-r from-blue-500 via-purple-500 to-pink-500 rounded-full animate-progress-bar"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Flash Messages -->
    {% if flash_messages is defined %}
        <div id="flash-messages" class="fixed top-4 right-4 z-50 space-y-3 max-w-md">
            {% for message in flash_messages %}
                <div class="flash-message bg-white/15 dark:bg-black/15 backdrop-blur-xl rounded-xl overflow-hidden shadow-lg"
                     data-type="{{ message.type }}">
                    <div class="relative px-6 py-4">
                        <div class="absolute inset-0 bg-linear-to-r 
                            {% if message.type == 'success' %}from-green-500/10 to-emerald-500/10
                            {% elseif message.type == 'error' %}from-red-500/10 to-rose-500/10
                            {% elseif message.type == 'warning' %}from-yellow-500/10 to-amber-500/10
                            {% else %}from-blue-500/10 to-cyan-500/10{% endif %}">
                        </div>
                        <div class="relative flex items-center justify-between">
                            <div class="flex items-center gap-4">
                                <div class="w-10 h-10 rounded-full flex items-center justify-center
                                    {% if message.type == 'success' %}bg-green-500/20 text-green-500
                                    {% elseif message.type == 'error' %}bg-red-500/20 text-red-500
                                    {% elseif message.type == 'warning' %}bg-yellow-500/20 text-yellow-500
                                    {% else %}bg-blue-500/20 text-blue-500{% endif %}">
                                    {% if message.type == 'success' %}
                                        <i class="fas fa-check-circle text-lg"></i>
                                    {% elseif message.type == 'error' %}
                                        <i class="fas fa-exclamation-circle text-lg"></i>
                                    {% elseif message.type == 'warning' %}
                                        <i class="fas fa-exclamation-triangle text-lg"></i>
                                    {% else %}
                                        <i class="fas fa-info-circle text-lg"></i>
                                    {% endif %}
                                </div>
                                <div>
                                    <h4 class="font-semibold">
                                        {% if message.type == 'success' %}Успішно
                                        {% elseif message.type == 'error' %}Помилка
                                        {% elseif message.type == 'warning' %}Увага
                                        {% else %}Інформація{% endif %}
                                    </h4>
                                    <p class="text-sm text-neutral-600 dark:text-neutral-400">{{ message.text }}</p>
                                </div>
                            </div>
                            <button class="flash-close w-8 h-8 rounded-full flex items-center justify-center hover:bg-black/10 dark:hover:bg-white/10 transition-colors">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                        <div class="relative mt-3 h-1 bg-black/10 dark:bg-white/10 rounded-full overflow-hidden">
                            <div class="h-full w-full bg-linear-to-r 
                                {% if message.type == 'success' %}from-green-500 to-emerald-500
                                {% elseif message.type == 'error' %}from-red-500 to-rose-500
                                {% elseif message.type == 'warning' %}from-yellow-500 to-amber-500
                                {% else %}from-blue-500 to-cyan-500{% endif %} 
                                animate-progress-bar"></div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    <!-- Header -->
    {% block header %}
        {% include 'components/header.html.twig' %}
    {% endblock %}

    <!-- Main Content -->
    <main class="flex-1" role="main">
        {% block body %}{% endblock %}
    </main>
    
    <!-- Back to Top Button -->
    <button id="back-to-top" 
        class="fixed bottom-6 right-6 bg-linear-to-br from-blue-500 via-purple-500 to-pink-500 text-white p-3 rounded-full shadow-2xl shadow-[0_0_20px_rgba(14,165,233,0.3)] transition-all duration-500 opacity-0 translate-y-10 z-40 hover:scale-110 hover:shadow-[0_0_40px_rgba(14,165,233,0.4)]"
        aria-label="Повернутися нагору">
        <i class="fas fa-chevron-up text-base"></i>
    </button>

    <!-- Footer -->
    {% block footer %}
        {% include 'components/footer.html.twig' %}
    {% endblock %}

    <script>
        // Видаляємо завантажувач після завантаження сторінки
        document.addEventListener('DOMContentLoaded', function() {
            const loader = document.getElementById('global-loader');
            if (loader) {
                setTimeout(function() {
                    loader.style.opacity = '0';
                    setTimeout(function() {
                        loader.style.display = 'none';
                    }, 300);
                }, 500);
            }
        });
    </script>
</body>
</html>