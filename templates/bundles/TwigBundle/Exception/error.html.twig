{# templates/bundles/TwigBundle/Exception/error.html.twig #}
{% extends 'components/erbase.html.twig' %}

{% block title %}{{ status_code }} – {{ status_text }}{% endblock %}

{% block body %}
<div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 mb-8 animate-fade-in"></div>
<div class="min-h-[80vh] flex items-center justify-center px-4 bg-(--color-surface-50) dark:bg-(--color-surface-950)">
    <div class="text-center max-w-lg">
        <div class="w-24 h-24 mx-auto mb-6 rounded-full bg-(--color-surface-200) dark:bg-(--color-surface-700) flex items-center justify-center">
            <svg class="w-12 h-12 text-(--color-surface-500) dark:text-(--color-surface-400)" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
            </svg>
        </div>
        <h1 class="text-6xl lg:text-8xl font-extrabold text-(--color-surface-900) dark:text-(--color-surface-100) mb-4">{{ status_code }}</h1>
        <h2 class="text-2xl lg:text-3xl font-bold text-(--color-surface-900) dark:text-(--color-surface-100) mb-4">{{ status_text }}</h2>
        <p class="text-(--color-surface-600) dark:text-(--color-surface-400) text-lg mb-8">
            Щось пішло не так. Спробуйте пізніше або поверніться на головну.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="{{ path('app_home') }}" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-(--gradient-primary) text-(--color-surface-0) font-semibold rounded-xl hover:shadow-(--shadow-lg) hover-scale transition-all duration-(--transition-base)">
                <i class="fas fa-home"></i>
                На головну
            </a>
        </div>
    </div>
</div>
{% endblock %}