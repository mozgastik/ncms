{# templates/blog/show.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}{{ blogPost.title }} | AdNews.FUN{% endblock %}

{% block meta_description %}{{ blogPost.excerpt|default(blogPost.content|striptags|slice(0, 160)) }}{% endblock %}

{% block body %}
<article class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Хлібні крихти -->
    <nav class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 mb-6">
        <a href="{{ path('blog_index') }}" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
            Головна
        </a>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
        
        <span class="text-gray-700 dark:text-gray-300 font-medium truncate max-w-[200px]">
            {{ blogPost.title|slice(0, 30) }}{% if blogPost.title|length > 30 %}...{% endif %}
        </span>
    </nav>

    <!-- Заголовок з анімацією -->
    <header class="mb-8 animate-fade-in">
        {% if blogPost.isBreaking %}
            <div class="flex items-center gap-2 mb-4">
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-gradient-to-r from-red-500 to-pink-600 text-white text-sm font-bold rounded-full animate-pulse">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                    </svg>
                    🔥 ГАРЯЧА НОВИНА!
                </span>
                <span class="px-3 py-1.5 bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-400 text-sm font-bold rounded-full">
                    ⚡ ЕКСКЛЮЗИВ
                </span>
            </div>
        {% endif %}
        
        <h1 class="text-4xl lg:text-5xl font-bold text-gray-900 dark:text-white mb-4 leading-tight">
            {{ blogPost.title }}
        </h1>
        
        <!-- Мета-інформація з інтерактивом -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
            <div class="flex items-center gap-4 group">
                <div class="relative cursor-pointer" onclick="showAuthorInfo({{ blogPost.author.id }})">
                    <div class="w-14 h-14 rounded-full bg-gradient-to-br from-blue-500 to-purple-600 p-0.5 transition-transform duration-300 group-hover:scale-110">
                        <div class="w-full h-full rounded-full bg-white dark:bg-gray-900 flex items-center justify-center overflow-hidden">
                            {% if blogPost.author.avatar %}
                                <img src="{{ asset('uploads/avatars/' ~ blogPost.author.avatar) }}" 
                                     alt="{{ blogPost.author.username }}" 
                                     class="w-full h-full object-cover">
                            {% else %}
                                <span class="text-xl font-bold text-blue-600 dark:text-blue-400">
                                    {{ blogPost.author.username|first|upper }}
                                </span>
                            {% endif %}
                        </div>
                    </div>
                    <div class="absolute -bottom-1 -right-1 w-5 h-5 bg-green-500 rounded-full border-2 border-white dark:border-gray-900 animate-pulse"></div>
                </div>
                <div>
                    <h3 class="font-bold text-gray-900 dark:text-white hover:text-blue-600 dark:hover:text-blue-400 transition-colors cursor-pointer" 
                        onclick="showAuthorInfo({{ blogPost.author.id }})">
                        {{ blogPost.author.username }}
                    </h3>
                    <div class="flex items-center gap-4 text-sm text-gray-600 dark:text-gray-400">
                        <span class="flex items-center gap-1" title="Дата публікації">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                            </svg>
                            {{ blogPost.publishedAt|date('d.m.Y H:i') }}
                        </span>
                        <span class="flex items-center gap-1" title="Час читання">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                            {{ blogPost.readingTime }} хв
                        </span>
                        <span class="flex items-center gap-1" title="Кількість переглядів">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                            </svg>
                            <span class="font-medium" id="view-count">{{ blogPost.viewCount }}</span>
                        </span>
                    </div>
                </div>
            </div>
            
            <!-- Інтерактивні кнопки дій -->
            <div class="flex items-center gap-3">
                {% if app.user %}
                    <!-- Кнопка закладок з анімацією -->
                    <button onclick="bookmark({{ blogPost.id }})" 
                            class="group relative p-3 rounded-xl bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 transition-all duration-300 hover:scale-110 active:scale-95"
                            aria-label="Додати до закладок"
                            id="bookmark-btn-{{ blogPost.id }}">
                        <svg id="bookmark-icon-{{ blogPost.id }}" 
                             class="w-5 h-5 text-gray-600 dark:text-gray-400 group-hover:text-yellow-500 dark:group-hover:text-yellow-400 transition-all duration-300" 
                             fill="none" 
                             stroke="currentColor" 
                             viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
                        </svg>
                        <span class="absolute -top-1 -right-1 w-4 h-4 bg-red-500 rounded-full text-white text-xs flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                            +
                        </span>
                    </button>
                    <input type="hidden" id="bookmark-{{ blogPost.id }}-token" value="{{ csrf_token('bookmark' ~ blogPost.id) }}">
                {% endif %}
                
                <!-- Кнопка поділитися з поповером -->
                <div class="relative share-dropdown" x-data="{ open: false }">
                    <button @click="open = !open" 
                            @click.outside="open = false"
                            class="p-3 rounded-xl bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 transition-all duration-300 hover:scale-110 active:scale-95 group"
                            aria-label="Поділитися">
                        <svg class="w-5 h-5 text-gray-600 dark:text-gray-400 group-hover:text-blue-500" 
                             fill="none" 
                             stroke="currentColor" 
                             viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>
                        </svg>
                    </button>
                    
                    <!-- Випадаюче меню поділитися -->
                    <div x-show="open" 
                         x-transition:enter="transition ease-out duration-200"
                         x-transition:enter-start="opacity-0 scale-95"
                         x-transition:enter-end="opacity-100 scale-100"
                         x-transition:leave="transition ease-in duration-150"
                         x-transition:leave-start="opacity-100 scale-100"
                         x-transition:leave-end="opacity-0 scale-95"
                         class="absolute right-0 mt-2 w-48 bg-white dark:bg-gray-900 rounded-2xl shadow-2xl border border-gray-200 dark:border-gray-800 overflow-hidden z-50">
                        <div class="p-2">
                            <button onclick="share('facebook')" 
                                    class="w-full flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-blue-50 dark:hover:bg-blue-900/20 text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 transition-all duration-300">
                                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                                </svg>
                                <span class="font-medium">Facebook</span>
                            </button>
                            <button onclick="share('twitter')" 
                                    class="w-full flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-sky-50 dark:hover:bg-sky-900/20 text-gray-700 dark:text-gray-300 hover:text-sky-600 dark:hover:text-sky-400 transition-all duration-300">
                                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.213c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
                                </svg>
                                <span class="font-medium">Twitter</span>
                            </button>
                            <button onclick="share('telegram')" 
                                    class="w-full flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-emerald-50 dark:hover:bg-emerald-900/20 text-gray-700 dark:text-gray-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition-all duration-300">
                                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.894 8.221l-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.446 1.394c-.16.16-.295.295-.605.295l.213-3.053 5.56-5.022c.242-.213-.054-.333-.373-.121l-6.869 4.326-2.962-.924c-.643-.204-.656-.643.136-.95l11.57-4.461c.538-.196 1.006.128.832.941z"/>
                                </svg>
                                <span class="font-medium">Telegram</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Категорія та теги з анімацією -->
        <div class="flex flex-wrap gap-2 mb-8">
            {% if blogPost.category %}
                <a href="{{ path('blog_category', {'slug': blogPost.category.slug}) }}" 
                   class="group inline-flex items-center gap-1.5 px-4 py-2 bg-gradient-to-r from-blue-500 to-blue-600 text-white rounded-xl hover:shadow-lg hover:scale-105 transition-all duration-300">
                    <svg class="w-4 h-4 group-hover:rotate-12 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                    </svg>
                    {{ blogPost.category.name }}
                </a>
            {% endif %}
            
            {% for tag in blogPost.tags %}
                <a href="{{ path('blog_tag', {'slug': tag.slug}) }}" 
                   class="inline-flex items-center gap-1 px-3 py-1.5 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 rounded-full text-sm font-medium hover:bg-blue-100 dark:hover:bg-blue-900/30 hover:text-blue-600 dark:hover:text-blue-400 transition-all duration-300 hover:scale-105 group">
                    <svg class="w-3 h-3 group-hover:rotate-12 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"/>
                    </svg>
                    {{ tag.name }}
                </a>
            {% endfor %}
        </div>
    </header>
    
    <!-- Головне зображення з ефектами -->
    {% if blogPost.featuredImage %}
        <div class="mb-8 overflow-hidden rounded-2xl shadow-xl group relative">
            <img src="{{ asset('uploads/blogs/' ~ blogPost.featuredImage.filename) }}" 
                 class="w-full h-auto max-h-[600px] object-cover group-hover:scale-105 transition-transform duration-700"
                 alt="{{ blogPost.featuredImage.altText|default(blogPost.title) }}"
                 id="featured-image">
            {% if blogPost.featuredImage.caption %}
                <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/80 to-transparent p-6 transform translate-y-full group-hover:translate-y-0 transition-transform duration-500">
                    <p class="text-white/90 text-sm italic text-center">
                        {{ blogPost.featuredImage.caption }}
                    </p>
                </div>
            {% endif %}
            
            <!-- Кнопка збільшення зображення -->
            <button onclick="openImageModal('{{ asset('uploads/blogs/' ~ blogPost.featuredImage.filename) }}')" 
                    class="absolute top-4 right-4 p-2 bg-black/50 hover:bg-black/70 text-white rounded-xl backdrop-blur-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/>
                </svg>
            </button>
        </div>
    {% endif %}
    
    
        
        <!-- Основний контент -->
        <div class="flex-1 order-1 lg:order-2">
            <div class="blog-content prose prose-lg dark:prose-invert max-w-none" id="blog-content">
                {{ blogPost.content|raw }}
            </div>
        </div>
    </div>
    
    <!-- Галерея зображень з лайтбоксом -->
    {% if blogPost.images|length > 1 %}
        <div class="mb-12">
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center gap-2">
                <svg class="w-6 h-6 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
                Галерея
            </h3>
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
                {% for image in blogPost.images %}
                    {% if image != blogPost.featuredImage %}
                        <div class="group relative overflow-hidden rounded-xl shadow-lg hover:shadow-2xl transition-all duration-500 cursor-pointer"
                             onclick="openGallery({{ loop.index0 }})">
                            <img src="{{ asset('uploads/blogs/' ~ image.filename) }}" 
                                 class="w-full h-48 object-cover group-hover:scale-110 transition-transform duration-500"
                                 alt="{{ image.altText|default('') }}">
                            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end justify-center p-4">
                                <span class="text-white text-sm">Переглянути</span>
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    {% endif %}

    <!-- Секція лайків/дизлайків з анімацією -->
    <div class="bg-gradient-to-br from-gray-50 to-gray-100 dark:from-gray-800 dark:to-gray-900 rounded-2xl p-8 mb-8 border border-gray-200 dark:border-gray-700 transform hover:scale-[1.02] transition-transform duration-300">
        <div class="text-center mb-6">
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">
                {% if voteInfo.userLiked or voteInfo.userDisliked %}
                    <span class="inline-block animate-bounce">🙏</span> Дякуємо за ваш відгук!
                {% else %}
                    Як вам стаття?
                {% endif %}
            </h3>
            <p class="text-gray-600 dark:text-gray-400">
                {% set total = voteInfo.likes + voteInfo.dislikes %}
                {% if total > 0 %}
                    {% set ratio = (voteInfo.likes / total * 100)|round %}
                    <span class="font-semibold text-green-600 dark:text-green-400">{{ ratio }}%</span> 
                    користувачів сподобалась ця стаття
                {% else %}
                    Будьте першим, хто оцінить статтю!
                {% endif %}
            </p>
        </div>

        {% if app.user %}
            <!-- Кнопки лайків/дизлайків -->
            <div class="flex flex-col sm:flex-row items-center justify-center gap-4 max-w-md mx-auto">
                <!-- Лайк -->
                <button onclick="like({{ blogPost.id }})" 
                        class="like-btn-{{ blogPost.id }} flex-1 flex items-center justify-center gap-3 px-6 py-4 rounded-xl transition-all duration-300 font-semibold text-lg group relative overflow-hidden"
                        {% if voteInfo.userLiked %}
                            style="background: linear-gradient(135deg, #10b981, #059669); color: white; box-shadow: 0 10px 15px -3px rgba(16, 185, 129, 0.3); transform: scale(1.05);"
                        {% endif %}>
                    <div class="absolute inset-0 bg-white/20 transform -translate-x-full group-hover:translate-x-0 transition-transform duration-500"></div>
                    <svg class="w-6 h-6 relative z-10 {% if not voteInfo.userLiked %}group-hover:scale-110 transition-transform{% endif %}" 
                         fill="{% if voteInfo.userLiked %}currentColor{% else %}none{% endif %}" 
                         stroke="{% if voteInfo.userLiked %}none{% else %}currentColor{% endif %}" 
                         viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="{% if voteInfo.userLiked %}0{% else %}2{% endif %}" 
                              d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5"></path>
                    </svg>
                    <span class="font-bold relative z-10" id="like-count-{{ blogPost.id }}">{{ voteInfo.likes }}</span>
                    {% if voteInfo.userLiked %}
                        <span class="text-xs bg-white/20 px-2 py-1 rounded-full relative z-10">✓</span>
                    {% endif %}
                </button>
                <input type="hidden" id="like-token-{{ blogPost.id }}" value="{{ csrf_token('like' ~ blogPost.id) }}">

                <!-- Дизлайк -->
                <button onclick="dislike({{ blogPost.id }})" 
                        class="dislike-btn-{{ blogPost.id }} flex-1 flex items-center justify-center gap-3 px-6 py-4 rounded-xl transition-all duration-300 font-semibold text-lg group relative overflow-hidden"
                        {% if voteInfo.userDisliked %}
                            style="background: linear-gradient(135deg, #ef4444, #dc2626); color: white; box-shadow: 0 10px 15px -3px rgba(239, 68, 68, 0.3); transform: scale(1.05);"
                        {% endif %}>
                    <div class="absolute inset-0 bg-white/20 transform -translate-x-full group-hover:translate-x-0 transition-transform duration-500"></div>
                    <svg class="w-6 h-6 relative z-10 {% if not voteInfo.userDisliked %}group-hover:scale-110 transition-transform{% endif %}" 
                         fill="{% if voteInfo.userDisliked %}currentColor{% else %}none{% endif %}" 
                         stroke="{% if voteInfo.userDisliked %}none{% else %}currentColor{% endif %}" 
                         viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="{% if voteInfo.userDisliked %}0{% else %}2{% endif %}" 
                              d="M10 14H5.236a2 2 0 01-1.789-2.894l3.5-7A2 2 0 018.736 3h4.018a2 2 0 01.485.06l3.76.94m-7 10v5a2 2 0 002 2h.096c.5 0 .905-.405.905-.904 0-.715.211-1.413.608-2.008L17 13V4m-7 10h2m5-10h2a2 2 0 012 2v6a2 2 0 01-2 2h-2.5"></path>
                    </svg>
                    <span class="font-bold relative z-10" id="dislike-count-{{ blogPost.id }}">{{ voteInfo.dislikes }}</span>
                    {% if voteInfo.userDisliked %}
                        <span class="text-xs bg-white/20 px-2 py-1 rounded-full relative z-10">✓</span>
                    {% endif %}
                </button>
                <input type="hidden" id="dislike-token-{{ blogPost.id }}" value="{{ csrf_token('dislike' ~ blogPost.id) }}">
            </div>
            
            <!-- Прогрес бар рейтингу -->
            {% set total = voteInfo.likes + voteInfo.dislikes %}
            {% if total > 0 %}
                {% set likePercent = (voteInfo.likes / total * 100)|round %}
                {% set dislikePercent = (voteInfo.dislikes / total * 100)|round %}
                <div class="mt-6 max-w-md mx-auto">
                    <div class="flex justify-between text-sm mb-2">
                        <span class="text-green-600 dark:text-green-400 font-medium">👍 {{ likePercent }}%</span>
                        <span class="text-red-600 dark:text-red-400 font-medium">👎 {{ dislikePercent }}%</span>
                    </div>
                    <div class="h-3 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden">
                        <div class="h-full bg-gradient-to-r from-green-500 to-green-400 rounded-full transition-all duration-500" 
                             style="width: {{ likePercent }}%"></div>
                    </div>
                </div>
            {% endif %}
        {% else %}
            <!-- Для неавторизованих -->
            <div class="flex flex-col sm:flex-row items-center justify-center gap-4 max-w-md mx-auto">
                <div class="flex-1 flex items-center justify-center gap-3 px-6 py-4 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 rounded-xl border-2 border-gray-200 dark:border-gray-700 hover:border-green-500 dark:hover:border-green-500 transition-colors group">
                    <svg class="w-6 h-6 text-green-500 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5"></path>
                    </svg>
                    <span class="font-bold" id="like-count-{{ blogPost.id }}">{{ voteInfo.likes }}</span>
                </div>
                <div class="flex-1 flex items-center justify-center gap-3 px-6 py-4 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 rounded-xl border-2 border-gray-200 dark:border-gray-700 hover:border-red-500 dark:hover:border-red-500 transition-colors group">
                    <svg class="w-6 h-6 text-red-500 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14H5.236a2 2 0 01-1.789-2.894l3.5-7A2 2 0 018.736 3h4.018a2 2 0 01.485.06l3.76.94m-7 10v5a2 2 0 002 2h.096c.5 0 .905-.405.905-.904 0-.715.211-1.413.608-2.008L17 13V4m-7 10h2m5-10h2a2 2 0 012 2v6a2 2 0 01-2 2h-2.5"></path>
                    </svg>
                    <span class="font-bold" id="dislike-count-{{ blogPost.id }}">{{ voteInfo.dislikes }}</span>
                </div>
            </div>
            
            <div class="mt-4 text-center">
                <a href="{{ path('app_login') }}" 
                   class="inline-flex items-center gap-2 text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 font-medium hover:underline group">
                    <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
                    </svg>
                    Увійдіть, щоб оцінити статтю
                </a>
            </div>
        {% endif %}
    </div>
    
    <!-- Автор з розширеною інформацією -->
    <div class="bg-gradient-to-br from-gray-50 to-gray-100 dark:from-gray-900 dark:to-gray-800 rounded-2xl p-8 mb-12 border border-gray-200 dark:border-gray-700 hover:shadow-xl transition-shadow duration-300">
        <div class="flex flex-col md:flex-row items-center gap-8">
            <div class="relative group cursor-pointer" onclick="showAuthorInfo({{ blogPost.author.id }})">
                <div class="w-32 h-32 rounded-full bg-gradient-to-br from-blue-500 via-purple-600 to-pink-500 p-1 transition-transform duration-500 group-hover:scale-110 group-hover:rotate-6">
                    <div class="w-full h-full rounded-full bg-white dark:bg-gray-900 flex items-center justify-center overflow-hidden">
                        {% if blogPost.author.avatar %}
                            <img src="{{ asset('uploads/avatars/' ~ blogPost.author.avatar) }}" 
                                 alt="{{ blogPost.author.username }}" 
                                 class="w-full h-full object-cover">
                        {% else %}
                            <span class="text-5xl font-bold text-blue-600 dark:text-blue-400">
                                {{ blogPost.author.username|first|upper }}
                            </span>
                        {% endif %}
                    </div>
                </div>
                <div class="absolute -bottom-2 -right-2 bg-green-500 w-8 h-8 rounded-full border-4 border-white dark:border-gray-800 flex items-center justify-center">
                    <span class="text-white text-xs font-bold">✓</span>
                </div>
            </div>
            <div class="flex-1 text-center md:text-left">
                <h3 class="text-3xl font-bold text-gray-900 dark:text-white mb-2 flex items-center justify-center md:justify-start gap-2">
                    {{ blogPost.author.username }}
                    <span class="px-3 py-1 bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 text-sm rounded-full">Автор</span>
                </h3>
                <p class="text-gray-600 dark:text-gray-300 mb-4 text-lg">
                    Автор цього блогу. Всього опубліковано 
                    <strong class="text-blue-600 dark:text-blue-400">{{ blogPost.author.blogPosts|filter(p => p.isPublished)|length }}</strong> 
                    {% if blogPost.author.blogPosts|filter(p => p.isPublished)|length == 1 %}блог{% else %}блогів{% endif %}.
                </p>
                
                <div class="flex flex-wrap items-center justify-center md:justify-start gap-4">
                    <button onclick="showAuthorInfo({{ blogPost.author.id }})" 
                            class="inline-flex items-center gap-2 px-6 py-3 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 rounded-xl hover:bg-gray-100 dark:hover:bg-gray-700 transition-all duration-300 hover:scale-105 border border-gray-200 dark:border-gray-700 group">
                        <svg class="w-5 h-5 group-hover:rotate-12 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        <span>Про автора</span>
                    </button>
                    
                    {% if app.user and app.user.id == blogPost.author.id %}
                        <a href="{{ path('user_blog_index') }}" 
                           class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-blue-500 to-purple-600 text-white rounded-xl hover:shadow-xl hover:scale-105 transition-all duration-300 group">
                            <svg class="w-5 h-5 group-hover:rotate-180 transition-transform duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                            </svg>
                            <span>Мої блоги</span>
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
    
    <!-- Схожі блоги з каруселлю -->
    {% if relatedPosts|length > 0 %}
        <div class="mb-12">
            <div class="flex items-center justify-between mb-6">
                <h3 class="text-2xl font-bold text-gray-900 dark:text-white flex items-center gap-2">
                    <svg class="w-6 h-6 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                    </svg>
                    Схожі блоги
                </h3>
                <div class="flex gap-2">
                    <button id="prev-related" class="p-2 bg-gray-100 dark:bg-gray-800 rounded-xl hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors disabled:opacity-50">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                        </svg>
                    </button>
                    <button id="next-related" class="p-2 bg-gray-100 dark:bg-gray-800 rounded-xl hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors disabled:opacity-50">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                    </button>
                </div>
            </div>
            
            <div class="relative overflow-hidden">
                <div id="related-carousel" class="flex transition-transform duration-500 ease-out gap-6">
                    {% for related in relatedPosts %}
                        <div class="flex-none w-full md:w-1/2 lg:w-1/3">
                            <a href="{{ path('blog_show', {'slug': related.slug}) }}" 
                               class="group block bg-white dark:bg-gray-900 rounded-2xl shadow-lg hover:shadow-2xl overflow-hidden transition-all duration-500 hover:scale-[1.02] border border-gray-200 dark:border-gray-800 h-full">
                                {% if related.featuredImage %}
                                    <div class="h-48 overflow-hidden">
                                        <img src="{{ asset('uploads/blogs/' ~ related.featuredImage.filename) }}" 
                                             class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                                             alt="{{ related.title }}">
                                    </div>
                                {% else %}
                                    <div class="h-48 bg-gradient-to-br from-gray-200 to-gray-300 dark:from-gray-800 dark:to-gray-700 flex items-center justify-center">
                                        <svg class="w-16 h-16 text-gray-400 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a1 1 0 01-1-1V5a1 1 0 011-1h14a1 1 0 011 1v14a1 1 0 01-1 1zM7 8v8h10V8H7z"/>
                                        </svg>
                                    </div>
                                {% endif %}
                                <div class="p-6">
                                    <h4 class="font-bold text-xl text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors duration-300 line-clamp-2 mb-3">
                                        {{ related.title }}
                                    </h4>
                                    <div class="flex items-center justify-between text-sm text-gray-500 dark:text-gray-400">
                                        <span class="flex items-center gap-1">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                            </svg>
                                            {{ related.readingTime }} хв
                                        </span>
                                        <span class="flex items-center gap-1">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                            </svg>
                                            {{ related.viewCount }}
                                        </span>
                                    </div>
                                </div>
                            </a>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    {% endif %}
    
    <!-- Коментарі з розширеним функціоналом -->
    <section class="mt-12">
        <div class="flex items-center justify-between mb-8">
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white flex items-center gap-2">
                <svg class="w-6 h-6 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                </svg>
                Коментарі
                <span class="ml-2 px-3 py-1 bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 rounded-full text-sm font-medium">
                    {{ approvedComments|length }}
                </span>
            </h3>
            
            <!-- Сортування коментарів -->
            {% if approvedComments|length > 0 %}
            <select id="comment-sort" 
                    class="px-4 py-2 bg-gray-100 dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-700 dark:text-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500">
                <option value="newest">Найновіші</option>
                <option value="oldest">Найстаріші</option>
                <option value="popular">Популярні</option>
            </select>
            {% endif %}
        </div>
        
        <!-- Форма коментаря -->
        <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-xl p-6 md:p-8 mb-8 border border-gray-200 dark:border-gray-800" id="comment-form-container">
            <h4 class="text-lg font-semibold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
                <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                </svg>
                {% if app.user %}
                    <span>Додати коментар як <span class="text-blue-600 dark:text-blue-400">{{ app.user.username }}</span></span>
                {% else %}
                    <span>Додати коментар (гість)</span>
                {% endif %}
            </h4>
            
            {{ form_start(commentForm, {
                'attr': {'class': 'space-y-4', 'id': 'comment-form'},
                'action': path('blog_comment', {'slug': blogPost.slug})
            }) }}
            
            <!-- Якщо користувач не авторизований, показуємо поля для імені та email -->
            {% if not app.user %}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        {{ form_label(commentForm.authorName, 'Ваше ім\'я', {
                            'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2'}
                        }) }}
                        {{ form_widget(commentForm.authorName, {
                            'attr': {
                                'class': 'w-full px-4 py-3 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 transition-all',
                                'placeholder': 'Введіть ваше ім\'я'
                            }
                        }) }}
                        {{ form_errors(commentForm.authorName) }}
                    </div>
                    
                    <div>
                        {{ form_label(commentForm.authorEmail, 'Ваш email', {
                            'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2'}
                        }) }}
                        {{ form_widget(commentForm.authorEmail, {
                            'attr': {
                                'class': 'w-full px-4 py-3 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 transition-all',
                                'placeholder': 'Введіть ваш email (необов\'язково)'
                            }
                        }) }}
                        {{ form_errors(commentForm.authorEmail) }}
                    </div>
                </div>
            {% else %}
                <!-- Приховані поля для авторизованих користувачів -->
                <div style="display: none;">
                    {{ form_widget(commentForm.authorName, { 'attr': {'value': app.user.username} }) }}
                    {{ form_widget(commentForm.authorEmail, { 'attr': {'value': app.user.email} }) }}
                </div>
                
                <!-- Інформація про авторизованого користувача -->
                <div class="flex items-center gap-3 p-4 bg-blue-50 dark:bg-blue-900/20 rounded-xl border border-blue-200 dark:border-blue-800 mb-4">
                    <div class="w-10 h-10 rounded-full bg-gradient-to-br from-blue-500 to-purple-600 p-0.5 flex-shrink-0">
                        <div class="w-full h-full rounded-full bg-white dark:bg-gray-900 flex items-center justify-center overflow-hidden">
                            {% if app.user.avatar %}
                                <img src="{{ asset('uploads/avatars/' ~ app.user.avatar) }}" 
                                     alt="{{ app.user.username }}" 
                                     class="w-full h-full object-cover">
                            {% else %}
                                <span class="text-lg font-bold text-blue-600 dark:text-blue-400">
                                    {{ app.user.username|first|upper }}
                                </span>
                            {% endif %}
                        </div>
                    </div>
                    <div class="flex-1">
                        <p class="text-sm text-gray-600 dark:text-gray-400">
                            Ви коментуєте як
                        </p>
                        <p class="font-semibold text-gray-900 dark:text-white">
                            {{ app.user.username }}
                            {% if app.user.fullName %}
                                <span class="text-sm text-gray-500 dark:text-gray-400">({{ app.user.fullName }})</span>
                            {% endif %}
                        </p>
                    </div>
                    <span class="px-3 py-1 bg-green-100 dark:bg-green-900/30 text-green-600 dark:text-green-400 text-xs rounded-full flex items-center gap-1">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                        Авторизовано
                    </span>
                </div>
            {% endif %}
            
            <!-- Текст коментаря -->
            <div>
                {{ form_label(commentForm.content, 'Ваш коментар', {
                    'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2'}
                }) }}
                {{ form_widget(commentForm.content, {
                    'attr': {
                        'class': 'w-full px-4 py-3 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 transition-all',
                        'rows': 4,
                        'placeholder': 'Напишіть ваш коментар тут...',
                        'id': 'comment-content'
                    }
                }) }}
                {{ form_errors(commentForm.content) }}
                
                <!-- Лічильник символів -->
                <div class="flex justify-end mt-2">
                    <span class="text-xs text-gray-500 dark:text-gray-400" id="comment-char-count">0</span>
                    <span class="text-xs text-gray-500 dark:text-gray-400">/1000</span>
                </div>
            </div>
            
            <!-- Кнопка відправки -->
            <div class="flex justify-end">
                <button type="submit" 
                        class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-gradient-to-r from-blue-500 to-purple-600 text-white font-semibold rounded-xl hover:shadow-xl hover:scale-105 active:scale-95 transition-all duration-300 group">
                    <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                    </svg>
                    <span>Надіслати коментар</span>
                    <span class="ml-1 text-xs bg-white/20 px-2 py-0.5 rounded-full opacity-0 group-hover:opacity-100 transition-opacity">
                        Ctrl+Enter
                    </span>
                </button>
            </div>
            
            {{ form_end(commentForm) }}
        </div>
        
        <!-- Список коментарів -->
        <div id="commentsList" class="space-y-6">
            {% if approvedComments|length > 0 %}
                {% for comment in approvedComments %}
                    <div class="comment-item bg-white dark:bg-gray-900 rounded-2xl p-6 border border-gray-200 dark:border-gray-800 hover:shadow-xl transition-all duration-300" 
                         data-comment-id="{{ comment.id }}"
                         data-created="{{ comment.createdAt|date('U') }}">
                        
                        <div class="flex items-start gap-4">
                            <!-- Аватар -->
                            <div class="relative flex-shrink-0">
                                <div class="w-12 h-12 rounded-full bg-gradient-to-br from-blue-500 to-purple-600 p-0.5">
                                    <div class="w-full h-full rounded-full bg-white dark:bg-gray-900 flex items-center justify-center overflow-hidden">
                                        {% if comment.user %}
                                            {% if comment.user.avatar %}
                                                <img src="{{ asset('uploads/avatars/' ~ comment.user.avatar) }}" 
                                                     alt="{{ comment.user.username }}" 
                                                     class="w-full h-full object-cover">
                                            {% else %}
                                                <span class="text-lg font-bold text-blue-600 dark:text-blue-400">
                                                    {{ comment.user.username|first|upper }}
                                                </span>
                                            {% endif %}
                                        {% else %}
                                            <span class="text-lg font-bold text-gray-600 dark:text-gray-400">
                                                {{ comment.authorName|first|upper }}
                                            </span>
                                        {% endif %}
                                    </div>
                                </div>
                                {% if comment.user %}
                                    <div class="absolute -bottom-1 -right-1 w-5 h-5 bg-green-500 rounded-full border-2 border-white dark:border-gray-900"></div>
                                {% endif %}
                            </div>
                            
                            <!-- Контент коментаря -->
                            <div class="flex-1">
                                <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                                    <div class="flex items-center gap-2">
                                        <h4 class="font-semibold text-gray-900 dark:text-white">
                                            {{ comment.getDisplayName() }}
                                        </h4>
                                        {% if comment.user %}
                                            {% if comment.user == blogPost.author %}
                                                <span class="px-2 py-0.5 bg-yellow-100 dark:bg-yellow-900/30 text-yellow-600 dark:text-yellow-400 text-xs rounded-full">
                                                    Автор
                                                </span>
                                            {% else %}
                                                <span class="px-2 py-0.5 bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 text-xs rounded-full flex items-center gap-1">
                                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                                    </svg>
                                                    Авторизований
                                                </span>
                                            {% endif %}
                                        {% else %}
                                            <span class="px-2 py-0.5 bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 text-xs rounded-full">
                                                Гість
                                            </span>
                                        {% endif %}
                                    </div>
                                    <span class="text-sm text-gray-500 dark:text-gray-400 flex items-center gap-1">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                        </svg>
                                        {{ comment.createdAt|date('d.m.Y H:i') }}
                                    </span>
                                </div>
                                
                                <p class="text-gray-700 dark:text-gray-300 leading-relaxed">
                                    {{ comment.content|nl2br }}
                                </p>
                                
                                <!-- Дії з коментарем -->
                                {% if app.user %}
                                    <div class="flex items-center gap-4 mt-4 pt-3 border-t border-gray-100 dark:border-gray-800">
                                        <button class="flex items-center gap-1 text-sm text-gray-500 hover:text-blue-600 dark:hover:text-blue-400 transition-colors group">
                                            <svg class="w-4 h-4 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5"/>
                                            </svg>
                                            <span class="comment-likes-count">0</span>
                                        </button>
                                        <button class="flex items-center gap-1 text-sm text-gray-500 hover:text-red-600 dark:hover:text-red-400 transition-colors group">
                                            <svg class="w-4 h-4 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14H5.236a2 2 0 01-1.789-2.894l3.5-7A2 2 0 018.736 3h4.018a2 2 0 01.485.06l3.76.94m-7 10v5a2 2 0 002 2h.096c.5 0 .905-.405.905-.904 0-.715.211-1.413.608-2.008L17 13V4m-7 10h2m5-10h2a2 2 0 012 2v6a2 2 0 01-2 2h-2.5"/>
                                            </svg>
                                            <span class="comment-dislikes-count">0</span>
                                        </button>
                                        <button class="flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700 dark:hover:text-gray-300 transition-colors group">
                                            <svg class="w-4 h-4 group-hover:rotate-12 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/>
                                            </svg>
                                            Відповісти
                                        </button>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
                
                <!-- Пагінація коментарів -->
                {% if approvedComments|length > 10 %}
                    <div class="mt-8 flex justify-center">
                        <button id="load-more-comments" 
                                class="px-6 py-3 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 rounded-xl hover:bg-gray-200 dark:hover:bg-gray-700 transition-all duration-300 hover:scale-105">
                            Завантажити ще коментарі
                        </button>
                    </div>
                {% endif %}
                
            {% else %}
                <!-- Немає коментарів -->
                <div class="text-center py-16 bg-gradient-to-br from-gray-50 to-gray-100 dark:from-gray-900 dark:to-gray-800 rounded-2xl border border-gray-200 dark:border-gray-800">
                    <svg class="w-20 h-20 text-gray-400 dark:text-gray-600 mx-auto mb-4 animate-bounce" 
                         fill="none" 
                         stroke="currentColor" 
                         viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                    </svg>
                    <h4 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">
                        Ще немає коментарів
                    </h4>
                    <p class="text-gray-600 dark:text-gray-400 text-lg">
                        Будьте першим, хто залишить коментар!
                    </p>
                </div>
            {% endif %}
        </div>
    </section>
</article>

<!-- Модальне вікно для зображень -->
<div id="image-modal" class="fixed inset-0 bg-black/90 z-50 hidden items-center justify-center" onclick="ModalManager.closeImage()">
    <button class="absolute top-4 right-4 text-white hover:text-gray-300 transition-colors" onclick="ModalManager.closeImage()">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
    </button>
    <img id="modal-image" src="" alt="" class="max-w-full max-h-[90vh] object-contain">
    
    <!-- Навігація галереї -->
    <button class="absolute left-4 top-1/2 transform -translate-y-1/2 text-white hover:text-gray-300 transition-colors" onclick="GalleryManager.prev()">
        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
    </button>
    <button class="absolute right-4 top-1/2 transform -translate-y-1/2 text-white hover:text-gray-300 transition-colors" onclick="GalleryManager.next()">
        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
    </button>
</div>

<!-- Модальне вікно для інформації про автора -->
<div id="author-modal" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 hidden items-center justify-center" onclick="ModalManager.closeAuthor()">
    <div class="bg-white dark:bg-gray-900 rounded-2xl max-w-md w-full mx-4 p-6" onclick="event.stopPropagation()">
        <div class="flex justify-between items-center mb-4">
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white">Про автора</h3>
            <button onclick="ModalManager.closeAuthor()" class="text-gray-500 hover:text-gray-700 dark:hover:text-gray-300">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>
        <div id="author-info" class="space-y-4">
            <!-- Буде заповнено JavaScript -->
        </div>
    </div>
</div>

<!-- JavaScript -->
<script>
// Конфігурація
const CONFIG = {
    postId: {{ blogPost.id }},
    userId: {% if app.user %}{{ app.user.id }}{% else %}null{% endif %},
    isAuthenticated: {% if app.user %}true{% else %}false{% endif %},
    isAdmin: {% if is_granted('ROLE_ADMIN') %}true{% else %}false{% endif %},
    debug: false
};

// Утиліти для логування
const Logger = {
    log: function(message, data = null) {
        if (CONFIG.debug) {
            console.log(`[LOG] ${message}`, data ? data : '');
        }
    },
    error: function(message, error = null) {
        console.error(`[ERROR] ${message}`, error ? error : '');
    },
    warn: function(message) {
        console.warn(`[WARN] ${message}`);
    }
};

// Управління лайками
const LikeManager = {
    async like(postId) {
        if (!CONFIG.isAuthenticated) {
            window.app?.notify('Увійдіть, щоб оцінити статтю', 'warning');
            return;
        }
        
        const token = document.getElementById(`like-token-${postId}`)?.value;
        if (!token) {
            Logger.error('Токен не знайдено');
            window.app?.notify('Помилка автентифікації', 'error');
            return;
        }
        
        try {
            const response = await fetch(`/blog/${postId}/like`, {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `_token=${encodeURIComponent(token)}`
            });
            
            const data = await response.json();
            
            if (data.success) {
                this.updateCounts(postId, data);
                window.app?.notify(data.message, 'success');
                this.updateVoteButtons(postId, data.userVote);
            } else {
                window.app?.notify(data.error || 'Сталася помилка', 'error');
            }
        } catch (error) {
            Logger.error('Помилка лайка:', error);
            window.app?.notify('Сталася помилка. Спробуйте пізніше.', 'error');
        }
    },
    
    async dislike(postId) {
        if (!CONFIG.isAuthenticated) {
            window.app?.notify('Увійдіть, щоб оцінити статтю', 'warning');
            return;
        }
        
        const token = document.getElementById(`dislike-token-${postId}`)?.value;
        if (!token) {
            Logger.error('Токен не знайдено');
            window.app?.notify('Помилка автентифікації', 'error');
            return;
        }
        
        try {
            const response = await fetch(`/blog/${postId}/dislike`, {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `_token=${encodeURIComponent(token)}`
            });
            
            const data = await response.json();
            
            if (data.success) {
                this.updateCounts(postId, data);
                window.app?.notify(data.message, 'info');
                this.updateVoteButtons(postId, data.userVote);
            } else {
                window.app?.notify(data.error || 'Сталася помилка', 'error');
            }
        } catch (error) {
            Logger.error('Помилка дизлайка:', error);
            window.app?.notify('Сталася помилка. Спробуйте пізніше.', 'error');
        }
    },
    
    updateCounts(postId, data) {
        const elements = {
            likeCount: document.getElementById(`like-count-${postId}`),
            dislikeCount: document.getElementById(`dislike-count-${postId}`),
            likes: document.getElementById(`likes-${postId}`),
            dislikes: document.getElementById(`dislikes-${postId}`)
        };
        
        if (elements.likeCount) elements.likeCount.textContent = data.likes;
        if (elements.dislikeCount) elements.dislikeCount.textContent = data.dislikes;
        if (elements.likes) elements.likes.textContent = data.likes;
        if (elements.dislikes) elements.dislikes.textContent = data.dislikes;
    },
    
    updateVoteButtons(postId, userVote) {
        const likeBtn = document.querySelector(`.like-btn-${postId}`);
        const dislikeBtn = document.querySelector(`.dislike-btn-${postId}`);
        
        if (!likeBtn || !dislikeBtn) return;
        
        // Скидаємо стилі
        [likeBtn, dislikeBtn].forEach(btn => {
            btn.removeAttribute('style');
            btn.className = btn.className.replace(/bg-gradient-to-r.*?(?=\s|$)/g, '');
            btn.classList.add('bg-white', 'dark:bg-gray-800', 'border-2', 'border-gray-200', 'dark:border-gray-700');
        });
        
        if (userVote === 'like') {
            likeBtn.style.background = 'linear-gradient(135deg, #10b981, #059669)';
            likeBtn.style.color = 'white';
            likeBtn.style.boxShadow = '0 10px 15px -3px rgba(16, 185, 129, 0.3)';
            likeBtn.style.transform = 'scale(1.05)';
            likeBtn.classList.remove('border-2', 'border-gray-200', 'dark:border-gray-700');
        } else if (userVote === 'dislike') {
            dislikeBtn.style.background = 'linear-gradient(135deg, #ef4444, #dc2626)';
            dislikeBtn.style.color = 'white';
            dislikeBtn.style.boxShadow = '0 10px 15px -3px rgba(239, 68, 68, 0.3)';
            dislikeBtn.style.transform = 'scale(1.05)';
            dislikeBtn.classList.remove('border-2', 'border-gray-200', 'dark:border-gray-700');
        }
    }
};

// Управління закладками
const BookmarkManager = {
    async toggle(postId) {
        if (!CONFIG.isAuthenticated) {
            window.app?.notify('Увійдіть, щоб додати до закладок', 'warning');
            return;
        }
        
        const token = document.getElementById(`bookmark-${postId}-token`)?.value;
        if (!token) {
            Logger.error('Токен не знайдено');
            window.app?.notify('Помилка автентифікації', 'error');
            return;
        }
        
        const icon = document.getElementById(`bookmark-icon-${postId}`);
        
        try {
            const response = await fetch(`/blog/${postId}/bookmark`, {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `_token=${encodeURIComponent(token)}`
            });
            
            const data = await response.json();
            
            if (data.success) {
                if (data.isBookmarked) {
                    icon.setAttribute('fill', 'currentColor');
                    icon.classList.add('text-yellow-500');
                    window.app?.notify('Додано до закладок!', 'success');
                } else {
                    icon.removeAttribute('fill');
                    icon.classList.remove('text-yellow-500');
                    window.app?.notify('Видалено з закладок', 'info');
                }
            }
        } catch (error) {
            Logger.error('Помилка закладок:', error);
            window.app?.notify('Сталася помилка', 'error');
        }
    }
};

// Управління коментарями
const CommentManager = {
    init() {
        this.setupCharacterCounter();
        this.setupSorting();
        this.setupLoadMore();
        this.setupKeyboardShortcuts();
    },
    
    setupCharacterCounter() {
        const commentInput = document.getElementById('comment-content');
        const charCount = document.getElementById('comment-char-count');
        
        if (commentInput && charCount) {
            commentInput.addEventListener('input', function() {
                const count = this.value.length;
                charCount.textContent = count;
                
                if (count > 1000) {
                    this.value = this.value.substring(0, 1000);
                    charCount.textContent = 1000;
                }
            });
        }
    },
    
    setupSorting() {
        const sortSelect = document.getElementById('comment-sort');
        const commentsList = document.getElementById('comments-list');
        
        if (sortSelect && commentsList) {
            sortSelect.addEventListener('change', function() {
                const comments = Array.from(commentsList.children);
                const sortBy = this.value;
                
                comments.sort((a, b) => {
                    const dateA = new Date(a.dataset.created * 1000);
                    const dateB = new Date(b.dataset.created * 1000);
                    
                    if (sortBy === 'newest') return dateB - dateA;
                    if (sortBy === 'oldest') return dateA - dateB;
                    return 0;
                });
                
                commentsList.innerHTML = '';
                comments.forEach(comment => commentsList.appendChild(comment));
            });
        }
    },
    
    setupLoadMore() {
        const loadMoreBtn = document.getElementById('load-more-comments');
        if (!loadMoreBtn) return;
        
        loadMoreBtn.addEventListener('click', async () => {
            loadMoreBtn.disabled = true;
            loadMoreBtn.innerHTML = 'Завантаження...';
            
            // Тут буде AJAX запит
            setTimeout(() => {
                loadMoreBtn.disabled = false;
                loadMoreBtn.innerHTML = 'Завантажити ще коментарі';
            }, 1000);
        });
    },
    
    setupKeyboardShortcuts() {
        const commentInput = document.getElementById('comment-content');
        const form = document.getElementById('comment-form');
        
        if (commentInput && form) {
            commentInput.addEventListener('keydown', (e) => {
                if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
                    e.preventDefault();
                    form.submit();
                }
            });
        }
    },
    
    reply(commentId) {
        if (!CONFIG.isAuthenticated) {
            window.app?.notify('Увійдіть, щоб відповісти на коментар', 'warning');
            return;
        }
        
        const commentInput = document.getElementById('comment-content');
        if (commentInput) {
            commentInput.focus();
            commentInput.value = `@${commentId} `;
            commentInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
    }
};

// Управління прогресом читання
const ReadingProgress = {
    bar: null,
    text: null,
    
    init() {
        this.bar = document.getElementById('reading-progress-bar');
        this.text = document.getElementById('reading-progress-text');
        
        if (this.bar) {
            window.addEventListener('scroll', this.update.bind(this));
            this.update();
        }
    },
    
    update() {
        const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
        const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const scrolled = (winScroll / height) * 100;
        
        if (this.bar) {
            this.bar.style.width = scrolled + '%';
        }
        if (this.text) {
            this.text.textContent = Math.round(scrolled) + '%';
        }
    }
};

// Управління модальними вікнами
const ModalManager = {
    openImage(imageUrl) {
        const modal = document.getElementById('image-modal');
        const modalImg = document.getElementById('modal-image');
        
        if (modal && modalImg) {
            modalImg.src = imageUrl;
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            document.body.style.overflow = 'hidden';
        }
    },
    
    closeImage() {
        const modal = document.getElementById('image-modal');
        if (modal) {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.body.style.overflow = 'auto';
        }
    },
    
    openAuthor(authorId) {
        const modal = document.getElementById('author-modal');
        const authorInfo = document.getElementById('author-info');
        
        if (modal && authorInfo) {
            // Тут буде AJAX запит
            authorInfo.innerHTML = this.getAuthorTemplate(authorId);
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            document.body.style.overflow = 'hidden';
        }
    },
    
    closeAuthor() {
        const modal = document.getElementById('author-modal');
        if (modal) {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.body.style.overflow = 'auto';
        }
    },
    
    getAuthorTemplate(authorId) {
        return `
            <div class="text-center">
                <div class="w-24 h-24 mx-auto rounded-full bg-gradient-to-br from-blue-500 to-purple-600 p-1 mb-4">
                    <div class="w-full h-full rounded-full bg-white dark:bg-gray-900 flex items-center justify-center">
                        <span class="text-3xl font-bold text-blue-600 dark:text-blue-400">A</span>
                    </div>
                </div>
                <h4 class="text-xl font-bold text-gray-900 dark:text-white mb-2">Інформація про автора</h4>
                <p class="text-gray-600 dark:text-gray-400 mb-4">Завантаження...</p>
            </div>
        `;
    }
};

// Управління галереєю
const GalleryManager = {
    currentIndex: 0,
    images: [
        {% for image in blogPost.images %}
            '{{ asset('uploads/blogs/' ~ image.filename) }}',
        {% endfor %}
    ],
    
    open(index) {
        this.currentIndex = index;
        ModalManager.openImage(this.images[index]);
    },
    
    next() {
        if (this.currentIndex < this.images.length - 1) {
            this.currentIndex++;
            ModalManager.openImage(this.images[this.currentIndex]);
        }
    },
    
    prev() {
        if (this.currentIndex > 0) {
            this.currentIndex--;
            ModalManager.openImage(this.images[this.currentIndex]);
        }
    }
};

// Управління каруселлю
const CarouselManager = {
    init() {
        const carousel = document.getElementById('related-carousel');
        const prevBtn = document.getElementById('prev-related');
        const nextBtn = document.getElementById('next-related');
        
        if (!carousel || !prevBtn || !nextBtn) return;
        
        let currentSlide = 0;
        const slides = carousel.children.length;
        
        const getVisibleSlides = () => {
            if (window.innerWidth < 768) return 1;
            if (window.innerWidth < 1024) return 2;
            return 3;
        };
        
        const updateCarousel = () => {
            const visibleSlides = getVisibleSlides();
            const slideWidth = 100 / visibleSlides;
            
            carousel.style.transform = `translateX(-${currentSlide * slideWidth}%)`;
            prevBtn.disabled = currentSlide === 0;
            nextBtn.disabled = currentSlide >= slides - visibleSlides;
        };
        
        prevBtn.addEventListener('click', () => {
            if (currentSlide > 0) {
                currentSlide--;
                updateCarousel();
            }
        });
        
        nextBtn.addEventListener('click', () => {
            const visibleSlides = getVisibleSlides();
            if (currentSlide < slides - visibleSlides) {
                currentSlide++;
                updateCarousel();
            }
        });
        
        window.addEventListener('resize', updateCarousel);
        updateCarousel();
    }
};

// Управління змістом
const TableOfContents = {
    init() {
        const content = document.getElementById('blog-content');
        const toc = document.getElementById('table-of-contents');
        
        if (!content || !toc) return;
        
        const headings = content.querySelectorAll('h2, h3');
        
        if (headings.length === 0) {
            toc.parentElement?.classList.add('hidden');
            return;
        }
        
        headings.forEach((heading, index) => {
            const id = `heading-${index}`;
            heading.id = id;
            
            const link = document.createElement('a');
            link.href = `#${id}`;
            link.className = `block py-1 hover:text-blue-600 dark:hover:text-blue-400 transition-colors ${
                heading.tagName === 'H3' ? 'ml-4 text-sm' : 'font-medium'
            }`;
            link.textContent = heading.textContent;
            
            link.addEventListener('click', (e) => {
                e.preventDefault();
                heading.scrollIntoView({ behavior: 'smooth' });
            });
            
            toc.appendChild(link);
        });
    }
};

// Ініціалізація
document.addEventListener('DOMContentLoaded', function() {
    CommentManager.init();
    ReadingProgress.init();
    TableOfContents.init();
    CarouselManager.init();
    
    {% if voteInfo.userLiked or voteInfo.userDisliked %}
        LikeManager.updateVoteButtons(
            {{ blogPost.id }}, 
            '{{ voteInfo.userLiked ? 'like' : (voteInfo.userDisliked ? 'dislike' : '') }}'
        );
    {% endif %}
    
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            ModalManager.closeImage();
            ModalManager.closeAuthor();
        }
    });
});

// Глобальні функції
window.like = (postId) => LikeManager.like(postId);
window.dislike = (postId) => LikeManager.dislike(postId);
window.bookmark = (postId) => BookmarkManager.toggle(postId);
window.share = (platform) => {
    const url = encodeURIComponent(window.location.href);
    const title = encodeURIComponent(document.title);
    
    const urls = {
        facebook: `https://www.facebook.com/sharer/sharer.php?u=${url}`,
        twitter: `https://twitter.com/intent/tweet?url=${url}&text=${title}`,
        telegram: `https://t.me/share/url?url=${url}&text=${title}`
    };
    
    if (urls[platform]) {
        window.open(urls[platform], '_blank', 'width=600,height=400');
        window.app?.notify('Дякуємо, що поділилися!', 'success');
    }
};
window.replyToComment = (commentId) => CommentManager.reply(commentId);
window.openImageModal = (imageUrl) => ModalManager.openImage(imageUrl);
window.closeModal = () => ModalManager.closeImage();
window.openGallery = (index) => GalleryManager.open(index);
window.showAuthorInfo = (authorId) => ModalManager.openAuthor(authorId);
window.closeAuthorModal = () => ModalManager.closeAuthor();
</script>
{% endblock %}