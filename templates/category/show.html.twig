{% extends 'base.html.twig' %}

{% block title %}Категорія: {{ category.name }} - Новинний портал{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <div class="mb-8">
        <div class="mb-4">
            <a href="{{ path('app_category_index') }}" 
               class="inline-flex items-center text-blue-600 hover:text-blue-800 font-medium">
                <svg class="w-5 h-5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
                Усі статті категорії
            </a>
        </div>
        
        <h1 class="text-4xl font-bold text-gray-800 mb-2">{{ category.name }}</h1>
        
        {% if category.description %}
            <p class="text-gray-600 text-lg mb-6">{{ category.description }}</p>
        {% endif %}
        
        <div class="flex items-center text-gray-500">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
            </svg>
            <span>Статей: {{ pagination.getTotalItemCount }}</span>
        </div>
    </div>

    {% if pagination|length > 0 %}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {% for article in pagination %}
                <article class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-xl transition group">
                    {% if article.coverImage %}
                        <div class="relative overflow-hidden h-48">
                            {% if article.coverImage %}
    <img src="{{ vich_uploader_asset(article, 'coverImageFile') }}" 
         alt="{{ article.title }}" 
                                 class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
                            
                            {# Бейдж часу читання #}
                            <div class="absolute top-2 right-2">
                                <span class="px-2 py-1 bg-black/70 text-white text-xs font-bold rounded backdrop-blur-sm">
                                    {{ (article.content|striptags|split(' ')|length / 200)|round(0, 'ceil') }} хв
                                </span>
                            </div>
                        </div>
                    {% else %}
                        <div class="h-48 bg-gradient-to-br from-gray-200 to-gray-300 dark:from-gray-700 dark:to-gray-800 flex items-center justify-center">
                            <svg class="w-16 h-16 text-gray-400 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
                            </svg>
                        </div>
                    {% endif %}
                    
                    <div class="p-6">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-gray-500 text-sm flex items-center gap-1">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                </svg>
                                {{ article.publishedAt|date('d.m.Y') }}
                            </span>
                            <span class="text-gray-500 text-sm flex items-center gap-1">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                </svg>
                                {{ article.views }}
                            </span>
                        </div>
                        
                        <h3 class="text-xl font-bold mb-3 line-clamp-2">
                            <a href="{{ path('app_article_show', {slug: article.slug}) }}" 
                               class="text-gray-800 hover:text-blue-600 transition">
                                {{ article.title }}
                            </a>
                        </h3>
                        
                        <p class="text-gray-600 mb-4 line-clamp-2">
                            {{ article.excerpt|slice(0, 120) }}...
                        </p>
                        
                        <div class="flex justify-between items-center">
                            <div class="flex flex-wrap gap-1">
                                {% for tag in article.tags|slice(0, 2) %}
                                    <a href="{{ path('app_tag_show', {slug: tag.slug}) }}" 
                                       class="bg-gray-100 hover:bg-gray-200 text-gray-800 text-xs px-2 py-1 rounded transition">
                                        #{{ tag.name }}
                                    </a>
                                {% endfor %}
                                {% if article.tags|length > 2 %}
                                    <span class="text-gray-400 text-xs px-1">+{{ article.tags|length - 2 }}</span>
                                {% endif %}
                            </div>
                            
                            <a href="{{ path('app_article_show', {slug: article.slug}) }}" 
                               class="text-blue-600 hover:text-blue-800 text-sm font-medium inline-flex items-center gap-1">
                                Читати
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                                </svg>
                            </a>
                        </div>
                    </div>
                </article>
            {% endfor %}
        </div>

        {# Пагінація #}
        <div class="mt-8">
            {{ knp_pagination_render(pagination) }}
        </div>
    {% else %}
        <div class="text-center py-12 bg-white rounded-lg shadow-sm">
            <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <h3 class="text-xl font-semibold text-gray-700 mb-2">Поки що немає статей</h3>
            <p class="text-gray-500">У цій категорії ще не опубліковано жодної статті.</p>
            <a href="{{ path('app_category_index') }}" 
               class="inline-block mt-4 px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition">
                До всіх категорій
            </a>
        </div>
    {% endif %}
</div>
{% endblock %}