{% extends 'base.html.twig' %}

{% block title %}Статті за тегом "{{ tag.name }}" - Новинний портал{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <!-- Breadcrumb -->
    <nav class="mb-6">
        <ol class="flex items-center space-x-2 text-sm">
            <li>
                <a href="{{ path('app_home') }}" class="text-blue-600 hover:text-blue-800">
                    Головна
                </a>
            </li>
            <li class="text-gray-500">/</li>
            <li>
                <a href="{{ path('app_tag_index') }}" class="text-blue-600 hover:text-blue-800">
                    Теги
                </a>
            </li>
            <li class="text-gray-500">/</li>
            <li class="text-gray-700">{{ tag.name }}</li>
        </ol>
    </nav>
    
    <!-- Tag Header -->
    <div class="bg-white rounded-xl shadow-lg p-6 md:p-8 mb-8">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-3xl font-bold text-gray-800 mb-2">
                    <i class="fas fa-hashtag mr-2"></i>
                    Тег: {{ tag.name }}
                </h1>
                <p class="text-gray-600">
                    Кількість статей: {{ pagination.getTotalItemCount() }}
                </p>
            </div>
            <div class="text-sm text-gray-500">
                <a href="{{ path('app_tag_index') }}" class="text-blue-600 hover:text-blue-800">
                    <i class="fas fa-list mr-1"></i>Всі теги
                </a>
            </div>
        </div>
    </div>
    
    <!-- Articles List -->
    {% if pagination|length > 0 %}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {% for article in pagination %}
                <article class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-xl transition group">
                    {% if article.coverImage %}
                        <div class="relative h-48 overflow-hidden">
                            <img src="{{ article.coverImage }}" 
                                 alt="{{ article.title }}" 
                                 class="w-full h-full object-cover group-hover:scale-105 transition duration-300">
                            <div class="absolute top-2 right-2">
                                <span class="text-xs font-semibold px-2 py-1 rounded-full bg-green-100 text-green-800">
                                    {{ article.getStatusText(article.status) }}
                                </span>
                            </div>
                        </div>
                    {% endif %}
                    <div class="p-6">
                        {% if article.category %}
                            <div class="mb-2">
                                <a href="{{ path('app_category_show', {'slug': article.category.slug}) }}" 
                                   class="text-xs font-medium text-blue-600 hover:text-blue-800">
                                    {{ article.category.name }}
                                </a>
                            </div>
                        {% endif %}
                        
                        <h3 class="text-xl font-bold mb-3">
                            <a href="{{ path('app_article_show', {'slug': article.slug}) }}" 
                               class="text-gray-800 hover:text-blue-600 transition">
                                {{ article.title }}
                            </a>
                        </h3>
                        <p class="text-gray-600 mb-4 text-sm">{{ article.excerpt|slice(0, 100) }}...</p>
                        <div class="flex items-center justify-between text-sm text-gray-500">
                            <div class="flex items-center space-x-3">
                                <span>{{ article.publishedAt|date('d.m.Y') }}</span>
                                <span class="flex items-center">
                                    <i class="fas fa-eye mr-1"></i>
                                    {{ article.views }}
                                </span>
                            </div>
                            <span class="text-blue-600 font-medium">
                                {{ article.readingTime }} хв
                            </span>
                        </div>
                        
                        <!-- Tags -->
                        {% if article.tags|length > 0 %}
                            <div class="mt-4 pt-4 border-t border-gray-100">
                                <div class="flex flex-wrap gap-1">
                                    {% for tag in article.tags %}
                                        {% if tag.id != currentTag.id %}
                                            <a href="{{ path('app_tag_show', {'slug': tag.slug}) }}"
                                               class="inline-flex items-center px-2 py-1 bg-gray-100 text-gray-800 text-xs rounded hover:bg-gray-200 transition">
                                                <i class="fas fa-hashtag mr-1 text-xs"></i>
                                                {{ tag.name }}
                                            </a>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </article>
            {% endfor %}
        </div>
        
        <!-- Pagination -->
        {% if pagination|length > 0 %}
            <div class="mt-8">
                {{ knp_pagination_render(pagination) }}
            </div>
        {% endif %}
    {% else %}
        <div class="text-center py-12">
            <div class="text-gray-300 mb-4">
                <i class="fas fa-newspaper text-5xl"></i>
            </div>
            <h3 class="text-xl font-semibold text-gray-700 mb-2">Немає статей з цим тегом</h3>
            <p class="text-gray-500 mb-6">На жаль, за тегом "{{ tag.name }}" поки що немає статей.</p>
            <a href="{{ path('app_article_index') }}" 
               class="inline-block px-6 py-3 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition">
                Перейти до всіх статей
            </a>
        </div>
    {% endif %}
</div>
{% endblock %}