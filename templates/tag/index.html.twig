{% extends 'base.html.twig' %}

{% block title %}Усі теги - Новинний портал{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <!-- Breadcrumb -->
    <nav class="mb-6">
        <ol class="flex items-center space-x-2 text-sm">
            <li>
                <a href="{{ path('app_home') }}" class="text-blue-600 hover:text-blue-800">
                    Головна
                </a>
            </li>
            <li class="text-gray-500">/</li>
            <li class="text-gray-700">Теги</li>
        </ol>
    </nav>
    
    <!-- Page Header -->
    <div class="bg-white rounded-xl shadow-lg p-6 md:p-8 mb-8">
        <h1 class="text-3xl font-bold text-gray-800 mb-2">
            <i class="fas fa-hashtag mr-2"></i>
            Усі теги
        </h1>
        <p class="text-gray-600">
            Оберіть тег для перегляду статей
        </p>
    </div>
    
    <!-- Tags Cloud -->
    {% if tags|length > 0 %}
        <div class="bg-white rounded-xl shadow-lg p-6 md:p-8">
            <div class="flex flex-wrap gap-3">
                {% for tag in tags %}
                    <a href="{{ path('app_tag_show', {'slug': tag.slug}) }}"
                       class="inline-flex items-center px-4 py-2 bg-blue-100 text-blue-700 rounded-full text-sm font-medium hover:bg-blue-200 transition group">
                        <i class="fas fa-hashtag mr-2"></i>
                        {{ tag.name }}
                        <span class="ml-2 text-xs bg-blue-600 text-white px-2 py-0.5 rounded-full">
                            {{ tag.articles|length }}
                        </span>
                    </a>
                {% endfor %}
            </div>
        </div>
    {% else %}
        <div class="text-center py-12">
            <div class="text-gray-300 mb-4">
                <i class="fas fa-hashtag text-5xl"></i>
            </div>
            <h3 class="text-xl font-semibold text-gray-700 mb-2">Немає тегів</h3>
            <p class="text-gray-500 mb-6">Теги ще не додані до системи.</p>
        </div>
    {% endif %}
</div>
{% endblock %}