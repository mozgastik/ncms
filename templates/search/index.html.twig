{% extends 'base.html.twig' %}

{% block title %}Пошук - Новинний портал{% endblock %}

{% block body %}
    <div class="max-w-4xl mx-auto">
        <div class="mb-8">
            <h1 class="text-4xl font-bold text-gray-800 mb-4">Пошук</h1>
            
            <form action="{{ path('app_search') }}" method="get" class="mb-6">
                <div class="relative">
                    <input type="search" 
                           name="q" 
                           value="{{ query }}"
                           placeholder="Введіть пошуковий запит..."
                           class="w-full px-6 py-4 border border-gray-300 rounded-lg text-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <button type="submit" 
                            class="absolute right-3 top-3 bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 transition">
                        Пошук
                    </button>
                </div>
            </form>
            
            {% if query %}
                <p class="text-gray-600">
                    Результати пошуку для "<span class="font-semibold">{{ query }}</span>":
                    <span class="ml-2 text-blue-600">{{ results_count }} знайдено</span>
                </p>
            {% endif %}
        </div>

        {% if query %}
            {% if articles|length > 0 %}
                <div class="space-y-6">
                    {% for article in articles %}
                        <article class="bg-white rounded-lg shadow-sm p-6 hover:shadow-md transition">
                            <div class="flex flex-col md:flex-row gap-6">
                                {% if article.coverImage %}
                                    <div class="md:w-1/4">
                                        <img src="{{ article.coverImage }}" alt="{{ article.title }}" 
                                             class="w-full h-40 object-cover rounded-lg">
                                    </div>
                                {% endif %}
                                <div class="flex-1">
                                    <div class="flex items-center mb-2">
                                        <span class="bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded">
                                            {{ article.category.name }}
                                        </span>
                                        <span class="text-gray-500 text-sm ml-2">
                                            {{ article.publishedAt|date('d.m.Y H:i') }}
                                        </span>
                                    </div>
                                    <h3 class="text-xl font-bold mb-3">
                                        <a href="{{ path('app_article_show', {slug: article.slug}) }}" 
                                           class="text-gray-800 hover:text-blue-600 transition">
                                            {{ article.title }}
                                        </a>
                                    </h3>
                                    {# Альтернативный блок с подсветкой #}
<p class="text-gray-600 mb-4">
    {% set full_text = article.excerpt ~ ' ' ~ article.content %}
    {% set search_query = query %}
    
    {# Простая проверка наличия #}
    {% if search_query|lower in full_text|lower %}
        {# Находим позицию #}
        {% set text_lower = full_text|lower %}
        {% set query_lower = search_query|lower %}
        {% set position = text_lower|split(query_lower)|first|length %}
        
        {% if position > 50 %}
            ...{{ full_text|slice(position - 50, 150)|raw }}...
        {% else %}
            {{ full_text|slice(0, 200)|raw }}...
        {% endif %}
    {% else %}
        {{ article.excerpt|slice(0, 200) }}...
    {% endif %}
</p>
                                    <div class="flex justify-between items-center">
                                        <div class="flex space-x-2">
                                            {% for tag in article.tags|slice(0, 2) %}
                                                <span class="bg-gray-100 text-gray-800 text-xs px-2 py-1 rounded">
                                                    {{ tag.name }}
                                                </span>
                                            {% endfor %}
                                        </div>
                                        <span class="text-gray-500 text-sm">
                                            👁️ {{ article.views }}
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </article>
                    {% endfor %}
                </div>
            {% else %}
                <div class="text-center py-12 bg-white rounded-lg shadow-sm">
                    <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <h3 class="text-xl font-semibold text-gray-700 mb-2">Нічого не знайдено</h3>
                    <p class="text-gray-500">Спробуйте інший пошуковий запит.</p>
                </div>
            {% endif %}
        {% else %}
            <div class="text-center py-12">
                <p class="text-gray-500 text-lg">Введіть пошуковий запит у поле вище</p>
            </div>
        {% endif %}
    </div>
{% endblock %}