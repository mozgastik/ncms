{% extends 'base.html.twig' %}

{% block title %}Мої відео{% endblock %}

{% block body %}
<div class="content-container py-6">
    <!-- Заголовок -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
        <div>
            <h1 class="text-2xl font-bold gradient-text">Мої відео</h1>
            <p class="text-surface-600 dark:text-surface-400">
                Керуйте вашими відео
            </p>
        </div>
        
        <a href="{{ path('user_video_new') }}" 
           class="px-4 py-2 bg-gradient-to-r from-red-500 to-purple-600 text-white rounded-lg hover:scale-105 transition-all duration-300 flex items-center gap-2">
            <i class="fas fa-plus"></i>
            <span>Додати відео</span>
        </a>
    </div>

    <!-- Статистика -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
        <div class="glass-light rounded-xl p-4 border border-surface-200/50 dark:border-surface-700/50">
            <p class="text-sm text-surface-500 dark:text-surface-400">Всього відео</p>
            <p class="text-2xl font-bold text-gray-900 dark:text-white">{{ stats.total }}</p>
        </div>
        
        <div class="glass-light rounded-xl p-4 border border-surface-200/50 dark:border-surface-700/50">
            <p class="text-sm text-surface-500 dark:text-surface-400">Опубліковано</p>
            <p class="text-2xl font-bold text-green-600">{{ stats.published }}</p>
        </div>
        
        <div class="glass-light rounded-xl p-4 border border-surface-200/50 dark:border-surface-700/50">
            <p class="text-sm text-surface-500 dark:text-surface-400">Чернетки</p>
            <p class="text-2xl font-bold text-yellow-600">{{ stats.drafts }}</p>
        </div>
        
        <div class="glass-light rounded-xl p-4 border border-surface-200/50 dark:border-surface-700/50">
            <p class="text-sm text-surface-500 dark:text-surface-400">Переглядів</p>
            <p class="text-2xl font-bold text-purple-600">{{ stats.views|number_format }}</p>
        </div>
    </div>

    <!-- Список відео -->
    {% if videos|length > 0 %}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {% for video in videos %}
                <div class="group relative bg-white dark:bg-gray-900/30 backdrop-blur-sm rounded-2xl shadow-md overflow-hidden border border-gray-200 dark:border-gray-700/50">
                    
                    <!-- Мініатюра -->
                    <a href="{{ path('user_video_edit', {'id': video.id}) }}" class="block relative aspect-video overflow-hidden">
                        {% if video.thumbnail %}
                            <img src="{{ video.thumbnail }}" alt="{{ video.title }}" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
                        {% else %}
                            <div class="w-full h-full bg-gradient-to-br from-gray-800 to-gray-900 flex items-center justify-center">
                                <i class="fas fa-video text-4xl text-white/30"></i>
                            </div>
                        {% endif %}
                        
                        <!-- Статус -->
                        <div class="absolute top-2 left-2">
                            {% if video.isPublished %}
                                <span class="px-2 py-1 bg-green-500 text-white text-xs rounded-md">Опубліковано</span>
                            {% else %}
                                <span class="px-2 py-1 bg-yellow-500 text-white text-xs rounded-md">На модерації</span>
                            {% endif %}
                        </div>
                    </a>
                    
                    <!-- Інформація -->
                    <div class="p-4">
                        <h3 class="font-bold text-gray-900 dark:text-white mb-2 line-clamp-2">
                            <a href="{{ path('user_video_edit', {'id': video.id}) }}" class="hover:text-red-600">
                                {{ video.title }}
                            </a>
                        </h3>
                        
                        <div class="flex items-center justify-between text-sm text-gray-500 dark:text-gray-400 mb-3">
                            <span class="flex items-center gap-1">
                                <i class="far fa-eye"></i>
                                {{ video.views }}
                            </span>
                            <span class="flex items-center gap-1">
                                <i class="far fa-heart"></i>
                                {{ video.likes }}
                            </span>
                            <span>
                                {{ video.createdAt|date('d.m.Y') }}
                            </span>
                        </div>
                        
                        <!-- Кнопки дій -->
                        <div class="flex gap-2 pt-3 border-t border-gray-200 dark:border-gray-700">
                            <a href="{{ path('user_video_edit', {'id': video.id}) }}" 
                               class="flex-1 text-center px-3 py-2 text-sm bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 rounded-lg hover:bg-blue-200 dark:hover:bg-blue-900/50 transition-colors">
                                <i class="fas fa-edit mr-1"></i> Редагувати
                            </a>
                            
                            <form method="post" action="{{ path('user_video_delete', {'id': video.id}) }}" 
                                  onsubmit="return confirm('Видалити це відео?');" class="flex-1">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ video.id) }}">
                                <button type="submit" 
                                        class="w-full px-3 py-2 text-sm bg-red-100 dark:bg-red-900/30 text-red-600 dark:text-red-400 rounded-lg hover:bg-red-200 dark:hover:bg-red-900/50 transition-colors">
                                    <i class="fas fa-trash mr-1"></i> Видалити
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <!-- Пустий стан -->
        <div class="text-center py-16 glass-light rounded-xl border border-surface-200/50 dark:border-surface-700/50">
            <div class="flex justify-center mb-4">
                <div class="w-24 h-24 bg-gradient-to-br from-red-500/20 to-purple-600/20 rounded-full flex items-center justify-center">
                    <i class="fas fa-video text-4xl text-red-500/50"></i>
                </div>
            </div>
            <h3 class="text-xl font-semibold text-surface-800 dark:text-surface-200 mb-2">У вас ще немає відео</h3>
            <p class="text-surface-500 dark:text-surface-400 mb-6">Додайте своє перше відео та поділіться ним зі спільнотою</p>
            <a href="{{ path('user_video_new') }}" 
               class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-red-500 to-purple-600 text-white rounded-lg hover:scale-105 transition-all duration-300">
                <i class="fas fa-plus"></i>
                <span>Додати відео</span>
            </a>
        </div>
    {% endif %}
</div>
{% endblock %}