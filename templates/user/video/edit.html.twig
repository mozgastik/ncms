{# templates/user/video/edit.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Редагування відео: {{ video.title }}{% endblock %}

{% block body %}
<div class="content-container py-8">
    <div class="max-w-4xl mx-auto">
        {# Заголовок #}
        <div class="flex items-center justify-between mb-6">
            <div>
                <h1 class="text-2xl lg:text-3xl font-bold text-(--color-surface-900) dark:text-(--color-surface-100)">
                    ✏️ Редагування відео
                </h1>
                <p class="text-(--color-surface-500) dark:text-(--color-surface-400) text-sm mt-1">
                    Змініть дані вашого відео
                </p>
            </div>
            <a href="{{ path('user_video_index') }}" 
               class="inline-flex items-center gap-2 text-sm text-(--color-surface-600) dark:text-(--color-surface-400) hover:text-(--color-primary-600) dark:hover:text-(--color-primary-400) transition-colors">
                <i class="fas fa-arrow-left"></i>
                Назад до списку
            </a>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            {# Ліва колонка: форма #}
            <div class="lg:col-span-2">
                <div class="bg-(--color-surface-0) dark:bg-(--color-surface-800) rounded-2xl shadow-(--shadow-md) border border-(--color-surface-200) dark:border-(--color-surface-700) p-6">
                    {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

                    {# Назва #}
                    <div>
                        <label class="block text-sm font-medium text-(--color-surface-700) dark:text-(--color-surface-300) mb-2">
                            {{ form.title.vars.label|default('Назва відео') }}
                        </label>
                        {{ form_widget(form.title, {
                            'attr': {
                                'class': 'w-full px-4 py-2.5 rounded-xl border border-(--color-surface-300) dark:border-(--color-surface-600) bg-(--color-surface-0) dark:bg-(--color-surface-800) text-(--color-surface-900) dark:text-(--color-surface-100) placeholder-(--color-surface-400) dark:placeholder-(--color-surface-500) focus:ring-2 focus:ring-(--color-primary-500)/50 focus:border-(--color-primary-500) transition-all',
                                'placeholder': 'Введіть назву відео'
                            }
                        }) }}
                        {{ form_errors(form.title) }}
                    </div>

                    {# URL #}
                    <div>
                        <label class="block text-sm font-medium text-(--color-surface-700) dark:text-(--color-surface-300) mb-2">
                            {{ form.url.vars.label|default('URL відео') }}
                        </label>
                        <div class="relative">
                            {{ form_widget(form.url, {
                                'attr': {
                                    'class': 'w-full px-4 py-2.5 rounded-xl border border-(--color-surface-300) dark:border-(--color-surface-600) bg-(--color-surface-0) dark:bg-(--color-surface-800) text-(--color-surface-900) dark:text-(--color-surface-100) placeholder-(--color-surface-400) dark:placeholder-(--color-surface-500) focus:ring-2 focus:ring-(--color-primary-500)/50 focus:border-(--color-primary-500) transition-all',
                                    'placeholder': 'https://www.youtube.com/watch?v=...'
                                }
                            }) }}
                            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-(--color-surface-400) dark:text-(--color-surface-500)">
                                <i class="fas fa-link"></i>
                            </span>
                        </div>
                        <p class="text-xs text-(--color-surface-500) dark:text-(--color-surface-400) mt-1">
                            Підтримуються YouTube, Vimeo, Rutube, Telegram
                        </p>
                        {{ form_errors(form.url) }}
                    </div>

                    {# Опис #}
                    <div>
                        <label class="block text-sm font-medium text-(--color-surface-700) dark:text-(--color-surface-300) mb-2">
                            {{ form.description.vars.label|default('Опис') }}
                        </label>
                        {{ form_widget(form.description, {
                            'attr': {
                                'class': 'w-full px-4 py-2.5 rounded-xl border border-(--color-surface-300) dark:border-(--color-surface-600) bg-(--color-surface-0) dark:bg-(--color-surface-800) text-(--color-surface-900) dark:text-(--color-surface-100) placeholder-(--color-surface-400) dark:placeholder-(--color-surface-500) focus:ring-2 focus:ring-(--color-primary-500)/50 focus:border-(--color-primary-500) transition-all',
                                'rows': 4,
                                'placeholder': 'Короткий опис відео...'
                            }
                        }) }}
                        {{ form_errors(form.description) }}
                    </div>

                    {# Категорія #}
                    <div>
                        <label class="block text-sm font-medium text-(--color-surface-700) dark:text-(--color-surface-300) mb-2">
                            {{ form.category.vars.label|default('Категорія') }}
                        </label>
                        {{ form_widget(form.category, {
                            'attr': {
                                'class': 'w-full px-4 py-2.5 rounded-xl border border-(--color-surface-300) dark:border-(--color-surface-600) bg-(--color-surface-0) dark:bg-(--color-surface-800) text-(--color-surface-900) dark:text-(--color-surface-100) focus:ring-2 focus:ring-(--color-primary-500)/50 focus:border-(--color-primary-500) transition-all'
                            }
                        }) }}
                        {{ form_errors(form.category) }}
                    </div>

                    {# Теги #}
                    <div>
                        <label class="block text-sm font-medium text-(--color-surface-700) dark:text-(--color-surface-300) mb-2">
                            {{ form.tags.vars.label|default('Теги') }}
                        </label>
                        {{ form_widget(form.tags, {
                            'attr': {
                                'class': 'w-full px-4 py-2.5 rounded-xl border border-(--color-surface-300) dark:border-(--color-surface-600) bg-(--color-surface-0) dark:bg-(--color-surface-800) text-(--color-surface-900) dark:text-(--color-surface-100) focus:ring-2 focus:ring-(--color-primary-500)/50 focus:border-(--color-primary-500) transition-all',
                                'placeholder': 'новини, спорт, технології'
                            }
                        }) }}
                        <p class="text-xs text-(--color-surface-500) dark:text-(--color-surface-400) mt-1">
                            Розділяйте теги комами
                        </p>
                        {{ form_errors(form.tags) }}
                    </div>

                    {# Кнопки дій #}
                    <div class="flex items-center justify-between pt-4 border-t border-(--color-surface-200) dark:border-(--color-surface-700)">
                        <a href="{{ path('user_video_index') }}" 
                           class="inline-flex items-center gap-2 px-4 py-2.5 text-sm font-medium text-(--color-surface-700) dark:text-(--color-surface-300) bg-(--color-surface-100) dark:bg-(--color-surface-800) rounded-xl hover:bg-(--color-surface-200) dark:hover:bg-(--color-surface-700) transition-all duration-(--transition-base)">
                            <i class="fas fa-times"></i>
                            Скасувати
                        </a>
                        <button type="submit" 
                                class="inline-flex items-center gap-2 px-6 py-2.5 bg-(--gradient-primary) text-(--color-surface-0) font-semibold rounded-xl hover:shadow-(--shadow-lg) hover-scale transition-all duration-(--transition-base)">
                            <i class="fas fa-save"></i>
                            Зберегти зміни
                        </button>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>

            {# Права колонка: прев'ю відео #}
            <div class="space-y-4">
                <div class="bg-(--color-surface-0) dark:bg-(--color-surface-800) rounded-2xl shadow-(--shadow-md) border border-(--color-surface-200) dark:border-(--color-surface-700) p-6">
                    <h3 class="text-lg font-semibold text-(--color-surface-900) dark:text-(--color-surface-100) mb-4">
                        📺 Поточне відео
                    </h3>
                    {% if video.thumbnail %}
                        <div class="relative pb-[56.25%] h-0 rounded-xl overflow-hidden mb-4">
                            <iframe src="{{ video.thumbnail }}" 
                                    class="absolute inset-0 w-full h-full"
                                    frameborder="0" 
                                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                                    allowfullscreen></iframe>
                        </div>
                    {% else %}
                        <div class="flex items-center justify-center h-40 bg-(--color-surface-100) dark:bg-(--color-surface-700) rounded-xl mb-4">
                            <p class="text-(--color-surface-400) dark:text-(--color-surface-500)">
                                Немає прев'ю
                            </p>
                        </div>
                    {% endif %}

                    <div class="space-y-2 text-sm">
                        <div class="flex justify-between">
                            <span class="text-(--color-surface-500) dark:text-(--color-surface-400)">Джерело:</span>
                            <span class="font-medium text-(--color-surface-900) dark:text-(--color-surface-100)">
                                {{ video.source|capitalize }}
                            </span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-(--color-surface-500) dark:text-(--color-surface-400)">Тривалість:</span>
                            <span class="font-medium text-(--color-surface-900) dark:text-(--color-surface-100)">
                                {{ video.formattedDuration }}
                            </span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-(--color-surface-500) dark:text-(--color-surface-400)">Створено:</span>
                            <span class="font-medium text-(--color-surface-900) dark:text-(--color-surface-100)">
                                {{ video.createdAt|date('d.m.Y H:i') }}
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}