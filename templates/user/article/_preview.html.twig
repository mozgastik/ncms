{# templates/user/article/_preview.html.twig #}

<div class="max-w-3xl mx-auto">
    {% if coverImage %}
        <div class="relative w-full h-64 mb-6 rounded-xl overflow-hidden bg-gray-100 dark:bg-gray-800">
            <img src="{{ coverImage }}" alt="{{ title }}" class="w-full h-full object-cover">
        </div>
    {% endif %}
    
    <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">{{ title }}</h1>
    
    {% if excerpt %}
        <div class="text-lg text-gray-600 dark:text-gray-400 mb-6">{{ excerpt }}</div>
    {% endif %}
    
    <div class="prose prose-lg dark:prose-invert max-w-none">
        {{ content|raw }}
    </div>
</div>