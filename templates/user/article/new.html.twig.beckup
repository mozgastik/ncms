{% extends 'base.html.twig' %}

{% block title %}Нова стаття{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link href="https://fonts.googleapis.com/css2?family=Aref+Ruqaa&family=Mirza&family=Roboto&display=swap" rel="stylesheet">

<style>
    /* ============================================ */
    /* ОСНОВНІ СТИЛІ ФОРМИ */
    /* ============================================ */
    
    .form-control, .form-select {
        width: 100%;
        padding: 0.5rem 0.75rem;
        border: 1px solid #d1d5db;
        border-radius: 0.5rem;
        transition: all 0.3s ease;
        background: white;
        color: #1f2937;
    }
    .dark .form-control, .dark .form-select {
        background: #1f2937;
        border-color: #374151;
        color: #e5e7eb;
    }
    .form-control:focus, .form-select:focus {
        outline: none;
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
    }

    /* Quill Editor Styles */
    .ql-toolbar.ql-snow {
        background: #f8fafc;
        border-color: #d1d5db;
        border-radius: 0.5rem 0.5rem 0 0;
    }
    .dark .ql-toolbar.ql-snow {
        background: #1f2937;
        border-color: #374151;
    }
    .ql-container.ql-snow {
        border-color: #d1d5db;
        border-radius: 0 0 0.5rem 0.5rem;
        min-height: 400px;
        background: white;
        color: #1f2937;
    }
    .dark .ql-container.ql-snow {
        background: #111827;
        border-color: #374151;
        color: #e5e7eb;
    }
    .ql-editor {
        min-height: 400px;
        font-size: 16px;
        line-height: 1.8;
    }
    .dark .ql-editor {
        color: #e5e7eb;
    }
    .dark .ql-editor.ql-blank::before {
        color: #6b7280;
    }
    .dark .ql-snow .ql-stroke {
        stroke: #d1d5db;
    }
    .dark .ql-snow .ql-fill {
        fill: #d1d5db;
    }
    .dark .ql-snow .ql-picker {
        color: #d1d5db;
    }
    .dark .ql-snow .ql-picker-options {
        background: #1f2937;
        border-color: #374151;
    }
    
    /* ============================================ */
    /* СТИЛІ ДЛЯ МОДАЛЬНОГО ВІКНА */
    /* ============================================ */
    
    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(8px);
        z-index: 1000;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 1rem;
    }
    .modal-overlay.active {
        display: flex;
        animation: fadeIn 0.3s ease-out;
    }
    .modal-content {
        background: white;
        border-radius: 1rem;
        max-width: 800px;
        width: 100%;
        max-height: 90vh;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    }
    .dark .modal-content {
        background: #1f2937;
    }
    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 1.5rem;
        border-bottom: 1px solid #e5e7eb;
    }
    .dark .modal-header {
        border-color: #374151;
    }
    .modal-body {
        padding: 1.5rem;
        overflow-y: auto;
        flex: 1;
        max-height: 60vh;
    }
    .modal-footer {
        padding: 1rem 1.5rem;
        border-top: 1px solid #e5e7eb;
        display: flex;
        justify-content: flex-end;
        gap: 0.5rem;
        flex-wrap: wrap;
    }
    .dark .modal-footer {
        border-color: #374151;
    }

    /* Медіа-бібліотека */
    .media-library {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
        gap: 0.75rem;
        padding: 0.5rem;
        background: #f8fafc;
        border-radius: 0.5rem;
        max-height: 400px;
        overflow-y: auto;
    }
    .dark .media-library {
        background: #1f2937;
    }
    
    .media-item {
        position: relative;
        border-radius: 0.5rem;
        overflow: hidden;
        cursor: pointer;
        border: 2px solid transparent;
        transition: all 0.3s ease;
        aspect-ratio: 1 / 1;
        background: white;
    }
    .dark .media-item {
        background: #111827;
    }
    .media-item:hover {
        border-color: #3b82f6;
        transform: scale(1.05);
    }
    .media-item.selected {
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.3);
    }
    .media-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .media-item .media-info {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        background: rgba(0, 0, 0, 0.7);
        color: white;
        padding: 0.25rem 0.5rem;
        font-size: 0.6rem;
        opacity: 0;
        transition: opacity 0.3s ease;
        backdrop-filter: blur(4px);
    }
    .media-item:hover .media-info {
        opacity: 1;
    }
    
    .media-empty {
        grid-column: 1 / -1;
        text-align: center;
        padding: 2rem;
        color: #9ca3af;
    }

    /* ============================================ */
    /* СТИЛІ ДЛЯ ТЕГІВ */
    /* ============================================ */
    
    .selected-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        padding: 0.5rem;
        min-height: 40px;
        border: 2px dashed #d1d5db;
        border-radius: 0.5rem;
        background: #f9fafb;
        transition: all 0.3s ease;
    }
    .dark .selected-tags {
        background: #1f2937;
        border-color: #374151;
    }
    .selected-tags:empty::before {
        content: 'Виберіть теги нижче';
        color: #9ca3af;
        font-size: 0.875rem;
        width: 100%;
        text-align: center;
    }
    
    .selected-tag {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        padding: 0.25rem 0.5rem 0.25rem 0.75rem;
        background: #eff6ff;
        color: #1e40af;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 500;
        border: 1px solid #bfdbfe;
        animation: tagAppear 0.2s ease-out;
    }
    .dark .selected-tag {
        background: #1e293b;
        color: #93c5fd;
        border-color: #1e40af;
    }
    .selected-tag .remove-tag {
        cursor: pointer;
        opacity: 0.6;
        transition: opacity 0.2s ease;
        font-size: 0.7rem;
        padding: 0 0.25rem;
        color: #dc2626;
    }
    .selected-tag .remove-tag:hover {
        opacity: 1;
        transform: scale(1.2);
    }
    
    .tag-search-input {
        width: 100%;
        padding: 0.5rem 0.75rem;
        border: 1px solid #d1d5db;
        border-radius: 0.5rem;
        font-size: 0.875rem;
        transition: all 0.3s ease;
        background: white;
    }
    .dark .tag-search-input {
        background: #1f2937;
        border-color: #374151;
        color: white;
    }
    .tag-search-input:focus {
        outline: none;
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
    }
    
    .tag-suggestions {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: white;
        border: 1px solid #d1d5db;
        border-radius: 0.5rem;
        max-height: 200px;
        overflow-y: auto;
        z-index: 50;
        display: none;
        margin-top: 0.25rem;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    }
    .dark .tag-suggestions {
        background: #1f2937;
        border-color: #374151;
    }
    .tag-suggestions.active {
        display: block;
    }
    .tag-suggestion-item {
        padding: 0.5rem 0.75rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        transition: background 0.2s ease;
        border-bottom: 1px solid #f3f4f6;
    }
    .dark .tag-suggestion-item {
        border-color: #374151;
    }
    .tag-suggestion-item:hover {
        background: #f3f4f6;
    }
    .dark .tag-suggestion-item:hover {
        background: #374151;
    }
    .tag-suggestion-item .tag-color {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        display: inline-block;
        flex-shrink: 0;
    }
    .tag-suggestion-item .tag-name {
        font-weight: 500;
    }
    .tag-suggestion-item .tag-count {
        font-size: 0.75rem;
        color: #6b7280;
        margin-left: auto;
    }
    
    .tags-container {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        padding: 0.5rem;
        background: #f8fafc;
        border-radius: 0.5rem;
        border: 1px solid #e5e7eb;
        min-height: 50px;
        max-height: 200px;
        overflow-y: auto;
    }
    .dark .tags-container {
        background: #1f2937;
        border-color: #374151;
    }
    
    .tag-item {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        padding: 0.25rem 0.75rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s ease;
        user-select: none;
        border: 2px solid transparent;
    }
    .tag-item:hover {
        transform: scale(1.05);
    }
    .tag-item.selected {
        border-color: #3b82f6;
        box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
    }
    .tag-item .tag-color {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
    }
    .tag-item .tag-remove {
        display: none;
        margin-left: 0.25rem;
        font-size: 0.7rem;
        cursor: pointer;
        opacity: 0.6;
        color: #dc2626;
    }
    .tag-item.selected .tag-remove {
        display: inline;
    }
    .tag-item .tag-remove:hover {
        opacity: 1;
        transform: scale(1.2);
    }
    
    @keyframes tagAppear {
        from { opacity: 0; transform: scale(0.8); }
        to { opacity: 1; transform: scale(1); }
    }
    
    /* ============================================ */
    /* СТИЛІ ДЛЯ ОБКЛАДИНКИ ТА ГАЛЕРЕЇ */
    /* ============================================ */
    
    .cover-url-input-group {
        display: flex;
        gap: 0.5rem;
        margin-top: 0.5rem;
    }
    .cover-url-input-group input {
        flex: 1;
        padding: 0.5rem 0.75rem;
        border: 1px solid #d1d5db;
        border-radius: 0.5rem;
        font-size: 0.875rem;
        transition: all 0.3s ease;
        background: white;
    }
    .dark .cover-url-input-group input {
        background: #1f2937;
        border-color: #374151;
        color: white;
    }
    .cover-url-input-group input:focus {
        outline: none;
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
    }
    .cover-url-input-group button {
        padding: 0.5rem 1rem;
        background: #3b82f6;
        color: white;
        border: none;
        border-radius: 0.5rem;
        cursor: pointer;
        transition: all 0.3s ease;
        white-space: nowrap;
    }
    .cover-url-input-group button:hover {
        background: #2563eb;
        transform: scale(1.02);
    }
    
    .upload-area {
        border: 2px dashed #d1d5db;
        border-radius: 0.5rem;
        padding: 1.5rem;
        text-align: center;
        cursor: pointer;
        transition: all 0.3s ease;
        background: #f9fafb;
    }
    .dark .upload-area {
        background: #1f2937;
        border-color: #374151;
    }
    .upload-area:hover, .upload-area.drag-over {
        border-color: #3b82f6;
        background: #eff6ff;
    }
    .dark .upload-area:hover, .dark .upload-area.drag-over {
        background: #1e293b;
        border-color: #3b82f6;
    }
    
    .gallery-item {
        position: relative;
        border-radius: 0.5rem;
        overflow: hidden;
        border: 1px solid #e5e7eb;
        transition: all 0.3s ease;
        background: white;
        aspect-ratio: 4/3;
    }
    .dark .gallery-item {
        background: #1f2937;
        border-color: #374151;
    }
    .gallery-item:hover {
        transform: scale(1.02);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    }
    .gallery-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .gallery-overlay {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.6);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        opacity: 0;
        transition: opacity 0.3s ease;
    }
    .gallery-item:hover .gallery-overlay {
        opacity: 1;
    }
    .gallery-overlay button {
        padding: 0.5rem;
        border-radius: 9999px;
        border: none;
        cursor: pointer;
        transition: transform 0.2s;
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .gallery-overlay button:hover {
        transform: scale(1.1);
    }
    .cover-badge {
        position: absolute;
        top: 0.5rem;
        left: 0.5rem;
        background: #3b82f6;
        color: white;
        font-size: 0.6rem;
        padding: 0.2rem 0.5rem;
        border-radius: 0.25rem;
        z-index: 10;
        display: flex;
        align-items: center;
        gap: 0.25rem;
    }
    
    .progress-bar {
        height: 4px;
        background: #e5e7eb;
        border-radius: 2px;
        overflow: hidden;
        margin-top: 0.5rem;
    }
    .dark .progress-bar {
        background: #374151;
    }
    .progress-fill {
        height: 100%;
        background: linear-gradient(90deg, #3b82f6, #8b5cf6);
        width: 0%;
        transition: width 0.3s ease;
    }
    
    .slug-preview {
        font-size: 0.75rem;
        color: #6b7280;
        margin-top: 0.25rem;
    }
    .slug-preview span {
        font-family: monospace;
        background: #f3f4f6;
        padding: 0.125rem 0.25rem;
        border-radius: 0.25rem;
    }
    .dark .slug-preview span {
        background: #374151;
        color: #9ca3af;
    }
    
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in {
        animation: fadeIn 0.3s ease-out;
    }
    
    [x-cloak] {
        display: none !important;
    }
</style>
{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto px-4 py-8" 
     x-data="articleForm()" 
     x-init="init()"
     x-cloak>

    <h1 class="text-3xl font-bold mb-6 bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">
        ✍️ Нова стаття
    </h1>

    {{ form_start(form, {'attr': {'enctype': 'multipart/form-data', 'id': 'articleForm', 'class': 'space-y-6'}}) }}

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Ліва колонка -->
        <div class="lg:col-span-2 space-y-6">
            <!-- Заголовок -->
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border p-6">
                {{ form_label(form.title, null, {'label_attr': {'class': 'block text-sm font-medium mb-2'}}) }}
                {{ form_widget(form.title, {'attr': {
                    'class': 'form-control',
                    'x-model': 'title',
                    '@input': 'generateSlug()',
                    'placeholder': 'Введіть заголовок статті...'
                }}) }}
                <div class="slug-preview mt-1" x-show="slug">
                    <span>🔗 /article/<span x-text="slug"></span></span>
                    <button type="button" @click="editSlug = !editSlug" class="ml-2 text-blue-600 hover:underline text-xs">редагувати</button>
                </div>
                <div x-show="editSlug" x-cloak class="mt-2">
                    {{ form_widget(form.slug, {'attr': {
                        'class': 'form-control text-sm font-mono',
                        'x-model': 'slug',
                        'placeholder': 'custom-slug'
                    }}) }}
                </div>
                {{ form_errors(form.title) }}
            </div>

            <!-- Короткий опис -->
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border p-6">
                {{ form_label(form.excerpt, null, {'label_attr': {'class': 'block text-sm font-medium mb-2'}}) }}
                {{ form_widget(form.excerpt, {'attr': {
                    'class': 'form-control',
                    'rows': 3,
                    'placeholder': 'Короткий опис для превью (необов\'язково)...'
                }}) }}
                <p class="text-xs text-gray-500 mt-1">✏️ Цей текст буде відображатися в картках статей</p>
                {{ form_errors(form.excerpt) }}
            </div>

            <!-- Контент з Quill -->
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border p-6">
                {{ form_label(form.content, null, {'label_attr': {'class': 'block text-sm font-medium mb-2'}}) }}
                <div id="editor" style="min-height: 400px; max-height: 600px;"></div>
                {{ form_widget(form.content, {'attr': {'class': 'hidden', 'id': 'user_article_content'}}) }}
                {{ form_errors(form.content) }}
                
                <div class="flex items-center gap-2 mt-2">
                    <button type="button" 
                            @click="openMediaLibrary()"
                            class="inline-flex items-center gap-2 px-3 py-1.5 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 text-xs rounded-lg hover:bg-gray-200 dark:hover:bg-gray-600 transition">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                        </svg>
                        📚 Медіа-бібліотека
                    </button>
                    <span class="text-xs text-gray-400">Вставте зображення в текст</span>
                </div>
                
                <div class="text-xs text-gray-500 mt-2 flex justify-between">
                    <span>📝 Використовуйте панель інструментів для форматування</span>
                    <span x-text="'📊 Символів: ' + contentLength"></span>
                </div>
            </div>
        </div>

        <!-- Права колонка -->
        <div class="space-y-6">
            <!-- Категорія -->
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border p-6">
                {{ form_label(form.category, null, {'label_attr': {'class': 'block text-sm font-medium mb-2'}}) }}
                {{ form_widget(form.category, {'attr': {
                    'class': 'form-select',
                    'x-model': 'category'
                }}) }}
                {{ form_errors(form.category) }}
            </div>

            <!-- Теги - повністю кастомний вибір -->
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border p-6">
                <label class="block text-sm font-medium mb-2">
                    🏷️ Теги
                    <span class="text-xs text-gray-500 font-normal" x-text="selectedTags.length ? '(' + selectedTags.length + ' вибрано)' : ''"></span>
                </label>
                
                <!-- Вибраний тег (відображення) -->
                <div class="selected-tags mb-3">
                    <template x-for="tag in selectedTags" :key="tag">
                        <span class="selected-tag">
                            <span x-text="tag"></span>
                            <span class="remove-tag" @click="removeTag(tag)">✕</span>
                        </span>
                    </template>
                </div>
                
                <!-- Пошук тегів -->
                <div class="relative">
                    <input type="text" 
                           class="tag-search-input"
                           placeholder="Пошук тегів..." 
                           x-model="tagSearch"
                           @input="searchTags()"
                           @focus="showSuggestions = true"
                           @keydown.enter.prevent="selectFirstSuggestion()"
                           @keydown.escape="showSuggestions = false">
                    
                    <!-- Підказки -->
                    <div class="tag-suggestions" :class="{'active': showSuggestions && filteredTags.length > 0}">
                        <template x-for="tag in filteredTags" :key="tag.id">
                            <div class="tag-suggestion-item" @click="toggleTag(tag.name)">
                                <span class="tag-color" :style="'background: ' + (tag.color || '#6b7280')"></span>
                                <span class="tag-name" x-text="tag.name"></span>
                                <span class="tag-count" x-text="tag.count + ' статей'"></span>
                                <span x-show="selectedTags.includes(tag.name)" class="text-blue-500 text-sm">✓</span>
                            </div>
                        </template>
                    </div>
                </div>
                
                <!-- Популярні теги -->
                <div class="mt-3">
                    <p class="text-xs text-gray-500 mb-2">Популярні теги:</p>
                    <div class="tags-container">
                        <template x-for="tag in popularTags" :key="tag.id">
                            <span class="tag-item" 
                                  :class="{'selected': selectedTags.includes(tag.name)}"
                                  :style="'background: ' + (selectedTags.includes(tag.name) ? tag.color + '20' : '#f3f4f6') + '; color: ' + (selectedTags.includes(tag.name) ? tag.color : '#6b7280')"
                                  @click="toggleTag(tag.name)">
                                <span class="tag-color" :style="'background: ' + (tag.color || '#6b7280')"></span>
                                <span x-text="tag.name"></span>
                                <span class="tag-remove" @click.stop="removeTag(tag.name)">✕</span>
                            </span>
                        </template>
                    </div>
                </div>
            </div>
<input type="hidden" name="tags" id="tags_field" value="">
            <!-- Зображення -->
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border p-6">
                <h3 class="text-lg font-semibold mb-4 flex items-center justify-between">
                    <span>🖼️ Обкладинка статті</span>
                    <button type="button" 
                            @click="openMediaLibrary()"
                            class="text-xs text-blue-600 dark:text-blue-400 hover:underline">
                        📚 З медіа-бібліотеки
                    </button>
                </h3>

                <!-- Завантаження через файл -->
                <div class="mb-3">
                    {{ form_label(form.coverImageFile, 'Завантажити обкладинку', {'label_attr': {'class': 'block text-sm font-medium mb-2'}}) }}
                    
                    <div class="flex items-center gap-4">
                        <div class="flex-1">
                            {{ form_widget(form.coverImageFile, {'attr': {
                                'class': 'block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 dark:file:bg-gray-700 dark:file:text-blue-400',
                                'accept': 'image/*',
                                '@change': 'handleCoverImage($event)'
                            }}) }}
                        </div>
                        <div x-show="coverImagePreview" class="flex-shrink-0">
                            <img :src="coverImagePreview" alt="Прев'ю обкладинки" class="w-16 h-16 object-cover rounded-lg border-2 border-blue-500">
                        </div>
                    </div>
                    {{ form_errors(form.coverImageFile) }}
                </div>

                <!-- Додавання через URL -->
                <div class="mb-3">
                    <label class="block text-sm font-medium mb-2">Або вставте URL зображення</label>
                    <div class="cover-url-input-group">
                        <input type="url" 
                               x-model="coverUrlInput"
                               placeholder="https://example.com/image.jpg"
                               @keydown.enter.prevent="addCoverFromUrl()">
                        <button type="button" @click="addCoverFromUrl()">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
                            </svg>
                            Додати
                        </button>
                    </div>
                    <p class="text-xs text-gray-500 mt-1" x-show="coverUrlError" x-text="coverUrlError"></p>
                </div>

                <input type="hidden" name="image_ids" id="image_ids" :value="imageIdsJson">

                <!-- Прогрес завантаження -->
                <div x-show="uploading" x-cloak class="mb-4">
                    <div class="flex justify-between text-sm mb-1">
                        <span x-text="uploadMessage"></span>
                        <span x-text="uploadProgress + '%'"></span>
                    </div>
                    <div class="progress-bar">
                        <div class="progress-fill" :style="'width: ' + uploadProgress + '%'"></div>
                    </div>
                </div>

                <!-- Drag & Drop зона -->
                <div class="upload-area"
                     @click="openFilePicker"
                     @dragover.prevent="dragOver = true"
                     @dragleave.prevent="dragOver = false"
                     @drop.prevent="handleDrop($event)"
                     :class="{'drag-over': dragOver}">
                    <i class="fas fa-cloud-upload-alt text-4xl text-gray-400 mb-2"></i>
                    <p class="text-gray-500">Перетягніть зображення або клікніть для завантаження</p>
                    <p class="text-xs text-gray-400 mt-1">JPG, PNG, GIF, WEBP (макс. 5MB)</p>
                    <input type="file" id="fileInput" class="hidden" accept="image/*" multiple @change="handleFileSelect($event)">
                </div>

                <!-- Галерея завантажених зображень -->
                <div x-show="uploadedImages.length > 0" x-cloak class="mt-4">
                    <h4 class="text-sm font-medium mb-2 flex items-center justify-between">
                        <span>📸 Завантажені зображення (<span x-text="uploadedImages.length"></span>)</span>
                        <button type="button" 
                                @click="openMediaLibrary()"
                                class="text-xs text-blue-600 dark:text-blue-400 hover:underline">
                            📚 Всі зображення
                        </button>
                    </h4>
                    <div class="grid grid-cols-3 gap-2">
                        <template x-for="(image, index) in uploadedImages" :key="image.id">
                            <div class="gallery-item">
                                <img :src="image.url" :alt="image.name" loading="lazy">
                                <div class="cover-badge" x-show="coverImage === image.url">
                                    ⭐ Обкладинка
                                </div>
                                <div class="gallery-overlay">
                                    <button type="button" 
                                            @click="setAsCover(image.url)" 
                                            class="bg-blue-500 hover:bg-blue-600 text-white" 
                                            title="Встановити обкладинку"
                                            x-show="coverImage !== image.url">
                                        ⭐
                                    </button>
                                    <button type="button" 
                                            @click="insertIntoEditor(image.url)" 
                                            class="bg-green-500 hover:bg-green-600 text-white" 
                                            title="Вставити в текст">
                                        📝
                                    </button>
                                    <button type="button" 
                                            @click="removeImage(index)" 
                                            class="bg-red-500 hover:bg-red-600 text-white" 
                                            title="Видалити">
                                        🗑️
                                    </button>
                                </div>
                            </div>
                        </template>
                    </div>
                </div>

                <!-- Прев'ю обкладинки -->
                <div x-show="coverImage" x-cloak class="mt-4 p-3 bg-blue-50 dark:bg-blue-900/20 rounded-lg animate-fade-in">
                    <p class="text-sm font-medium text-blue-700 dark:text-blue-300 mb-2">🖼️ Поточна обкладинка:</p>
                    <div class="relative inline-block">
                        <img :src="coverImage" class="w-32 h-20 object-cover rounded-lg border-2 border-blue-500" @error="handleImageError">
                        <button type="button" @click="clearCoverImage()" 
                                class="absolute -top-2 -right-2 bg-red-500 text-white rounded-full w-5 h-5 flex items-center justify-center text-xs hover:bg-red-600 transition">
                            ✕
                        </button>
                    </div>
                </div>
            </div>

            <!-- Кнопка відправки -->
            <div class="bg-gradient-to-r from-blue-50 to-purple-50 dark:from-blue-900/20 dark:to-purple-900/20 rounded-xl border p-6">
                <button type="submit" 
                        class="w-full bg-gradient-to-r from-blue-600 to-purple-600 text-white py-3 rounded-lg font-semibold hover:shadow-lg hover:scale-[1.02] transition-all duration-300">
                    <i class="fas fa-paper-plane mr-2"></i>
                    Відправити на модерацію
                </button>
                <p class="text-xs text-gray-500 text-center mt-3">
                    <i class="fas fa-info-circle mr-1"></i>
                    Після відправки стаття буде перевірена модератором
                </p>
            </div>
        </div>
    </div>

    {{ form_end(form) }}
</div>

<!-- ========================================== -->
<!-- МОДАЛЬНЕ ВІКНО МЕДІА-БІБЛІОТЕКИ -->
<!-- ========================================== -->

<div class="modal-overlay" 
     x-show="mediaLibraryOpen" 
     x-cloak
     @click.away="closeMediaLibrary()"
     @keydown.escape="closeMediaLibrary()">
    <div class="modal-content">
        <div class="modal-header">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
                📚 Медіа-бібліотека
            </h3>
            <button @click="closeMediaLibrary()" 
                    class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>
        <div class="modal-body">
            <!-- Пошук -->
            <div class="mb-4">
                <input type="text" 
                       x-model="mediaSearch"
                       @input="filterMedia()"
                       placeholder="Пошук зображень..." 
                       class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500/50 focus:border-transparent transition-all">
            </div>
            
            <!-- Список зображень -->
            <div class="media-library" id="mediaLibrary">
                <template x-for="image in filteredImages" :key="image.id">
                    <div class="media-item" 
                         :class="{'selected': selectedImageId === image.id}"
                         @click="selectMediaImage(image.id)"
                         @dblclick="insertMediaImage(image)">
                        <img :src="image.url" :alt="image.name" loading="lazy">
                        <div class="media-info">
                            <span x-text="image.name"></span>
                        </div>
                        <div class="absolute top-1 right-1" x-show="selectedImageId === image.id">
                            <span class="bg-blue-500 text-white text-xs px-1.5 py-0.5 rounded">✓</span>
                        </div>
                    </div>
                </template>
                <div class="media-empty" x-show="filteredImages.length === 0">
                    <svg class="w-12 h-12 mx-auto text-gray-400 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                    <p>Немає зображень</p>
                    <p class="text-xs text-gray-400">Завантажте зображення через форму вище</p>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button @click="closeMediaLibrary()" 
                    class="px-4 py-2 bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition">
                Закрити
            </button>
            <button @click="insertSelectedMedia()" 
                    :disabled="!selectedImageId"
                    class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition disabled:opacity-50 disabled:cursor-not-allowed">
                Вставити в текст
            </button>
            <button @click="setSelectedAsCover()" 
                    :disabled="!selectedImageId"
                    class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition disabled:opacity-50 disabled:cursor-not-allowed">
                ⭐ Встановити обкладинку
            </button>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
function registerQuillFonts() {
    if (typeof Quill !== 'undefined') {
        const Font = Quill.import('formats/font');
        if (Font) {
            Font.whitelist = ['aref', 'mirza', 'roboto'];
            Quill.register(Font, true);
        }
    }
}

function articleForm() {
    return {
        // ========================================
        // ОСНОВНІ ДАНІ
        // ========================================
        title: '',
        slug: '',
        coverImage: '',
        coverImagePreview: '',
        imageIds: [],
        imageIdsJson: '[]',
        category: '',
        editSlug: false,
        uploadedImages: [],
        dragOver: false,
        uploading: false,
        uploadProgress: 0,
        uploadMessage: '',
        quill: null,
        contentLength: 0,
        csrfToken: '{{ csrf_token('image_upload') }}',
        
        // ========================================
        // МЕДІА-БІБЛІОТЕКА
        // ========================================
        mediaLibraryOpen: false,
        mediaImages: [],
        filteredImages: [],
        mediaSearch: '',
        selectedImageId: null,
        
        // ========================================
        // ТЕГИ
        // ========================================
        selectedTags: [],
        tagSearch: '',
        filteredTags: [],
        showSuggestions: false,
        allTags: [],
        popularTags: [],
        
        // ========================================
        // URL ОБКЛАДИНКИ
        // ========================================
        coverUrlInput: '',
        coverUrlError: '',

        // ========================================
        // МЕТОДИ ДЛЯ РОБОТИ З SLUG
        // ========================================
        generateSlug() {
            if (!this.title.trim() || this.editSlug) return;
            
            const translit = {
                'а':'a','б':'b','в':'v','г':'h','ґ':'g','д':'d','е':'e','є':'ye',
                'ж':'zh','з':'z','и':'y','і':'i','ї':'yi','й':'y','к':'k','л':'l',
                'м':'m','н':'n','о':'o','п':'p','р':'r','с':'s','т':'t','у':'u',
                'ф':'f','х':'kh','ц':'ts','ч':'ch','ш':'sh','щ':'shch','ю':'yu','я':'ya'
            };
            
            let slug = this.title.toLowerCase()
                .split('')
                .map(char => translit[char] || char)
                .join('')
                .replace(/[^a-z0-9-]/g, '-')
                .replace(/-+/g, '-')
                .replace(/^-|-$/g, '')
                .substring(0, 100);
            
            this.slug = slug;
        },

        // ========================================
        // МЕТОДИ ДЛЯ РОБОТИ З QUILL
        // ========================================
        initQuill() {
            const editorElement = document.getElementById('editor');
            const hiddenField = document.getElementById('user_article_content');
            
            if (typeof Quill === 'undefined' || !editorElement || this.quill) return;
            
            registerQuillFonts();
            
            this.quill = new Quill(editorElement, {
                theme: 'snow',
                placeholder: 'Текст вашої статті...',
                modules: {
                    toolbar: [
                        ['bold', 'italic', 'underline', 'strike'],
                        ['blockquote', 'code-block'],
                        ['link', 'image'],
                        [{ 'header': [1, 2, 3, false] }],
                        [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                        ['clean']
                    ]
                }
            });
            
            // Встановлюємо початковий контент
            this.quill.root.innerHTML = hiddenField.value || '';
            this.contentLength = this.quill.root.innerText.length;
            
            // Оновлюємо при зміні
            this.quill.on('text-change', () => {
                hiddenField.value = this.quill.root.innerHTML;
                this.contentLength = this.quill.root.innerText.length;
            });
            
            // Обробник для вставки зображень
            const toolbar = this.quill.getModule('toolbar');
            if (toolbar) {
                toolbar.addHandler('image', () => {
                    const input = document.createElement('input');
                    input.setAttribute('type', 'file');
                    input.setAttribute('accept', 'image/*');
                    input.click();
                    
                    input.onchange = () => {
                        const file = input.files[0];
                        if (file) {
                            const reader = new FileReader();
                            reader.onload = (e) => {
                                const range = this.quill.getSelection();
                                this.quill.insertEmbed(range ? range.index : this.quill.getLength(), 'image', e.target.result);
                            };
                            reader.readAsDataURL(file);
                        }
                    };
                });
            }
        },

        // ========================================
        // МЕТОДИ ДЛЯ РОБОТИ З ТЕГАМИ
        // ========================================
        async loadTags() {
            try {
                const response = await fetch('/api/tags/list', {
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'application/json'
                    }
                });
                
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                
                const data = await response.json();
                
                if (data.success) {
                    this.allTags = data.tags || [];
                    this.popularTags = this.allTags.slice(0, 12);
                } else {
                    // Якщо API повернуло помилку, використовуємо тестові теги
                    this.setDefaultTags();
                }
            } catch (error) {
                console.error('Error loading tags:', error);
                this.setDefaultTags();
            }
        },
        
        setDefaultTags() {
            this.allTags = [
                { id: 1, name: 'Політика', color: '#3b82f6', count: 5 },
                { id: 2, name: 'Економіка', color: '#10b981', count: 3 },
                { id: 3, name: 'Технології', color: '#8b5cf6', count: 7 },
                { id: 4, name: 'Спорт', color: '#ef4444', count: 4 },
                { id: 5, name: 'Культура', color: '#f59e0b', count: 2 },
                { id: 6, name: 'Наука', color: '#06b6d4', count: 6 },
                { id: 7, name: 'Освіта', color: '#22c55e', count: 3 },
                { id: 8, name: 'Здоров\'я', color: '#ec4899', count: 4 }
            ];
            this.popularTags = this.allTags.slice(0, 12);
        },

        searchTags() {
            if (!this.tagSearch.trim()) {
                this.filteredTags = [];
                this.showSuggestions = false;
                return;
            }
            
            const search = this.tagSearch.toLowerCase();
            this.filteredTags = this.allTags.filter(tag => 
                tag.name.toLowerCase().includes(search) &&
                !this.selectedTags.includes(tag.name)
            ).slice(0, 10);
            
            this.showSuggestions = this.filteredTags.length > 0;
        },

        toggleTag(tagName) {
            const index = this.selectedTags.indexOf(tagName);
            if (index === -1) {
                if (this.selectedTags.length < 10) {
                    this.selectedTags.push(tagName);
                } else {
                    alert('Можна вибрати максимум 10 тегів');
                }
            } else {
                this.selectedTags.splice(index, 1);
            }
            this.tagSearch = '';
            this.filteredTags = [];
            this.showSuggestions = false;
        },

        removeTag(tagName) {
            const index = this.selectedTags.indexOf(tagName);
            if (index !== -1) {
                this.selectedTags.splice(index, 1);
            }
        },

        selectFirstSuggestion() {
            if (this.filteredTags.length > 0) {
                this.toggleTag(this.filteredTags[0].name);
            }
        },

        // ========================================
        // МЕТОДИ ДЛЯ РОБОТИ З ОБКЛАДИНКОЮ
        // ========================================
        handleCoverImage(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = (e) => {
                    this.coverImagePreview = e.target.result;
                    this.coverImage = e.target.result;
                };
                reader.readAsDataURL(file);
            } else {
                this.coverImagePreview = '';
            }
        },

        handleImageError() {
            if (this.coverImage && !this.coverImage.startsWith('/uploads/')) {
                this.coverUrlError = 'Не вдалося завантажити зображення за вказаним URL';
                this.clearCoverImage();
            }
        },

        addCoverFromUrl() {
            if (!this.coverUrlInput.trim()) {
                this.coverUrlError = 'Будь ласка, введіть URL зображення';
                return;
            }
            
            try {
                const url = new URL(this.coverUrlInput);
                if (!url.protocol.startsWith('http')) {
                    throw new Error('Невірний протокол');
                }
                
                const imageExtensions = ['.jpg', '.jpeg', '.png', '.gif', '.webp', '.svg'];
                const isImage = imageExtensions.some(ext => url.pathname.toLowerCase().endsWith(ext));
                
                if (!isImage) {
                    this.coverUrlError = 'URL має вказувати на зображення (jpg, png, gif, webp, svg)';
                    return;
                }
                
                this.coverUrlError = '';
                this.setAsCover(this.coverUrlInput);
                this.coverUrlInput = '';
            } catch (error) {
                this.coverUrlError = 'Невірний URL: ' + error.message;
            }
        },

        setAsCover(url) {
            this.coverImage = url;
            this.coverImagePreview = url;
        },

        clearCoverImage() {
            this.coverImage = '';
            this.coverImagePreview = '';
            this.coverUrlError = '';
        },

        useLastUploadedAsCover() {
            if (this.uploadedImages.length > 0) {
                this.coverImage = this.uploadedImages[this.uploadedImages.length - 1].url;
                this.coverImagePreview = this.coverImage;
            }
        },

        // ========================================
        // МЕТОДИ ДЛЯ РОБОТИ ІЗ ЗОБРАЖЕННЯМИ
        // ========================================
        openFilePicker() {
            document.getElementById('fileInput')?.click();
        },

        async handleFileSelect(event) {
            const files = Array.from(event.target.files);
            await this.uploadFiles(files);
            event.target.value = '';
        },

        async handleDrop(event) {
            event.preventDefault();
            this.dragOver = false;
            const files = Array.from(event.dataTransfer.files);
            await this.uploadFiles(files);
        },

        async uploadFiles(files) {
            for (const file of files) {
                if (!file.type.startsWith('image/')) {
                    alert('❌ Можна завантажувати тільки зображення');
                    continue;
                }
                if (file.size > 5 * 1024 * 1024) {
                    alert('❌ Файл занадто великий (макс. 5MB)');
                    continue;
                }
                
                const formData = new FormData();
                formData.append('image', file);
                formData.append('_token', this.csrfToken);
                
                this.uploading = true;
                this.uploadProgress = 0;
                this.uploadMessage = `⏳ Завантаження ${file.name}...`;
                
                try {
                    const response = await fetch('/api/images/upload', {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });
                    
                    // Симуляція прогресу
                    let progress = 0;
                    const interval = setInterval(() => {
                        progress += 10;
                        if (progress <= 90) {
                            this.uploadProgress = progress;
                        }
                    }, 100);
                    
                    const data = await response.json();
                    clearInterval(interval);
                    
                    if (data.success) {
                        this.imageIds.push(data.id);
                        this.imageIdsJson = JSON.stringify(this.imageIds);
                        
                        this.uploadedImages.push({
                            id: data.id,
                            url: data.url,
                            name: file.name,
                            path: data.path
                        });
                        
                        this.uploadProgress = 100;
                        this.uploadMessage = `✅ ${file.name} завантажено!`;
                        
                        // Якщо це перше зображення і немає обкладинки
                        if (this.uploadedImages.length === 1 && !this.coverImage) {
                            this.coverImage = data.url;
                            this.coverImagePreview = data.url;
                        }
                        
                        this.loadMediaImages();
                    } else {
                        this.uploadMessage = `❌ ${data.message || 'Помилка завантаження'}`;
                        alert(data.message || 'Помилка завантаження зображення');
                    }
                } catch (error) {
                    console.error('Upload error:', error);
                    this.uploadMessage = `❌ Помилка: ${error.message}`;
                    alert('Помилка завантаження зображення');
                }
                
                setTimeout(() => {
                    this.uploading = false;
                    this.uploadProgress = 0;
                }, 1500);
            }
        },

        removeImage(index) {
            const image = this.uploadedImages[index];
            if (image) {
                const idIndex = this.imageIds.indexOf(image.id);
                if (idIndex !== -1) {
                    this.imageIds.splice(idIndex, 1);
                    this.imageIdsJson = JSON.stringify(this.imageIds);
                }
                
                this.uploadedImages.splice(index, 1);
                
                if (this.coverImage === image.url) {
                    this.coverImage = '';
                    this.coverImagePreview = '';
                }
            }
        },

        insertIntoEditor(url) {
            if (this.quill) {
                const range = this.quill.getSelection() || { index: this.quill.getLength() };
                this.quill.insertEmbed(range.index, 'image', url);
                this.quill.setSelection(range.index + 1);
            }
        },

        // ========================================
        // МЕТОДИ ДЛЯ РОБОТИ З МЕДІА-БІБЛІОТЕКОЮ
        // ========================================
        async loadMediaImages() {
            try {
                const response = await fetch('/api/images/list', {
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'application/json'
                    }
                });
                
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                
                const data = await response.json();
                
                if (data.success) {
                    this.mediaImages = data.images || [];
                    this.filteredImages = this.mediaImages;
                }
            } catch (error) {
                console.error('Error loading media:', error);
                this.mediaImages = [];
                this.filteredImages = [];
            }
        },

        filterMedia() {
            if (!this.mediaSearch.trim()) {
                this.filteredImages = this.mediaImages;
                return;
            }
            const search = this.mediaSearch.toLowerCase();
            this.filteredImages = this.mediaImages.filter(img => 
                img.name?.toLowerCase().includes(search) ||
                img.alt?.toLowerCase().includes(search)
            );
        },

        openMediaLibrary() {
            this.mediaLibraryOpen = true;
            this.selectedImageId = null;
            this.loadMediaImages();
            document.body.style.overflow = 'hidden';
            
            const modal = document.querySelector('.modal-overlay');
            if (modal) {
                modal.classList.add('active');
            }
        },

        closeMediaLibrary() {
            this.mediaLibraryOpen = false;
            this.selectedImageId = null;
            this.mediaSearch = '';
            document.body.style.overflow = 'auto';
            
            const modal = document.querySelector('.modal-overlay');
            if (modal) {
                modal.classList.remove('active');
            }
        },

        selectMediaImage(id) {
            this.selectedImageId = this.selectedImageId === id ? null : id;
        },

        insertMediaImage(image) {
            if (this.quill) {
                this.insertIntoEditor(image.url);
                this.closeMediaLibrary();
            }
        },

        insertSelectedMedia() {
            if (this.selectedImageId) {
                const image = this.mediaImages.find(img => img.id === this.selectedImageId);
                if (image) {
                    this.insertMediaImage(image);
                }
            }
        },

        setSelectedAsCover() {
            if (this.selectedImageId) {
                const image = this.mediaImages.find(img => img.id === this.selectedImageId);
                if (image) {
                    this.setAsCover(image.url);
                    this.closeMediaLibrary();
                }
            }
        },

        // ========================================
        // ІНІЦІАЛІЗАЦІЯ
        // ========================================
        init() {
            console.log('🚀 Ініціалізація форми...');
            
            // 1. Ініціалізація Quill
            setTimeout(() => {
                this.initQuill();
                console.log('✅ Quill ініціалізовано');
            }, 100);
            
            // 2. Завантаження тегів
            setTimeout(() => {
                this.loadTags();
                console.log('✅ Теги завантажено');
            }, 200);
            
            // 3. Завантаження медіа-бібліотеки
            setTimeout(() => {
                this.loadMediaImages();
                console.log('✅ Медіа-бібліотеку завантажено');
            }, 500);
            
            // 4. Відстежуємо категорію
            const categoryField = document.getElementById('user_article_category');
            if (categoryField) {
                this.category = categoryField.value || '';
                categoryField.addEventListener('change', (e) => {
                    this.category = e.target.value;
                    console.log('📂 Змінено категорію:', this.category);
                });
            } else {
                console.warn('⚠️ Поле категорії не знайдено');
            }
            
            // 5. Завантажуємо існуючі теги з форми
            const tagsField = document.querySelector('select[name="tags"]');
            if (tagsField) {
                const selectedOptions = tagsField.querySelectorAll('option:checked');
                if (selectedOptions.length > 0) {
                    this.selectedTags = Array.from(selectedOptions).map(opt => opt.value);
                    console.log('📌 Завантажено вибрані теги:', this.selectedTags);
                } else if (tagsField.value) {
                    this.selectedTags = tagsField.value.split(',').filter(Boolean);
                    console.log('📌 Завантажено теги з value:', this.selectedTags);
                }
            } else {
                console.warn('⚠️ Поле тегів не знайдено');
            }
            
            // 6. Відстежуємо зміни вибраних тегів
            this.$watch('selectedTags', (value) => {
                // Оновлюємо приховане поле
                const hiddenTagsField = document.querySelector('input[name="tags"]');
                if (hiddenTagsField) {
                    hiddenTagsField.value = value.join(',');
                }
                
                // Оновлюємо стандартне поле
                const selectField = document.querySelector('select[name="tags"]');
                if (selectField) {
                    selectField.querySelectorAll('option').forEach(opt => opt.selected = false);
                    selectField.querySelectorAll('option').forEach(opt => {
                        if (value.includes(opt.value)) {
                            opt.selected = true;
                        }
                    });
                }
                
                console.log('🏷️ Оновлено теги:', value);
            });
            
            // 7. Відстежуємо зміни обкладинки
            this.$watch('coverImage', (value) => {
                if (!value) {
                    this.coverImagePreview = '';
                }
                console.log('🖼️ Оновлено обкладинку:', value ? 'є' : 'немає');
            });
            
            console.log('✅ Форму ініціалізовано успішно!');
        }
    };
}

// ============================================
// РЕЄСТРАЦІЯ ПРИ ЗАВАНТАЖЕННІ СТОРІНКИ
// ============================================
document.addEventListener('DOMContentLoaded', function() {
    registerQuillFonts();
    
    // Ініціалізація Drag & Drop
    document.addEventListener('dragover', function(e) {
        e.preventDefault();
    });
    
    document.addEventListener('drop', function(e) {
        e.preventDefault();
    });
});

console.log('✅ Article form script loaded successfully!');
</script>
{% endblock %}