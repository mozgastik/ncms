{% extends 'base.html.twig' %}

{% block title %}Мої опубліковані блоги{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 py-8">
    <div class="container mx-auto px-4 max-w-7xl">
        <!-- Хлібні крихти -->
        <nav class="flex mb-6" aria-label="Breadcrumb">
            <ol class="inline-flex items-center space-x-1 md:space-x-3">
                <li class="inline-flex items-center">
                    <a href="{{ path('user_blog_index') }}" class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-blue-600">
                        <i class="fas fa-home mr-2"></i>
                        Мої блоги
                    </a>
                </li>
                <li aria-current="page">
                    <div class="flex items-center">
                        <i class="fas fa-chevron-right text-gray-400 mx-2"></i>
                        <span class="ml-1 text-sm font-medium text-gray-500 md:ml-2">Опубліковані</span>
                    </div>
                </li>
            </ol>
        </nav>

        <!-- Заголовок та кнопка -->
        <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-6 mb-8">
            <div>
                <h1 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-2">
                    Мої опубліковані блоги
                </h1>
                <p class="text-lg text-gray-600">
                    Блоги, які вже доступні для читання всім користувачам
                </p>
            </div>
            <a href="{{ path('user_blog_new') }}" 
               class="inline-flex items-center px-6 py-3 bg-blue-600 text-white font-medium rounded-xl hover:bg-blue-700 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 shadow-lg hover:shadow-xl">
                <i class="fas fa-plus text-lg mr-3"></i>
                <span class="text-lg">Новий блог</span>
            </a>
        </div>

        {% if published|length > 0 %}
            <!-- Фільтри та пошук -->
            <div class="bg-white rounded-2xl shadow-lg p-6 mb-8">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    <!-- Пошук -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">
                            <i class="fas fa-search mr-2"></i>Пошук серед опублікованих блогів
                        </label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <i class="fas fa-search text-gray-400"></i>
                            </div>
                            <input type="text" 
                                   class="block w-full pl-10 pr-3 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all"
                                   placeholder="Введіть заголовок або ключові слова..."
                                   id="searchInput">
                        </div>
                    </div>
                    
                    <!-- Сортування -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">
                            <i class="fas fa-sort mr-2"></i>Сортування
                        </label>
                        <div class="flex gap-3">
                            <select class="block w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all appearance-none bg-white"
                                    id="sortSelect">
                                <option value="newest">Спочатку нові</option>
                                <option value="oldest">Спочатку старі</option>
                                <option value="popular">За популярністю</option>
                                <option value="views">За переглядами</option>
                            </select>
                            <button class="px-6 py-3 border border-gray-300 text-gray-700 font-medium rounded-xl hover:bg-gray-50 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-gray-500"
                                    id="filterBtn">
                                <i class="fas fa-filter mr-2"></i>Фільтр
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Статистика -->
            {% set totalViews = 0 %}
            {% set totalLikes = 0 %}
            {% set totalComments = 0 %}
            {% set totalShares = 0 %}
            
            {% for post in published %}
                {% set totalViews = totalViews + post.viewCount %}
                {% set totalLikes = totalLikes + post.getLikeCount() %}
                {% set totalComments = totalComments + post.comments|length %}
                {% set totalShares = totalShares + post.shares|length %}
            {% endfor %}
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
                <!-- Опубліковано -->
                <div class="bg-gradient-to-br from-blue-50 to-blue-100 border border-blue-200 rounded-2xl p-6">
                    <div class="flex items-center justify-between">
                        <div>
                            <div class="text-3xl font-bold text-blue-600 mb-1">{{ published|length }}</div>
                            <div class="text-sm font-medium text-blue-700">Опубліковано</div>
                        </div>
                        <div class="w-12 h-12 flex items-center justify-center rounded-full bg-blue-500">
                            <i class="fas fa-check text-white text-xl"></i>
                        </div>
                    </div>
                    <div class="mt-4 pt-4 border-t border-blue-200">
                        <p class="text-xs text-blue-600">Всі ваші доступні блоги</p>
                    </div>
                </div>

                <!-- Перегляди -->
                <div class="bg-gradient-to-br from-green-50 to-green-100 border border-green-200 rounded-2xl p-6">
                    <div class="flex items-center justify-between">
                        <div>
                            <div class="text-3xl font-bold text-green-600 mb-1">{{ totalViews }}</div>
                            <div class="text-sm font-medium text-green-700">Всього переглядів</div>
                        </div>
                        <div class="w-12 h-12 flex items-center justify-center rounded-full bg-green-500">
                            <i class="fas fa-eye text-white text-xl"></i>
                        </div>
                    </div>
                    <div class="mt-4 pt-4 border-t border-green-200">
                        <p class="text-xs text-green-600">Загальна кількість переглядів</p>
                    </div>
                </div>

                <!-- Лайки -->
                <div class="bg-gradient-to-br from-purple-50 to-purple-100 border border-purple-200 rounded-2xl p-6">
                    <div class="flex items-center justify-between">
                        <div>
                            <div class="text-3xl font-bold text-purple-600 mb-1">{{ totalLikes }}</div>
                            <div class="text-sm font-medium text-purple-700">Всього лайків</div>
                        </div>
                        <div class="w-12 h-12 flex items-center justify-center rounded-full bg-purple-500">
                            <i class="fas fa-heart text-white text-xl"></i>
                        </div>
                    </div>
                    <div class="mt-4 pt-4 border-t border-purple-200">
                        <p class="text-xs text-purple-600">Загальна кількість лайків</p>
                    </div>
                </div>

                <!-- Коментарі -->
                <div class="bg-gradient-to-br from-amber-50 to-amber-100 border border-amber-200 rounded-2xl p-6">
                    <div class="flex items-center justify-between">
                        <div>
                            <div class="text-3xl font-bold text-amber-600 mb-1">{{ totalComments }}</div>
                            <div class="text-sm font-medium text-amber-700">Всього коментарів</div>
                        </div>
                        <div class="w-12 h-12 flex items-center justify-center rounded-full bg-amber-500">
                            <i class="fas fa-comment text-white text-xl"></i>
                        </div>
                    </div>
                    <div class="mt-4 pt-4 border-t border-amber-200">
                        <p class="text-xs text-amber-600">Загальна кількість коментарів</p>
                    </div>
                </div>
            </div>

            <!-- Список блогів -->
            <div id="blogsContainer" class="space-y-6">
                {% for post in published %}
                    <div class="blog-item bg-white rounded-2xl shadow-lg overflow-hidden transition-all duration-300 hover:shadow-xl"
                         data-title="{{ post.title|lower }}"
                         data-views="{{ post.viewCount }}"
                         data-likes="{{ post.getLikeCount() }}"
                         data-date="{{ post.publishedAt|date('Y-m-d') }}">
                        <div class="md:flex">
                            <!-- Зображення -->
                            <div class="md:w-2/5 lg:w-1/3 relative">
                                {% if post.images|length > 0 %}
                                    <img src="{{ asset('uploads/blogs/' ~ post.images.first.filename) }}" 
                                         class="w-full h-64 md:h-full object-cover"
                                         alt="{{ post.images.first.altText|default(post.title) }}"
                                         loading="lazy">
                                {% else %}
                                    <div class="w-full h-64 md:h-full bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center">
                                        <i class="fas fa-blog text-5xl text-gray-400"></i>
                                    </div>
                                {% endif %}
                                
                                <!-- Бейджи -->
                                <div class="absolute top-4 left-4 flex flex-col gap-2">
                                    {% if post.category %}
                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-blue-500 text-white shadow-lg">
                                            <i class="fas fa-tag mr-1"></i>
                                            {{ post.category.name }}
                                        </span>
                                    {% endif %}
                                    {% if post.isBreaking %}
                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-red-500 text-white shadow-lg">
                                            <i class="fas fa-bolt mr-1"></i>
                                            Новина!
                                        </span>
                                    {% endif %}
                                </div>
                                
                                <!-- Статус -->
                                <div class="absolute top-4 right-4">
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-500 text-white shadow-lg">
                                        <i class="fas fa-check-circle mr-1"></i>
                                        Опубліковано
                                    </span>
                                </div>
                            </div>
                            
                            <!-- Контент -->
                            <div class="md:w-3/5 lg:w-2/3 p-6 md:p-8">
                                <div class="flex flex-col h-full">
                                    <!-- Заголовок та опис -->
                                    <div class="mb-4">
                                        <h3 class="text-xl lg:text-2xl font-bold text-gray-900 mb-3 line-clamp-2">
                                            <a href="{{ path('blog_show', {'slug': post.slug}) }}" 
                                               target="_blank"
                                               class="hover:text-blue-600 transition-colors duration-200">
                                                {{ post.title }}
                                                <i class="fas fa-external-link-alt ml-2 text-sm text-gray-400"></i>
                                            </a>
                                        </h3>
                                        
                                        {% if post.excerpt %}
                                            <p class="text-gray-600 line-clamp-3">
                                                {{ post.excerpt }}
                                            </p>
                                        {% endif %}
                                    </div>
                                    
                                    <!-- Статистика -->
                                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
                                        <div class="text-center p-3 bg-blue-50 rounded-xl">
                                            <div class="text-2xl font-bold text-blue-600 mb-1">{{ post.viewCount }}</div>
                                            <div class="text-xs font-medium text-blue-700">
                                                <i class="fas fa-eye mr-1"></i>Переглядів
                                            </div>
                                        </div>
                                        <div class="text-center p-3 bg-purple-50 rounded-xl">
                                            <div class="text-2xl font-bold text-purple-600 mb-1">{{ post.getLikeCount() }}</div>
                                            <div class="text-xs font-medium text-purple-700">
                                                <i class="fas fa-heart mr-1"></i>Лайків
                                            </div>
                                        </div>
                                        <div class="text-center p-3 bg-amber-50 rounded-xl">
                                            <div class="text-2xl font-bold text-amber-600 mb-1">{{ post.comments|length }}</div>
                                            <div class="text-xs font-medium text-amber-700">
                                                <i class="fas fa-comment mr-1"></i>Коментарів
                                            </div>
                                        </div>
                                        <div class="text-center p-3 bg-green-50 rounded-xl">
                                            <div class="text-2xl font-bold text-green-600 mb-1">{{ post.shares|length }}</div>
                                            <div class="text-xs font-medium text-green-700">
                                                <i class="fas fa-share-alt mr-1"></i>Поділень
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <!-- Мета та кнопки -->
                                    <div class="mt-auto">
                                        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                                            <!-- Мета інформація -->
                                            <div class="flex flex-wrap items-center gap-4 text-sm text-gray-500">
                                                <div class="flex items-center">
                                                    <i class="far fa-calendar mr-2 text-gray-400"></i>
                                                    <span>{{ post.publishedAt|date('d.m.Y H:i') }}</span>
                                                </div>
                                                <div class="flex items-center">
                                                    <i class="far fa-clock mr-2 text-gray-400"></i>
                                                    <span>{{ post.readingTime }} хв читання</span>
                                                </div>
                                            </div>
                                            
                                            <!-- Кнопки дій -->
                                            <div class="flex flex-wrap gap-2">
                                                <a href="{{ path('blog_show', {'slug': post.slug}) }}" 
                                                   target="_blank"
                                                   class="inline-flex items-center px-4 py-2 bg-green-600 text-white font-medium rounded-lg hover:bg-green-700 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-green-500">
                                                    <i class="fas fa-external-link-alt mr-2"></i>
                                                    <span class="hidden sm:inline">На сайті</span>
                                                </a>
                                                <a href="{{ path('user_blog_edit', {'id': post.id}) }}"
                                                   class="inline-flex items-center px-4 py-2 border border-blue-300 text-blue-700 font-medium rounded-lg hover:bg-blue-50 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500">
                                                    <i class="fas fa-edit mr-2"></i>
                                                    <span class="hidden sm:inline">Редагувати</span>
                                                </a>
                                                <a href="{{ path('user_blog_show', {'id': post.id}) }}"
                                                   class="inline-flex items-center px-4 py-2 border border-gray-300 text-gray-700 font-medium rounded-lg hover:bg-gray-50 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-gray-500">
                                                    <i class="fas fa-chart-bar mr-2"></i>
                                                    <span class="hidden sm:inline">Статистика</span>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
            
            <!-- Кнопка "Завантажити ще" -->
            {% if published|length > 10 %}
                <div class="text-center mt-8">
                    <button id="loadMoreBtn" 
                            class="inline-flex items-center px-8 py-3 bg-blue-600 text-white font-medium rounded-xl hover:bg-blue-700 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 shadow-lg hover:shadow-xl">
                        <i class="fas fa-arrow-down text-lg mr-3"></i>
                        Завантажити ще
                    </button>
                </div>
            {% endif %}
        {% else %}
            <!-- Пустий стан -->
            <div class="bg-white rounded-2xl shadow-lg p-12 text-center">
                <div class="max-w-md mx-auto">
                    <div class="inline-flex items-center justify-center w-24 h-24 rounded-full bg-blue-100 mb-6">
                        <i class="fas fa-newspaper text-4xl text-blue-600"></i>
                    </div>
                    <h3 class="text-2xl font-bold text-gray-900 mb-3">
                        Ще немає опублікованих блогів
                    </h3>
                    <p class="text-gray-600 mb-8">
                        Створіть свій перший блог та відправте його на модерацію. Після схвалення він з'явиться тут.
                    </p>
                    <div class="flex flex-col sm:flex-row justify-center gap-4">
                        <a href="{{ path('user_blog_new') }}" 
                           class="inline-flex items-center px-6 py-3 bg-blue-600 text-white font-medium rounded-xl hover:bg-blue-700 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                            <i class="fas fa-plus text-lg mr-3"></i>
                            Створити блог
                        </a>
                        <a href="{{ path('user_blog_pending') }}" 
                           class="inline-flex items-center px-6 py-3 border border-gray-300 text-gray-700 font-medium rounded-xl hover:bg-gray-50 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2">
                            <i class="fas fa-hourglass-half text-lg mr-3"></i>
                            На модерації
                        </a>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('searchInput');
    const sortSelect = document.getElementById('sortSelect');
    const filterBtn = document.getElementById('filterBtn');
    const blogItems = document.querySelectorAll('.blog-item');
    const blogsContainer = document.getElementById('blogsContainer');
    const loadMoreBtn = document.getElementById('loadMoreBtn');
    
    // Пошук
    if (searchInput) {
        searchInput.addEventListener('input', function() {
            const searchTerm = this.value.toLowerCase().trim();
            
            blogItems.forEach(item => {
                const title = item.getAttribute('data-title');
                const display = title.includes(searchTerm) || searchTerm === '' ? 'block' : 'none';
                item.style.display = display;
            });
        });
    }
    
    // Сортування
    if (sortSelect) {
        sortSelect.addEventListener('change', function() {
            const items = Array.from(blogItems).filter(item => item.style.display !== 'none');
            
            items.sort((a, b) => {
                switch(this.value) {
                    case 'newest':
                        return new Date(b.getAttribute('data-date')) - new Date(a.getAttribute('data-date'));
                    case 'oldest':
                        return new Date(a.getAttribute('data-date')) - new Date(b.getAttribute('data-date'));
                    case 'popular':
                        const likesA = parseInt(a.getAttribute('data-likes')) || 0;
                        const likesB = parseInt(b.getAttribute('data-likes')) || 0;
                        return likesB - likesA;
                    case 'views':
                        const viewsA = parseInt(a.getAttribute('data-views')) || 0;
                        const viewsB = parseInt(b.getAttribute('data-views')) || 0;
                        return viewsB - viewsA;
                    default:
                        return 0;
                }
            });
            
            // Переміщаємо відсортовані елементи
            items.forEach(item => {
                blogsContainer.appendChild(item);
            });
        });
    }
    
    // Фільтр (приклад розширеного функціоналу)
    if (filterBtn) {
        filterBtn.addEventListener('click', function() {
            // Тут може бути логіка відкриття модального вікна з додатковими фільтрами
            alert('Додаткові фільтри будуть доступні в наступних версіях');
        });
    }
    
    // Завантаження ще
    if (loadMoreBtn && blogItems.length > 0) {
        let visibleItems = 5;
        
        // Спочатку показуємо тільки перші 5 елементів
        blogItems.forEach((item, index) => {
            if (index >= visibleItems) {
                item.style.display = 'none';
            }
        });
        
        // Показуємо/приховуємо кнопку в залежності від кількості елементів
        if (blogItems.length <= visibleItems) {
            loadMoreBtn.style.display = 'none';
        }
        
        loadMoreBtn.addEventListener('click', function() {
            visibleItems += 5;
            
            blogItems.forEach((item, index) => {
                if (index < visibleItems) {
                    item.style.display = 'block';
                }
            });
            
            // Плавна прокрутка до останнього показаного елемента
            const lastVisibleItem = blogItems[Math.min(visibleItems, blogItems.length) - 1];
            if (lastVisibleItem) {
                lastVisibleItem.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
            
            // Приховуємо кнопку, якщо показано всі елементи
            if (visibleItems >= blogItems.length) {
                this.style.opacity = '0';
                this.style.transform = 'scale(0.95)';
                setTimeout(() => {
                    this.style.display = 'none';
                }, 300);
            }
        });
    }
    
    // Анімації при завантаженні
    const observerOptions = {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
    };
    
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.style.opacity = '1';
                entry.target.style.transform = 'translateY(0)';
            }
        });
    }, observerOptions);
    
    // Застосовуємо анімації до всіх елементів блогів
    blogItems.forEach((item, index) => {
        item.style.opacity = '0';
        item.style.transform = 'translateY(20px)';
        item.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
        
        setTimeout(() => {
            item.style.opacity = '1';
            item.style.transform = 'translateY(0)';
            observer.observe(item);
        }, index * 100);
    });
});
</script>

<style>
.line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

@media (min-width: 768px) {
    .md\:h-full {
        height: 100%;
        min-height: 300px;
    }
}
</style>
{% endblock %}