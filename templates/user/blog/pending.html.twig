{% extends 'base.html.twig' %}

{% block title %}Блоги на модерації{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 py-8">
    <div class="container mx-auto px-4 max-w-7xl">
        <!-- Хлібні крихти -->
        <nav class="flex mb-6" aria-label="Breadcrumb">
            <ol class="inline-flex items-center space-x-1 md:space-x-3">
                <li class="inline-flex items-center">
                    <a href="{{ path('user_blog_index') }}" class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-blue-600">
                        <i class="fas fa-home mr-2"></i>
                        Мої блоги
                    </a>
                </li>
                <li aria-current="page">
                    <div class="flex items-center">
                        <i class="fas fa-chevron-right text-gray-400 mx-2"></i>
                        <span class="ml-1 text-sm font-medium text-gray-500 md:ml-2">На модерації</span>
                    </div>
                </li>
            </ol>
        </nav>

    <!-- Header -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 mb-8">
        <div class="flex-1">
            <h1 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-3">
                Блоги на модерації
            </h1>
            <p class="text-lg text-gray-600 max-w-3xl">
                Блоги, які очікують на перевірку модератором перед публікацією
            </p>
        </div>
        <div class="shrink-0">
            <a href="{{ path('user_blog_new') }}" 
               class="inline-flex items-center gap-2 bg-primary hover:bg-primary/90 text-white font-medium py-3 px-6 rounded-lg transition-all duration-200 hover:shadow-lg">
                <i class="fas fa-plus"></i>
                Новий блог
            </a>
        </div>
    </div>

    {% if pending|length > 0 %}
        <!-- Table -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden mb-8">
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-gray-50 border-b border-gray-200">
                        <tr>
                            <th class="py-4 px-6 text-left text-sm font-semibold text-gray-700 whitespace-nowrap">
                                Заголовок
                            </th>
                            <th class="py-4 px-6 text-left text-sm font-semibold text-gray-700 whitespace-nowrap">
                                Категорія
                            </th>
                            <th class="py-4 px-6 text-left text-sm font-semibold text-gray-700 whitespace-nowrap">
                                Відправлено
                            </th>
                            <th class="py-4 px-6 text-left text-sm font-semibold text-gray-700 whitespace-nowrap">
                                Статус
                            </th>
                            <th class="py-4 px-6 text-left text-sm font-semibold text-gray-700 whitespace-nowrap">
                                Дії
                            </th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        {% for post in pending %}
                            <tr class="hover:bg-gray-50/80 transition-colors duration-150">
                                <!-- Title Column -->
                                <td class="py-4 px-6">
                                    <div class="flex items-start gap-4">
                                        {% if post.images|length > 0 %}
                                            <div class="shrink-0">
                                                <img src="{{ asset('uploads/blogs/' ~ post.images.first.filename) }}" 
                                                     class="w-12 h-12 rounded-lg object-cover"
                                                     alt="">
                                            </div>
                                        {% endif %}
                                        <div class="min-w-0">
                                            <h4 class="font-semibold text-gray-900 truncate">
                                                {{ post.title|slice(0, 60) }}{% if post.title|length > 60 %}...{% endif %}
                                            </h4>
                                            <div class="flex items-center gap-3 mt-1 text-sm text-gray-500">
                                                <span>{{ post.readingTime }} хв читання</span>
                                                <span class="w-1 h-1 bg-gray-300 rounded-full"></span>
                                                <span>{{ post.content|length }} символів</span>
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Category Column -->
                                <td class="py-4 px-6">
                                    {% if post.category %}
                                        <span class="inline-block bg-gray-100 hover:bg-gray-200 text-gray-800 text-sm font-medium py-1.5 px-3 rounded-lg transition-colors duration-200">
                                            {{ post.category.name }}
                                        </span>
                                    {% else %}
                                        <span class="text-gray-400">—</span>
                                    {% endif %}
                                </td>

                                <!-- Date Column -->
                                <td class="py-4 px-6">
                                    <div class="text-sm">
                                        <div class="font-medium text-gray-900">
                                            {{ post.updatedAt|date('d.m.Y') }}
                                        </div>
                                        <div class="text-gray-500">
                                            {{ post.updatedAt|date('H:i') }}
                                        </div>
                                    </div>
                                </td>

                                <!-- Status Column -->
                                <td class="py-4 px-6">
                                    <div class="flex items-center gap-3">
                                        <span class="inline-flex items-center gap-1.5 bg-amber-50 hover:bg-amber-100 text-amber-700 text-sm font-medium py-1.5 px-3 rounded-lg transition-colors duration-200">
                                            <i class="fas fa-hourglass-half text-xs"></i>
                                            На модерації
                                        </span>
                                        <div class="w-24 h-1.5 bg-gray-200 rounded-full overflow-hidden">
                                            <div class="h-full w-3/4 bg-amber-500 rounded-full animate-pulse"></div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Actions Column -->
                                <td class="py-4 px-6">
                                    <div class="flex items-center gap-2">
                                        <button onclick="window.location.href='{{ path('user_blog_edit', {'id': post.id}) }}'"
                                                class="inline-flex items-center justify-center w-9 h-9 rounded-lg border border-gray-300 hover:bg-gray-50 text-gray-700 hover:text-gray-900 transition-colors duration-200"
                                                title="Редагувати">
                                            <i class="fas fa-edit text-sm"></i>
                                        </button>
                                        <button onclick="window.location.href='{{ path('user_blog_show', {'id': post.id}) }}'"
                                                class="inline-flex items-center justify-center w-9 h-9 rounded-lg border border-gray-300 hover:bg-gray-50 text-blue-600 hover:text-blue-700 transition-colors duration-200"
                                                title="Переглянути">
                                            <i class="fas fa-eye text-sm"></i>
                                        </button>
                                        <button onclick="changeToDraft({{ post.id }})"
                                                class="inline-flex items-center justify-center w-9 h-9 rounded-lg border border-gray-300 hover:bg-gray-50 text-green-600 hover:text-green-700 transition-colors duration-200"
                                                title="Повернути в чернетки">
                                            <i class="fas fa-undo text-sm"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Info Card -->
        <div class="bg-blue-50 border border-blue-100 rounded-2xl p-6 mb-8">
            <div class="flex flex-col md:flex-row gap-6">
                <div class="shrink-0">
                    <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center">
                        <i class="fas fa-info-circle text-2xl text-blue-600"></i>
                    </div>
                </div>
                <div class="flex-1">
                    <h3 class="text-xl font-semibold text-gray-900 mb-3">
                        Як працює модерація?
                    </h3>
                    <p class="text-gray-700 mb-4">
                        Наші модератори перевіряють кожен блог перед публікацією. 
                        <strong>Середній час перевірки: 24-48 годин.</strong>
                    </p>
                    <div class="mt-4">
                        <h4 class="font-medium text-gray-900 mb-2">Що перевіряється:</h4>
                        <ul class="grid grid-cols-1 md:grid-cols-2 gap-2 text-gray-700">
                            <li class="flex items-start gap-2">
                                <i class="fas fa-check text-green-500 mt-1 text-sm"></i>
                                <span>Відповідність правилам спільноти</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <i class="fas fa-check text-green-500 mt-1 text-sm"></i>
                                <span>Якість контенту</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <i class="fas fa-check text-green-500 mt-1 text-sm"></i>
                                <span>Відсутність порушень авторських прав</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <i class="fas fa-check text-green-500 mt-1 text-sm"></i>
                                <span>Наявність образливого контенту</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <!-- Empty State -->
        <div class="text-center py-16 px-4">
            <div class="inline-flex items-center justify-center w-24 h-24 bg-gray-100 rounded-full mb-6">
                <i class="fas fa-hourglass-half text-4xl text-gray-400"></i>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-3">
                Немає блогів на модерації
            </h3>
            <p class="text-gray-600 max-w-md mx-auto mb-8">
                Всі ваші блоги вже перевірені або ще не відправлені на модерацію
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a href="{{ path('user_blog_new') }}" 
                   class="inline-flex items-center justify-center gap-2 bg-primary hover:bg-primary/90 text-white font-medium py-3 px-6 rounded-lg transition-all duration-200 hover:shadow-lg">
                    <i class="fas fa-plus"></i>
                    Створити блог
                </a>
                <a href="{{ path('user_blog_drafts') }}" 
                   class="inline-flex items-center justify-center gap-2 border border-gray-300 hover:bg-gray-50 text-gray-700 hover:text-gray-900 font-medium py-3 px-6 rounded-lg transition-all duration-200">
                    <i class="fas fa-file-alt"></i>
                    Мої чернетки
                </a>
            </div>
        </div>
    {% endif %}
</div>

<script>
function changeToDraft(postId) {
    if (confirm('Повернути цей блог в чернетки? Ви зможете відредагувати його та відправити на модерацію знову.')) {
        fetch(`/user/blog/${postId}/status/draft`, {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: `_token={{ csrf_token('status') }}`
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                alert('Помилка: ' + data.error);
            }
        })
        .catch(error => {
            alert('Помилка мережі');
        });
    }
}
</script>

<style>
/* Custom animations */
@keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
}

.animate-pulse {
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

/* Hover effects */
.hover\:shadow-lg:hover {
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
}

/* Custom colors - adjust primary color as needed */
.bg-primary {
    background-color: #3b82f6; /* blue-500 */
}

.bg-primary\/90 {
    background-color: rgba(59, 130, 246, 0.9);
}

.text-primary {
    color: #3b82f6;
}
</style>
{% endblock %}