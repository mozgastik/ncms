{% extends 'base.html.twig' %}

{% block title %}Мої чернетки{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 py-8">
    <div class="container mx-auto px-4 max-w-7xl">
        <!-- Хлібні крихти -->
        <nav class="flex mb-6" aria-label="Breadcrumb">
            <ol class="inline-flex items-center space-x-1 md:space-x-3">
                <li class="inline-flex items-center">
                    <a href="{{ path('user_blog_index') }}" class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-blue-600">
                        <i class="fas fa-home mr-2"></i>
                        Мої блоги
                    </a>
                </li>
                <li aria-current="page">
                    <div class="flex items-center">
                        <i class="fas fa-chevron-right text-gray-400 mx-2"></i>
                        <span class="ml-1 text-sm font-medium text-gray-500 md:ml-2">Чернетки</span>
                    </div>
                </li>
            </ol>
        </nav>

    <!-- Header -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 mb-8">
        <div class="flex-1">
            <h1 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-3">
                Мої чернетки
            </h1>
            <p class="text-lg text-gray-600 max-w-3xl">
                Незавершені блоги, які ви можете відредагувати та відправити на модерацію
            </p>
        </div>
        <div class="shrink-0">
            <a href="{{ path('user_blog_new') }}" 
               class="inline-flex items-center gap-2 bg-primary hover:bg-primary/90 text-white font-medium py-3 px-6 rounded-lg transition-all duration-200 hover:shadow-lg">
                <i class="fas fa-plus"></i>
                Новий блог
            </a>
        </div>
    </div>

    {% if drafts|length > 0 %}
        <!-- Drafts Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
            {% for draft in drafts %}
                <!-- Draft Card -->
                <div class="group bg-white rounded-xl shadow-sm border border-gray-200 hover:shadow-lg transition-all duration-300 overflow-hidden flex flex-col h-full">
                    <!-- Image -->
                    {% if draft.images|length > 0 %}
                        <div class="relative h-48 overflow-hidden">
                            <img src="{{ asset('uploads/blogs/' ~ draft.images.first.filename) }}" 
                                 class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                                 alt="{{ draft.images.first.altText|default(draft.title) }}">
                            <div class="absolute top-4 left-4">
                                <span class="inline-flex items-center px-3 py-1.5 rounded-full bg-gray-800/90 text-white text-xs font-medium">
                                    Чернетка
                                </span>
                            </div>
                        </div>
                    {% else %}
                        <div class="h-48 bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center">
                            <div class="text-center">
                                <i class="fas fa-blog text-5xl text-gray-400 mb-3"></i>
                                <div class="inline-flex items-center px-3 py-1.5 rounded-full bg-gray-800/90 text-white text-xs font-medium">
                                    Чернетка
                                </div>
                            </div>
                        </div>
                    {% endif %}
                    
                    <!-- Card Content -->
                    <div class="p-6 flex-1 flex flex-col">
                        <!-- Category -->
                        <div class="mb-4">
                            {% if draft.category %}
                                <span class="inline-block bg-gray-100 hover:bg-gray-200 text-gray-800 text-sm font-medium py-1.5 px-3 rounded-lg transition-colors duration-200">
                                    {{ draft.category.name }}
                                </span>
                            {% endif %}
                        </div>
                        
                        <!-- Title -->
                        <h3 class="text-xl font-bold text-gray-900 mb-3 line-clamp-2">
                            {{ draft.title|slice(0, 60) }}{% if draft.title|length > 60 %}...{% endif %}
                        </h3>
                        
                        <!-- Excerpt -->
                        {% if draft.excerpt %}
                            <p class="text-gray-600 mb-6 flex-1 line-clamp-3">
                                {{ draft.excerpt|slice(0, 120) }}{% if draft.excerpt|length > 120 %}...{% endif %}
                            </p>
                        {% endif %}
                        
                        <!-- Meta Info -->
                        <div class="flex items-center justify-between text-sm text-gray-500 mb-6">
                            <div class="flex items-center gap-4">
                                <span class="flex items-center gap-1.5">
                                    <i class="far fa-clock text-xs"></i>
                                    {{ draft.readingTime }} хв
                                </span>
                                <span class="flex items-center gap-1.5">
                                    <i class="far fa-calendar text-xs"></i>
                                    {{ draft.updatedAt|date('d.m.Y') }}
                                </span>
                            </div>
                        </div>
                        
                        <!-- Actions -->
                        <div class="space-y-3 mt-auto">
                            <button onclick="window.location.href='{{ path('user_blog_edit', {'id': draft.id}) }}'"
                                    class="w-full inline-flex items-center justify-center gap-2 border-2 border-primary hover:bg-primary text-primary hover:text-white font-medium py-3 px-4 rounded-lg transition-all duration-200">
                                <i class="fas fa-edit"></i>
                                Редагувати
                            </button>
                            
                            <div class="flex gap-2">
                                <button onclick="sendToModeration({{ draft.id }})"
                                        class="flex-1 inline-flex items-center justify-center gap-2 bg-green-600 hover:bg-green-700 text-white font-medium py-3 px-4 rounded-lg transition-all duration-200">
                                    <i class="fas fa-paper-plane"></i>
                                    На модерацію
                                </button>
                                
                                <button onclick="openDeleteModal({{ draft.id }})"
                                        class="inline-flex items-center justify-center w-12 bg-red-600 hover:bg-red-700 text-white font-medium py-3 px-4 rounded-lg transition-all duration-200">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Delete Modal -->
                <div id="deleteModal{{ draft.id }}" 
                     class="fixed inset-0 bg-black/50 z-50 hidden items-center justify-center p-4">
                    <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full transform transition-all duration-300 scale-95">
                        <!-- Modal Header -->
                        <div class="p-6 border-b border-gray-200">
                            <div class="flex items-center justify-between">
                                <h3 class="text-xl font-bold text-gray-900">Видалити чернетку</h3>
                                <button onclick="closeDeleteModal({{ draft.id }})"
                                        class="w-8 h-8 rounded-lg hover:bg-gray-100 flex items-center justify-center transition-colors duration-200">
                                    <i class="fas fa-times text-gray-500"></i>
                                </button>
                            </div>
                        </div>
                        
                        <!-- Modal Body -->
                        <div class="p-6">
                            <p class="text-gray-700 mb-4">
                                Видалити чернетку <strong>"{{ draft.title }}"</strong>?
                            </p>
                            <div class="space-y-2 text-sm text-gray-500 bg-gray-50 rounded-lg p-4">
                                <div class="flex items-center gap-2">
                                    <i class="far fa-calendar text-xs"></i>
                                    <span>Створено: {{ draft.createdAt|date('d.m.Y H:i') }}</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <i class="fas fa-sync-alt text-xs"></i>
                                    <span>Оновлено: {{ draft.updatedAt|date('d.m.Y H:i') }}</span>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Modal Footer -->
                        <div class="p-6 border-t border-gray-200 flex justify-end gap-3">
                            <button onclick="closeDeleteModal({{ draft.id }})"
                                    class="px-6 py-3 border border-gray-300 hover:bg-gray-50 text-gray-700 font-medium rounded-lg transition-colors duration-200">
                                Скасувати
                            </button>
                            <form method="post" action="{{ path('user_blog_delete', {'id': draft.id }) }}" 
                                  class="inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ draft.id) }}">
                                <button type="submit"
                                        class="px-6 py-3 bg-red-600 hover:bg-red-700 text-white font-medium rounded-lg transition-colors duration-200">
                                    Видалити
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <!-- Empty State -->
        <div class="text-center py-16 px-4">
            <div class="inline-flex items-center justify-center w-24 h-24 bg-gray-100 rounded-full mb-6">
                <i class="fas fa-file-alt text-4xl text-gray-400"></i>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-3">
                Немає чернеток
            </h3>
            <p class="text-gray-600 max-w-md mx-auto mb-8">
                Створіть свою першу чернетку блогу
            </p>
            <a href="{{ path('user_blog_new') }}" 
               class="inline-flex items-center gap-2 bg-primary hover:bg-primary/90 text-white font-medium py-3 px-8 rounded-lg text-lg transition-all duration-200 hover:shadow-lg">
                <i class="fas fa-plus"></i>
                Створити блог
            </a>
        </div>
    {% endif %}
</div>

<script>
function sendToModeration(postId) {
    if (confirm('Відправити цю чернетку на модерацію?')) {
        fetch(`/user/blog/${postId}/status/pending`, {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: `_token={{ csrf_token('status') }}`
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                alert('Помилка: ' + data.error);
            }
        })
        .catch(error => {
            alert('Помилка мережі');
        });
    }
}

function openDeleteModal(postId) {
    const modal = document.getElementById(`deleteModal${postId}`);
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    setTimeout(() => {
        modal.querySelector('.transform').classList.remove('scale-95');
        modal.querySelector('.transform').classList.add('scale-100');
    }, 10);
}

function closeDeleteModal(postId) {
    const modal = document.getElementById(`deleteModal${postId}`);
    modal.querySelector('.transform').classList.remove('scale-100');
    modal.querySelector('.transform').classList.add('scale-95');
    setTimeout(() => {
        modal.classList.remove('flex');
        modal.classList.add('hidden');
    }, 300);
}

// Close modal on outside click
document.addEventListener('click', (e) => {
    if (e.target.classList.contains('fixed')) {
        const modal = e.target;
        modal.querySelector('.transform').classList.remove('scale-100');
        modal.querySelector('.transform').classList.add('scale-95');
        setTimeout(() => {
            modal.classList.remove('flex');
            modal.classList.add('hidden');
        }, 300);
    }
});
</script>

<style>
/* Custom styles */
.line-clamp-2 {
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
}

.line-clamp-3 {
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
}

/* Modal backdrop animation */
.fixed {
    backdrop-filter: blur(4px);
}

/* Custom colors */
.bg-primary {
    background-color: #3b82f6;
}

.bg-primary\/90 {
    background-color: rgba(59, 130, 246, 0.9);
}

.hover\:bg-primary:hover {
    background-color: #3b82f6;
}

.text-primary {
    color: #3b82f6;
}

/* Hover effects */
.group:hover .group-hover\:scale-105 {
    transform: scale(1.05);
}

/* Transition utilities */
.transition-all {
    transition-property: all;
}

.duration-300 {
    transition-duration: 300ms;
}
</style>
{% endblock %}