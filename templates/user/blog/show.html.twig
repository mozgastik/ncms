{% extends 'base.html.twig' %}

{% block title %}Редагувати блог - {{ blogPost.title }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/@yaireo/tagify/dist/tagify.css" rel="stylesheet" type="text/css" />
    <style>
        .status-badge {
            font-size: 0.8rem;
            padding: 5px 10px;
        }
        .existing-images {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 15px;
            margin-top: 20px;
        }
        .existing-image {
            position: relative;
            border: 1px solid #dee2e6;
            border-radius: 8px;
            overflow: hidden;
        }
        .existing-image img {
            width: 100%;
            height: 150px;
            object-fit: cover;
        }
        .image-actions {
            position: absolute;
            top: 5px;
            right: 5px;
        }
        .image-caption {
            padding: 8px;
            font-size: 0.8rem;
            background: rgba(0,0,0,0.7);
            color: white;
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
        }
        .moderator-notes {
            background-color: #fff3cd;
            border: 1px solid #ffeaa7;
            border-radius: 8px;
            padding: 15px;
            margin-top: 20px;
        }
        .notes-label {
            font-weight: bold;
            color: #856404;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <div class="d-flex justify-content-between align-items-center">
                        <h1 class="h3 mb-0">
                            <i class="fas fa-edit me-2"></i>Редагувати блог
                        </h1>
                        <div>
                            <span class="status-badge badge bg-{{ blogPost.status == 'published' ? 'success' : (blogPost.status == 'pending' ? 'warning' : (blogPost.status == 'rejected' ? 'danger' : 'secondary')) }}">
                                {{ blogPost.status == 'draft' ? 'Чернетка' : 
                                   (blogPost.status == 'pending' ? 'На модерації' : 
                                   (blogPost.status == 'published' ? 'Опубліковано' : 'Відхилено')) }}
                            </span>
                            {% if blogPost.status == 'published' %}
                                <a href="{{ path('blog_show', {'slug': blogPost.slug}) }}" 
                                   target="_blank" 
                                   class="btn btn-sm btn-outline-dark ms-2">
                                    <i class="fas fa-external-link-alt me-1"></i>Переглянути
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    {% if blogPost.status == 'rejected' and blogPost.moderatorNotes %}
                        <div class="moderator-notes">
                            <div class="notes-label">
                                <i class="fas fa-exclamation-triangle me-2"></i>Причина відхилення від модератора:
                            </div>
                            <p class="mb-0 mt-2">{{ blogPost.moderatorNotes }}</p>
                        </div>
                    {% endif %}
                    
                    {{ form_start(form, {'attr': {'id': 'blog-form', 'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
                    
                    <!-- Статистика -->
                    <div class="row mb-4">
                        <div class="col-md-3 text-center">
                            <div class="p-3 bg-light rounded">
                                <div class="h4 mb-0">{{ blogPost.viewCount }}</div>
                                <small class="text-muted">Переглядів</small>
                            </div>
                        </div>
                        <div class="col-md-3 text-center">
                            <div class="p-3 bg-light rounded">
                                <div class="h4 mb-0">{{ blogPost.getLikeCount() }}</div>
                                <small class="text-muted">Лайків</small>
                            </div>
                        </div>
                        <div class="col-md-3 text-center">
                            <div class="p-3 bg-light rounded">
                                <div class="h4 mb-0">{{ blogPost.comments|length }}</div>
                                <small class="text-muted">Коментарів</small>
                            </div>
                        </div>
                        <div class="col-md-3 text-center">
                            <div class="p-3 bg-light rounded">
                                <div class="h4 mb-0">{{ blogPost.readingTime }}</div>
                                <small class="text-muted">Хв читання</small>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Заголовок -->
                    <div class="mb-4">
                        {{ form_label(form.title, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                        {{ form_widget(form.title, {'attr': {
                            'class': 'form-control form-control-lg'
                        }}) }}
                        <div class="invalid-feedback">
                            {{ form_errors(form.title) }}
                        </div>
                    </div>
                    
                    <!-- Короткий опис -->
                    <div class="mb-4">
                        {{ form_label(form.excerpt, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                        {{ form_widget(form.excerpt, {'attr': {
                            'class': 'form-control',
                            'rows': 3
                        }}) }}
                        <div class="invalid-feedback">
                            {{ form_errors(form.excerpt) }}
                        </div>
                        <div class="text-end">
                            <span id="excerpt-counter" class="badge bg-secondary">{{ blogPost.excerpt|length }}/500</span>
                        </div>
                    </div>
                    
                    <!-- Зміст блогу -->
                    <div class="mb-4">
                        {{ form_label(form.content, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                        {{ form_widget(form.content, {'attr': {
                            'class': 'form-control editor-content',
                            'rows': 15
                        }}) }}
                        <div class="invalid-feedback">
                            {{ form_errors(form.content) }}
                        </div>
                        <div class="text-end mt-2">
                            <span id="content-counter" class="badge bg-secondary">{{ blogPost.content|length }} символів</span>
                            <span id="reading-time" class="badge bg-info ms-2">~ {{ blogPost.readingTime }} хв читання</span>
                        </div>
                    </div>
                    
                    <!-- Категорія та теги -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            {{ form_label(form.category, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            {{ form_widget(form.category, {'attr': {
                                'class': 'form-select category-select'
                            }}) }}
                            <div class="invalid-feedback">
                                {{ form_errors(form.category) }}
                            </div>
                        </div>
                        <div class="col-md-6">
                            {{ form_label(form.tags, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            {{ form_widget(form.tags, {'attr': {
                                'class': 'form-select tags-select',
                                'data-placeholder': 'Виберіть теги або введіть нові...'
                            }}) }}
                            <div class="invalid-feedback">
                                {{ form_errors(form.tags) }}
                            </div>
                        </div>
                    </div>
                    
                    <!-- Існуючі зображення -->
                    {% if blogPost.images|length > 0 %}
                        <div class="mb-4">
                            <label class="form-label fw-bold d-block">
                                Існуючі зображення
                                <small class="text-muted">({{ blogPost.images|length }})</small>
                            </label>
                            <div class="existing-images">
                                {% for image in blogPost.images %}
                                    <div class="existing-image">
                                        <img src="{{ asset('uploads/blogs/' ~ image.filename) }}" 
                                             alt="{{ image.altText|default('') }}"
                                             data-id="{{ image.id }}">
                                        {% if image.caption %}
                                            <div class="image-caption">{{ image.caption|slice(0, 50) }}{% if image.caption|length > 50 %}...{% endif %}</div>
                                        {% endif %}
                                        <div class="image-actions">
                                            <button type="button" 
                                                    class="btn btn-sm btn-danger delete-image" 
                                                    data-id="{{ image.id }}"
                                                    data-filename="{{ image.filename }}"
                                                    title="Видалити">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}
                    
                    <!-- Новий головне зображення -->
                    <div class="mb-4">
                        <label class="form-label fw-bold">Нове головне зображення</label>
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle me-2"></i>
                            Поточне зображення збережеться. Для заміни завантажте нове.
                        </div>
                        {{ form_widget(form.featuredImage, {'attr': {
                            'class': 'form-control',
                            'accept': 'image/*'
                        }}) }}
                        <div class="invalid-feedback">
                            {{ form_errors(form.featuredImage) }}
                        </div>
                        <small class="form-text text-muted">
                            Дозволені формати: JPG, PNG, GIF, WebP (макс. 5MB)
                        </small>
                    </div>
                    
                    <!-- Нові додаткові зображення -->
                    <div class="mb-4">
                        <label class="form-label fw-bold">Додати нові зображення</label>
                        <button type="button" class="btn btn-outline-secondary mb-3" onclick="addImageField()">
                            <i class="fas fa-plus me-2"></i>Додати поле для зображення
                        </button>
                        
                        <div id="imageCollection">
                            <!-- Динамічно додані поля будуть тут -->
                        </div>
                    </div>
                    
                    <!-- Налаштування -->
                    <div class="mb-4">
                        <div class="form-check form-switch">
                            {{ form_widget(form.isBreaking, {'attr': {
                                'class': 'form-check-input',
                                'role': 'switch'
                            }}) }}
                            {{ form_label(form.isBreaking, null, {'label_attr': {'class': 'form-check-label fw-bold'}}) }}
                        </div>
                    </div>
                    
                    <!-- Дії -->
                    <div class="form-actions">
                        <div class="d-flex justify-content-between">
                            <div>
                                <a href="{{ path('user_blog_index') }}" class="btn btn-outline-secondary">
                                    <i class="fas fa-arrow-left me-2"></i>Назад
                                </a>
                                {% if blogPost.status != 'published' %}
                                    <button type="button" 
                                            class="btn btn-outline-danger" 
                                            data-bs-toggle="modal" 
                                            data-bs-target="#deleteModal">
                                        <i class="fas fa-trash me-2"></i>Видалити
                                    </button>
                                {% endif %}
                            </div>
                            <div>
                                {% if blogPost.status == 'draft' or blogPost.status == 'rejected' %}
                                    <button type="submit" name="submit_type" value="draft" class="btn btn-secondary">
                                        <i class="fas fa-save me-2"></i>Зберегти чернетку
                                    </button>
                                {% endif %}
                                
                                {% if blogPost.status != 'published' and blogPost.status != 'pending' %}
                                    <button type="submit" name="submit_type" value="moderate" class="btn btn-primary">
                                        <i class="fas fa-paper-plane me-2"></i>Відправити на модерацію
                                    </button>
                                {% elseif blogPost.status == 'pending' %}
                                    <button type="button" class="btn btn-warning" disabled>
                                        <i class="fas fa-hourglass-half me-2"></i>На модерації
                                    </button>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                    
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Модальне вікно для видалення -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Видалити блог</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Ви впевнені, що хочете видалити блог <strong>"{{ blogPost.title }}"</strong>?</p>
                <p class="text-danger">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    Цю дію неможливо скасувати. Буде видалено всі коментарі, зображення та статистику.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Скасувати</button>
                <form method="post" action="{{ path('user_blog_delete', {'id': blogPost.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ blogPost.id) }}">
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash me-2"></i>Видалити назавжди
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@yaireo/tagify/dist/tagify.min.js"></script>
    <script>
        $(document).ready(function() {
            // Ініціалізація Select2
            $('.category-select').select2({
                placeholder: 'Виберіть категорію',
                allowClear: true,
                width: '100%'
            });
            
            // Ініціалізація Tagify
            const tagsInput = document.querySelector('.tags-select');
            if (tagsInput) {
                const tagify = new Tagify(tagsInput, {
                    whitelist: [],
                    dropdown: {
                        enabled: 0,
                        maxItems: 10,
                    },
                    enforceWhitelist: false,
                    editTags: false,
                    maxTags: 10,
                    placeholder: 'Виберіть теги або введіть нові...',
                });
                
                // Завантаження існуючих тегів
                fetch('{{ path("blog_tags_json") }}')
                    .then(response => response.json())
                    .then(data => {
                        tagify.settings.whitelist = data;
                    });
            }
            
            // Підрахунок символів
            const excerptTextarea = document.getElementById('blog_post_excerpt');
            const contentTextarea = document.getElementById('blog_post_content');
            
            if (excerptTextarea) {
                excerptTextarea.addEventListener('input', function() {
                    const length = this.value.length;
                    document.getElementById('excerpt-counter').textContent = length + '/500';
                });
            }
            
            if (contentTextarea) {
                contentTextarea.addEventListener('input', function() {
                    const length = this.value.length;
                    document.getElementById('content-counter').textContent = length + ' символів';
                });
            }
            
            // Видалення зображень через AJAX
            document.querySelectorAll('.delete-image').forEach(button => {
                button.addEventListener('click', function() {
                    const imageId = this.getAttribute('data-id');
                    const filename = this.getAttribute('data-filename');
                    
                    if (confirm('Видалити це зображення?')) {
                        fetch(`/user/blog/image/${imageId}/delete`, {
                            method: 'DELETE',
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                this.closest('.existing-image').remove();
                                showToast('Зображення видалено', 'success');
                            } else {
                                showToast('Помилка видалення', 'error');
                            }
                        })
                        .catch(error => {
                            showToast('Помилка мережі', 'error');
                        });
                    }
                });
            });
        });
        
        // Додавання полів для нових зображень
        function addImageField() {
            const container = document.getElementById('imageCollection');
            const div = document.createElement('div');
            div.className = 'image-field mb-2';
            div.innerHTML = `
                <div class="input-group">
                    <input type="file" 
                           class="form-control" 
                           name="blog_post[additionalImages][]" 
                           accept="image/*">
                    <button type="button" class="btn btn-outline-danger" onclick="this.closest('.image-field').remove()">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            `;
            container.appendChild(div);
        }
        
        // Функція для показу сповіщень
        function showToast(message, type = 'info') {
            const toast = document.createElement('div');
            toast.className = `toast align-items-center text-white bg-${type === 'success' ? 'success' : 'danger'} border-0`;
            toast.setAttribute('role', 'alert');
            toast.innerHTML = `
                <div class="d-flex">
                    <div class="toast-body">
                        ${message}
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            `;
            
            const container = document.getElementById('toast-container') || (() => {
                const div = document.createElement('div');
                div.id = 'toast-container';
                div.className = 'toast-container position-fixed top-0 end-0 p-3';
                document.body.appendChild(div);
                return div;
            })();
            
            container.appendChild(toast);
            
            const bsToast = new bootstrap.Toast(toast);
            bsToast.show();
            
            toast.addEventListener('hidden.bs.toast', function() {
                this.remove();
            });
        }
    </script>
{% endblock %}