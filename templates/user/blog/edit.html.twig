{# templates/admin/blog_post/edit.html.twig #}
{% extends 'admin/base.html.twig' %}

{% block title %}{% if blogPost.id %}Редагування блогу{% else %}Створення нового блогу{% endif %} - Адмін панель{% endblock %}

{% block stylesheets %}
{{ parent() }}
<!-- CKEditor 5 -->
<script src="https://cdn.ckeditor.com/ckeditor5/41.1.0/classic/ckeditor.js"></script>
<!-- Select2 for tags -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<!-- Datepicker -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<style>
    /* CKEditor Styles */
    .ck-editor__editable {
        min-height: 300px;
        background: white;
        color: #1f2937;
        border-radius: 0.5rem;
    }
    .dark .ck-editor__editable {
        background: #374151;
        color: #f3f4f6;
    }
    .ck.ck-editor {
        margin-top: 0.5rem;
        border-radius: 0.5rem;
        overflow: hidden;
    }
    .ck-fullscreen {
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        width: 100vw !important;
        height: 100vh !important;
        z-index: 9999 !important;
        border: none !important;
        border-radius: 0 !important;
    }
    .ck-fullscreen-body { 
        overflow: hidden !important; 
    }
    
    /* Select2 Styles */
    .select2-container--default .select2-selection--multiple {
        border: 1px solid #d1d5db;
        border-radius: 0.5rem;
        padding: 0.5rem;
        background: white;
    }
    .dark .select2-container--default .select2-selection--multiple {
        background: #374151;
        border-color: #4b5563;
        color: #f3f4f6;
    }
    .select2-container .select2-selection--multiple .select2-selection__choice {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        color: white;
        padding: 2px 8px;
        border-radius: 0.375rem;
        margin-right: 4px;
        margin-bottom: 4px;
    }
    .select2-container .select2-selection--multiple .select2-selection__choice__remove {
        color: white;
        margin-right: 4px;
    }
    
    /* Image Upload Styles */
    .image-upload-area {
        border: 2px dashed #d1d5db;
        border-radius: 0.75rem;
        transition: all 0.3s ease;
        background: #f9fafb;
        cursor: pointer;
    }
    .dark .image-upload-area {
        background: #374151;
        border-color: #4b5563;
    }
    .image-upload-area:hover {
        border-color: #3b82f6;
        background-color: #f8fafc;
    }
    .dark .image-upload-area:hover {
        background-color: #4b5563;
    }
    .image-upload-area.dragover {
        border-color: #3b82f6;
        background-color: #eff6ff;
    }
    .dark .image-upload-area.dragover {
        background-color: #3b82f6;
        opacity: 0.8;
    }
    
    /* Upload Preview */
    .upload-preview {
        max-height: 200px;
        object-fit: contain;
        border-radius: 0.5rem;
    }
    
    /* Tag Badges */
    .tag-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.25rem 0.75rem;
        border-radius: 9999px;
        font-size: 0.875rem;
        font-weight: 500;
        margin-right: 0.5rem;
        margin-bottom: 0.5rem;
    }
    
    /* Status Badges */
    .status-draft {
        background: linear-gradient(135deg, #f59e0b, #d97706);
        color: white;
    }
    .status-pending {
        background: linear-gradient(135deg, #fbbf24, #f59e0b);
        color: white;
    }
    .status-published {
        background: linear-gradient(135deg, #10b981, #059669);
        color: white;
    }
    .status-rejected {
        background: linear-gradient(135deg, #ef4444, #dc2626);
        color: white;
    }
    
    /* Toggle Switch */
    .toggle-checkbox:checked {
        right: 0;
        border-color: #3b82f6;
    }
    .toggle-checkbox:checked + .toggle-label {
        background-color: #3b82f6;
    }
    
    /* Animations */
    @keyframes fade-in {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    .animate-fade-in {
        animation: fade-in 0.3s ease-out;
    }
    
    @keyframes slide-in {
        from {
            opacity: 0;
            transform: translateX(-20px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }
    .animate-slide-in {
        animation: slide-in 0.3s ease-out;
    }
</style>
{% endblock %}

{% block body %}
<main class="flex-1 p-4 lg:p-6">
    <!-- Header with Flash Messages -->
    <div class="mb-6">
        <!-- Flash Messages -->
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-4 px-4 py-3 rounded-lg animate-slide-in
                    {% if type == 'success' %}bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-300 border border-green-200 dark:border-green-800/50
                    {% elseif type == 'error' %}bg-red-100 dark:bg-red-900/30 text-red-800 dark:text-red-300 border border-red-200 dark:border-red-800/50
                    {% elseif type == 'warning' %}bg-yellow-100 dark:bg-yellow-900/30 text-yellow-800 dark:text-yellow-300 border border-yellow-200 dark:border-yellow-800/50
                    {% else %}bg-blue-100 dark:bg-blue-900/30 text-blue-800 dark:text-blue-300 border border-blue-200 dark:border-blue-800/50
                    {% endif %}">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center">
                            {% if type == 'success' %}
                                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            {% elseif type == 'error' %}
                                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            {% else %}
                                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            {% endif %}
                            {{ message }}
                        </div>
                        <button onclick="this.parentElement.parentElement.remove()" class="ml-4 hover:opacity-70 transition-opacity">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </button>
                    </div>
                </div>
            {% endfor %}
        {% endfor %}
        
        <!-- Page Header -->
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-2xl lg:text-3xl font-bold text-gray-900 dark:text-white">
                    {% if blogPost.id %}Редагування блогу{% else %}Створення нового блогу{% endif %}
                </h1>
                <p class="text-gray-600 dark:text-gray-400 mt-1">
                    Заповніть форму для {% if blogPost.id %}редагування{% else %}створення{% endif %} блогу
                </p>
            </div>
            <a href="{{ path('admin_blog_index') }}" 
               class="inline-flex items-center gap-2 px-4 py-2.5 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 font-medium rounded-lg hover:bg-gray-50 dark:hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-all duration-300">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                Назад до списку
            </a>
        </div>
    </div>

    <!-- Main Form -->
    {{ form_start(form, {'attr': {'class': 'space-y-6', 'enctype': 'multipart/form-data'}}) }}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Left Column: Main Content -->
        <div class="lg:col-span-2 space-y-6">
            <!-- Basic Information Card -->
            <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm p-6">
                <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Основна інформація</h2>
                
                <div class="space-y-4">
                    <!-- Title -->
                    <div>
                        {{ form_label(form.title, 'Заголовок блогу', {
                            'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2'}
                        }) }}
                        {{ form_widget(form.title, {
                            'attr': {
                                'class': 'block w-full px-3 py-2.5 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-300',
                                'placeholder': 'Введіть заголовок блогу',
                                'autocomplete': 'off',
                                'id': 'blog_title'
                            }
                        }) }}
                        {{ form_errors(form.title) }}
                    </div>

                    <!-- Slug -->
                    <div>
                        {{ form_label( form.slug , 'URL-адреса (slug)', {
                            'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2'}
                        }) }}
                        <div class="relative">
                            {{ form_widget(form.slug, {
                                'attr': {
                                    'class': 'block w-full pl-24 pr-3 py-2.5 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-300',
                                    'placeholder': 'avtomatychnyy-slug',
                                    'id': 'blog_slug'
                                }
                            }) }}
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <span class="text-gray-400 dark:text-gray-500">/blog/</span>
                            </div>
                        </div>
                        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
                            Залиште порожнім для автоматичного створення на основі заголовка
                        </p>
                        {{ form_errors(form.slug) }}
                    </div>
                    
                    <!-- Excerpt -->
                    <div>
                        {{ form_label(form.excerpt, 'Короткий опис', {
                            'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2'}
                        }) }}
                        {{ form_widget(form.excerpt, {
                            'attr': {
                                'class': 'block w-full px-3 py-2.5 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-300',
                                'placeholder': 'Короткий опис блогу для превью',
                                'rows': 3,
                                'id': 'blog_excerpt'
                            }
                        }) }}
                        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
                            Цей текст буде відображатися на головній сторінці та в картках блогів
                        </p>
                        {{ form_errors(form.excerpt) }}
                    </div>
                </div>
            </div>

            <!-- Content Card -->
            <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm p-6">
                <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Контент</h2>
                
                <div class="space-y-6">
                    <!-- Content with CKEditor -->
                    <div>
                        <div class="flex items-center justify-between mb-2">
                            {{ form_label(form.content, 'Основний вміст', {
                                'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300'}
                            }) }}
                            <div class="flex items-center gap-2 text-sm">
                                <button type="button" 
                                        onclick="toggleEditorFullscreen()"
                                        class="text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 p-1.5 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors duration-300"
                                        title="Повноекранний режим">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5v-4m0 4h-4m4 0l-5-5" />
                                    </svg>
                                </button>
                            </div>
                        </div>
                        {{ form_widget(form.content, {
                            'attr': {
                                'class': 'hidden',
                                'id': 'blog_content'
                            }
                        }) }}
                        <div id="editor-container">
                            <div id="editor" placeholder="Текст вашого блогу..."></div>
                        </div>
                        {{ form_errors(form.content) }}
                    </div>
                </div>
            </div>
            
            <!-- Images Card -->
            <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm p-6">
                <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Зображення</h2>
                
                <div class="space-y-4">
                    <!-- Image Upload Area -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            Завантажити зображення
                        </label>
                        <div id="imageUploadArea" 
                             class="image-upload-area rounded-lg p-6 text-center cursor-pointer transition-all duration-300">
                            <input type="file" id="fileInput" multiple accept="image/*" class="hidden">
                            <div class="space-y-3">
                                <div class="mx-auto w-12 h-12 rounded-full bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center">
                                    <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                                    </svg>
                                </div>
                                <div>
                                    <p class="text-sm font-medium text-gray-900 dark:text-white">
                                        Перетягніть зображення сюди
                                    </p>
                                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
                                        або клікніть для вибору файлів
                                    </p>
                                </div>
                                <p class="text-xs text-gray-400 dark:text-gray-500">
                                    PNG, JPG, WebP до 5MB
                                </p>
                            </div>
                        </div>
                        
                        <!-- Progress -->
                        <div id="uploadProgress" class="mt-3 hidden">
                            <div class="flex items-center justify-between text-sm mb-1">
                                <span class="text-gray-600 dark:text-gray-400">Завантаження...</span>
                                <span id="progressPercent" class="font-medium text-blue-600 dark:text-blue-400">0%</span>
                            </div>
                            <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2 overflow-hidden">
                                <div id="progressBar" class="bg-blue-600 h-2 rounded-full transition-all duration-300" style="width: 0%"></div>
                            </div>
                        </div>
                        
                        <!-- Uploaded Images Preview -->
                        <div id="uploadedImages" class="mt-4 space-y-3">
                            {% if blogPost.images is defined and blogPost.images|length > 0 %}
                                {% for image in blogPost.images %}
                                <div class="flex items-center justify-between p-3 bg-gray-50 dark:bg-gray-700/50 rounded-lg border border-gray-200 dark:border-gray-600">
                                    <div class="flex items-center space-x-3">
                                        <img src="{{ asset('uploads/blogs/' ~ image.filename) }}" 
                                             alt="Preview" 
                                             class="w-10 h-10 object-cover rounded-lg">
                                        <div>
                                            <p class="text-sm font-medium text-gray-900 dark:text-white truncate max-w-[150px]">
                                                {{ image.filename }}
                                            </p>
                                            <p class="text-xs text-gray-500 dark:text-gray-400">
                                                {{ (image.size / 1024)|number_format(1) }} KB
                                            </p>
                                        </div>
                                    </div>
                                    <button type="button" 
                                            onclick="removeImage('{{ image.id }}')"
                                            class="text-red-500 hover:text-red-700 p-1.5 rounded-lg hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors duration-300">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                        </svg>
                                    </button>
                                </div>
                                {% endfor %}
                            {% endif %}
                        </div>
                        
                        <input type="hidden" id="uploadedImageIds" name="uploaded_image_ids" value="">
                    </div>
                    
                    <!-- Featured Image -->
                    <div>
                        {{ form_label(form.featuredImage, 'Головне зображення', {
                            'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2'}
                        }) }}
                        
                        <div class="space-y-3">
                            <!-- URL Input -->
                            {{ form_widget(form.featuredImage, {
                                'attr': {
                                    'class': 'block w-full px-3 py-2.5 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-300',
                                    'placeholder': 'https://example.com/image.jpg або виберіть зі завантажених',
                                    'id': 'blog_featuredImage'
                                }
                            }) }}
                            
                            <!-- Select from uploaded -->
                            <div id="featuredImageSelect" class="hidden">
                                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                                    Вибрати з завантажених
                                </label>
                                <select id="featuredImageDropdown" 
                                        class="block w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                                    <option value="">Виберіть зображення...</option>
                                </select>
                            </div>
                            
                            <!-- Preview -->
                            <div id="imagePreview" class="mt-3 {% if not form.featuredImage.vars.value %}hidden{% endif %}">
                                <img id="previewImage" 
                                     src="{{ form.featuredImage.vars.value ? asset(form.featuredImage.vars.value) : '' }}" 
                                     alt="Попередній перегляд" 
                                     class="w-full h-48 object-cover rounded-lg border border-gray-200 dark:border-gray-600">
                                <div class="mt-2 flex justify-center">
                                    <button type="button" 
                                            onclick="clearFeaturedImage()"
                                            class="text-sm text-red-600 hover:text-red-800 flex items-center gap-1">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                        </svg>
                                        Видалити
                                    </button>
                                </div>
                            </div>
                        </div>
                        {{ form_errors(form.featuredImage) }}
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Sidebar -->
        <div class="space-y-6">
            <!-- Category & Tags Card -->
            <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm p-6">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Категорії та теги</h3>
                
                <div class="space-y-4">
                    <!-- Category -->
                    <div>
                        {{ form_label(form.category, 'Категорія', {
                            'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2'}
                        }) }}
                        
                        <div class="space-y-2">
                            {{ form_widget(form.category, {
                                'attr': {
                                    'class': 'w-full px-3 py-2.5 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-300',
                                    'id': 'blog_category'
                                }
                            }) }}
                            
                            <div class="flex items-center justify-between">
                                <a href="{{ path('admin_category_new') }}" 
                                   target="_blank"
                                   class="inline-flex items-center gap-1.5 text-sm text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors duration-300">
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                                    </svg>
                                    <span>Створити нову категорію</span>
                                </a>
                            </div>
                        </div>
                        {{ form_errors(form.category) }}
                    </div>

                    <!-- Tags -->
                    <div>
                        {{ form_label(form.tags, 'Теги', {
                            'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2'}
                        }) }}
                        
                        <div class="space-y-2">
                            <!-- Select2 tags input -->
                            <select id="blog_tags" 
                                    name="blog_post[tags][]" 
                                    multiple="multiple" 
                                    class="hidden">
                                {% for tag in allTags %}
                                <option value="{{ tag.id }}" 
                                        {% if blogPost.tags is defined and tag in blogPost.tags %}selected{% endif %}>
                                    {{ tag.name }}
                                </option>
                                {% endfor %}
                            </select>
                            
                            <!-- Manual tag input -->
                            <div class="space-y-3">
                                <div class="flex space-x-2">
                                    <input type="text" 
                                           id="newTagInput" 
                                           placeholder="Введіть новий тег..."
                                           class="flex-1 px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-300">
                                    <button type="button" 
                                            onclick="addNewTag()"
                                            class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all duration-300">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                                        </svg>
                                    </button>
                                </div>
                                
                                <div id="selectedTags" class="flex flex-wrap gap-2">
                                    {% if blogPost.tags is defined %}
                                        {% for tag in blogPost.tags %}
                                        <span class="tag-badge bg-blue-100 dark:bg-blue-900/30 text-blue-800 dark:text-blue-300 px-3 py-1.5 rounded-full text-sm inline-flex items-center">
                                            {{ tag.name }}
                                            <button type="button" 
                                                    onclick="removeTag({{ tag.id }})"
                                                    class="ml-2 text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-200 transition-colors duration-300">
                                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                                </svg>
                                            </button>
                                        </span>
                                        {% endfor %}
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                        {{ form_errors(form.tags) }}
                    </div>
                </div>
            </div>

            <!-- Publish Settings Card -->
            <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm p-6">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Публікація</h3>
                
                <div class="space-y-4">
                    <!-- Published Date -->
                    <div>
                        {{ form_label(form.publishedAt, 'Дата публікації', {
                            'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2'}
                        }) }}
                        <div class="relative">
                            {{ form_widget(form.publishedAt, {
                                'attr': {
                                    'class': 'block w-full pl-10 pr-3 py-2.5 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-300',
                                    'placeholder': 'Оберіть дату',
                                    'id': 'blog_publishedAt'
                                }
                            }) }}
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                            </div>
                        </div>
                        {{ form_errors(form.publishedAt) }}
                    </div>
                    
                    <!-- Status -->
                    <div>
                        {{ form_label(form.status, 'Статус', {
                            'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2'}
                        }) }}
                        {{ form_widget(form.status, {
                            'attr': {
                                'class': 'w-full px-3 py-2.5 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-300',
                                'id': 'blog_status'
                            }
                        }) }}
                        {{ form_errors(form.status) }}
                        <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
                            • Чернетка: лише ви бачите<br>
                            • На модерації: чекає перевірки<br>
                            • Опубліковано: доступно всім
