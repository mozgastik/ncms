                        </button>
                        {% endif %}
                    </div>
                </div>
            </div>

            <!-- Blog Stats Card (for edit) -->
            {% if blogPost.id %}
            <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm p-6">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Статистика</h3>
                
                <div class="grid grid-cols-2 gap-3">
                    <div class="text-center p-3 bg-gray-50 dark:bg-gray-700/50 rounded-lg">
                        <div class="text-2xl font-bold text-gray-900 dark:text-white">
                            {{ blogPost.viewCount is defined ? blogPost.viewCount : 0 }}
                        </div>
                        <div class="text-xs text-gray-500 dark:text-gray-400">Переглядів</div>
                    </div>
                    <div class="text-center p-3 bg-gray-50 dark:bg-gray-700/50 rounded-lg">
                        <div class="text-2xl font-bold text-gray-900 dark:text-white">
                            {{ blogPost.comments is defined ? blogPost.comments|length : 0 }}
                        </div>
                        <div class="text-xs text-gray-500 dark:text-gray-400">Коментарів</div>
                    </div>
                    <div class="text-center p-3 bg-gray-50 dark:bg-gray-700/50 rounded-lg">
                        <div class="text-sm font-medium text-gray-900 dark:text-white">
                            {{ blogPost.createdAt|date('d.m.Y') }}
                        </div>
                        <div class="text-xs text-gray-500 dark:text-gray-400">Створено</div>
                    </div>
                    <div class="text-center p-3 bg-gray-50 dark:bg-gray-700/50 rounded-lg">
                        <div class="text-sm font-medium text-gray-900 dark:text-white">
                            {% if blogPost.updatedAt is defined and blogPost.updatedAt %}
                                {{ blogPost.updatedAt|date('d.m.Y') }}
                            {% else %}
                                -
                            {% endif %}
                        </div>
                        <div class="text-xs text-gray-500 dark:text-gray-400">Оновлено</div>
                    </div>
                </div>
                
                <!-- Current Status -->
                <div class="mt-4 pt-4 border-t border-gray-200 dark:border-gray-700">
                    <div class="flex items-center justify-between">
                        <span class="text-sm text-gray-600 dark:text-gray-400">Поточний статус:</span>
                        <span class="px-2 py-1 text-xs font-medium rounded-full 
                            {% if blogPost.status == 'draft' %}status-draft
                            {% elseif blogPost.status == 'pending' %}status-pending
                            {% elseif blogPost.status == 'published' %}status-published
                            {% elseif blogPost.status == 'rejected' %}status-rejected
                            {% else %}bg-gray-200 dark:bg-gray-700 text-gray-800 dark:text-gray-300
                            {% endif %}">
                            {{ blogPost.status|default('чернетка')|capitalize }}
                        </span>
                    </div>
                </div>
            </div>
            {% endif %}
        </div>
    </div>
    {{ form_end(form) }}
</main>
{% endblock %}

{% block javascripts %}
{{ parent() }}

<!-- External Libraries -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.ckeditor.com/ckeditor5/41.1.0/classic/ckeditor.js"></script>

<script>
// Конфігурація та глобальні змінні
const CONFIG = {
    maxFileSize: 5 * 1024 * 1024, // 5MB
    validExtensions: ['jpg', 'jpeg', 'png', 'gif', 'webp'],
    uploadUrl: '{{ path('admin_blog_image_upload') }}',
    csrfToken: '{{ csrf_token('blog_image_upload') }}'
};

// Глобальні змінні
let ckeditor;
let uploadedFiles = [];
const blogId = {{ blogPost.id ? blogPost.id : 0 }};

// Утиліти
const Utils = {
    showNotification(message, type = 'info') {
        const types = {
            success: { 
                icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
                bg: 'bg-green-100 dark:bg-green-900/30',
                text: 'text-green-800 dark:text-green-300',
                border: 'border-green-200 dark:border-green-800/50'
            },
            error: { 
                icon: 'M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
                bg: 'bg-red-100 dark:bg-red-900/30',
                text: 'text-red-800 dark:text-red-300',
                border: 'border-red-200 dark:border-red-800/50'
            },
            warning: { 
                icon: 'M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.998-.833-2.732 0L4.346 16.5c-.77.833.192 2.5 1.732 2.5z',
                bg: 'bg-yellow-100 dark:bg-yellow-900/30',
                text: 'text-yellow-800 dark:text-yellow-300',
                border: 'border-yellow-200 dark:border-yellow-800/50'
            },
            info: { 
                icon: 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
                bg: 'bg-blue-100 dark:bg-blue-900/30',
                text: 'text-blue-800 dark:text-blue-300',
                border: 'border-blue-200 dark:border-blue-800/50'
            }
        };
        
        const notification = document.createElement('div');
        notification.className = `fixed top-4 right-4 px-4 py-3 rounded-lg shadow-lg z-50 animate-fade-in ${types[type].bg} ${types[type].text} ${types[type].border}`;
        
        notification.innerHTML = `
            <div class="flex items-center gap-3">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="${types[type].icon}" />
                </svg>
                <span class="font-medium flex-1">${message}</span>
                <button onclick="this.parentElement.parentElement.remove()" 
                        class="ml-4 hover:opacity-70 transition-opacity">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
        `;
        
        document.body.appendChild(notification);
        setTimeout(() => notification.remove(), 5000);
    },
    
    generateSlug(text) {
        return text.toLowerCase()
            .normalize('NFD').replace(/[\u0300-\u036f]/g, '') // Видаляє діакритичні знаки
            .replace(/[^\w\s\-]/g, '') // Видаляє спецсимволи
            .replace(/\s+/g, '-')
            .replace(/-+/g, '-')
            .replace(/^-+|-+$/g, '')
            .trim();
    },
    
    formatFileSize(bytes) {
        if (bytes < 1024) return bytes + ' B';
        if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
        return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
    },
    
    async sleep(ms) {
        return new Promise(resolve => setTimeout(resolve, ms));
    }
};

// CKEditor Manager
const EditorManager = {
    async init() {
        try {
            ckeditor = await ClassicEditor.create(document.querySelector('#editor'), {
                toolbar: {
                    items: [
                        'heading', '|',
                        'bold', 'italic', 'underline', 'strikethrough', 'code', 'subscript', 'superscript', '|',
                        'link', 'bulletedList', 'numberedList', 'todoList', '|',
                        'outdent', 'indent', '|',
                        'alignment', '|',
                        'blockQuote', 'codeBlock', 'insertTable', 'mediaEmbed', '|',
                        'undo', 'redo', '|',
                        'imageUpload'
                    ]
                },
                language: 'uk',
                placeholder: 'Текст вашого блогу...',
                image: {
                    toolbar: [
                        'imageTextAlternative',
                        'toggleImageCaption',
                        'imageStyle:inline',
                        'imageStyle:block',
                        'imageStyle:side',
                        'linkImage'
                    ],
                    upload: {
                        types: ['jpeg', 'png', 'gif', 'bmp', 'webp', 'tiff']
                    }
                },
                mediaEmbed: {
                    previewsInData: true
                },
                table: {
                    contentToolbar: ['tableColumn', 'tableRow', 'mergeTableCells', 'tableProperties', 'tableCellProperties']
                }
            });
            
            ckeditor.model.document.on('change:data', () => {
                document.getElementById('blog_content').value = ckeditor.getData();
            });
            
            const existingContent = document.getElementById('blog_content').value;
            if (existingContent) {
                ckeditor.setData(existingContent);
            }
            
            console.log('✅ CKEditor завантажено');
        } catch (error) {
            console.error('❌ Помилка CKEditor:', error);
            Utils.showNotification('Помилка завантаження редактора тексту', 'error');
        }
    },
    
    toggleFullscreen() {
        const editorElement = document.querySelector('.ck-editor');
        if (!editorElement) return;
        
        const isFullscreen = editorElement.classList.contains('ck-fullscreen');
        editorElement.classList.toggle('ck-fullscreen', !isFullscreen);
        document.body.classList.toggle('ck-fullscreen-body', !isFullscreen);
    }
};

// Tag Manager
const TagManager = {
    init() {
        $('#blog_tags').select2({
            placeholder: 'Виберіть теги або введіть нові',
            tags: true,
            tokenSeparators: [',', ' '],
            width: '100%',
            theme: 'default',
            allowClear: true,
            createTag: function(params) {
                const term = params.term.trim();
                if (term === '') return null;
                
                return {
                    id: term,
                    text: term,
                    newTag: true
                };
            }
        }).on('select2:select', function(e) {
            TagManager.addTagBadge(e.params.data);
        }).on('select2:unselect', function(e) {
            TagManager.removeTagBadge(e.params.data.id);
        });
        
        // Заповнюємо теги з існуючого блогу
        this.initExistingTags();
    },
    
    initExistingTags() {
        $('#blog_tags option:selected').each(function() {
            const tagData = {
                id: $(this).val(),
                text: $(this).text()
            };
            TagManager.addTagBadge(tagData);
        });
    },
    
    addTagBadge(tagData) {
        const existingBadge = document.querySelector(`#selectedTags .tag-badge[data-tag-id="${tagData.id}"]`);
        if (existingBadge) return;
        
        const tagBadge = document.createElement('span');
        tagBadge.className = 'tag-badge bg-blue-100 dark:bg-blue-900/30 text-blue-800 dark:text-blue-300 px-3 py-1.5 rounded-full text-sm inline-flex items-center';
        tagBadge.dataset.tagId = tagData.id;
        tagBadge.innerHTML = `
            ${tagData.text}
            <button onclick="TagManager.removeTag('${tagData.id}')" 
                    class="ml-2 text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-200 transition-colors duration-300">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        `;
        
        document.getElementById('selectedTags').appendChild(tagBadge);
    },
    
    removeTagBadge(tagId) {
        const badge = document.querySelector(`#selectedTags .tag-badge[data-tag-id="${tagId}"]`);
        if (badge) badge.remove();
    },
    
    removeTag(tagId) {
        const $select = $('#blog_tags');
        $select.val($select.val().filter(val => val != tagId)).trigger('change');
        this.removeTagBadge(tagId);
    },
    
    addNewTag() {
        const input = document.getElementById('newTagInput');
        const tagName = input.value.trim();
        if (!tagName) {
            Utils.showNotification('Введіть назву тегу', 'warning');
            return;
        }
        
        const $select = $('#blog_tags');
        if (!$select.find(`option[value="${tagName}"]`).length) {
            const newOption = new Option(tagName, tagName, true, true);
            $select.append(newOption);
        }
        $select.val([...($select.val() || []), tagName]).trigger('change');
        input.value = '';
    }
};

// Image Upload Manager
const ImageManager = {
    elements: {},
    
    init() {
        this.elements = {
            uploadArea: document.getElementById('imageUploadArea'),
            fileInput: document.getElementById('fileInput'),
            progress: document.getElementById('uploadProgress'),
            progressBar: document.getElementById('progressBar'),
            progressPercent: document.getElementById('progressPercent'),
            uploadedImages: document.getElementById('uploadedImages'),
            uploadedImageIds: document.getElementById('uploadedImageIds'),
            featuredImageSelect: document.getElementById('featuredImageSelect'),
            featuredImageDropdown: document.getElementById('featuredImageDropdown'),
            featuredImageInput: document.getElementById('blog_featuredImage')
        };
        
        this.setupDragAndDrop();
        this.setupFeaturedImage();
        this.initExistingImages();
    },
    
    setupDragAndDrop() {
        if (!this.elements.uploadArea) return;
        
        ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
            this.elements.uploadArea.addEventListener(eventName, e => {
                e.preventDefault();
                e.stopPropagation();
                
                if (eventName === 'dragenter' || eventName === 'dragover') {
                    this.elements.uploadArea.classList.add('dragover');
                } else {
                    this.elements.uploadArea.classList.remove('dragover');
                }
            }, false);
        });
        
        this.elements.uploadArea.addEventListener('drop', e => this.handleDrop(e));
        this.elements.uploadArea.addEventListener('click', () => this.elements.fileInput.click());
        this.elements.fileInput.addEventListener('change', e => this.handleFiles(e));
    },
    
    setupFeaturedImage() {
        if (!this.elements.featuredImageDropdown) return;
        
        this.elements.featuredImageDropdown.addEventListener('change', () => {
            if (this.elements.featuredImageDropdown.value) {
                this.elements.featuredImageInput.value = this.elements.featuredImageDropdown.value;
                this.updateImagePreview(this.elements.featuredImageDropdown.value);
            }
        });
        
        this.elements.featuredImageInput.addEventListener('input', () => {
            this.updateImagePreview(this.elements.featuredImageInput.value);
        });
    },
    
    initExistingImages() {
        // Якщо вже є зображення у блозі
        if (blogId) {
            // Можна завантажити список існуючих зображень через AJAX
            // fetch(`/admin/blog/${blogId}/images`)
            //     .then(response => response.json())
            //     .then(images => this.processExistingImages(images));
        }
    },
    
    async handleDrop(e) {
        const files = Array.from(e.dataTransfer.files);
        await this.processFiles(files);
    },
    
    async handleFiles(e) {
        const files = Array.from(e.target.files);
        await this.processFiles(files);
        this.elements.fileInput.value = ''; // Очищаємо input
    },
    
    async processFiles(files) {
        if (files.length === 0) return;
        
        for (const file of files) {
            try {
                await this.validateFile(file);
                await this.uploadFile(file);
            } catch (error) {
                Utils.showNotification(error.message, 'error');
            }
        }
    },
    
    validateFile(file) {
        return new Promise((resolve, reject) => {
            // Перевірка типу
            if (!file.type.match('image.*')) {
                reject(new Error(`Файл "${file.name}" не є зображенням`));
                return;
            }
            
            // Перевірка розширення
            const extension = file.name.split('.').pop().toLowerCase();
            if (!CONFIG.validExtensions.includes(extension)) {
                reject(new Error(`Недопустимий формат файлу "${file.name}". Дозволено: ${CONFIG.validExtensions.join(', ')}`));
                return;
            }
            
            // Перевірка розміру
            if (file.size > CONFIG.maxFileSize) {
                reject(new Error(`Файл "${file.name}" занадто великий (макс. ${Utils.formatFileSize(CONFIG.maxFileSize)})`));
                return;
            }
            
            resolve();
        });
    },
    
    async uploadFile(file) {
        console.log('📤 Завантаження файлу:', file.name);
        
        const formData = new FormData();
        formData.append('image', file);
        formData.append('blog_id', blogId || '');
        formData.append('_token', CONFIG.csrfToken);
        
        this.showProgress();
        
        try {
            const response = await fetch(CONFIG.uploadUrl, {
                method: 'POST',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });
            
            if (!response.ok) {
                throw new Error(`HTTP ${response.status}: ${response.statusText}`);
            }
            
            const data = await response.json();
            console.log('✅ Відповідь сервера:', data);
            
            if (data.success) {
                this.addUploadedImage(data.image, file);
                Utils.showNotification(`Зображення "${file.name}" завантажено`, 'success');
                
                // Якщо це перше зображення, пропонуємо зробити його головним
                if (!this.elements.featuredImageInput.value) {
                    this.elements.featuredImageInput.value = data.image.url;
                    this.updateImagePreview(data.image.url);
                }
            } else {
                throw new Error(data.message || 'Невідома помилка');
            }
        } catch (error) {
            console.error('❌ Помилка завантаження:', error);
            Utils.showNotification(`Помилка завантаження "${file.name}": ${error.message}`, 'error');
        } finally {
            this.hideProgress();
        }
    },
    
    showProgress() {
        if (this.elements.progress) {
            this.elements.progress.classList.remove('hidden');
        }
    },
    
    hideProgress() {
        if (this.elements.progress) {
            this.elements.progress.classList.add('hidden');
            if (this.elements.progressBar) {
                this.elements.progressBar.style.width = '0%';
            }
            if (this.elements.progressPercent) {
                this.elements.progressPercent.textContent = '0%';
            }
        }
    },
    
    addUploadedImage(imageData, file) {
        const imageId = imageData.id || 'temp_' + Date.now();
        
        // Створюємо елемент для списку завантажених зображень
        const imageItem = document.createElement('div');
        imageItem.className = 'flex items-center justify-between p-3 bg-gray-50 dark:bg-gray-700/50 rounded-lg border border-gray-200 dark:border-gray-600 animate-slide-in';
        imageItem.innerHTML = `
            <div class="flex items-center space-x-3">
                <img src="${imageData.url}" 
                     alt="${imageData.alt || file.name}" 
                     class="w-10 h-10 object-cover rounded-lg"
                     onerror="this.src='/images/placeholder.png'; this.onerror=null;">
                <div>
                    <p class="text-sm font-medium truncate max-w-[150px] text-gray-900 dark:text-white">
                        ${imageData.alt || file.name}
                    </p>
                    <p class="text-xs text-gray-500 dark:text-gray-400">
                        ${Utils.formatFileSize(file.size)}
                    </p>
                </div>
            </div>
            <button onclick="ImageManager.removeUploadedImage('${imageId}')" 
                    class="text-red-500 hover:text-red-700 p-1.5 rounded-lg hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors duration-300">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
            </button>
        `;
        
        if (this.elements.uploadedImages) {
            this.elements.uploadedImages.appendChild(imageItem);
        }
        
        // Додаємо в dropdown для вибору головного зображення
        if (this.elements.featuredImageDropdown) {
            const option = document.createElement('option');
            option.value = imageData.url;
            option.textContent = imageData.alt || file.name;
            option.dataset.imageId = imageId;
            this.elements.featuredImageDropdown.appendChild(option);
            
            if (this.elements.featuredImageSelect) {
                this.elements.featuredImageSelect.classList.remove('hidden');
            }
        }
        
        // Зберігаємо інформацію про файл
        uploadedFiles.push({
            id: imageId,
            url: imageData.url,
            alt: imageData.alt || file.name,
            size: file.size,
            isTemporary: !imageData.id
        });
        
        this.updateUploadedImageIds();
    },
    
    removeUploadedImage(imageId) {
        const fileIndex = uploadedFiles.findIndex(file => file.id === imageId);
        if (fileIndex === -1) return;
        
        const fileInfo = uploadedFiles[fileIndex];
        
        // Видаляємо з сервера якщо потрібно
        if (!fileInfo.isTemporary && fileInfo.id && blogId) {
            fetch(`/admin/blog/image/${fileInfo.id}/delete`, {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'X-CSRF-Token': CONFIG.csrfToken
                }
            }).catch(console.error);
        }
        
        // Видаляємо локально
        uploadedFiles.splice(fileIndex, 1);
        this.removeImageFromUI(imageId);
        this.updateUploadedImageIds();
        
        Utils.showNotification(`Зображення "${fileInfo.alt}" видалено`, 'success');
    },
    
    removeImageFromUI(imageId) {
        // Видаляємо зі списку завантажених
        document.querySelectorAll('#uploadedImages > div').forEach(item => {
            if (item.querySelector('button').getAttribute('onclick').includes(imageId)) {
                item.remove();
            }
        });
        
        // Видаляємо з dropdown
        if (this.elements.featuredImageDropdown) {
            Array.from(this.elements.featuredImageDropdown.options).forEach(option => {
                if (option.dataset.imageId === imageId) {
                    option.remove();
                }
            });
            
            // Ховаємо dropdown якщо порожній
            if (this.elements.featuredImageSelect && 
                this.elements.featuredImageDropdown.options.length <= 1) {
                this.elements.featuredImageSelect.classList.add('hidden');
            }
        }
        
        // Якщо це було головне зображення - очищаємо
        if (this.elements.featuredImageInput && 
            this.elements.featuredImageInput.value.includes(imageId)) {
            this.clearFeaturedImage();
        }
    },
    
    updateUploadedImageIds() {
        if (!this.elements.uploadedImageIds) return;
        
        const ids = uploadedFiles.map(file => file.id);
        this.elements.uploadedImageIds.value = ids.join(',');
    },
    
    updateImagePreview(url) {
        const preview = document.getElementById('imagePreview');
        const img = document.getElementById('previewImage');
        
        if (url && img) {
            img.src = url;
            preview?.classList.remove('hidden');
        } else if (preview) {
            preview.classList.add('hidden');
        }
    },
    
    clearFeaturedImage() {
        if (this.elements.featuredImageInput) {
            this.elements.featuredImageInput.value = '';
        }
        if (this.elements.featuredImageDropdown) {
            this.elements.featuredImageDropdown.value = '';
        }
        this.updateImagePreview('');
        Utils.showNotification('Головне зображення видалено', 'info');
    }
};

// Form Manager
const FormManager = {
    init() {
        this.setupSlugGeneration();
        this.setupValidation();
        this.setupDatePicker();
        this.addStyles();
    },
    
    setupSlugGeneration() {
        const titleInput = document.getElementById('blog_title');
        const slugInput = document.getElementById('blog_slug');
        
        if (titleInput && slugInput) {
            titleInput.addEventListener('input', function() {
                if (!slugInput.value) {
                    slugInput.value = Utils.generateSlug(this.value.trim());
                }
            });
            
            slugInput.addEventListener('focus', function() {
                if (!this.value && titleInput.value) {
                    this.value = Utils.generateSlug(titleInput.value.trim());
                }
            });
        }
    },
    
    setupValidation() {
        const form = document.querySelector('form');
        if (!form) return;
        
        form.addEventListener('submit', (e) => {
            // Валідація заголовка
            const title = document.getElementById('blog_title')?.value.trim();
            if (!title) {
                e.preventDefault();
                Utils.showNotification('Будь ласка, введіть заголовок блогу', 'error');
                document.getElementById('blog_title')?.focus();
                return false;
            }
            
            // Зберігаємо вміст CKEditor
            if (ckeditor) {
                document.getElementById('blog_content').value = ckeditor.getData();
            }
            
            // Попередження про тимчасові файли
            if (!blogId && uploadedFiles.some(f => f.isTemporary)) {
                const confirmed = confirm(
                    'У вас є тимчасові завантажені зображення. ' +
                    'Після створення блогу їх потрібно буде завантажити знову. ' +
                    'Продовжити?'
                );
                
                if (!confirmed) {
                    e.preventDefault();
                    return false;
                }
            }
            
            // Показуємо індикатор завантаження
            const submitButtons = form.querySelectorAll('button[type="submit"]');
            submitButtons.forEach(btn => {
                btn.disabled = true;
                btn.innerHTML = `
                    <svg class="animate-spin h-5 w-5 mr-2 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    Обробка...
                `;
            });
            
            return true;
        });
    },
    
    setupDatePicker() {
        const dateInput = document.getElementById('blog_publishedAt');
        if (dateInput) {
            flatpickr(dateInput, {
                enableTime: true,
                dateFormat: "Y-m-d H:i",
                time_24hr: true,
                locale: "uk",
                defaultDate: dateInput.value || new Date(),
                minDate: "today",
                onChange: function(selectedDates, dateStr, instance) {
                    // Оновлюємо значення поля
                    dateInput.value = dateStr;
                }
            });
        }
    },
    
    addStyles() {
        // Стилі вже додані в <style> блок
    }
};

// Глобальні функції для виклику з HTML
window.toggleEditorFullscreen = () => EditorManager.toggleFullscreen();
window.addNewTag = () => TagManager.addNewTag();
window.removeTag = (id) => TagManager.removeTag(id);
window.clearFeaturedImage = () => ImageManager.clearFeaturedImage();
window.removeImage = (id) => ImageManager.removeUploadedImage(id);

// Основна ініціалізація
document.addEventListener('DOMContentLoaded', async () => {
    console.log('🚀 Початок ініціалізації форми блогу');
    
    try {
        // Ініціалізація компонентів
        FormManager.init();
        
        if (document.querySelector('#editor')) {
            await EditorManager.init();
        }
        
        if (document.querySelector('#blog_tags')) {
            TagManager.init();
        }
        
        if (document.querySelector('#imageUploadArea')) {
            ImageManager.init();
        }
        
        console.log('✅ Всі компоненти успішно ініціалізовані');
        
        // Показуємо повідомлення при першому завантаженні
        if (!blogId) {
            Utils.showNotification('Заповніть форму для створення нового блогу', 'info');
        }
        
    } catch (error) {
        console.error('❌ Помилка ініціалізації:', error);
        Utils.showNotification('Помилка ініціалізації форми. Будь ласка, оновіть сторінку.', 'error');
    }
});

// Обробка повідомлень від CKEditor
window.addEventListener('message', (event) => {
    if (event.data.type === 'CKEDITOR_READY') {
        console.log('CKEditor готовий');
    }
});
</script>
