{# templates/user/blog/new.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Новий блог{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/@yaireo/tagify/dist/tagify.css" rel="stylesheet" type="text/css" />
    <style>
        .select2-container--default .select2-selection--single {
            height: 42px;
            border: 1px solid #d1d5db;
            border-radius: 0.375rem;
        }
        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 40px;
        }
        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 40px;
        }
        .tagify {
            border: 1px solid #d1d5db;
            border-radius: 0.375rem;
            min-height: 42px;
        }
        .tagify__tag {
            background: #3b82f6;
            color: white;
        }
        .tagify__tag__removeBtn {
            color: white;
        }
        .tagify__input::before {
            color: #6b7280;
        }
        .prose {
            max-width: none;
        }
        .editor-content {
            min-height: 300px;
        }
        .ProseMirror {
            min-height: 300px;
            padding: 1rem;
            border: 1px solid #d1d5db;
            border-radius: 0.375rem;
        }
        .ProseMirror:focus {
            outline: none;
            border-color: #3b82f6;
            ring: 2px;
            ring-color: #3b82f6;
        }
    </style>
{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 py-8">
    <div class="container mx-auto px-4 max-w-6xl">
        <!-- Заголовок -->
        <div class="mb-8">
            <div class="flex items-center gap-3 mb-2">
                <a href="{{ path('user_blog_index') }}" class="text-blue-600 hover:text-blue-800 transition-colors">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <h1 class="text-3xl font-bold text-gray-900">
                    <i class="fas fa-plus text-blue-600 mr-2"></i>Створити новий блог
                </h1>
            </div>
            <p class="text-gray-600">Поділіться своїми думками та досвідом зі спільнотою</p>
        </div>

        <div class="bg-white rounded-2xl shadow-xl overflow-hidden">
            <!-- Картка форми -->
            <div class="p-8">
                {{ form_start(form, {'attr': {'id': 'blog-form', 'class': 'space-y-8'}}) }}
                
                <!-- Заголовок -->
                <div>
                    {{ form_label(form.title, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
                    <div class="relative">
                        {{ form_widget(form.title, {'attr': {
                            'class': 'block w-full px-4 py-3 text-lg border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all',
                            'placeholder': 'Наприклад: Мої враження від подорожі до Карпат'
                        }}) }}
                        <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                            <i class="fas fa-heading text-gray-400"></i>
                        </div>
                    </div>
                    <div class="mt-1 text-sm text-gray-500">
                        Напишіть зрозумілий та привабливий заголовок (5-255 символів)
                    </div>
                    <div class="mt-1 text-sm text-red-600">
                        {{ form_errors(form.title) }}
                    </div>
                </div>
                
                <!-- Короткий опис -->
                <div>
                    {{ form_label(form.excerpt, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
                    {{ form_widget(form.excerpt, {'attr': {
                        'class': 'block w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all',
                        'rows': 3,
                        'placeholder': 'Короткий опис, який відображатиметься в списку блогів...'
                    }}) }}
                    <div class="mt-2 flex justify-between items-center">
                        <div class="text-sm text-gray-500">
                            Максимум 500 символів
                        </div>
                        <div class="flex items-center gap-2">
                            <span id="excerpt-counter" class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                                0/500
                            </span>
                        </div>
                    </div>
                    <div class="mt-1 text-sm text-red-600">
                        {{ form_errors(form.excerpt) }}
                    </div>
                </div>
                
                <!-- Зміст блогу -->
                <div>
                    <div class="flex items-center justify-between mb-3">
                        {{ form_label(form.content, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                        <div class="flex gap-2">
                            <span id="content-counter" class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                0 символів
                            </span>
                            <span id="reading-time" class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                ~ 0 хв
                            </span>
                        </div>
                    </div>
                    
                    <!-- Панель інструментів редактора -->
                    <div class="mb-3 p-3 bg-gray-50 border border-gray-200 rounded-xl flex flex-wrap gap-1">
                        <button type="button" class="px-3 py-2 text-gray-600 hover:text-gray-900 hover:bg-white rounded-lg transition-colors" data-format="bold" title="Жирний">
                            <i class="fas fa-bold"></i>
                        </button>
                        <button type="button" class="px-3 py-2 text-gray-600 hover:text-gray-900 hover:bg-white rounded-lg transition-colors" data-format="italic" title="Курсив">
                            <i class="fas fa-italic"></i>
                        </button>
                        <button type="button" class="px-3 py-2 text-gray-600 hover:text-gray-900 hover:bg-white rounded-lg transition-colors" data-format="underline" title="Підкреслений">
                            <i class="fas fa-underline"></i>
                        </button>
                        <div class="w-px h-6 bg-gray-300 mx-1"></div>
                        <button type="button" class="px-3 py-2 text-gray-600 hover:text-gray-900 hover:bg-white rounded-lg transition-colors" data-format="insertUnorderedList" title="Маркований список">
                            <i class="fas fa-list-ul"></i>
                        </button>
                        <button type="button" class="px-3 py-2 text-gray-600 hover:text-gray-900 hover:bg-white rounded-lg transition-colors" data-format="insertOrderedList" title="Нумерований список">
                            <i class="fas fa-list-ol"></i>
                        </button>
                        <div class="w-px h-6 bg-gray-300 mx-1"></div>
                        <button type="button" class="px-3 py-2 text-gray-600 hover:text-gray-900 hover:bg-white rounded-lg transition-colors" data-format="createLink" title="Посилання">
                            <i class="fas fa-link"></i>
                        </button>
                        <button type="button" class="px-3 py-2 text-gray-600 hover:text-gray-900 hover:bg-white rounded-lg transition-colors" onclick="insertImage()" title="Зображення">
                            <i class="fas fa-image"></i>
                        </button>
                        <div class="w-px h-6 bg-gray-300 mx-1"></div>
                        <button type="button" class="px-3 py-2 text-gray-600 hover:text-gray-900 hover:bg-white rounded-lg transition-colors" data-format="formatBlock" data-block="h2" title="Заголовок 2">
                            H2
                        </button>
                        <button type="button" class="px-3 py-2 text-gray-600 hover:text-gray-900 hover:bg-white rounded-lg transition-colors" data-format="formatBlock" data-block="h3" title="Заголовок 3">
                            H3
                        </button>
                    </div>
                    
                    {{ form_widget(form.content, {'attr': {
                        'class': 'block w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all editor-content prose max-w-none',
                        'rows': 15,
                        'placeholder': 'Почніть писати свій блог тут...'
                    }}) }}
                    <div class="mt-2 text-sm text-gray-500">
                        Мінімум 100 символів. Використовуйте панель інструментів для форматування тексту
                    </div>
                    <div class="mt-1 text-sm text-red-600">
                        {{ form_errors(form.content) }}
                    </div>
                </div>
                
                <!-- Категорія та теги -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Категорія -->
                    <div>
                        {{ form_label(form.category, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
                        {{ form_widget(form.category, {'attr': {
                            'class': 'block w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all appearance-none bg-white'
                        }}) }}
                        <div class="mt-1 text-sm text-red-600">
                            {{ form_errors(form.category) }}
                        </div>
                    </div>
                    
                    <!-- Теги -->
                    <div>
                        {{ form_label(form.tags, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
                        {{ form_widget(form.tags, {'attr': {
                            'class': 'block w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all tags-select',
                            'data-placeholder': 'Виберіть теги або введіть нові...'
                        }}) }}
                        <div class="mt-2 text-sm text-gray-500">
                            Натисніть для вибору або введіть новий тег та натисніть Enter
                        </div>
                        <div class="mt-1 text-sm text-red-600">
                            {{ form_errors(form.tags) }}
                        </div>
                    </div>
                </div>
                
                <!-- Головне зображення -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-3">Головне зображення</label>
                    
                    <!-- Область завантаження -->
                    <div id="featuredImageUpload" class="border-2 border-dashed border-gray-300 rounded-2xl p-8 text-center transition-all hover:border-blue-400 hover:bg-blue-50 cursor-pointer">
                        <div class="flex flex-col items-center">
                            <div class="w-16 h-16 mb-4 flex items-center justify-center rounded-full bg-blue-100">
                                <i class="fas fa-cloud-upload-alt text-2xl text-blue-600"></i>
                            </div>
                            <p class="text-lg font-medium text-gray-700 mb-2">Перетягніть зображення сюди</p>
                            <p class="text-gray-500 mb-4">або</p>
                            <button type="button" onclick="document.getElementById('blog_post_featuredImage').click()" 
                                    class="px-6 py-3 bg-blue-600 text-white font-medium rounded-xl hover:bg-blue-700 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                                <i class="fas fa-folder-open mr-2"></i>Обрати файл
                            </button>
                            <p class="mt-4 text-sm text-gray-500">
                                Дозволені формати: JPG, PNG, GIF, WebP<br>
                                Максимальний розмір: 5MB
                            </p>
                        </div>
                    </div>
                    
                    {{ form_widget(form.featuredImage, {'attr': {
                        'class': 'hidden',
                        'accept': 'image/*'
                    }}) }}
                    
                    <!-- Прев'ю зображення -->
                    <div id="featuredImagePreview" class="hidden mt-6">
                        <div class="flex items-start gap-4">
                            <div class="relative">
                                <img src="" alt="Preview" class="w-48 h-48 object-cover rounded-2xl border-2 border-gray-200">
                                <button type="button" onclick="removeFeaturedImage()" 
                                        class="absolute -top-2 -right-2 w-8 h-8 bg-red-500 text-white rounded-full flex items-center justify-center hover:bg-red-600 transition-colors focus:outline-none focus:ring-2 focus:ring-red-500">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                            <div class="flex-1">
                                <p class="text-sm text-gray-600">Головне зображення буде відображатися як обкладинка блогу</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mt-1 text-sm text-red-600">
                        {{ form_errors(form.featuredImage) }}
                    </div>
                </div>
                
                <!-- Додаткові зображення -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-3">Додаткові зображення</label>
                    
                    <div id="additionalImagesUpload" class="border-2 border-dashed border-gray-300 rounded-2xl p-6 text-center mb-4 transition-all hover:border-gray-400 hover:bg-gray-50 cursor-pointer">
                        <div class="flex flex-col items-center">
                            <div class="w-12 h-12 mb-3 flex items-center justify-center rounded-full bg-gray-100">
                                <i class="fas fa-images text-xl text-gray-600"></i>
                            </div>
                            <p class="text-gray-700 mb-3">Додайте додаткові зображення до вашого блогу</p>
                            <button type="button" onclick="addImageField()" 
                                    class="px-5 py-2.5 bg-gray-200 text-gray-700 font-medium rounded-xl hover:bg-gray-300 transition-colors focus:outline-none focus:ring-2 focus:ring-gray-400">
                                <i class="fas fa-plus mr-2"></i>Додати зображення
                            </button>
                        </div>
                    </div>
                    
                    <!-- Контейнер для додаткових зображень -->
                    <div id="imageCollection" class="space-y-4">
                        <!-- Динамічно додані поля будуть тут -->
                    </div>
                    
                    <!-- Шаблон для нового поля зображення -->
                    <template id="imageTemplate">
                        <div class="image-collection-item bg-gray-50 p-4 rounded-xl border border-gray-200">
                            <div class="flex items-center gap-3 mb-3">
                                <input type="file" 
                                       class="flex-1 px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-medium file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100"
                                       name="blog_post[additionalImages][]" 
                                       accept="image/*">
                                <button type="button" class="remove-field px-4 py-2.5 bg-red-500 text-white rounded-xl hover:bg-red-600 transition-colors focus:outline-none focus:ring-2 focus:ring-red-500">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                            <div class="image-preview-container mt-2"></div>
                        </div>
                    </template>
                </div>
                
                <!-- Налаштування -->
                <div class="bg-gray-50 p-6 rounded-2xl">
                    <div class="flex items-center justify-between">
                        <div>
                            <label class="flex items-center cursor-pointer">
                                <div class="relative">
                                    {{ form_widget(form.isBreaking, {'attr': {
                                        'class': 'sr-only peer'
                                    }}) }}
                                    <div class="w-12 h-6 bg-gray-200 rounded-full peer peer-checked:bg-blue-600 peer-focus:ring-2 peer-focus:ring-blue-300 transition-colors"></div>
                                    <div class="dot absolute left-1 top-1 bg-white w-4 h-4 rounded-full transition-transform peer-checked:translate-x-6"></div>
                                </div>
                                <span class="ml-3 text-sm font-medium text-gray-700">Позначити як важливу новину</span>
                            </label>
                            <p class="mt-1 text-sm text-gray-500">
                                Цей блог буде виділено в списках та на головній сторінці
                            </p>
                        </div>
                    </div>
                </div>
                
                <!-- Кнопки дій -->
                <div class="pt-8 border-t border-gray-200">
                    <div class="flex flex-col sm:flex-row justify-between gap-4">
                        <div class="flex gap-3">
                            <a href="{{ path('user_blog_index') }}" 
                               class="inline-flex items-center px-6 py-3 border border-gray-300 text-gray-700 font-medium rounded-xl hover:bg-gray-50 transition-colors focus:outline-none focus:ring-2 focus:ring-gray-300">
                                <i class="fas fa-arrow-left mr-2"></i>
                                Назад до списку
                            </a>
                        </div>
                        <div class="flex gap-3">
                            <button type="submit" name="submit_type" value="draft" 
                                    class="inline-flex items-center px-6 py-3 bg-gray-600 text-white font-medium rounded-xl hover:bg-gray-700 transition-colors focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2">
                                <i class="fas fa-save mr-2"></i>
                                Зберегти чернетку
                            </button>
                            <button type="submit" name="submit_type" value="moderate" 
                                    class="inline-flex items-center px-6 py-3 bg-blue-600 text-white font-medium rounded-xl hover:bg-blue-700 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                                <i class="fas fa-paper-plane mr-2"></i>
                                Відправити на модерацію
                            </button>
                        </div>
                    </div>
                </div>
                
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@yaireo/tagify/dist/tagify.min.js"></script>
    <script>
        // Ініціалізація Select2 для категорій
        $(document).ready(function() {
            $('.category-select').select2({
                placeholder: 'Виберіть категорію',
                allowClear: true,
                width: '100%',
                theme: 'classic'
            });
            
            // Ініціалізація Tagify для тегів
            const tagsInput = document.querySelector('.tags-select');
            if (tagsInput) {
                const tagify = new Tagify(tagsInput, {
                    whitelist: [],
                    dropdown: {
                        enabled: 0,
                        maxItems: 10,
                        classname: 'tagify__dropdown'
                    },
                    enforceWhitelist: false,
                    editTags: false,
                    maxTags: 10,
                    placeholder: 'Виберіть теги або введіть нові...',
                });
                
                // Завантаження існуючих тегів
                fetch('{{ path("blog_tags_json") }}')
                    .then(response => response.json())
                    .then(data => {
                        tagify.settings.whitelist = data;
                    })
                    .catch(error => console.error('Error loading tags:', error));
            }
            
            // Підрахунок символів для ексепту
            const excerptTextarea = document.getElementById('blog_post_excerpt');
            const excerptCounter = document.getElementById('excerpt-counter');
            
            if (excerptTextarea) {
                excerptTextarea.addEventListener('input', function() {
                    const length = this.value.length;
                    excerptCounter.textContent = length + '/500';
                    
                    if (length > 500) {
                        excerptCounter.classList.remove('bg-gray-100', 'text-gray-800');
                        excerptCounter.classList.add('bg-red-100', 'text-red-800');
                    } else {
                        excerptCounter.classList.remove('bg-red-100', 'text-red-800');
                        excerptCounter.classList.add('bg-gray-100', 'text-gray-800');
                    }
                });
                excerptTextarea.dispatchEvent(new Event('input'));
            }
            
            // Підрахунок символів та часу читання для контенту
            const contentTextarea = document.getElementById('blog_post_content');
            const contentCounter = document.getElementById('content-counter');
            const readingTime = document.getElementById('reading-time');
            
            if (contentTextarea) {
                contentTextarea.addEventListener('input', function() {
                    const length = this.value.length;
                    contentCounter.textContent = length + ' символів';
                    
                    // Зміна кольору в залежності від довжини
                    if (length < 100) {
                        contentCounter.classList.remove('bg-blue-100', 'text-blue-800');
                        contentCounter.classList.add('bg-red-100', 'text-red-800');
                    } else {
                        contentCounter.classList.remove('bg-red-100', 'text-red-800');
                        contentCounter.classList.add('bg-blue-100', 'text-blue-800');
                    }
                    
                    // Розрахунок часу читання (приблизно 200 слів на хвилину)
                    const wordCount = this.value.trim().split(/\s+/).filter(word => word.length > 0).length;
                    const minutes = Math.max(1, Math.ceil(wordCount / 200));
                    readingTime.textContent = '~ ' + minutes + ' хв читання';
                });
                contentTextarea.dispatchEvent(new Event('input'));
            }
        });
        
        // Завантаження зображень
        const featuredImageInput = document.getElementById('blog_post_featuredImage');
        const featuredImagePreview = document.getElementById('featuredImagePreview');
        const featuredImageImg = featuredImagePreview.querySelector('img');
        const uploadArea = document.getElementById('featuredImageUpload');
        
        // Drag and drop для головного зображення
        ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
            uploadArea.addEventListener(eventName, preventDefaults, false);
        });
        
        function preventDefaults(e) {
            e.preventDefault();
            e.stopPropagation();
        }
        
        ['dragenter', 'dragover'].forEach(eventName => {
            uploadArea.addEventListener(eventName, highlight, false);
        });
        
        ['dragleave', 'drop'].forEach(eventName => {
            uploadArea.addEventListener(eventName, unhighlight, false);
        });
        
        function highlight() {
            uploadArea.classList.add('border-blue-400', 'bg-blue-50');
            uploadArea.classList.remove('border-gray-300', 'hover:border-blue-400', 'hover:bg-blue-50');
        }
        
        function unhighlight() {
            uploadArea.classList.remove('border-blue-400', 'bg-blue-50');
            uploadArea.classList.add('border-gray-300', 'hover:border-blue-400', 'hover:bg-blue-50');
        }
        
        uploadArea.addEventListener('drop', handleDrop, false);
        
        function handleDrop(e) {
            const dt = e.dataTransfer;
            const files = dt.files;
            if (files.length > 0) {
                featuredImageInput.files = files;
                handleFeaturedImage(files[0]);
            }
            unhighlight();
        }
        
        featuredImageInput.addEventListener('change', function() {
            if (this.files && this.files[0]) {
                handleFeaturedImage(this.files[0]);
            }
        });
        
        function handleFeaturedImage(file) {
            // Перевірка типу файлу
            const allowedTypes = ['image/jpeg', 'image/png', 'image/gif', 'image/webp'];
            if (!allowedTypes.includes(file.type)) {
                alert('Дозволені тільки зображення (JPEG, PNG, GIF, WebP)');
                return;
            }
            
            // Перевірка розміру
            if (file.size > 5 * 1024 * 1024) {
                alert('Розмір файлу не повинен перевищувати 5MB');
                return;
            }
            
            // Прев'ю
            const reader = new FileReader();
            reader.onload = function(e) {
                featuredImageImg.src = e.target.result;
                uploadArea.classList.add('hidden');
                featuredImagePreview.classList.remove('hidden');
            };
            reader.readAsDataURL(file);
        }
        
        function removeFeaturedImage() {
            featuredImageInput.value = '';
            uploadArea.classList.remove('hidden');
            featuredImagePreview.classList.add('hidden');
            featuredImageImg.src = '';
        }
        
        // Керування додатковими зображеннями
        function addImageField() {
            const template = document.getElementById('imageTemplate');
            const clone = template.content.cloneNode(true);
            const container = document.getElementById('imageCollection');
            container.appendChild(clone);
            
            // Додаємо обробник зміни для прев'ю
            const input = clone.querySelector('.image-input');
            const previewContainer = clone.querySelector('.image-preview-container');
            
            if (input) {
                input.addEventListener('change', function() {
                    if (this.files && this.files[0]) {
                        const file = this.files[0];
                        
                        // Перевірки
                        const allowedTypes = ['image/jpeg', 'image/png', 'image/gif', 'image/webp'];
                        if (!allowedTypes.includes(file.type)) {
                            alert('Дозволені тільки зображення (JPEG, PNG, GIF, WebP)');
                            this.value = '';
                            return;
                        }
                        
                        if (file.size > 5 * 1024 * 1024) {
                            alert('Розмір файлу не повинен перевищувати 5MB');
                            this.value = '';
                            return;
                        }
                        
                        // Створюємо прев'ю
                        const reader = new FileReader();
                        reader.onload = function(e) {
                            const img = document.createElement('img');
                            img.src = e.target.result;
                            img.className = 'w-48 h-48 object-cover rounded-xl border border-gray-200 mt-2';
                            
                            // Очищаємо контейнер та додаємо нове зображення
                            previewContainer.innerHTML = '';
                            previewContainer.appendChild(img);
                        };
                        reader.readAsDataURL(file);
                    }
                });
            }
            
            // Видалення поля
            const removeBtn = clone.querySelector('.remove-field');
            if (removeBtn) {
                removeBtn.addEventListener('click', function() {
                    const item = this.closest('.image-collection-item');
                    if (item) {
                        item.remove();
                    }
                });
            }
        }
        
        // Функції редактора
        function formatText(command, value = null) {
            const contentField = document.getElementById('blog_post_content');
            contentField.focus();
            document.execCommand(command, false, value);
            
            // Тригеримо подію input для підрахунку символів
            const event = new Event('input', { bubbles: true });
            contentField.dispatchEvent(event);
        }
        
        function insertImage() {
            const url = prompt('Введіть URL зображення:');
            if (url) {
                formatText('insertImage', url);
            }
        }
        
        // Ініціалізація кнопок редактора
        document.querySelectorAll('[data-format]').forEach(button => {
            button.addEventListener('click', function() {
                const command = this.getAttribute('data-format');
                const value = this.getAttribute('data-block');
                formatText(command, value);
            });
        });
        
        // Валідація форми
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('blog-form');
            
            form.addEventListener('submit', function(event) {
                if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                    
                    // Додаємо класи для валідації всім полям
                    const fields = form.querySelectorAll('input, select, textarea');
                    fields.forEach(field => {
                        if (!field.checkValidity()) {
                            field.classList.add('border-red-500');
                        }
                    });
                }
            }, false);
            
            // Видаляємо класи помилок при введенні
            form.querySelectorAll('input, select, textarea').forEach(field => {
                field.addEventListener('input', function() {
                    this.classList.remove('border-red-500');
                });
            });
        });
        
        // Обробка drag and drop для додаткових зображень
        const additionalImagesUpload = document.getElementById('additionalImagesUpload');
        
        ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
            additionalImagesUpload.addEventListener(eventName, preventDefaults, false);
        });
        
        ['dragenter', 'dragover'].forEach(eventName => {
            additionalImagesUpload.addEventListener(eventName, function() {
                this.classList.add('border-blue-400', 'bg-blue-50');
            }, false);
        });
        
        ['dragleave', 'drop'].forEach(eventName => {
            additionalImagesUpload.addEventListener(eventName, function() {
                this.classList.remove('border-blue-400', 'bg-blue-50');
            }, false);
        });
        
        additionalImagesUpload.addEventListener('drop', function(e) {
            const dt = e.dataTransfer;
            const files = dt.files;
            
            Array.from(files).forEach(file => {
                // Створюємо поле для кожного файлу
                addImageField();
                
                // Знаходимо останнє додане поле
                const lastField = document.querySelector('#imageCollection .image-collection-item:last-child input');
                if (lastField) {
                    // Створюємо DataTransfer для встановлення файлу
                    const dataTransfer = new DataTransfer();
                    dataTransfer.items.add(file);
                    lastField.files = dataTransfer.files;
                    
                    // Тригеримо подію change
                    const event = new Event('change', { bubbles: true });
                    lastField.dispatchEvent(event);
                }
            });
        }, false);
    </script>
{% endblock %}