{# templates/user/_sidebar.html.twig #}

<!-- User Sidebar Menu -->
<div class="space-y-6" x-data="sidebarMenu()" x-init="init()">
    
    <!-- User Card - без аватарки -->
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg dark:shadow-gray-900/50 p-5 border border-gray-100 dark:border-gray-700 hover:shadow-xl transition-all duration-300">
        <div class="flex items-center gap-4">
            <!-- Ініціали замість аватарки -->
            <div class="relative flex-shrink-0">
                <div class="w-14 h-14 rounded-full bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform duration-300">
                    <span class="text-white font-bold text-xl">{{ app.user.username|first|upper }}</span>
                </div>
                
                <!-- Онлайн статус -->
                <div class="absolute -bottom-0.5 -right-0.5 w-4 h-4 bg-green-500 rounded-full border-2 border-white dark:border-gray-800 animate-pulse"></div>
            </div>
            
            <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2">
                    <h3 class="font-bold text-gray-800 dark:text-white text-base truncate">{{ app.user.username }}</h3>
                    {% if is_granted('ROLE_ADMIN') %}
                        <span class="flex-shrink-0 px-1.5 py-0.5 bg-gradient-to-r from-yellow-400 to-yellow-600 text-white text-[8px] font-bold rounded-full">
                            <i class="fas fa-crown mr-0.5"></i>ADMIN
                        </span>
                    {% elseif is_granted('ROLE_MODERATOR') %}
                        <span class="flex-shrink-0 px-1.5 py-0.5 bg-gradient-to-r from-blue-400 to-blue-600 text-white text-[8px] font-bold rounded-full">
                            <i class="fas fa-shield-alt mr-0.5"></i>MOD
                        </span>
                    {% endif %}
                </div>
                <p class="text-gray-500 dark:text-gray-400 text-xs truncate">{{ app.user.email }}</p>
            </div>
        </div>
        
        <!-- Статистика в рядок -->
        <div class="mt-4 grid grid-cols-3 gap-1.5">
            {% set commentCount = app.user.comments|length %}
            <div class="text-center p-1.5 rounded-lg bg-gray-50 dark:bg-gray-700/50 hover:bg-blue-50 dark:hover:bg-blue-900/20 transition-all duration-300 group cursor-default">
                <div class="text-sm font-bold text-gray-800 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                    {{ commentCount }}
                </div>
                <div class="text-[10px] text-gray-500 dark:text-gray-400">Коментарів</div>
            </div>
            
            {% set blogCount = app.user.blogs|default([])|length %}
            <div class="text-center p-1.5 rounded-lg bg-gray-50 dark:bg-gray-700/50 hover:bg-purple-50 dark:hover:bg-purple-900/20 transition-all duration-300 group cursor-default">
                <div class="text-sm font-bold text-gray-800 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">
                    {{ blogCount }}
                </div>
                <div class="text-[10px] text-gray-500 dark:text-gray-400">Блогів</div>
            </div>
            
            {% set videoCount = app.user.videos|default([])|length %}
            <div class="text-center p-1.5 rounded-lg bg-gray-50 dark:bg-gray-700/50 hover:bg-red-50 dark:hover:bg-red-900/20 transition-all duration-300 group cursor-default">
                <div class="text-sm font-bold text-gray-800 dark:text-white group-hover:text-red-600 dark:group-hover:text-red-400 transition-colors">
                    {{ videoCount }}
                </div>
                <div class="text-[10px] text-gray-500 dark:text-gray-400">Відео</div>
            </div>
        </div>
    </div>
    
    <!-- Navigation Menu -->
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg dark:shadow-gray-900/50 border border-gray-100 dark:border-gray-700 overflow-hidden">
        <nav class="p-2 space-y-0.5">
            <!-- Dashboard -->
            <a href="{{ path('user_dashboard') }}" 
               class="menu-item flex items-center gap-3 px-3 py-2.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-blue-50 dark:hover:bg-blue-900/20 hover:text-blue-600 dark:hover:text-blue-400 rounded-lg transition-all duration-200 {{ app.request.attributes.get('_route') == 'user_dashboard' ? 'bg-blue-50 dark:bg-blue-900/20 text-blue-600 dark:text-blue-400 shadow-sm' : '' }}"
               :class="{ 'scale-105': hover }"
               @mouseenter="hover = true" @mouseleave="hover = false">
                <div class="w-8 h-8 rounded-lg bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-tachometer-alt text-blue-600 dark:text-blue-400"></i>
                </div>
                <span class="flex-1 font-medium">Панель керування</span>
                <span class="text-[10px] px-1.5 py-0.5 bg-gray-100 dark:bg-gray-700 text-gray-500 dark:text-gray-400 rounded-full">Головна</span>
            </a>
            
            <!-- Profile -->
            <a href="{{ path('user_profile') }}" 
               class="menu-item flex items-center gap-3 px-3 py-2.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-blue-50 dark:hover:bg-blue-900/20 hover:text-blue-600 dark:hover:text-blue-400 rounded-lg transition-all duration-200 {{ app.request.attributes.get('_route') == 'user_profile' ? 'bg-blue-50 dark:bg-blue-900/20 text-blue-600 dark:text-blue-400 shadow-sm' : '' }}">
                <div class="w-8 h-8 rounded-lg bg-green-100 dark:bg-green-900/30 flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-user-edit text-green-600 dark:text-green-400"></i>
                </div>
                <span class="flex-1 font-medium">Редагувати профіль</span>
                <i class="fas fa-chevron-right text-gray-400 text-xs opacity-0 group-hover:opacity-100 transition-opacity"></i>
            </a>
            
            <!-- Comments -->
            {% if app.user.comments is defined %}
                <a href="{{ path('user_comments') }}" 
                   class="menu-item flex items-center gap-3 px-3 py-2.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-blue-50 dark:hover:bg-blue-900/20 hover:text-blue-600 dark:hover:text-blue-400 rounded-lg transition-all duration-200 {{ app.request.attributes.get('_route') == 'user_comments' ? 'bg-blue-50 dark:bg-blue-900/20 text-blue-600 dark:text-blue-400 shadow-sm' : '' }}">
                    <div class="w-8 h-8 rounded-lg bg-indigo-100 dark:bg-indigo-900/30 flex items-center justify-center flex-shrink-0">
                        <i class="fas fa-comments text-indigo-600 dark:text-indigo-400"></i>
                    </div>
                    <span class="flex-1 font-medium">Мої коментарі</span>
                    {% set pendingComments = app.user.comments|filter(c => c.isApproved is defined and not c.isApproved) %}
                    {% if pendingComments|length > 0 %}
                        <span class="flex items-center justify-center min-w-[20px] h-5 px-1.5 text-[10px] font-bold bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-400 rounded-full animate-pulse">
                            {{ pendingComments|length }}
                        </span>
                    {% endif %}
                </a>
            {% endif %}
            
            <!-- Favorites -->
            <a href="{{ path('user_favorites') }}" 
               class="menu-item flex items-center gap-3 px-3 py-2.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-blue-50 dark:hover:bg-blue-900/20 hover:text-blue-600 dark:hover:text-blue-400 rounded-lg transition-all duration-200 {{ app.request.attributes.get('_route') == 'user_favorites' ? 'bg-blue-50 dark:bg-blue-900/20 text-blue-600 dark:text-blue-400 shadow-sm' : '' }}">
                <div class="w-8 h-8 rounded-lg bg-red-100 dark:bg-red-900/30 flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-heart text-red-600 dark:text-red-400"></i>
                </div>
                <span class="flex-1 font-medium">Обране</span>
                <span class="flex items-center justify-center min-w-[20px] h-5 px-1.5 text-[10px] font-bold bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400 rounded-full">
                    0
                </span>
            </a>
            
            <!-- Notifications -->
            <a href="{{ path('user_notifications') }}" 
               class="menu-item flex items-center gap-3 px-3 py-2.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-blue-50 dark:hover:bg-blue-900/20 hover:text-blue-600 dark:hover:text-blue-400 rounded-lg transition-all duration-200 {{ app.request.attributes.get('_route') == 'user_notifications' ? 'bg-blue-50 dark:bg-blue-900/20 text-blue-600 dark:text-blue-400 shadow-sm' : '' }}">
                <div class="w-8 h-8 rounded-lg bg-yellow-100 dark:bg-yellow-900/30 flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-bell text-yellow-600 dark:text-yellow-400"></i>
                </div>
                <span class="flex-1 font-medium">Сповіщення</span>
                <span class="flex items-center justify-center min-w-[20px] h-5 px-1.5 text-[10px] font-bold bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-400 rounded-full">
                    0
                </span>
            </a>
            
            <!-- Change Password -->
            <a href="{{ path('user_change_password') }}" 
               class="menu-item flex items-center gap-3 px-3 py-2.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-blue-50 dark:hover:bg-blue-900/20 hover:text-blue-600 dark:hover:text-blue-400 rounded-lg transition-all duration-200 {{ app.request.attributes.get('_route') == 'user_change_password' ? 'bg-blue-50 dark:bg-blue-900/20 text-blue-600 dark:text-blue-400 shadow-sm' : '' }}">
                <div class="w-8 h-8 rounded-lg bg-orange-100 dark:bg-orange-900/30 flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-key text-orange-600 dark:text-orange-400"></i>
                </div>
                <span class="flex-1 font-medium">Змінити пароль</span>
            </a>
            
            <!-- My Videos -->
            <a href="{{ path('user_video_index') }}" 
               class="menu-item flex items-center gap-3 px-3 py-2.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-blue-50 dark:hover:bg-blue-900/20 hover:text-blue-600 dark:hover:text-blue-400 rounded-lg transition-all duration-200 {{ app.request.attributes.get('_route') starts with 'user_video' ? 'bg-blue-50 dark:bg-blue-900/20 text-blue-600 dark:text-blue-400 shadow-sm' : '' }}">
                <div class="w-8 h-8 rounded-lg bg-red-100 dark:bg-red-900/30 flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-video text-red-600 dark:text-red-400"></i>
                </div>
                <div class="flex-1">
                    <span class="font-medium">Мої відео</span>
                    <p class="text-[10px] text-gray-400 dark:text-gray-500">Керування відео</p>
                </div>
                {% if videoCount > 0 %}
                    <span class="flex items-center justify-center min-w-[20px] h-5 px-1.5 text-[10px] font-bold bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400 rounded-full">
                        {{ videoCount }}
                    </span>
                {% endif %}
            </a>

            <!-- Articles Dropdown -->
            <div class="relative" x-data="{ open: false }">
                <button @click="open = !open" 
                        class="w-full flex items-center gap-3 px-3 py-2.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-blue-50 dark:hover:bg-blue-900/20 hover:text-blue-600 dark:hover:text-blue-400 rounded-lg transition-all duration-200 {{ app.request.attributes.get('_route') starts with 'user_article' ? 'bg-blue-50 dark:bg-blue-900/20 text-blue-600 dark:text-blue-400 shadow-sm' : '' }}">
                    <div class="w-8 h-8 rounded-lg bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center flex-shrink-0">
                        <i class="fas fa-newspaper text-blue-600 dark:text-blue-400"></i>
                    </div>
                    <span class="flex-1 text-left font-medium">Мої новини</span>
                    {% set articleCount = app.user.articles|default([])|length %}
                    {% if articleCount > 0 %}
                        <span class="flex items-center justify-center min-w-[20px] h-5 px-1.5 text-[10px] font-bold bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-400 rounded-full mr-1">
                            {{ articleCount }}
                        </span>
                    {% endif %}
                    <i class="fas fa-chevron-down text-[10px] text-gray-400 transition-transform duration-200" 
                       :class="{ 'rotate-180': open }"></i>
                </button>
                
                <!-- Dropdown Menu -->
                <div x-show="open" 
                     @click.away="open = false"
                     x-transition:enter="transition ease-out duration-200"
                     x-transition:enter-start="opacity-0 scale-95"
                     x-transition:enter-end="opacity-100 scale-100"
                     x-transition:leave="transition ease-in duration-150"
                     x-transition:leave-start="opacity-100 scale-100"
                     x-transition:leave-end="opacity-0 scale-95"
                     class="mt-1 ml-11 bg-gray-50 dark:bg-gray-700/50 rounded-lg border border-gray-200 dark:border-gray-600 py-1 z-10">
                    <a href="{{ path('user_articles') }}" 
                       class="flex items-center gap-2 px-3 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-blue-50 dark:hover:bg-gray-600 hover:text-blue-600 dark:hover:text-blue-400 rounded transition-colors">
                        <i class="fas fa-list text-gray-400 w-4 text-center"></i>
                        Всі новини
                    </a>
                    <a href="{{ path('user_article_new') }}" 
                       class="flex items-center gap-2 px-3 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-blue-50 dark:hover:bg-gray-600 hover:text-blue-600 dark:hover:text-blue-400 rounded transition-colors">
                        <i class="fas fa-plus text-green-400 w-4 text-center"></i>
                        Написати новину
                    </a>
                    <div class="border-t border-gray-200 dark:border-gray-600 my-1"></div>
                    <a href="{{ path('user_articles') }}?status=draft" 
                       class="flex items-center gap-2 px-3 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-blue-50 dark:hover:bg-gray-600 hover:text-blue-600 dark:hover:text-blue-400 rounded transition-colors">
                        <i class="fas fa-pencil-alt text-yellow-400 w-4 text-center"></i>
                        Чернетки
                    </a>
                    <a href="{{ path('user_articles') }}?status=pending" 
                       class="flex items-center gap-2 px-3 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-blue-50 dark:hover:bg-gray-600 hover:text-blue-600 dark:hover:text-blue-400 rounded transition-colors">
                        <i class="fas fa-clock text-orange-400 w-4 text-center"></i>
                        На модерації
                    </a>
                    <a href="{{ path('user_articles') }}?status=published" 
                       class="flex items-center gap-2 px-3 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-blue-50 dark:hover:bg-gray-600 hover:text-blue-600 dark:hover:text-blue-400 rounded transition-colors">
                        <i class="fas fa-check-circle text-green-400 w-4 text-center"></i>
                        Опубліковані
                    </a>
                </div>
            </div>
            
            <!-- Blogs Dropdown -->
            <div class="relative" x-data="{ open: false }">
                <button @click="open = !open" 
                        class="w-full flex items-center gap-3 px-3 py-2.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-blue-50 dark:hover:bg-blue-900/20 hover:text-blue-600 dark:hover:text-blue-400 rounded-lg transition-all duration-200 {{ app.request.attributes.get('_route') starts with 'user_blog' ? 'bg-blue-50 dark:bg-blue-900/20 text-blue-600 dark:text-blue-400 shadow-sm' : '' }}">
                    <div class="w-8 h-8 rounded-lg bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center flex-shrink-0">
                        <i class="fas fa-blog text-purple-600 dark:text-purple-400"></i>
                    </div>
                    <span class="flex-1 text-left font-medium">Мої блоги</span>
                    {% if blogCount > 0 %}
                        <span class="flex items-center justify-center min-w-[20px] h-5 px-1.5 text-[10px] font-bold bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-400 rounded-full mr-1">
                            {{ blogCount }}
                        </span>
                    {% endif %}
                    <i class="fas fa-chevron-down text-[10px] text-gray-400 transition-transform duration-200" 
                       :class="{ 'rotate-180': open }"></i>
                </button>
                
                <!-- Dropdown Menu -->
                <div x-show="open" 
                     @click.away="open = false"
                     x-transition:enter="transition ease-out duration-200"
                     x-transition:enter-start="opacity-0 scale-95"
                     x-transition:enter-end="opacity-100 scale-100"
                     x-transition:leave="transition ease-in duration-150"
                     x-transition:leave-start="opacity-100 scale-100"
                     x-transition:leave-end="opacity-0 scale-95"
                     class="mt-1 ml-11 bg-gray-50 dark:bg-gray-700/50 rounded-lg border border-gray-200 dark:border-gray-600 py-1 z-10">
                    <a href="{{ path('user_blog_index') }}" 
                       class="flex items-center gap-2 px-3 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-blue-50 dark:hover:bg-gray-600 hover:text-blue-600 dark:hover:text-blue-400 rounded transition-colors">
                        <i class="fas fa-list text-gray-400 w-4 text-center"></i>
                        Всі блоги
                    </a>
                    <a href="{{ path('user_blog_new') }}" 
                       class="flex items-center gap-2 px-3 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-blue-50 dark:hover:bg-gray-600 hover:text-blue-600 dark:hover:text-blue-400 rounded transition-colors">
                        <i class="fas fa-plus text-green-400 w-4 text-center"></i>
                        Написати блог
                    </a>
                    <div class="border-t border-gray-200 dark:border-gray-600 my-1"></div>
                    <a href="{{ path('user_blog_drafts') }}" 
                       class="flex items-center gap-2 px-3 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-blue-50 dark:hover:bg-gray-600 hover:text-blue-600 dark:hover:text-blue-400 rounded transition-colors">
                        <i class="fas fa-pencil-alt text-yellow-400 w-4 text-center"></i>
                        Чернетки
                    </a>
                    <a href="{{ path('user_blog_pending') }}" 
                       class="flex items-center gap-2 px-3 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-blue-50 dark:hover:bg-gray-600 hover:text-blue-600 dark:hover:text-blue-400 rounded transition-colors">
                        <i class="fas fa-clock text-orange-400 w-4 text-center"></i>
                        На модерації
                    </a>
                    <a href="{{ path('user_blog_published') }}" 
                       class="flex items-center gap-2 px-3 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-blue-50 dark:hover:bg-gray-600 hover:text-blue-600 dark:hover:text-blue-400 rounded transition-colors">
                        <i class="fas fa-check-circle text-green-400 w-4 text-center"></i>
                        Опубліковані
                    </a>
                    <a href="{{ path('user_blog_rejected') }}" 
                       class="flex items-center gap-2 px-3 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-blue-50 dark:hover:bg-gray-600 hover:text-blue-600 dark:hover:text-blue-400 rounded transition-colors">
                        <i class="fas fa-times-circle text-red-400 w-4 text-center"></i>
                        Відхилені
                    </a>
                </div>
            </div>
            
            <!-- Moderator Section -->
            {% if is_granted('ROLE_MODERATOR') and not is_granted('ROLE_ADMIN') %}
                <div class="border-t border-gray-200 dark:border-gray-700 my-2 pt-2">
                    <p class="px-3 text-[10px] font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider mb-1 flex items-center gap-1">
                        <i class="fas fa-shield-alt text-blue-400"></i>Модерація
                    </p>
                    <a href="{{ path('moderation_dashboard') }}" 
                       class="flex items-center gap-3 px-3 py-2.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-blue-50 dark:hover:bg-blue-900/20 hover:text-blue-600 dark:hover:text-blue-400 rounded-lg transition-all duration-200">
                        <div class="w-8 h-8 rounded-lg bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-check-double text-blue-600 dark:text-blue-400"></i>
                        </div>
                        <span class="flex-1 font-medium">Панель модератора</span>
                    </a>
                </div>
            {% endif %}
            
            <!-- Logout -->
            <div class="border-t border-gray-200 dark:border-gray-700 my-2 pt-2">
                <a href="{{ path('app_logout') }}" 
                   class="flex items-center gap-3 px-3 py-2.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-red-50 dark:hover:bg-red-900/20 hover:text-red-600 dark:hover:text-red-400 rounded-lg transition-all duration-200 group">
                    <div class="w-8 h-8 rounded-lg bg-gray-100 dark:bg-gray-700 flex items-center justify-center flex-shrink-0 group-hover:bg-red-100 dark:group-hover:bg-red-900/30 transition-colors">
                        <i class="fas fa-sign-out-alt text-gray-500 dark:text-gray-400 group-hover:text-red-600 dark:group-hover:text-red-400 transition-colors"></i>
                    </div>
                    <span class="flex-1 font-medium">Вийти</span>
                    <i class="fas fa-arrow-right text-gray-400 text-xs opacity-0 group-hover:opacity-100 transition-opacity group-hover:translate-x-1 transform"></i>
                </a>
            </div>
        </nav>
    </div>
    
    <!-- Stats Card -->
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg dark:shadow-gray-900/50 p-4 border border-gray-100 dark:border-gray-700 hover:shadow-xl transition-all duration-300">
        <h3 class="font-semibold text-gray-800 dark:text-white mb-3 flex items-center gap-2 text-sm">
            <i class="fas fa-chart-pie text-blue-500"></i>
            <span>Статистика</span>
        </h3>
        
        <div class="space-y-3">
            <!-- Comments Stats -->
            {% if app.user.comments is defined %}
                {% set totalComments = app.user.comments|length %}
                {% set approvedComments = app.user.comments|filter(c => c.isApproved is defined and c.isApproved)|length %}
                {% set pendingComments = totalComments - approvedComments %}
                
                <div>
                    <div class="flex justify-between items-center text-sm mb-1">
                        <span class="text-gray-600 dark:text-gray-400">Коментарі</span>
                        <span class="font-semibold text-gray-800 dark:text-white">{{ totalComments }}</span>
                    </div>
                    <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-1.5 overflow-hidden">
                        {% if totalComments > 0 %}
                            <div class="bg-gradient-to-r from-blue-500 to-purple-600 h-1.5 rounded-full transition-all duration-1000" 
                                 style="width: {{ (approvedComments / totalComments) * 100 }}%"></div>
                        {% endif %}
                    </div>
                    <div class="flex justify-between text-[10px] mt-1">
                        <span class="text-green-600 dark:text-green-400">
                            <i class="fas fa-check-circle mr-0.5"></i>{{ approvedComments }} схвалено
                        </span>
                        <span class="text-yellow-600 dark:text-yellow-400">
                            <i class="fas fa-clock mr-0.5"></i>{{ pendingComments }} в черзі
                        </span>
                    </div>
                </div>
            {% endif %}
            
            <!-- Blogs Stats -->
            {% set blogs = app.user.blogs|default([]) %}
            {% set totalBlogs = blogs|length %}
            {% if totalBlogs > 0 %}
                {% set publishedBlogs = blogs|filter(b => b.status is defined and b.status == 'published')|length %}
                {% set draftBlogs = blogs|filter(b => b.status is defined and b.status == 'draft')|length %}
                {% set pendingBlogs = blogs|filter(b => b.status is defined and b.status == 'pending')|length %}
                
                <div class="border-t border-gray-200 dark:border-gray-700 pt-2">
                    <div class="flex justify-between items-center text-sm mb-1">
                        <span class="text-gray-600 dark:text-gray-400">Блоги</span>
                        <span class="font-semibold text-gray-800 dark:text-white">{{ totalBlogs }}</span>
                    </div>
                    <div class="grid grid-cols-3 gap-1 text-center text-[10px]">
                        <div class="bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 p-1 rounded">
                            <i class="fas fa-check-circle mr-0.5"></i>{{ publishedBlogs }}
                        </div>
                        <div class="bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-400 p-1 rounded">
                            <i class="fas fa-clock mr-0.5"></i>{{ pendingBlogs }}
                        </div>
                        <div class="bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-400 p-1 rounded">
                            <i class="fas fa-pencil-alt mr-0.5"></i>{{ draftBlogs }}
                        </div>
                    </div>
                </div>
            {% endif %}
            
            <!-- Videos Stats -->
            {% set videos = app.user.videos|default([]) %}
            {% set totalVideos = videos|length %}
            {% if totalVideos > 0 %}
                {% set publishedVideos = videos|filter(v => v.isPublished)|length %}
                {% set totalViews = videos|reduce((carry, v) => carry + v.views, 0) %}
                
                <div class="border-t border-gray-200 dark:border-gray-700 pt-2">
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-gray-600 dark:text-gray-400">
                            <i class="fas fa-video mr-1 text-red-500"></i>Відео
                        </span>
                        <span class="font-semibold text-gray-800 dark:text-white">{{ totalVideos }}</span>
                    </div>
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-gray-600 dark:text-gray-400">
                            <i class="fas fa-eye mr-1 text-blue-500"></i>Переглядів
                        </span>
                        <span class="font-semibold text-gray-800 dark:text-white">{{ totalViews|number_format }}</span>
                    </div>
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-gray-600 dark:text-gray-400">
                            <i class="fas fa-check-circle mr-1 text-green-500"></i>Опубліковано
                        </span>
                        <span class="font-semibold text-green-600 dark:text-green-400">{{ publishedVideos }}</span>
                    </div>
                </div>
            {% endif %}
            
            <!-- Registration Date -->
            <div class="border-t border-gray-200 dark:border-gray-700 pt-2">
                <div class="flex justify-between items-center text-sm">
                    <span class="text-gray-600 dark:text-gray-400">
                        <i class="fas fa-calendar-alt mr-1 text-purple-500"></i>На сайті з
                    </span>
                    {% if app.user.createdAt is defined and app.user.createdAt %}
                        <span class="font-semibold text-gray-800 dark:text-white">{{ app.user.createdAt|date('d.m.Y') }}</span>
                    {% else %}
                        <span class="font-semibold text-gray-800 dark:text-white">-</span>
                    {% endif %}
                </div>
            </div>
            
            <!-- Last Login -->
            {% if app.user.lastLoginAt is defined and app.user.lastLoginAt %}
                <div class="flex justify-between items-center text-sm">
                    <span class="text-gray-600 dark:text-gray-400">
                        <i class="fas fa-clock mr-1 text-blue-500"></i>Останній вхід
                    </span>
                    <span class="font-semibold text-gray-800 dark:text-white">{{ app.user.lastLoginAt|date('d.m.Y H:i') }}</span>
                </div>
            {% endif %}
        </div>
    </div>
    
    <!-- Tips Card -->
    <div class="bg-gradient-to-br from-blue-500 to-purple-600 rounded-xl shadow-lg p-4 text-white hover:shadow-xl transition-all duration-300 hover:scale-[1.02] cursor-default">
        <div class="flex items-start gap-3">
            <div class="w-8 h-8 bg-white/20 rounded-lg flex items-center justify-center flex-shrink-0 animate-pulse">
                <i class="fas fa-lightbulb text-yellow-300"></i>
            </div>
            <div>
                <h4 class="font-semibold text-sm mb-1">💡 Порада дня</h4>
                <p class="text-xs text-white/90 leading-relaxed">
                    Додайте відео до свого профілю, щоб поділитися цікавим контентом зі спільнотою!
                </p>
                <a href="{{ path('user_video_new') }}" 
                   class="inline-flex items-center gap-1 mt-2 text-xs bg-white/20 hover:bg-white/30 px-3 py-1.5 rounded-lg transition-all duration-300 hover:scale-105">
                    <span>Додати відео</span>
                    <i class="fas fa-arrow-right text-xs"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<script>
function sidebarMenu() {
    return {
        hover: false,
        init() {
            // Анімація появи елементів меню
            this.$nextTick(() => {
                const items = this.$el.querySelectorAll('.menu-item');
                items.forEach((item, index) => {
                    item.style.opacity = '0';
                    item.style.transform = 'translateX(-10px)';
                    setTimeout(() => {
                        item.style.transition = 'all 0.3s cubic-bezier(0.4, 0, 0.2, 1)';
                        item.style.opacity = '1';
                        item.style.transform = 'translateX(0)';
                    }, 50 * (index + 1));
                });
            });
        }
    };
}
</script>

<style>
.menu-item {
    position: relative;
    overflow: hidden;
}

.menu-item::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.1), transparent);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
}

.menu-item:hover::after {
    opacity: 1;
}

.menu-item .fas.fa-chevron-right {
    transition: all 0.3s ease;
}

.menu-item:hover .fas.fa-chevron-right {
    transform: translateX(2px);
}
</style>