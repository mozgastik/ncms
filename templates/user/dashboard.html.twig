{% extends 'base.html.twig' %}

{% block title %}Панель користувача - Новинний портал{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    /* Анімації для карток */
    .stat-card {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        cursor: default;
        position: relative;
        overflow: hidden;
    }
    .stat-card::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(255,255,255,0.1), transparent);
        opacity: 0;
        transition: opacity 0.3s ease;
    }
    .stat-card:hover::before {
        opacity: 1;
    }
    .stat-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 24px -8px rgba(0, 0, 0, 0.15);
    }
    
    .stat-card .stat-icon {
        transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .stat-card:hover .stat-icon {
        transform: scale(1.1) rotate(-5deg);
    }
    
    .stat-number {
        transition: all 0.3s ease;
    }
    .stat-card:hover .stat-number {
        transform: scale(1.05);
    }
    
    /* Анімація для швидких дій */
    .quick-action {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        cursor: pointer;
    }
    .quick-action:hover {
        transform: translateY(-4px) scale(1.02);
        box-shadow: 0 8px 16px -4px rgba(0, 0, 0, 0.1);
    }
    .quick-action .action-icon {
        transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .quick-action:hover .action-icon {
        transform: scale(1.1) rotate(-10deg);
    }
    
    /* Коментарі */
    .comment-item {
        transition: all 0.3s ease;
        animation: slideIn 0.5s ease-out forwards;
        opacity: 0;
        transform: translateY(10px);
    }
    .comment-item:nth-child(1) { animation-delay: 0.1s; }
    .comment-item:nth-child(2) { animation-delay: 0.2s; }
    .comment-item:nth-child(3) { animation-delay: 0.3s; }
    .comment-item:nth-child(4) { animation-delay: 0.4s; }
    .comment-item:nth-child(5) { animation-delay: 0.5s; }
    
    .comment-item:hover {
        transform: translateX(4px);
        background-color: rgba(59, 130, 246, 0.05);
    }
    
    @keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    @keyframes pulse-ring {
        0% { transform: scale(1); opacity: 0.7; }
        50% { transform: scale(1.05); opacity: 0.3; }
        100% { transform: scale(1); opacity: 0.7; }
    }
    
    .status-pulse {
        animation: pulse-ring 2s ease-in-out infinite;
    }
    
    /* Welcome badge */
    .welcome-badge {
        background: linear-gradient(135deg, #3b82f6, #8b5cf6);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    
    /* Avatar glow */
    .avatar-glow {
        position: relative;
    }
    .avatar-glow::after {
        content: '';
        position: absolute;
        inset: -3px;
        border-radius: 50%;
        background: linear-gradient(135deg, #3b82f6, #8b5cf6, #ec4899);
        opacity: 0.6;
        z-index: -1;
        filter: blur(8px);
        transition: all 0.5s ease;
    }
    .avatar-glow:hover::after {
        opacity: 1;
        filter: blur(12px);
        transform: scale(1.1);
    }
    
    /* Progress bars */
    .stat-progress {
        height: 3px;
        border-radius: 2px;
        background: #e5e7eb;
        overflow: hidden;
        margin-top: 8px;
    }
    .dark .stat-progress {
        background: #374151;
    }
    .stat-progress-bar {
        height: 100%;
        border-radius: 2px;
        transition: width 1s ease;
        background: linear-gradient(90deg, #3b82f6, #8b5cf6);
    }
    
    /* Dark mode fixes for comments */
    .dark .comment-item {
        background-color: rgba(31, 41, 55, 0.5) !important;
        border-color: rgba(55, 65, 81, 0.8) !important;
    }
    .dark .comment-item:hover {
        background-color: rgba(55, 65, 81, 0.5) !important;
    }
    .dark .comment-item .text-gray-700 {
        color: #d1d5db !important;
    }
    .dark .comment-item .text-gray-500 {
        color: #9ca3af !important;
    }
    .dark .comment-item .bg-gray-50 {
        background-color: rgba(31, 41, 55, 0.3) !important;
    }
    .dark .comment-item .border-gray-200 {
        border-color: rgba(55, 65, 81, 0.6) !important;
    }
    
    /* Quick actions dark mode */
    .dark .quick-action {
        background-color: rgba(31, 41, 55, 0.8) !important;
        border-color: rgba(55, 65, 81, 0.8) !important;
    }
    .dark .quick-action:hover {
        background-color: rgba(55, 65, 81, 0.6) !important;
    }
    
    /* Stats cards dark mode improvements */
    .dark .stat-card.bg-blue-50 {
        background-color: rgba(30, 58, 138, 0.2) !important;
    }
    .dark .stat-card.bg-green-50 {
        background-color: rgba(6, 78, 59, 0.2) !important;
    }
    .dark .stat-card.bg-yellow-50 {
        background-color: rgba(113, 63, 18, 0.2) !important;
    }
    .dark .stat-card.bg-red-50 {
        background-color: rgba(127, 29, 29, 0.2) !important;
    }
</style>
{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 dark:bg-gray-900 py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
        <div class="flex flex-col lg:flex-row gap-8">
            
            <!-- Sidebar Menu -->
            <div class="lg:w-1/4">
                {{ include('user/_sidebar.html.twig') }}
            </div>
            
            <!-- Main Content -->
            <div class="lg:w-3/4">
                <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-6 md:p-8">
                    
                    <!-- ======================== -->
                    <!-- ЗАГОЛОВОК ПРОФІЛЮ -->
                    <!-- ======================== -->
                    <div class="flex flex-col md:flex-row items-start md:items-center justify-between mb-6 pb-6 border-b border-gray-200 dark:border-gray-700">
                        <div class="flex items-center gap-4 w-full md:w-auto">
                            <!-- Avatar -->
                            <div class="avatar-glow flex-shrink-0">
                                <div class="w-16 h-16 md:w-20 md:h-20 rounded-full bg-gradient-to-br from-blue-500 to-purple-600 p-0.5">
                                    <div class="w-full h-full rounded-full bg-white dark:bg-gray-800 overflow-hidden">
                                        {% if app.user.avatar %}
                                            <img src="{{ asset('uploads/avatars/' ~ app.user.avatar) }}" 
                                                 alt="{{ app.user.username }}" 
                                                 class="w-full h-full object-cover">
                                        {% else %}
                                            <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-blue-500 to-purple-600">
                                                <span class="text-white font-bold text-2xl">{{ app.user.username|first|upper }}</span>
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                                <div class="absolute -bottom-1 -right-1 w-5 h-5 bg-green-500 rounded-full border-2 border-white dark:border-gray-800 flex items-center justify-center">
                                    <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                                    </svg>
                                </div>
                            </div>
                            
                            <div>
                                <h1 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white welcome-badge">
                                    Вітаємо, {{ app.user.username }}!
                                </h1>
                                <p class="text-gray-600 dark:text-gray-400 mt-1 flex items-center gap-2 text-sm">
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-green-100 dark:bg-green-900/30 text-green-600 dark:text-green-400 rounded-full text-xs">
                                        <span class="w-1.5 h-1.5 bg-green-500 rounded-full animate-pulse"></span>
                                        Онлайн
                                    </span>
                                    <span>•</span>
                                    <span>На сайті з {{ app.user.createdAt|date('d.m.Y') }}</span>
                                </p>
                            </div>
                        </div>
                        
                        <div class="flex gap-2 mt-4 md:mt-0">
                            <a href="{{ path('user_profile') }}" 
                               class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-all duration-300 text-sm hover:scale-105 shadow-md">
                                <i class="fas fa-user-edit"></i>
                                <span>Редагувати</span>
                            </a>
                        </div>
                    </div>
                    
                    <!-- ======================== -->
                    <!-- STATS CARDS -->
                    <!-- ======================== -->
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
                        {% set stats = {
                            'comments': {
                                'count': user.comments|length,
                                'label': 'Коментарів',
                                'icon': 'fa-comment',
                                'color': 'blue'
                            },
                            'approved': {
                                'count': user.comments|filter(c => c.isApproved)|length,
                                'label': 'Схвалено',
                                'icon': 'fa-check-circle',
                                'color': 'green'
                            },
                            'pending': {
                                'count': user.comments|filter(c => not c.isApproved)|length,
                                'label': 'В черзі',
                                'icon': 'fa-clock',
                                'color': 'yellow'
                            },
                            'likes': {
                                'count': user.comments|reduce((carry, c) => carry + c.likes|length, 0),
                                'label': 'Вподобань',
                                'icon': 'fa-heart',
                                'color': 'red'
                            }
                        } %}
                        
                        {% for key, stat in stats %}
                            <div class="stat-card rounded-xl p-5 border border-{{ stat.color }}-100 dark:border-{{ stat.color }}-800 bg-{{ stat.color }}-50 dark:bg-{{ stat.color }}-900/20">
                                <div class="flex items-center justify-between">
                                    <div>
                                        <p class="text-sm text-{{ stat.color }}-600 dark:text-{{ stat.color }}-400 font-medium">
                                            {{ stat.label }}
                                        </p>
                                        <p class="stat-number text-2xl font-bold text-gray-800 dark:text-white mt-1" 
                                           x-data="{ count: 0 }" 
                                           x-init="
                                               let target = {{ stat.count }};
                                               let interval = setInterval(() => {
                                                   if (count < target) {
                                                       count += Math.ceil(target / 20);
                                                       if (count > target) count = target;
                                                   } else {
                                                       clearInterval(interval);
                                                   }
                                               }, 50);
                                           "
                                           x-text="count">
                                            0
                                        </p>
                                    </div>
                                    <div class="stat-icon w-12 h-12 rounded-xl bg-{{ stat.color }}-100 dark:bg-{{ stat.color }}-800 flex items-center justify-center">
                                        <i class="fas {{ stat.icon }} text-{{ stat.color }}-600 dark:text-{{ stat.color }}-400 text-xl"></i>
                                    </div>
                                </div>
                                <div class="stat-progress">
                                    <div class="stat-progress-bar" style="width: {{ (stat.count / 100 * 100)|min(100) }}%"></div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                    
                    <!-- ======================== -->
                    <!-- ДОДАТКОВІ СТАТИСТИКИ -->
                    <!-- ======================== -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
                        <div class="bg-gradient-to-br from-purple-50 to-indigo-50 dark:from-purple-900/20 dark:to-indigo-900/20 rounded-xl p-6 border border-purple-100 dark:border-purple-800">
                            <div class="flex items-center justify-between mb-3">
                                <div>
                                    <p class="text-sm text-purple-600 dark:text-purple-400 font-medium">Мої блоги</p>
                                    <p class="text-2xl font-bold text-gray-800 dark:text-white mt-1">{{ user.blogs|default([])|length }}</p>
                                </div>
                                <div class="w-12 h-12 rounded-xl bg-purple-100 dark:bg-purple-800 flex items-center justify-center">
                                    <i class="fas fa-pen-fancy text-purple-600 dark:text-purple-400 text-xl"></i>
                                </div>
                            </div>
                            <div class="flex flex-wrap gap-2">
                                <a href="{{ path('user_blog_index') }}" 
                                   class="inline-flex items-center gap-1 px-3 py-1.5 bg-purple-600 hover:bg-purple-700 text-white text-xs rounded-lg transition-all duration-300 hover:scale-105">
                                    <i class="fas fa-list"></i>
                                    Всі блоги
                                </a>
                                <a href="{{ path('user_blog_new') }}" 
                                   class="inline-flex items-center gap-1 px-3 py-1.5 bg-green-600 hover:bg-green-700 text-white text-xs rounded-lg transition-all duration-300 hover:scale-105">
                                    <i class="fas fa-plus"></i>
                                    Новий
                                </a>
                            </div>
                        </div>
                        
                        <div class="bg-gradient-to-br from-red-50 to-orange-50 dark:from-red-900/20 dark:to-orange-900/20 rounded-xl p-6 border border-red-100 dark:border-red-800">
                            <div class="flex items-center justify-between mb-3">
                                <div>
                                    <p class="text-sm text-red-600 dark:text-red-400 font-medium">Мої відео</p>
                                    <p class="text-2xl font-bold text-gray-800 dark:text-white mt-1">{{ user.videos|default([])|length }}</p>
                                </div>
                                <div class="w-12 h-12 rounded-xl bg-red-100 dark:bg-red-800 flex items-center justify-center">
                                    <i class="fas fa-video text-red-600 dark:text-red-400 text-xl"></i>
                                </div>
                            </div>
                            <p class="text-xs text-gray-500 dark:text-gray-400 mb-3">
                                <i class="fas fa-eye mr-1"></i> 
                                {{ user.videos|reduce((carry, v) => carry + v.views, 0) }} переглядів
                            </p>
                            <div class="flex flex-wrap gap-2">
                                <a href="{{ path('user_video_index') }}" 
                                   class="inline-flex items-center gap-1 px-3 py-1.5 bg-red-600 hover:bg-red-700 text-white text-xs rounded-lg transition-all duration-300 hover:scale-105">
                                    <i class="fas fa-list"></i>
                                    Всі відео
                                </a>
                                <a href="{{ path('user_video_new') }}" 
                                   class="inline-flex items-center gap-1 px-3 py-1.5 bg-green-600 hover:bg-green-700 text-white text-xs rounded-lg transition-all duration-300 hover:scale-105">
                                    <i class="fas fa-plus"></i>
                                    Додати
                                </a>
                            </div>
                        </div>
                    </div>
                    
                    <!-- ======================== -->
                    <!-- ОСТАННІ КОМЕНТАРІ -->
                    <!-- ======================== -->
                    <div class="mb-8">
                        <div class="flex items-center justify-between mb-4">
                            <h2 class="text-lg font-semibold text-gray-900 dark:text-white flex items-center gap-2">
                                <i class="fas fa-history text-blue-500"></i>
                                Останні коментарі
                                <span class="ml-2 px-2 py-0.5 text-xs bg-gray-200 dark:bg-gray-700 rounded-full text-gray-600 dark:text-gray-400">
                                    {{ user.comments|length }}
                                </span>
                            </h2>
                            <a href="{{ path('user_comments') }}" 
                               class="text-sm text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-1">
                                Всі коментарі
                                <i class="fas fa-arrow-right"></i>
                            </a>
                        </div>
                        
                        {% if user.comments|length > 0 %}
                            <div class="space-y-3">
                                {% for comment in user.comments|slice(0, 5) %}
                                    <div class="comment-item bg-gray-50 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700 rounded-xl p-4 hover:shadow-md transition-all duration-300">
                                        <div class="flex items-start justify-between">
                                            <div class="flex items-start gap-3 flex-1">
                                                <div class="w-8 h-8 rounded-full bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center flex-shrink-0 mt-0.5">
                                                    <span class="text-white text-xs font-bold">{{ comment.getDisplayName()|first|upper }}</span>
                                                </div>
                                                <div class="flex-1 min-w-0">
                                                    <div class="flex items-center flex-wrap gap-2 mb-1">
                                                        <span class="font-medium text-gray-800 dark:text-gray-200 text-sm">
                                                            {{ comment.getDisplayName() }}
                                                        </span>
                                                        <span class="text-xs text-gray-500 dark:text-gray-400">
                                                            {{ comment.createdAt|date('d.m.Y H:i') }}
                                                        </span>
                                                        {% if comment.isApproved %}
                                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 text-xs bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 rounded-full">
                                                                <i class="fas fa-check-circle text-[10px]"></i>
                                                                Схвалено
                                                            </span>
                                                        {% else %}
                                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 text-xs bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-300 rounded-full">
                                                                <i class="fas fa-clock text-[10px]"></i>
                                                                Очікує
                                                            </span>
                                                        {% endif %}
                                                    </div>
                                                    <p class="text-sm text-gray-700 dark:text-gray-300 line-clamp-2">
                                                        {{ comment.content|striptags|slice(0, 120) }}
                                                        {% if comment.content|striptags|length > 120 %}...{% endif %}
                                                    </p>
                                                    <div class="flex items-center gap-3 mt-2 text-xs text-gray-500 dark:text-gray-400">
                                                        <span class="flex items-center gap-1">
                                                            <i class="far fa-newspaper"></i>
                                                            <a href="{{ path('app_article_show', {'slug': comment.article.slug}) }}" 
                                                               class="text-blue-600 dark:text-blue-400 hover:underline truncate max-w-[200px]">
                                                                {{ comment.article.title }}
                                                            </a>
                                                        </span>
                                                        <span class="flex items-center gap-1">
                                                            <i class="far fa-heart"></i>
                                                            {{ comment.likes|length }}
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                            <a href="{{ path('app_article_show', {'slug': comment.article.slug}) }}#comment-{{ comment.id }}" 
                                               class="ml-2 px-3 py-1.5 bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 text-xs rounded-lg hover:bg-blue-200 dark:hover:bg-blue-900/50 transition-colors flex-shrink-0">
                                                <i class="fas fa-external-link-alt"></i>
                                            </a>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        {% else %}
                            <div class="text-center py-12 bg-gray-50 dark:bg-gray-800/50 rounded-xl border border-gray-200 dark:border-gray-700">
                                <div class="inline-flex items-center justify-center w-16 h-16 bg-gray-200 dark:bg-gray-700 rounded-full mb-3">
                                    <i class="fas fa-comment-slash text-gray-500 dark:text-gray-400 text-2xl"></i>
                                </div>
                                <p class="text-gray-600 dark:text-gray-400">Ви ще не залишали коментарів</p>
                                <a href="{{ path('app_article_index') }}" 
                                   class="inline-flex items-center gap-2 mt-4 px-6 py-2.5 bg-gradient-to-r from-blue-600 to-purple-600 text-white rounded-lg hover:shadow-lg hover:scale-105 transition-all duration-300">
                                    <i class="fas fa-newspaper"></i>
                                    До статей
                                </a>
                            </div>
                        {% endif %}
                    </div>
                    
                    <!-- ======================== -->
                    <!-- ШВИДКІ ДІЇ -->
                    <!-- ======================== -->
                    <div class="bg-gradient-to-br from-gray-50 to-gray-100 dark:from-gray-800/50 dark:to-gray-800/30 rounded-xl p-6 border border-gray-200 dark:border-gray-700">
                        <h3 class="text-md font-semibold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
                            <i class="fas fa-bolt text-yellow-500"></i>
                            Швидкі дії
                        </h3>
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                            <a href="{{ path('user_blog_new') }}" 
                               class="quick-action flex flex-col items-center gap-2 p-4 bg-white dark:bg-gray-700 rounded-xl hover:bg-gray-50 dark:hover:bg-gray-600 transition-all duration-300 border border-gray-200 dark:border-gray-600">
                                <div class="action-icon w-12 h-12 rounded-xl bg-gradient-to-br from-purple-500 to-indigo-600 flex items-center justify-center text-white shadow-lg">
                                    <i class="fas fa-pen text-lg"></i>
                                </div>
                                <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Написати блог</span>
                                <span class="text-[10px] text-gray-400 dark:text-gray-500">Нова стаття</span>
                            </a>
                            
                            <a href="{{ path('user_video_new') }}" 
                               class="quick-action flex flex-col items-center gap-2 p-4 bg-white dark:bg-gray-700 rounded-xl hover:bg-gray-50 dark:hover:bg-gray-600 transition-all duration-300 border border-gray-200 dark:border-gray-600">
                                <div class="action-icon w-12 h-12 rounded-xl bg-gradient-to-br from-red-500 to-pink-600 flex items-center justify-center text-white shadow-lg">
                                    <i class="fas fa-video text-lg"></i>
                                </div>
                                <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Додати відео</span>
                                <span class="text-[10px] text-gray-400 dark:text-gray-500">Завантажити</span>
                            </a>
                            
                            <a href="{{ path('user_profile') }}" 
                               class="quick-action flex flex-col items-center gap-2 p-4 bg-white dark:bg-gray-700 rounded-xl hover:bg-gray-50 dark:hover:bg-gray-600 transition-all duration-300 border border-gray-200 dark:border-gray-600">
                                <div class="action-icon w-12 h-12 rounded-xl bg-gradient-to-br from-blue-500 to-cyan-600 flex items-center justify-center text-white shadow-lg">
                                    <i class="fas fa-user-cog text-lg"></i>
                                </div>
                                <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Налаштування</span>
                                <span class="text-[10px] text-gray-400 dark:text-gray-500">Редагувати профіль</span>
                            </a>
                            
                            <a href="{{ path('user_favorites') }}" 
                               class="quick-action flex flex-col items-center gap-2 p-4 bg-white dark:bg-gray-700 rounded-xl hover:bg-gray-50 dark:hover:bg-gray-600 transition-all duration-300 border border-gray-200 dark:border-gray-600">
                                <div class="action-icon w-12 h-12 rounded-xl bg-gradient-to-br from-yellow-500 to-orange-600 flex items-center justify-center text-white shadow-lg">
                                    <i class="fas fa-star text-lg"></i>
                                </div>
                                <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Обране</span>
                                <span class="text-[10px] text-gray-400 dark:text-gray-500">Збережене</span>
                            </a>
