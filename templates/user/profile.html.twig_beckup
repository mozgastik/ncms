{% extends 'base.html.twig' %}

{% block title %}Редагування профілю - Новинний портал{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 dark:bg-gray-900 py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
        <div class="flex flex-col lg:flex-row gap-8">
            <!-- Sidebar Menu -->
            <div class="lg:w-1/4">
                {{ include('user/_sidebar.html.twig') }}
            </div>
            
            <!-- Main Content -->
            <div class="lg:w-3/4">
                <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg dark:shadow-gray-900/50 p-6 md:p-8 border border-gray-100 dark:border-gray-700">
                    
                    <!-- Заголовок -->
                    <div class="mb-8 pb-6 border-b border-gray-200 dark:border-gray-700">
                        <h1 class="text-2xl md:text-3xl font-bold text-gray-800 dark:text-white">
                            <span class="bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">
                                Редагування профілю
                            </span>
                        </h1>
                        <p class="text-gray-600 dark:text-gray-400 mt-2">Оновіть вашу особисту інформацію</p>
                    </div>
                    
                    <div class="flex flex-col md:flex-row gap-8">
                        <!-- Avatar Section -->
                        <div class="md:w-1/3">
                            <div class="sticky top-8">
                                <div class="text-center mb-6">
                                    <div class="relative inline-block">
                                        <!-- Аватар -->
                                        <div class="w-40 h-40 rounded-full bg-gray-100 dark:bg-gray-700 flex items-center justify-center mx-auto mb-4 overflow-hidden border-4 border-blue-100 dark:border-blue-900 shadow-lg">
                                            {% if app.user.avatar %}
                                                <img src="{{ asset('uploads/avatars/' ~ app.user.avatar) }}" 
                                                     alt="{{ app.user.username }}" 
                                                     class="w-full h-full object-cover">
                                            {% else %}
                                                <div class="w-full h-full bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center">
                                                    <span class="text-white text-4xl font-bold">
                                                        {{ app.user.username|first|upper }}
                                                    </span>
                                                </div>
                                            {% endif %}
                                        </div>
                                        
                                        <!-- Інформація про поточний аватар -->
                                        {% if app.user.avatar %}
                                            <div class="mt-2 text-sm text-gray-500 dark:text-gray-400 bg-gray-50 dark:bg-gray-700/50 p-2 rounded-lg">
                                                <i class="fas fa-check-circle text-green-500 mr-1"></i>
                                                Поточний аватар: {{ app.user.avatar }}
                                            </div>
                                        {% endif %}
                                        
                                        <!-- Вимоги до зображення -->
                                        <div class="text-sm text-gray-500 dark:text-gray-400 mt-4 p-3 bg-gray-50 dark:bg-gray-700/50 rounded-lg border border-gray-200 dark:border-gray-700">
                                            <p class="font-medium mb-2 text-gray-700 dark:text-gray-300">
                                                <i class="fas fa-info-circle text-blue-500 mr-1"></i>
                                                Вимоги до зображення:
                                            </p>
                                            <ul class="text-left space-y-1">
                                                <li class="flex items-center gap-2">
                                                    <i class="fas fa-check text-green-500 w-4"></i>
                                                    <span>Розмір: до 2MB</span>
                                                </li>
                                                <li class="flex items-center gap-2">
                                                    <i class="fas fa-check text-green-500 w-4"></i>
                                                    <span>Формат: JPG, PNG, GIF</span>
                                                </li>
                                                <li class="flex items-center gap-2">
                                                    <i class="fas fa-check text-green-500 w-4"></i>
                                                    <span>Макс. розміри: 500x500px</span>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Form Section -->
                        <div class="md:w-2/3">
                            {{ form_start(form, {'attr': {'class': 'space-y-6', 'enctype': 'multipart/form-data'}}) }}
                            
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <!-- Email -->
                                <div class="md:col-span-2">
                                    {{ form_label(form.mail, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1'}}) }}
                                    {{ form_widget(form.mail, {'attr': {
                                        'class': 'w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent transition'
                                    }}) }}
                                    {{ form_errors(form.mail, {'attr': {'class': 'text-sm text-red-600 dark:text-red-400 mt-1'}}) }}
                                </div>
                                
                                <!-- Username -->
                                <div>
                                    {{ form_label(form.username, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1'}}) }}
                                    {{ form_widget(form.username, {'attr': {
                                        'class': 'w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent transition'
                                    }}) }}
                                    {{ form_errors(form.username) }}
                                </div>
                                
                                <!-- Full Name -->
                                <div>
                                    {{ form_label(form.fullName, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1'}}) }}
                                    {{ form_widget(form.fullName, {'attr': {
                                        'class': 'w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent transition'
                                    }}) }}
                                    {{ form_errors(form.fullName) }}
                                </div>
                                
                                <!-- Birth Date -->
                                <div class="md:col-span-2">
                                    {{ form_label(form.birthDate, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1'}}) }}
                                    {{ form_widget(form.birthDate, {'attr': {
                                        'class': 'w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent transition'
                                    }}) }}
                                    {{ form_errors(form.birthDate) }}
                                </div>
                            </div>
                            
                            <!-- Bio -->
                            <div>
                                {{ form_label(form.bio, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1'}}) }}
                                {{ form_widget(form.bio, {'attr': {
                                    'class': 'w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent transition',
                                    'rows': 4,
                                    'placeholder': 'Розкажіть про себе...'
                                }}) }}
                                {{ form_errors(form.bio) }}
                            </div>
                            
                            <!-- Avatar Upload -->
                            <div class="bg-gray-50 dark:bg-gray-700/50 p-4 rounded-lg border border-gray-200 dark:border-gray-700">
                                <h3 class="font-medium text-gray-700 dark:text-gray-300 mb-3 flex items-center gap-2">
                                    <i class="fas fa-camera text-blue-500"></i>
                                    Оновлення аватара
                                </h3>
                                
                                {{ form_label(form.avatarFile, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1'}}) }}
                                {{ form_widget(form.avatarFile, {'attr': {
                                    'class': 'w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent transition file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 dark:file:bg-blue-900 dark:file:text-blue-300 dark:hover:file:bg-blue-800'
                                }}) }}
                                
                                {% if form.avatarFile.vars.help is defined %}
                                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-2">
                                        <i class="fas fa-info-circle mr-1"></i>
                                        {{ form.avatarFile.vars.help }}
                                    </p>
                                {% else %}
                                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-2">
                                        <i class="fas fa-info-circle mr-1"></i>
                                        Залиште порожнім, щоб залишити поточний аватар
                                    </p>
                                {% endif %}
                                
                                {{ form_errors(form.avatarFile) }}
                            </div>
                            
                            <!-- Buttons -->
                            <div class="flex items-center justify-between pt-6 border-t border-gray-200 dark:border-gray-700">
                                <a href="{{ path('user_dashboard') }}" 
                                   class="px-4 py-2 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition flex items-center gap-2">
                                    <i class="fas fa-times"></i>
                                    Скасувати
                                </a>
                                <button type="submit" 
                                        class="px-6 py-3 bg-gradient-to-r from-blue-500 to-purple-600 text-white font-medium rounded-lg hover:shadow-lg hover:scale-105 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-all duration-300 flex items-center gap-2">
                                    <i class="fas fa-save"></i>
                                    Зберегти зміни
                                </button>
                            </div>
                            
                            {{ form_end(form) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}