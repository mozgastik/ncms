{% set unreadCount = app.user ? notification_unread_count() : 0 %}
{% set latestNotifications = app.user ? notification_latest(10) : [] %}
{% set personalNotificationTarget = constant('App\\Entity\\Notification\\AdminNotification::TARGET_SPECIFIC') %}
{% set latestUnreadNotifications = latestNotifications|filter(notification => notification.target == personalNotificationTarget and not notification.isRead) %}
<nav id="mainNavbar"
     x-data="headerManager({{ unreadCount }}, {{ app.user ? 'true' : 'false' }})"
     x-init="init()"
     class="sticky top-0 z-50 backdrop-blur-xl bg-white/95 dark:bg-gray-900/95 transition-all duration-500 border-b border-transparent"
     :class="{ 'shadow-lg shadow-black/5 dark:shadow-black/20 border-gray-200/30 dark:border-gray-800/30': scrolled, 'header-hidden': hidden }">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16 lg:h-20">
            
            <!-- Ліва частина: логотип -->
            <div class="flex items-center gap-3">
                <a class="flex items-center gap-3 group" href="{{ path('app_home') }}">
                    <div class="relative w-9 h-9 sm:w-10 sm:h-10 bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl flex items-center justify-center shadow-lg shadow-blue-500/20 group-hover:shadow-blue-500/30 transition-all duration-300 group-hover:scale-105">
                    <span class="text-white font-bold text-sm sm:text-base"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-waypoints-icon lucide-waypoints"><path d="m10.586 5.414-5.172 5.172"/><path d="m18.586 13.414-5.172 5.172"/><path d="M6 12h12"/><circle cx="12" cy="20" r="2"/><circle cx="12" cy="4" r="2"/><circle cx="20" cy="12" r="2"/><circle cx="4" cy="12" r="2"/></svg></span>
                        <div class="absolute inset-0 rounded-xl bg-gradient-to-br from-white/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                    </div>
                    <span class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white transition-colors duration-300">AdNews<span class="text-blue-500">.</span>FUN
                    </span>
                </a>
            </div>

            <!-- Десктопна навігація (прихована на мобільних) -->
            <div class="hidden lg:flex lg:items-center lg:gap-6">
                <ul class="flex items-center gap-1">
                    <li>
                        <a href="/page/faq" class="group relative px-4 py-2.5 rounded-xl text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 transition-all duration-300 hover:bg-gray-100/50 dark:hover:bg-gray-800/50 flex items-center gap-2">
                            <i class="fas fa-question-circle text-sm opacity-60 group-hover:opacity-100 transition-opacity duration-300"></i>
                            <span class="font-medium">FAQ</span>
                        </a>
                    </li>
                    <li>
                        <a href="/feedback" class="group relative px-4 py-2.5 rounded-xl text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 transition-all duration-300 hover:bg-gray-100/50 dark:hover:bg-gray-800/50 flex items-center gap-2">
                            <i class="fas fa-envelope text-sm opacity-60 group-hover:opacity-100 transition-opacity duration-300"></i>
                            <span class="font-medium">Контакти</span>
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Права частина -->
            <div class="flex items-center gap-2 sm:gap-3">
<div data-weather-api-key="{{ open_weather_api_key|default('') }}">
</div>
            {{ include('components/weather_widget.html.twig') }}
                <!-- Годинник (прихований на дуже малих екранах) -->
                <div class="hidden sm:flex items-center gap-2 px-3 py-2 bg-gray-100/50 dark:bg-gray-800/50 backdrop-blur-sm rounded-xl">
                    <i class="fas fa-clock text-xs text-gray-500 dark:text-gray-400"></i>
                    <span class="font-mono text-sm font-medium text-gray-800 dark:text-gray-200 tabular-nums" x-text="time"></span>
                    <span class="hidden xl:inline text-xs text-gray-500 dark:text-gray-400" x-text="date"></span>
                </div>

                <!-- Перемикач теми (кнопка з іконкою) -->
                <button id="theme-toggle"
                        type="button"
                        class="flex items-center justify-center w-10 h-10 rounded-xl bg-gray-100/50 dark:bg-gray-800/50 backdrop-blur-sm hover:bg-gray-200/50 dark:hover:bg-gray-700/50 transition border border-gray-200/30 dark:border-gray-700/30"
                        aria-label="Перемкнути тему">
                    <i id="theme-icon" class="fas fa-moon text-gray-700 dark:text-gray-300"></i>
                </button>

                {% if app.user %}
                    <!-- Дзвіночок сповіщень -->
                    <div class="relative" @click.outside="notificationsOpen = false">
                        <button @click="notificationsOpen = !notificationsOpen; userOpen = false"
                                class="relative p-2.5 rounded-xl bg-gray-100/50 dark:bg-gray-800/50 backdrop-blur-sm hover:bg-gray-200/50 dark:hover:bg-gray-700/50 transition-all duration-300"
                                :aria-expanded="notificationsOpen">
                            <i class="fas fa-bell text-gray-700 dark:text-gray-300 text-lg"></i>
                            <span x-show="unreadCount > 0" x-text="unreadCount > 9 ? '9+' : unreadCount"
                                  class="absolute -top-1 -right-1 min-w-5 h-5 px-1 rounded-full bg-red-500 text-white text-[10px] font-bold flex items-center justify-center border-2 border-white dark:border-gray-900 shadow"></span>
                        </button>
                        <!-- Dropdown сповіщень -->
                        <div x-show="notificationsOpen" x-cloak x-transition
                             class="fixed left-3 right-3 top-20 sm:absolute sm:left-auto sm:right-0 sm:top-auto sm:mt-3 sm:w-96 rounded-xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 shadow-2xl overflow-hidden z-50">
                            <div class="px-4 py-3 border-b border-gray-200 dark:border-gray-700">
                                <div class="flex items-center justify-between gap-3">
                                    <div class="min-w-0">
                                        <h5 class="font-bold text-gray-900 dark:text-white">Сповіщення</h5>
                                        <p class="text-xs text-gray-500 dark:text-gray-400">
                                            <template x-if="unreadCount > 0"><span>Непрочитані: <span x-text="unreadCount"></span></span></template>
                                            <template x-if="unreadCount === 0"><span>Усі повідомлення прочитані</span></template>
                                        </p>
                                    </div>
                                    <a href="{{ path('user_notifications') }}" class="text-sm font-medium text-blue-600 dark:text-blue-400 hover:underline">Всі</a>
                                </div>
                                <div class="grid grid-cols-2 gap-2 mt-3 p-1 bg-gray-100 dark:bg-gray-800 rounded-lg">
                                    <button @click="notificationTab = 'all'"
                                            :class="notificationTab === 'all' ? 'bg-white dark:bg-gray-900 text-blue-600 shadow-sm' : 'text-gray-600 dark:text-gray-400'"
                                            class="px-3 py-2 rounded-md text-sm font-semibold transition">Усі</button>
                                    <button @click="notificationTab = 'unread'"
                                            :class="notificationTab === 'unread' ? 'bg-white dark:bg-gray-900 text-blue-600 shadow-sm' : 'text-gray-600 dark:text-gray-400'"
                                            class="px-3 py-2 rounded-md text-sm font-semibold transition">
                                        Непрочитані
                                        <span x-show="unreadCount > 0" x-text="unreadCount > 99 ? '99+' : unreadCount"
                                              class="ml-1 inline-flex min-w-5 h-5 px-1.5 items-center justify-center rounded-full bg-red-500 text-white text-[11px]"></span>
                                    </button>
                                </div>
                            </div>
                            <div class="max-h-[70vh] sm:max-h-96 overflow-y-auto">
                                <div x-show="notificationTab === 'all'">
                                    {% if latestNotifications is not empty %}
                                        {% for notification in latestNotifications %}
                                            {% include 'components/_notification_item.html.twig' with { notification: notification } %}
                                        {% endfor %}
                                    {% else %}
                                        <div class="text-center py-8 px-4 text-sm text-gray-500 dark:text-gray-400">Немає сповіщень</div>
                                    {% endif %}
                                </div>
                                <div x-show="notificationTab === 'unread'">
                                    {% if latestUnreadNotifications is not empty %}
                                        {% for notification in latestUnreadNotifications %}
                                            {% include 'components/_notification_item.html.twig' with { notification: notification } %}
                                        {% endfor %}
                                    {% else %}
                                        <div class="text-center py-8 px-4 text-sm text-gray-500 dark:text-gray-400">Немає непрочитаних</div>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="p-3 bg-gray-50 dark:bg-gray-800/70 border-t border-gray-200 dark:border-gray-700">
                                <a href="{{ path('user_notifications') }}" class="flex items-center justify-center gap-2 w-full px-4 py-2.5 rounded-lg bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 text-sm font-semibold text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800 transition">
                                    <i class="fas fa-list-ul text-xs"></i>Переглянути всі
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Профіль -->
                    <div class="relative" @click.outside="userOpen = false">
                        <button @click="userOpen = !userOpen; notificationsOpen = false"
                                class="flex items-center gap-2.5 rounded-xl bg-gray-100/50 dark:bg-gray-800/50 backdrop-blur-sm p-2 transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-blue-500/20">
                            <div class="relative">
                                     {% if app.user.avatar %}
                                        <img src="{{ asset('uploads/avatars/' ~ app.user.avatar) }}" alt="{{ app.user.username }}" class="w-9 h-9 rounded-full object-cover border-2 border-white/50 dark:border-gray-700/50">
                                    {% else %}
                                        <i class="fas fa-user text-gray-700 dark:text-gray-300"></i>
                                    {% endif %}
                                <div class="absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 rounded-full bg-green-500 border-2 border-white dark:border-gray-900"></div>
                            </div>
                            <div class="text-left hidden sm:block">
                                <div class="font-medium text-gray-900 dark:text-white text-sm">{{ app.user.username }}</div>
                                <div class="text-xs text-gray-500 dark:text-gray-400">Меню</div>
                            </div>
                            <i class="fas fa-chevron-down text-xs text-gray-400 transition-transform duration-300 ml-1" :class="{ 'rotate-180': userOpen }"></i>
                        </button>
                        <!-- Dropdown профілю -->
                        <div x-show="userOpen" x-cloak x-transition
                             class="fixed left-3 right-3 top-20 sm:absolute sm:left-auto sm:right-0 sm:top-auto sm:mt-2 sm:w-72 rounded-xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 shadow-2xl py-2 z-50">
                            <div class="px-4 py-3 border-b border-gray-200 dark:border-gray-700">
                                <p class="font-bold text-gray-900 dark:text-white truncate">{{ app.user.username }}</p>
                                <p class="text-sm text-gray-600 dark:text-gray-400 truncate">{{ app.user.mail }}</p>
                            </div>
                            <a href="{{ path('user_dashboard') }}" class="flex items-center gap-3 px-4 py-2.5 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
                                <span class="w-5 text-blue-600"><i class="fas fa-chart-line"></i></span>
                                <span class="text-gray-800 dark:text-gray-200">Панель керування</span>
                            </a>
                            <a href="{{ path('user_profile') }}" class="flex items-center gap-3 px-4 py-2.5 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
                                <span class="w-5 text-gray-600"><i class="fas fa-user"></i></span>
                                <span class="text-gray-800 dark:text-gray-200">Профіль</span>
                            </a>
                            <a href="{{ path('user_notifications') }}" class="flex items-center gap-3 px-4 py-2.5 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
                                <span class="w-5 text-yellow-600"><i class="fas fa-bell"></i></span>
                                <span class="text-gray-800 dark:text-gray-200">Сповіщення</span>
                            </a>
                            <a href="{{ path('user_favorites') }}" class="flex items-center gap-3 px-4 py-2.5 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
                                <span class="w-5 text-pink-600"><i class="fas fa-heart"></i></span>
                                <span class="text-gray-800 dark:text-gray-200">Обране</span>
                            </a>
                            {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('admin_dashboard') }}" class="flex items-center gap-3 px-4 py-2.5 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
                                <span class="w-5 text-orange-600"><i class="fas fa-cog"></i></span>
                                <span class="text-gray-800 dark:text-gray-200">Адмінка</span>
                            </a>
                            {% endif %}
                            <div class="border-t border-gray-200 dark:border-gray-700 mt-1 pt-1">
                                <a href="{{ path('app_logout') }}" class="flex items-center gap-3 px-4 py-2.5 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors text-red-600 dark:text-red-400">
                                    <span class="w-5"><i class="fas fa-sign-out-alt"></i></span>
                                    <span>Вийти</span>
                                </a>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <!-- Кнопки входу/реєстрації (видно на всіх екранах) -->
                    <div class="flex items-center gap-2">
                        <a href="{{ path('app_login') }}" class="px-4 py-2 rounded-xl text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-gray-100/50 dark:hover:bg-gray-800/50 transition-all duration-300 font-medium">Увійти</a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</nav>

<style>
    #mainNavbar.header-hidden {
        transform: translateY(-100%);
    }
</style>

<script>
    // Перемикач теми (простий та надійний)
    (function() {
        const html = document.documentElement;
        const savedTheme = localStorage.getItem('theme');
        if (savedTheme === 'dark') {
            html.classList.add('dark');
        } else if (savedTheme === 'light') {
            html.classList.remove('dark');
        }

        function updateThemeIcon() {
            const icon = document.getElementById('theme-icon');
            if (!icon) return;
            const isDark = html.classList.contains('dark');
            icon.className = isDark ? 'fas fa-sun text-gray-700 dark:text-gray-300' : 'fas fa-moon text-gray-700 dark:text-gray-300';
        }
        updateThemeIcon();

        document.getElementById('theme-toggle').addEventListener('click', function() {
            const isDark = html.classList.toggle('dark');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
            updateThemeIcon();
        });
    })();

    // Alpine компонент
    document.addEventListener('alpine:init', () => {
        Alpine.data('headerManager', (initialUnreadCount = 0, authenticated = false) => ({
            userOpen: false,
            notificationsOpen: false,
            notificationTab: 'all',
            unreadCount: Number(initialUnreadCount) || 0,
            scrolled: false,
            hidden: false,
            lastScrollTop: 0,
            time: '',
            date: '',
            authenticated,

            init() {
                this.updateClock();
                setInterval(() => this.updateClock(), 1000);

                window.addEventListener('scroll', () => this.handleScroll(), { passive: true });
                this.handleScroll();

                if (this.authenticated) {
                    setInterval(() => this.checkNotifications(), 30000);
                }
            },

            updateClock() {
                const now = new Date();
                this.time = now.toLocaleTimeString('uk-UA', { hour: '2-digit', minute: '2-digit' });
                this.date = `${['Неділя', 'Понеділок', 'Вівторок', 'Середа', 'Четвер', 'Пʼятниця', 'Субота'][now.getDay()]}, ${now.getDate()} ${['січня', 'лютого', 'березня', 'квітня', 'травня', 'червня', 'липня', 'серпня', 'вересня', 'жовтня', 'листопада', 'грудня'][now.getMonth()]}`;
            },

            handleScroll() {
                const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
                this.scrolled = scrollTop > 10;
                // ховаємо, якщо скролимо вниз і прокрутили більше 100px
                if (scrollTop > this.lastScrollTop && scrollTop > 100) {
                    this.hidden = true;
                } else if (scrollTop < this.lastScrollTop || scrollTop < 100) {
                    // показуємо, якщо скролимо вгору або на самому верху
                    this.hidden = false;
                }
                this.lastScrollTop = scrollTop;
            },

            async checkNotifications() {
                try {
                    const resp = await fetch('/api/notifications/unread-count', { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    if (!resp.ok) return;
                    const data = await resp.json();
                    if (data.unreadCount > this.unreadCount) this.playSound();
                    this.unreadCount = data.unreadCount;
                } catch (e) {}
            },

            playSound() {
                if (!this.soundUnlocked) return;
                const audio = document.getElementById('notification-sound');
                if (!audio) return;
                audio.currentTime = 0;
                audio.play().catch(() => {});
            }
        }));
    });
</script>