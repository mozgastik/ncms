<!DOCTYPE html>
<html lang="uk" class="light scroll-smooth" data-theme="light" x-data x-init="$el.classList.toggle('dark', localStorage.getItem('theme') === 'dark')">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{% block meta_description %}Сучасний новинний портал з актуальними новинами та статтями{% endblock %}">
    <meta name="keywords" content="{% block meta_keywords %}новини, статті, блог, інформація{% endblock %}">
    <meta name="author" content="Новинний портал">
    <meta name="theme-color" content="#3b82f6" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#1e293b" media="(prefers-color-scheme: dark)">
    <meta name="csrf-token" content="{{ csrf_token('authenticate') }}">
    
    <title>{% block title %}Новинний портал{% endblock %}</title>
    
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}
    
    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
        
        <!-- Lodash для debounce/throttle -->
        <script src="https://cdn.jsdelivr.net/npm/lodash@4.17.21/lodash.min.js"></script>
        
        <!-- Основний JavaScript для Tailwind v4 -->
        <script>
            (function() {
                'use strict';
                
                // Утиліти
                const utils = {
                    debounce: (func, wait) => {
                        let timeout;
                        return function executedFunction(...args) {
                            const later = () => {
                                clearTimeout(timeout);
                                func(...args);
                            };
                            clearTimeout(timeout);
                            timeout = setTimeout(later, wait);
                        };
                    },
                    
                    throttle: (func, limit) => {
                        let inThrottle;
                        return function(...args) {
                            if (!inThrottle) {
                                func.apply(this, args);
                                inThrottle = true;
                                setTimeout(() => inThrottle = false, limit);
                            }
                        };
                    },
                    
                    formatDate: (date) => {
                        return new Date(date).toLocaleDateString('uk-UA', {
                            day: 'numeric',
                            month: 'long',
                            year: 'numeric'
                        });
                    },
                    
                    getSystemTheme: () => {
                        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
                    }
                };
                
                // Управління темою
                const themeManager = {
                    init() {
                        this.themeToggle = document.querySelector('[data-theme-toggle]');
                        if (this.themeToggle) {
                            this.themeToggle.addEventListener('click', () => this.toggle());
                        }
                        
                        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
                            if (!localStorage.getItem('theme')) {
                                this.set(e.matches ? 'dark' : 'light');
                            }
                        });
                    },
                    
                    set(theme) {
                        document.documentElement.classList.toggle('dark', theme === 'dark');
                        document.documentElement.setAttribute('data-theme', theme);
                        localStorage.setItem('theme', theme);
                        
                        // Оновлюємо тему для Tailwind v4
                        if (theme === 'dark') {
                            document.documentElement.classList.add('dark');
                        } else {
                            document.documentElement.classList.remove('dark');
                        }
                    },
                    
                    toggle() {
                        const currentTheme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
                        this.set(currentTheme === 'dark' ? 'light' : 'dark');
                    }
                };
                
                // Управління мобільним меню
                const mobileMenuManager = {
                    init() {
                        this.menuButton = document.querySelector('[data-menu-toggle]');
                        this.mobileMenu = document.querySelector('[data-mobile-menu]');
                        this.menuOverlay = document.querySelector('[data-menu-overlay]');
                        
                        if (this.menuButton && this.mobileMenu) {
                            this.menuButton.addEventListener('click', () => this.toggle());
                            
                            if (this.menuOverlay) {
                                this.menuOverlay.addEventListener('click', () => this.close());
                            }
                            
                            this.mobileMenu.querySelectorAll('a').forEach(link => {
                                link.addEventListener('click', () => this.close());
                            });
                            
                            window.addEventListener('resize', utils.throttle(() => {
                                if (window.innerWidth >= 1024 && this.mobileMenu && !this.mobileMenu.classList.contains('hidden')) {
                                    this.close();
                                }
                            }, 150));
                        }
                    },
                    
                    toggle() {
                        const isOpen = !this.mobileMenu.classList.contains('hidden');
                        isOpen ? this.close() : this.open();
                    },
                    
                    open() {
                        this.mobileMenu.classList.remove('hidden');
                        if (this.menuOverlay) this.menuOverlay.classList.remove('hidden');
                        document.body.classList.add('mobile-menu-open');
                        this.mobileMenu.classList.add('animate-slide-in');
                    },
                    
                    close() {
                        this.mobileMenu.classList.add('hidden');
                        if (this.menuOverlay) this.menuOverlay.classList.add('hidden');
                        document.body.classList.remove('mobile-menu-open');
                        this.mobileMenu.classList.remove('animate-slide-in');
                    }
                };
                
                // Пошук
                const searchManager = {
                    init() {
                        this.searchInput = document.querySelector('[data-search-input]');
                        this.searchResults = document.querySelector('[data-search-results]');
                        this.searchButton = document.querySelector('[data-search-button]');
                        
                        if (this.searchInput && this.searchResults) {
                            this.setupSearch();
                        }
                        
                        if (this.searchButton) {
                            this.searchButton.addEventListener('click', () => this.toggleSearch());
                        }
                        
                        document.addEventListener('keydown', (e) => {
                            if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
                                e.preventDefault();
                                this.focusSearch();
                            }
                        });
                    },
                    
                    setupSearch() {
                        const debouncedSearch = utils.debounce((query) => {
                            if (query.length > 1) this.performSearch(query);
                        }, 300);
                        
                        this.searchInput.addEventListener('input', (e) => {
                            const query = e.target.value.trim();
                            query.length === 0 ? this.hideResults() : debouncedSearch(query);
                        });
                        
                        document.addEventListener('click', (e) => {
                            if (!this.searchInput.contains(e.target) && 
                                !this.searchResults.contains(e.target) &&
                                !this.searchButton?.contains(e.target)) {
                                this.hideResults();
                            }
                        });
                        
                        document.addEventListener('keydown', (e) => {
                            if (e.key === 'Escape') {
                                this.hideResults();
                                this.searchInput.blur();
                            }
                        });
                    },
                    
                    performSearch(query) {
                        console.log('Пошук:', query);
                        
                        const mockResults = [
                            { title: 'Як вивчити JavaScript за 30 днів', url: '#', category: 'Програмування' },
                            { title: '10 порад для продуктивної роботи', url: '#', category: 'Кар\'єра' },
                            { title: 'Новини технологій: травень 2024', url: '#', category: 'Технології' },
                            { title: 'Огляд найкращих IDE для розробки', url: '#', category: 'Інструменти' },
                        ];
                        
                        this.showResults(mockResults);
                    },
                    
                    showResults(results) {
                        if (results.length === 0) {
                            this.searchResults.innerHTML = `
                                <div class="p-8 text-center">
                                    <i class="fas fa-search text-[var(--color-surface-300)] text-3xl mb-2"></i>
                                    <p class="text-[var(--color-surface-500)]">Нічого не знайдено</p>
                                </div>
                            `;
                        } else {
                            this.searchResults.innerHTML = results.map(result => `
                                <a href="${result.url}" class="block p-4 hover:bg-[var(--color-surface-50)] dark:hover:bg-[var(--color-surface-800)] transition-colors border-b border-[var(--color-surface-100)] dark:border-[var(--color-surface-800)] last:border-0 group">
                                    <div class="flex items-start gap-3">
                                        <div class="flex-1">
                                            <div class="font-medium text-[var(--color-surface-900)] dark:text-[var(--color-surface-100)] group-hover:text-[var(--color-primary-600)] dark:group-hover:text-[var(--color-primary-400)] transition-colors">
                                                ${result.title}
                                            </div>
                                            <div class="text-sm text-[var(--color-surface-500)] mt-1">
                                                <span class="bg-[var(--color-surface-100)] dark:bg-[var(--color-surface-800)] px-2 py-0.5 rounded-full text-xs">
                                                    ${result.category}
                                                </span>
                                            </div>
                                        </div>
                                        <i class="fas fa-arrow-right text-[var(--color-surface-400)] group-hover:text-[var(--color-primary-500)] transition-colors"></i>
                                    </div>
                                </a>
                            `).join('');
                        }
                        
                        this.searchResults.classList.remove('hidden');
                        this.searchResults.classList.add('animate-scale-in');
                    },
                    
                    hideResults() {
                        this.searchResults.classList.add('hidden');
                        this.searchResults.classList.remove('animate-scale-in');
                    },
                    
                    focusSearch() {
                        this.searchInput?.focus();
                    },
                    
                    toggleSearch() {
                        if (window.innerWidth < 1024) {
                            this.searchInput?.classList.toggle('hidden');
                            if (!this.searchInput?.classList.contains('hidden')) {
                                this.searchInput.focus();
                            }
                        }
                    }
                };
                
                // Прогрес читання
                const readingProgress = {
                    init() {
                        this.progressBar = document.querySelector('.reading-progress');
                        if (!this.progressBar) {
                            this.progressBar = document.createElement('div');
                            this.progressBar.className = 'reading-progress hidden';
                            document.body.appendChild(this.progressBar);
                        }
                        
                        window.addEventListener('scroll', utils.throttle(() => this.updateProgress(), 50));
                    },
                    
                    updateProgress() {
                        const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
                        const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
                        const scrolled = (winScroll / height) * 100;
                        
                        if (scrolled > 5 && scrolled < 95) {
                            this.progressBar.classList.remove('hidden');
                            this.progressBar.style.transform = `scaleX(${scrolled / 100})`;
                        } else {
                            this.progressBar.classList.add('hidden');
                        }
                    }
                };
                
                // Сповіщення
                window.notify = function(message, type = 'info', duration = 3000) {
                    const notification = document.createElement('div');
                    
                    const icons = {
                        success: 'fa-circle-check',
                        error: 'fa-circle-exclamation',
                        warning: 'fa-triangle-exclamation',
                        info: 'fa-circle-info'
                    };
                    
                    const colors = {
                        success: 'border-l-green-500',
                        error: 'border-l-red-500',
                        warning: 'border-l-yellow-500',
                        info: 'border-l-primary-500'
                    };
                    
                    notification.className = `
                        fixed top-4 right-4 z-9999 notification ${colors[type]} 
                        bg-white dark:bg-[var(--color-surface-800)]
                        shadow-lg rounded-lg border-l-4
                        flex items-center gap-3 min-w-75 max-w-md p-4
                        transform transition-all duration-300 translate-x-full opacity-0
                    `;
                    
                    notification.innerHTML = `
                        <i class="fas ${icons[type]} text-${type === 'info' ? 'primary' : type}-500 text-xl"></i>
                        <div class="flex-1">
                            <p class="text-[var(--color-surface-900)] dark:text-[var(--color-surface-100)]">${message}</p>
                        </div>
                        <button onclick="this.closest('.notification').remove()" class="text-[var(--color-surface-400)] hover:text-[var(--color-surface-600)] dark:hover:text-[var(--color-surface-200)]">
                            <i class="fas fa-times"></i>
                        </button>
                    `;
                    
                    document.body.appendChild(notification);
                    
                    setTimeout(() => notification.classList.remove('translate-x-full', 'opacity-0'), 10);
                    
                    setTimeout(() => {
                        notification.classList.add('translate-x-full', 'opacity-0');
                        setTimeout(() => notification.remove(), 300);
                    }, duration);
                };
                
                // Ініціалізація
                document.addEventListener('DOMContentLoaded', () => {
                    themeManager.init();
                    mobileMenuManager.init();
                    searchManager.init();
                    readingProgress.init();
                    
                    // Кнопка "наверх"
                    const scrollToTopBtn = document.querySelector('.scroll-to-top');
                    if (scrollToTopBtn) {
                        window.addEventListener('scroll', utils.throttle(() => {
                            window.scrollY > 300 ? 
                                (scrollToTopBtn.classList.remove('hidden'), scrollToTopBtn.classList.add('flex')) :
                                (scrollToTopBtn.classList.add('hidden'), scrollToTopBtn.classList.remove('flex'));
                        }, 100));
                        
                        scrollToTopBtn.addEventListener('click', () => {
                            window.scrollTo({ top: 0, behavior: 'smooth' });
                        });
                    }
                    
                    document.body.classList.add('loaded');
                });
                
                // Публічне API
                window.app = {
                    theme: themeManager,
                    notify: window.notify,
                    utils,
                    search: searchManager,
                    mobileMenu: mobileMenuManager
                };
            })();
        </script>
    {% endblock %}
    
    <!-- Favicon -->
    

    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    
    <!-- Open Graph -->
    <meta property="og:title" content="{% block og_title %}Новинний портал{% endblock %}">
    <meta property="og:description" content="{% block og_description %}Сучасний новинний портал з актуальними новинами та статтями{% endblock %}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ app.request.uri }}">
    <meta property="og:image" content="{% block og_image %}/images/og-image.jpg{% endblock %}">
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{% block twitter_title %}Новинний портал{% endblock %}">
    <meta name="twitter:description" content="{% block twitter_description %}Сучасний новинний портал з актуальними новинами та статтями{% endblock %}">
    <meta name="twitter:image" content="{% block twitter_image %}/images/twitter-image.jpg{% endblock %}">
    <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0,1" />
</head>
<body class="min-h-screen bg-[var(--color-surface-0)] text-[var(--color-surface-900)] font-sans antialiased dark:bg-[var(--color-surface-100)] dark:text-[var(--color-surface-950)] overflow-x-hidden">
    
    <!-- Флеш-повідомлення -->
    <div class="fixed top-4 right-4 z-9999 space-y-2">
        {% for message in app.flashes('success') %}
            <div class="bg-linear-to-r from-green-500 to-emerald-600 text-white px-6 py-4 rounded-xl shadow-2xl animate-slide-in flex items-center gap-3 min-w-75 max-w-md">
                <i class="fas fa-check-circle text-white text-xl"></i>
                <span class="flex-1 font-medium">{{ message }}</span>
                <button onclick="this.parentElement.remove()" class="text-white/80 hover:text-white transition-colors">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        {% endfor %}
        
        {% for message in app.flashes('error') %}
            <div class="bg-linear-to-r from-red-500 to-rose-600 text-white px-6 py-4 rounded-xl shadow-2xl animate-slide-in flex items-center gap-3 min-w-75 max-w-md">
                <i class="fas fa-exclamation-circle text-white text-xl"></i>
                <span class="flex-1 font-medium">{{ message }}</span>
                <button onclick="this.parentElement.remove()" class="text-white/80 hover:text-white transition-colors">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        {% endfor %}
        
        {% for message in app.flashes('warning') %}
            <div class="bg-linear-to-r from-yellow-500 to-amber-600 text-white px-6 py-4 rounded-xl shadow-2xl animate-slide-in flex items-center gap-3 min-w-75 max-w-md">
                <i class="fas fa-exclamation-triangle text-white text-xl"></i>
                <span class="flex-1 font-medium">{{ message }}</span>
                <button onclick="this.parentElement.remove()" class="text-white/80 hover:text-white transition-colors">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        {% endfor %}
    </div>
    <div data-menu-overlay class="fixed inset-0 bg-[var(--color-surface-900)]/50 backdrop-blur-sm z-40 hidden lg:hidden transition-opacity"></div>

    <main class="min-h-[calc(100vh-200px)]">
        {% block body %}{% endblock %}
    </main>
    
    
</body>
</html>