{% extends 'base.html.twig' %}

{% block title %}Головна - Новини та блоги{% endblock %}

{% block body %}
<div x-data="homePage()" 
     x-init="init()"
     class="min-h-screen bg-gradient-to-b from-gray-50 to-white dark:from-gray-900 dark:to-gray-950">
    
    <!-- Декоративні елементи -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none">
        <div class="absolute -top-40 -right-40 w-80 h-80 bg-blue-500/5 dark:bg-blue-500/10 rounded-full blur-3xl animate-float"></div>
        <div class="absolute -bottom-40 -left-40 w-80 h-80 bg-purple-500/5 dark:bg-purple-500/10 rounded-full blur-3xl animate-float" style="animation-delay: 1s"></div>
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-pink-500/5 dark:bg-pink-500/10 rounded-full blur-3xl animate-float" style="animation-delay: 2s"></div>
    </div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        
        <!-- МОБІЛЬНІ ВКЛАДКИ -->
        <div class="lg:hidden mb-6">
            <div class="grid grid-cols-3 gap-1 rounded-2xl border border-gray-200/70 dark:border-white/10 bg-white/85 dark:bg-gray-900/85 p-1.5 shadow-sm backdrop-blur-xl">
                <button type="button" @click="switchTab('news')"
                        :class="activeTab === 'news' ? 'bg-blue-500 text-white shadow-md' : 'text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800/80'"
                        class="relative flex min-h-14 flex-col items-center justify-center gap-1 rounded-xl px-2 py-2 text-xs font-semibold transition-all duration-300 active:scale-95"
                        aria-label="Новини">
                    <i class="fas fa-shekel-sign text-base"></i>
                    <span class="leading-none">Новини</span>
                    <span class="absolute -top-1 -right-1 min-w-5 h-5 px-1 rounded-full bg-red-500 text-white text-[11px] font-bold flex items-center justify-center border-2 border-white dark:border-gray-900">
                        {{ ((featuredArticles|default([])|length) + (latestArticles|default([])|length)) > 99 ? '99+' : (featuredArticles|default([])|length) + (latestArticles|default([])|length) }}
                    </span>
                </button>
                <button type="button" @click="switchTab('blogs')"
                        :class="activeTab === 'blogs' ? 'bg-purple-500 text-white shadow-md' : 'text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800/80'"
                        class="relative flex min-h-14 flex-col items-center justify-center gap-1 rounded-xl px-2 py-2 text-xs font-semibold transition-all duration-300 active:scale-95"
                        aria-label="Блоги">
                    <i class="fas fa-blog text-base"></i>
                    <span class="leading-none">Блоги</span>
                    <span class="absolute -top-1 -right-1 min-w-5 h-5 px-1 rounded-full bg-red-500 text-white text-[11px] font-bold flex items-center justify-center border-2 border-white dark:border-gray-900">
                        {{ blogs|default([])|length > 99 ? '99+' : blogs|default([])|length }}
                    </span>
                </button>
                <button type="button" @click="switchTab('video')"
                        :class="activeTab === 'video' ? 'bg-red-500 text-white shadow-md' : 'text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800/80'"
                        class="relative flex min-h-14 flex-col items-center justify-center gap-1 rounded-xl px-2 py-2 text-xs font-semibold transition-all duration-300 active:scale-95"
                        aria-label="Відео">
                    <i class="far fa-circle-play text-base"></i>
                    <span class="leading-none">Відео</span>
                    <span class="absolute -top-1 -right-1 min-w-5 h-5 px-1 rounded-full bg-red-500 text-white text-[11px] font-bold flex items-center justify-center border-2 border-white dark:border-gray-900">
                        {{ videos|default([])|length > 99 ? '99+' : videos|default([])|length }}
                    </span>
                </button>
            </div>
        </div>

        <!-- ОСНОВНИЙ КОНТЕНТ: ДЕСКТОПНА ПАНЕЛЬ ЗЛІВА + КОНТЕНТ СПРАВА -->
        <div class="flex gap-6 items-start">
            
            <!-- ЛІВА КОЛОНКА: ІКОНКИ ВКЛАДОК ДЛЯ ДЕСКТОПА -->
            <div class="hidden lg:block sticky top-24 z-30 flex-shrink-0">
                <div class="flex flex-col gap-2 bg-white/70 dark:bg-gray-900/30 backdrop-blur-sm rounded-2xl border border-gray-200/50 dark:border-white/20 p-2 shadow-sm">
                    <button @click="switchTab('news')"
                            :class="activeTab === 'news' ? 'bg-blue-500 text-white shadow-lg' : 'text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800'"
                            class="relative w-12 h-12 flex items-center justify-center rounded-xl transition-all duration-300 group"
                            title="Новини">
                        <i class="fas fa-shekel-sign text-xl"></i>
                        <span class="absolute -top-1 -right-1 w-5 h-5 bg-red-500 text-white text-xs rounded-full flex items-center justify-center font-bold">
                            {{ (featuredArticles|default([])|length) + (latestArticles|default([])|length) }}
                        </span>
                    </button>
                    <button @click="switchTab('blogs')"
                            :class="activeTab === 'blogs' ? 'bg-purple-500 text-white shadow-lg' : 'text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800'"
                            class="relative w-12 h-12 flex items-center justify-center rounded-xl transition-all duration-300 group"
                            title="Блоги">
                        <i class="fas fa-blog text-xl"></i>
                        <span class="absolute -top-1 -right-1 w-5 h-5 bg-red-500 text-white text-xs rounded-full flex items-center justify-center font-bold">
                            {{ blogs|default([])|length }}
                        </span>
                    </button>
                    <button @click="switchTab('video')"
                            :class="activeTab === 'video' ? 'bg-red-500 text-white shadow-lg' : 'text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800'"
                            class="relative w-12 h-12 flex items-center justify-center rounded-xl transition-all duration-300 group"
                            title="Відео">
                        <i class="far fa-circle-play text-xl"></i>
                        <span class="absolute -top-1 -right-1 w-5 h-5 bg-red-500 text-white text-xs rounded-full flex items-center justify-center font-bold">
                            {{ videos|default([])|length }}
                        </span>
                    </button>
                </div>
            </div>


<!-- ПРАВА КОЛОНКА: КОНТЕНТ ВКЛАДОК -->
            <div class="flex-1 min-w-0">
                <!-- Універсальний рекламний блок (показується над усіма вкладками) -->
                {% set headerAd = ad_zone('header')|trim %}
                {% set hasAd = headerAd is not empty %}
                <div x-data="{ adOpen: {{ hasAd ? 'true' : 'false' }} }" class="mb-6">
                    <button @click="adOpen = !adOpen"
                            class="w-full flex items-center justify-between gap-2 px-4 py-2 rounded-lg bg-gray-100/80 dark:bg-gray-800/50 backdrop-blur-sm border border-gray-200 dark:border-gray-700 text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-200/80 dark:hover:bg-gray-700/50 transition-colors"
                            :aria-expanded="adOpen">
                        <span class="flex items-center gap-2">
                            <i class="fas fa-ad text-gray-500 dark:text-gray-400"></i>
                            <span>Реклама</span>
                            {% if hasAd %}
                                <span class="inline-flex items-center px-1.5 py-0.5 rounded-full text-xs font-medium bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400">активна</span>
                            {% endif %}
                        </span>
                        <i class="fas text-xs transition-transform duration-300" :class="adOpen ? 'fa-chevron-up' : 'fa-chevron-down'"></i>
                    </button>
                    <div x-show="adOpen" x-cloak x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 -translate-y-2" x-transition:enter-end="opacity-100 translate-y-0" class="mt-2">
                        {% if hasAd %}
                            <div class="w-full overflow-hidden rounded-xl shadow-md hover:shadow-lg transition-shadow duration-300">
                                {{ headerAd|raw }}
                            </div>
                        {% else %}
                            <div class="w-full rounded-xl border-2 border-dashed border-gray-300 dark:border-gray-600 bg-gray-50/80 dark:bg-gray-800/50 backdrop-blur-sm px-6 py-8 text-center">
                                <div class="mx-auto max-w-md">
                                    <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-gray-100 dark:bg-gray-700">
                                        <i class="fas fa-ad text-2xl text-gray-400 dark:text-gray-500"></i>
                                    </div>
                                    <h2 class="text-lg font-semibold text-gray-700 dark:text-gray-300">Тут могла бути ваша реклама</h2>
                                    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Розмістіть свій банер на найвиднішому місці сайту</p>
                                    <a href="{{ path('app_contact') }}" class="mt-4 inline-flex items-center gap-1.5 rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700 transition-colors">
                                        <i class="fas fa-envelope"></i> Зв'язатися з нами
                                    </a>
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>

                <!-- Вкладка: Новини -->
                <div x-show="activeTab === 'news'" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 translate-y-4" x-transition:enter-end="opacity-100 translate-y-0" class="space-y-8">
                    <!-- Заголовок новин -->
                    <div class="mb-8 backdrop-blur-sm bg-white/70 dark:bg-gray-900/30 p-6 rounded-2xl border border-gray-200/50 dark:border-white/20 shadow-sm animate-slide-in">
                        <div class="flex items-center justify-between mb-4">
                            <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 dark:text-white/90 flex items-center gap-3">
                                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-500 to-cyan-600 dark:from-blue-500/80 dark:to-cyan-600/80 text-white flex items-center justify-center shadow-md">
                                    <i class="fas fa-shekel-sign text-center"></i>
                                </div>
                                <span class="text-gray-900 dark:text-white">Новини</span>
                            </h2>
                            {% if app.user %}
                                <a href="{{ path('user_article_new') }}" class="inline-flex items-center gap-2 px-5 py-3 bg-gradient-to-r from-blue-500 to-cyan-600 dark:from-blue-500/80 dark:to-cyan-600/80 text-white rounded-2xl hover:shadow-xl hover:scale-105 active:scale-95 transition-all duration-300 group shadow-sm">
                                    <svg class="w-5 h-5 group-hover:rotate-180 transition-transform duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                                    </svg>
                                    <span class="font-bold">Додати</span>
                                </a>
                            {% endif %}
                        </div>
                        <p class="text-gray-600 dark:text-gray-300/70 max-w-3xl">Спільнота користувачів ділиться своїми думками, досвідом та ідеями.</p>
                    </div>

                    <!-- Головні новини -->
                    {% if featuredArticles|default([])|length > 0 %}
                        <section class="mb-12">
                            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                                {% for article in featuredArticles %}
                                    {% include 'components/article_card.html.twig' with {article: article, featured: true} %}
                                {% endfor %}
                            </div>
                        </section>
                    {% endif %}


                    <!-- Сітка новин -->
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                        <!-- Останні новини -->
                        <div class="lg:col-span-2">
                            <div class="mb-6 animate-slide-in" style="animation-delay: 0.1s">
                                <h2 class="text-2xl font-bold text-gray-900 dark:text-white/90 mb-4 flex items-center gap-3">
                                    <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-purple-500 to-pink-500 dark:from-purple-500/80 dark:to-pink-500/80 text-white flex items-center justify-center shadow-md">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                                        </svg>
                                    </div>
                                    <span class="text-gray-900 dark:text-white">Останні новини</span>
                                </h2>
                                <div class="space-y-4">
                                    {% for article in latestArticles|default([]) %}
                                        {% include 'components/article_card_small.html.twig' with {article: article} %}
                                    {% endfor %}
                                </div>
                                <div class="animate-fade-in" style="animation-delay: 0.3s">
                                    {% include 'components/quote_widget.html.twig' %}
                                </div>
                            </div>
                        </div>

                        <!-- Бічна панель -->
                        <aside class="space-y-6">
                            {% if categories|default([])|length > 0 %}
                                {% include 'components/sidebar.html.twig' with {categories: categories} %}
                            {% endif %}
                            {% if recommendedArticles|default([])|length > 0 %}
                                {% include 'components/recommended_sidebar.html.twig' with {articles: recommendedArticles} %}
                            {% endif %}
                        </aside>
                    </div>
                </div>

                <!-- Вкладка: Блоги -->
                <div x-show="activeTab === 'blogs'" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 translate-y-4" x-transition:enter-end="opacity-100 translate-y-0" class="space-y-6">
                    <div class="mb-8 backdrop-blur-sm bg-white/70 dark:bg-gray-900/30 p-6 rounded-2xl border border-gray-200/50 dark:border-white/20 shadow-sm animate-slide-in">
                        <div class="flex items-center justify-between mb-4">
                            <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 dark:text-white/90 flex items-center gap-3">
                                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-purple-500 to-pink-600 dark:from-purple-500/80 dark:to-pink-600/80 text-white flex items-center justify-center shadow-md">
                                    <i class="fas fa-blog w-5 text-center"></i>
                                </div>
                                <span class="text-gray-900 dark:text-white">Блоги спільноти</span>
                            </h2>
                            {% if app.user %}
                                <a href="{{ path('user_blog_new') }}" class="inline-flex items-center gap-2 px-5 py-3 bg-gradient-to-r from-purple-500 to-pink-600 dark:from-purple-500/80 dark:to-pink-600/80 text-white rounded-2xl hover:shadow-xl hover:scale-105 active:scale-95 transition-all duration-300 group shadow-sm">
                                    <svg class="w-5 h-5 group-hover:rotate-180 transition-transform duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                                    </svg>
                                    <span class="font-bold">Додати</span>
                                </a>
                            {% endif %}
                        </div>
                        <p class="text-gray-600 dark:text-gray-300/70 max-w-3xl">Спільнота користувачів ділиться своїми думками, досвідом та ідеями.</p>
                    </div>

                    {% if blogs|default([])|length > 0 %}
                        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                            <div class="lg:col-span-2">
                                <div class="mb-6 animate-slide-in" style="animation-delay: 0.1s">
                                    <h2 class="text-2xl font-bold text-gray-900 dark:text-white/90 mb-4 flex items-center gap-3">
                                        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-purple-500 to-pink-500 dark:from-purple-500/80 dark:to-pink-500/80 text-white flex items-center justify-center shadow-md">
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                                            </svg>
                                        </div>
                                        <span class="text-gray-900 dark:text-white">Останні блоги</span>
                                    </h2>
                                    <div class="space-y-4">
                                        {% for blog in blogs %}
                                            {% include 'components/blog_card.html.twig' with {blog: blog} %}
                                        {% endfor %}
                                    </div>
                                    <div class="animate-fade-in" style="animation-delay: 0.3s">
                                        {% include 'components/quote_widget.html.twig' %}
                                    </div>
                                </div>
                            </div>
                            <aside class="space-y-6">
                                {% if categories|default([])|length > 0 %}
                                    {% include 'components/sidebar.html.twig' with {categories: categories} %}
                                {% endif %}
                                {% if recommendedArticles|default([])|length > 0 %}
                                    {% include 'components/recommended_sidebar.html.twig' with {articles: recommendedArticles} %}
                                {% endif %}
                            </aside>
                        </div>
                    {% else %}
                        {% include 'components/empty_state.html.twig' with {
                            icon: '📝',
                            title: 'Блогів поки що немає',
                            message: 'Станьте першим автором блогу та поділіться своїми думками зі спільнотою!',
                            button_text: 'Створити блог',
                            button_link: path('user_blog_new'),
                            show_button: app.user
                        } %}
                    {% endif %}
                </div>

                <!-- Вкладка: Відео -->
                <div x-show="activeTab === 'video'" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 translate-y-4" x-transition:enter-end="opacity-100 translate-y-0" class="space-y-6">
                    <div class="mb-8 backdrop-blur-sm bg-white/70 dark:bg-gray-900/30 p-6 rounded-2xl border border-gray-200/50 dark:border-white/20 shadow-sm animate-slide-in">
                        <div class="flex items-center justify-between mb-4">
                            <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 dark:text-white/90 flex items-center gap-3">
                                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-red-500 to-purple-600 dark:from-red-500/80 dark:to-purple-600/80 text-white flex items-center justify-center shadow-md">
                                    <i class="far fa-circle-play text-center"></i>
                                </div>
                                <span class="text-gray-900 dark:text-white">Відео світу та не тільки..</span>
                            </h2>
                        </div>
                        <p class="text-gray-600 dark:text-gray-300/70 max-w-3xl">Актуальні відео, репортажі та цікаві моменти з життя.</p>
                    </div>

                    {% if videos|default([])|length > 0 %}
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
                            {% for video in videos|slice(0, 6) %}
                                {% include 'components/front/video/_card.html.twig' with {video: video} %}
                            {% endfor %}
                        </div>
                        <div class="text-center mt-8 animate-fade-in">
                            <a href="{{ path('app_video_index') }}" class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-red-500 to-purple-600 dark:from-red-500/80 dark:to-purple-600/80 text-white rounded-2xl hover:shadow-xl hover:scale-105 active:scale-95 transition-all duration-300 group shadow-sm">
                                <span class="font-bold">Переглянути всі відео</span>
                                <svg class="w-5 h-5 group-hover:translate-x-2 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                                </svg>
                            </a>
                        </div>
                    {% else %}
                        <div class="text-center py-16 bg-white/70 dark:bg-gray-900/30 backdrop-blur-sm rounded-2xl border border-gray-200 dark:border-gray-700/50">
                            <div class="inline-flex items-center justify-center w-20 h-20 bg-gradient-to-r from-red-500 to-purple-600 rounded-full mb-6">
                                <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                            </div>
                            <h3 class="text-2xl font-bold text-gray-900 dark:text-white/90 mb-3">Відео поки що немає</h3>
                            <p class="text-gray-600 dark:text-gray-300/70 mb-6 max-w-md mx-auto">Скоро тут з'являться цікаві відео. Заходьте пізніше!</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function homePage() {
    return {
        activeTab: 'news',
        init() {
            const savedTab = localStorage.getItem('activeTab');
            if (savedTab && ['news', 'blogs', 'video'].includes(savedTab)) {
                this.activeTab = savedTab;
            }
        },
        switchTab(tabName) {
            this.activeTab = tabName;
            localStorage.setItem('activeTab', tabName);
        }
    }
}
</script>

<style>
@keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-20px); }
}
.animate-float { animation: float 6s ease-in-out infinite; }
[x-cloak] { display: none !important; }
</style>
{% endblock %}