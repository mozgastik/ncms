{% extends 'base.html.twig' %}

{% block title %}Категорії{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Заголовок -->
    <div class="text-center mb-12">
        <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-4">Категорії</h1>
        <p class="text-lg text-gray-600 dark:text-gray-400">Оберіть категорію для перегляду контенту</p>
    </div>

    <!-- Сітка категорій -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for category in categories %}
            <a href="{{ path('app_category_show', {'slug': category.slug}) }}" 
               class="group relative bg-white dark:bg-gray-900/30 backdrop-blur-sm rounded-2xl p-6 border border-gray-200 dark:border-gray-700/50 hover:shadow-xl transition-all duration-300 hover:scale-[1.02]">
                
                <!-- Градієнтний фон при наведенні -->
                <div class="absolute inset-0 bg-gradient-to-r from-primary-500/10 to-purple-500/10 opacity-0 group-hover:opacity-100 rounded-2xl transition-opacity"></div>
                
                <!-- Іконка -->
                <div class="w-16 h-16 rounded-xl bg-gradient-to-br from-primary-500 to-purple-600 flex items-center justify-center text-white text-2xl mb-4 group-hover:scale-110 transition-transform">
                    {% if category.image %}
                      <span class="material-icons text-green-400 text-xl">{{ category.image }}</span>
                      {% else %}
                      <span class="material-icons text-green-400 text-xl">folder</span>
                    {% endif %}
                </div>
                
                <!-- Назва -->
                <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2 group-hover:text-primary-600 transition-colors">
                    {{ category.name }}
                </h3>
                
                <!-- Опис -->
                {% if category.description %}
                    <p class="text-gray-600 dark:text-gray-400 text-sm mb-4 line-clamp-2">
                        {{ category.description }}
                    </p>
                {% endif %}
                
                <!-- Статистика -->
                <div class="flex items-center gap-4 text-sm text-gray-500 dark:text-gray-400">
                    <span class="flex items-center gap-1">
                        <i class="fas fa-newspaper"></i>
                        {{ ((featuredArticles|default([])|length) + (latestArticles|default([])|length)) > 99 ? '99+' : (featuredArticles|default([])|length) + (latestArticles|default([])|length) }}
                    </span>
                    <span class="flex items-center gap-1">
                        <i class="fas fa-blog"></i>
                        {{ category.blogsCount }}
                    </span>
                    <span class="flex items-center gap-1">
                        <i class="fas fa-video"></i>
                        {{ category.videosCount }}
                    </span>
                </div>
                
                <!-- Стрілка -->
                <div class="absolute top-6 right-6 text-gray-400 group-hover:text-primary-500 group-hover:translate-x-1 transition-all">
                    <i class="fas fa-arrow-right"></i>
                </div>
            </a>
        {% endfor %}
    </div>
</div>
{% endblock %}