{% extends 'base.html.twig' %}

{% block title %}Відеотека - Всі відео{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-b from-gray-50 to-white dark:from-gray-900 dark:to-gray-950">
    
    <!-- Декоративні елементи -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none">
        <div class="absolute -top-40 -right-40 w-80 h-80 bg-red-500/5 dark:bg-red-500/10 rounded-full blur-3xl animate-float"></div>
        <div class="absolute -bottom-40 -left-40 w-80 h-80 bg-purple-500/5 dark:bg-purple-500/10 rounded-full blur-3xl animate-float" style="animation-delay: 1s"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        
        <!-- Заголовок сторінки -->
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 mb-8 animate-fade-in">
            <div class="backdrop-blur-sm bg-white/70 dark:bg-gray-900/30 p-6 rounded-2xl border border-gray-200/50 dark:border-white/20 shadow-sm">
                <h1 class="text-4xl lg:text-5xl font-bold mb-3">
                    <span class="bg-gradient-to-r from-red-600 via-purple-600 to-pink-600 dark:from-red-400 dark:via-purple-400 dark:to-pink-400 bg-clip-text text-transparent">
                        Відеотека
                    </span>
                </h1>
                <p class="text-lg text-gray-600 dark:text-gray-300/90 max-w-2xl">
                    Всі відео в одному місці: новини, репортажі, інтерв'ю та цікаві моменти
                </p>
            </div>
            
            <div class="flex flex-wrap gap-3">
                <a href="{{ path('app_home') }}" 
                   class="inline-flex items-center gap-2 px-5 py-3 bg-gradient-to-r from-gray-500 to-gray-600 dark:from-gray-500/80 dark:to-gray-600/80 text-white rounded-2xl hover:shadow-xl hover:scale-105 transition-all duration-300 group shadow-sm">
                    <svg class="w-5 h-5 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                    </svg>
                    <span class="font-bold">На головну</span>
                </a>
                
                {% if app.user %}
                <a href="{{ path('user_video_new') }}" 
                   class="inline-flex items-center gap-2 px-5 py-3 bg-gradient-to-r from-red-500 to-purple-600 dark:from-red-500/80 dark:to-purple-600/80 text-white rounded-2xl hover:shadow-xl hover:scale-105 active:scale-95 transition-all duration-300 group shadow-sm">
                    <svg class="w-5 h-5 group-hover:rotate-180 transition-transform duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    <span class="font-bold">Додати відео</span>
                </a>
                {% endif %}
            </div>
        </div>

        <!-- Категорії відео -->
        <div class="mb-8 animate-slide-in">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-xl font-bold text-gray-900 dark:text-white flex items-center gap-2">
                    <svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                    </svg>
                    <span>Категорії відео</span>
                </h2>
                
                {% if categories|length > 8 %}
                <a href="#all-categories" class="text-sm text-red-600 hover:text-red-700 flex items-center gap-1">
                    <span>Всі категорії</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                    </svg>
                </a>
                {% endif %}
            </div>
            
            <!-- Сітка категорій -->
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
                {% for category in categories|default([])|slice(0, 12) %}
                <a href="{{ path('app_video_category', {'id': category.id}) }}" 
                   class="group relative bg-white dark:bg-gray-800/30 backdrop-blur-sm rounded-xl p-4 border border-gray-200 dark:border-gray-700/50 hover:border-red-500/50 hover:shadow-lg transition-all duration-300 hover:-translate-y-1">
                    
                    <!-- Іконка категорії -->
                    
                    <div class="w-10 h-10 mx-auto mb-2 rounded-full bg-gradient-to-br from-red-500/20 to-purple-500/20 flex items-center justify-center group-hover:scale-110 transition-transform">
    {% if category.image %}
        <span class="material-icons text-red-500 text-xl">{{ category.image }}</span>
    {% else %}
        <span class="material-icons text-red-500 text-xl">folder</span>
    {% endif %}
</div>
                    
                    <!-- Назва категорії -->
                    <h3 class="text-sm font-medium text-gray-900 dark:text-white text-center group-hover:text-red-600 transition-colors">
                        {{ category.name }}
                    </h3>
                    
                    <!-- Кількість відео -->
                    <span class="absolute -top-2 -right-2 w-6 h-6 bg-red-500 text-white text-xs rounded-full flex items-center justify-center shadow-lg">
                        {{ category.videos|default([])|length }}
                    </span>
                </a>
                {% else %}
                <!-- Якщо категорій немає -->
                <div class="col-span-full text-center py-8 bg-white/50 dark:bg-gray-800/30 rounded-xl">
                    <p class="text-gray-500 dark:text-gray-400">Категорії відео поки що не створені</p>
                </div>
                {% endfor %}
            </div>
        </div>

        <!-- Фільтри -->
        <div class="glass-light rounded-xl p-4 mb-8 border border-gray-200 dark:border-gray-700/50 animate-slide-in">
            <form method="get" action="" class="flex flex-wrap gap-4 items-center">
                <div class="flex-1 min-w-[250px]">
                    <div class="relative">
                        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">
                            <i class="fas fa-search"></i>
                        </span>
                        <input type="text" 
                               name="search" 
                               value="{{ app.request.query.get('search') }}"
                               placeholder="Пошук відео за назвою..."
                               class="w-full pl-12 pr-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 focus:ring-2 focus:ring-red-500/50 focus:border-transparent transition-all">
                    </div>
                </div>
                
                <div class="w-48">
                    <select name="sort" 
                            class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 focus:ring-2 focus:ring-red-500/50 focus:border-transparent transition-all">
                        <option value="newest" {{ app.request.query.get('sort') == 'newest' ? 'selected' : '' }}>Спочатку нові</option>
                        <option value="oldest" {{ app.request.query.get('sort') == 'oldest' ? 'selected' : '' }}>Спочатку старі</option>
                        <option value="popular" {{ app.request.query.get('sort') == 'popular' ? 'selected' : '' }}>Найпопулярніші</option>
                        <option value="views" {{ app.request.query.get('sort') == 'views' ? 'selected' : '' }}>За переглядами</option>
                    </select>
                </div>
                
                <button type="submit" 
                        class="px-6 py-3 bg-gradient-to-r from-red-500 to-purple-600 text-white rounded-xl hover:shadow-lg hover:scale-105 transition-all duration-300 flex items-center gap-2">
                    <i class="fas fa-filter"></i>
                    <span>Застосувати</span>
                </button>
                
                {% if app.request.query.all|length > 0 %}
                <a href="{{ path('app_video_index') }}" 
                   class="px-4 py-3 glass-light rounded-xl hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors flex items-center gap-2">
                    <i class="fas fa-times"></i>
                    <span>Скинути</span>
                </a>
                {% endif %}
            </form>
        </div>

        <!-- Заголовок з кількістю відео -->
        <div class="flex items-center justify-between mb-6 animate-fade-in">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white flex items-center gap-3">
                <span>Всі відео</span>
                <span class="px-3 py-1 text-sm bg-gradient-to-r from-red-500 to-purple-600 text-white rounded-full">
                    {{ videos|length }}
                </span>
            </h2>
            
            <!-- Вид відображення (grid/list) -->
            <div class="flex gap-2">
                <button class="w-10 h-10 rounded-lg bg-red-500 text-white flex items-center justify-center" title="Сітка">
                    <i class="fas fa-th"></i>
                </button>
                <button class="w-10 h-10 rounded-lg glass-light hover:bg-gray-100 dark:hover:bg-gray-800 flex items-center justify-center" title="Список">
                    <i class="fas fa-list"></i>
                </button>
            </div>
        </div>

        <!-- Список відео -->
        {% if videos|default([])|length > 0 %}
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 mb-8">
                {% for video in videos %}
                    {% include 'front/video/_card.html.twig' with {video: video} %}
                {% endfor %}
            </div>
            
            <!-- Пагінація -->
            {% if totalPages is defined and totalPages > 1 %}
            <div class="flex justify-center mt-8">
                <div class="flex gap-2">
                    {% if currentPage > 1 %}
                    <a href="{{ path('app_video_index', {page: currentPage - 1, search: app.request.query.get('search'), sort: app.request.query.get('sort')}) }}" 
                       class="w-10 h-10 flex items-center justify-center rounded-lg glass-light hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
                        <i class="fas fa-chevron-left"></i>
                    </a>
                    {% endif %}
                    
                    {% for i in 1..totalPages %}
                        <a href="{{ path('app_video_index', {page: i, search: app.request.query.get('search'), sort: app.request.query.get('sort')}) }}" 
                           class="w-10 h-10 flex items-center justify-center rounded-lg transition-colors {{ i == currentPage ? 'bg-gradient-to-r from-red-500 to-purple-600 text-white shadow-md' : 'glass-light hover:bg-gray-100 dark:hover:bg-gray-800' }}">
                            {{ i }}
                        </a>
                    {% endfor %}
                    
                    {% if currentPage < totalPages %}
                    <a href="{{ path('app_video_index', {page: currentPage + 1, search: app.request.query.get('search'), sort: app.request.query.get('sort')}) }}" 
                       class="w-10 h-10 flex items-center justify-center rounded-lg glass-light hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
                        <i class="fas fa-chevron-right"></i>
                    </a>
                    {% endif %}
                </div>
            </div>
            {% endif %}
            
        {% else %}
            <!-- Пустий стан -->
            <div class="text-center py-16 bg-white/70 dark:bg-gray-900/30 backdrop-blur-sm rounded-2xl border border-gray-200 dark:border-gray-700/50">
                <div class="inline-flex items-center justify-center w-24 h-24 bg-gradient-to-r from-red-500 to-purple-600 rounded-full mb-6">
                    <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
                <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-3">
                    Відео не знайдено
                </h3>
                <p class="text-gray-600 dark:text-gray-300/70 mb-6 max-w-md mx-auto">
                    {% if app.request.query.get('search') %}
                        За запитом "{{ app.request.query.get('search') }}" нічого не знайдено.
                    {% else %}
                        На сайті ще немає відео. Додайте перше відео!
                    {% endif %}
                </p>
                
                <div class="flex gap-4 justify-center">
                    {% if app.request.query.all|length > 0 %}
                    <a href="{{ path('app_video_index') }}" 
                       class="px-6 py-3 glass-light rounded-xl hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors flex items-center gap-2">
                        <i class="fas fa-times"></i>
                        <span>Скинути фільтри</span>
                    </a>
                    {% endif %}
                    
                    {% if app.user %}
                    <a href="{{ path('user_video_new') }}" 
                       class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-red-500 to-purple-600 text-white rounded-xl hover:scale-105 transition-all duration-300 shadow-lg">
                        <i class="fas fa-plus"></i>
                        <span>Додати відео</span>
                    </a>
                    {% endif %}
                </div>
            </div>
        {% endif %}
        
        <!-- Всі категорії (якщо їх багато) -->
        {% if categories|length > 12 %}
        <div id="all-categories" class="mt-12 pt-8 border-t border-gray-200 dark:border-gray-700">
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Всі категорії відео</h3>
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
                {% for category in categories|slice(12) %}
                <a href="{{ path('app_video_category', {'id': category.id}) }}" 
                   class="group flex items-center gap-2 p-3 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800/30 transition-colors">
                    <span class="text-red-500">
                        <i class="fas fa-folder"></i>
                    </span>
                    <span class="text-sm text-gray-700 dark:text-gray-300 group-hover:text-red-600">{{ category.name }}</span>
                    <span class="ml-auto text-xs text-gray-500">({{ category.videos|length }})</span>
                </a>
                {% endfor %}
            </div>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}