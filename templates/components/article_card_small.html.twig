<article class="group bg-white dark:bg-gray-900/30 backdrop-blur-sm rounded-2xl shadow-md hover:shadow-xl transition-all duration-500 overflow-hidden hover:scale-[1.02] active:scale-95 border border-gray-200 dark:border-gray-700/50">
    <div class="p-4 sm:p-5">
        <div class="flex flex-col sm:flex-row gap-4 sm:gap-5">
            
            <!-- ========================================== -->
            <!-- БЛОК: ДАТА + ЗОБРАЖЕННЯ (як одне ціле) -->
            <!-- ========================================== -->
            <div class="sm:w-2/5 lg:w-1/3 flex-shrink-0">
                <div class="flex flex-row h-48 sm:h-56 md:h-64 overflow-hidden rounded-2xl border border-gray-200/50 dark:border-gray-700/50">
                    
                    <!-- ДАТА (ліва частина) - склоподібна -->
                    <div class="flex flex-col items-center justify-center px-3 py-4 w-[70px] flex-shrink-0
                                bg-gradient-to-b from-blue-50/90 to-purple-50/90 dark:from-blue-950/40 dark:to-purple-950/40
                                backdrop-blur-sm
                                border-r border-gray-200/50 dark:border-gray-700/50">
                        <time datetime="{{ article.publishedAt ? article.publishedAt|date('Y-m-d') : '' }}" 
                              class="flex flex-col items-center gap-0.5 text-center">
                            
                            <!-- День -->
                            <span class="text-2xl font-bold text-gray-900 dark:text-white leading-none">
                                {{ article.publishedAt ? article.publishedAt|date('d') : '--' }}
                            </span>
                            
                            <!-- Місяць -->
                            <span class="text-[10px] font-semibold text-blue-600 dark:text-blue-400 uppercase tracking-wider mt-0.5">
                                {{ article.publishedAt ? article.publishedAt|month_uk(true) : '---' }}
                            </span>
                            
                            <!-- Роздільник -->
                            <span class="w-5 h-px bg-gradient-to-r from-transparent via-gray-300 dark:via-gray-600 to-transparent my-1.5"></span>
                            
                            <!-- Рік -->
                            <span class="text-[9px] font-medium text-gray-500 dark:text-gray-400">
                                {{ article.publishedAt ? article.publishedAt|date('Y') : '----' }}
                            </span>
                            
                            <!-- Час читання -->
                            <span class="flex items-center gap-1 text-[8px] text-gray-400 dark:text-gray-500 mt-1">
                                <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                                {{ (article.content|striptags|split(' ')|length / 200)|round(0, 'ceil') }} хв
                            </span>
                        </time>
                    </div>
                    
                    <!-- ЗОБРАЖЕННЯ (права частина) -->
                    {% if article.coverImage %}
                    <div class="flex-1 relative overflow-hidden">
                        <img src="{{ vich_uploader_asset(article, 'coverImageFile') }}"
                             alt="{{ article.title }}" 
                             class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700">
                        
                        <!-- Склоподібний оверлей при наведенні -->
                        <div class="absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                        
                        <!-- Категорія (нижній лівий кут) -->
                        {% if article.category %}
                        <div class="absolute bottom-3 left-3 z-10">
                            <a href="{{ path('app_category_show', {slug: article.category.slug}) }}"
                               class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl 
                                      bg-white/15 dark:bg-black/25 
                                      backdrop-blur-md backdrop-saturate-150
                                      border border-white/25 dark:border-white/10 
                                      shadow-[0_8px_32px_rgba(0,0,0,0.12)] 
                                      hover:bg-white/25 dark:hover:bg-black/35 
                                      hover:border-white/35 dark:hover:border-white/20
                                      hover:shadow-[0_8px_40px_rgba(59,130,246,0.2)] 
                                      transition-all duration-300 group/cat
                                      hover:scale-105 active:scale-95">
                                
                                <span class="material-icons text-[10px] text-blue-400 dark:text-blue-300 group-hover/cat:rotate-12 transition-transform duration-300">
                                    {{ article.category.image|default('folder_open') }}
                                </span>
                                
                                <span class="text-[9px] font-medium text-white/90 dark:text-white/80 tracking-wide">
                                    {{ article.category.name }}
                                </span>
                            </a>
                        </div>
                        {% endif %}
                        
                        <!-- Час читання (верхній правий кут, тільки на мобільних) -->
                        <div class="absolute top-3 right-3 backdrop-blur-md bg-black/40 border border-white/20 rounded-full px-2.5 py-1 shadow-lg sm:hidden">
                            <span class="flex items-center gap-1.5 text-white text-[10px] font-medium">
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                                {{ (article.content|striptags|split(' ')|length / 200)|round(0, 'ceil') }} хв
                            </span>
                        </div>
                    </div>
                    {% else %}
                    <!-- Заглушка якщо немає зображення -->
                    <div class="flex-1 bg-gradient-to-br from-blue-100 to-purple-100 dark:from-blue-900/30 dark:to-purple-900/30 flex items-center justify-center">
                        <svg class="w-12 h-12 text-gray-400 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
                        </svg>
                    </div>
                    {% endif %}
                </div>
            </div>
            
            <!-- ========================================== -->
            <!-- КОНТЕНТ -->
            <!-- ========================================== -->
            <div class="flex-1 flex flex-col min-w-0">
                <!-- Заголовок -->
                <h3 class="text-lg sm:text-xl font-bold text-gray-900 dark:text-white/90 mb-1.5 line-clamp-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                    <a href="{{ path('app_article_show', {slug: article.slug}) }}" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
                        {{ article.title }}
                    </a>
                </h3>
                
                <!-- Мета-інформація (компактна) -->
                <div class="flex flex-wrap items-center gap-2 mb-2.5 text-xs text-gray-500 dark:text-gray-400">
                    <span class="flex items-center gap-1 bg-blue-50/50 dark:bg-blue-900/20 px-2 py-0.5 rounded-full">
                        <svg class="w-3.5 h-3.5 text-blue-500 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                        </svg>
                        {{ article.publishedAt ? article.publishedAt|date('d.m.Y') : 'Не опубліковано' }}
                    </span>
                </div>
                
                <!-- Короткий опис -->
                <p class="text-gray-600 dark:text-gray-300/70 mb-3 line-clamp-2 text-sm leading-relaxed flex-1">
                    {{ clean_excerpt(article, 200) }}...
                </p>
                
                <!-- Теги -->
                {% if article.tags|length > 0 %}
                <div class="flex flex-wrap items-center gap-1.5 mb-3">
                    {% for tag in article.tags|slice(0, 3) %}
                        <a href="{{ path('app_tag_show', {slug: tag.slug}) }}"
                           class="inline-flex items-center gap-0.5 px-2 py-0.5 bg-gray-100/70 dark:bg-gray-700/30 text-gray-600 dark:text-gray-400 text-[10px] font-medium rounded-full hover:bg-gray-200 dark:hover:bg-gray-600/50 transition-colors border border-gray-200/50 dark:border-gray-700/30 backdrop-blur-sm">
                            <span class="text-blue-400 dark:text-blue-500 text-[8px]">#</span>
                            {{ tag.name }}
                        </a>
                    {% endfor %}
                    {% if article.tags|length > 3 %}
                        <span class="text-[10px] text-gray-400 dark:text-gray-500">+{{ article.tags|length - 3 }}</span>
                    {% endif %}
                </div>
                {% endif %}
                
                <!-- Нижня панель -->
                <div class="flex flex-wrap items-center justify-between gap-2 pt-3 border-t border-gray-200 dark:border-gray-700/50">
                    <!-- Статистика -->
                    <div class="flex items-center gap-3 text-xs text-gray-500 dark:text-gray-400">
                        <span class="flex items-center gap-1">
                            <svg class="w-3.5 h-3.5 text-blue-400 dark:text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                            </svg>
                            {{ article.views|default(0) }}
                        </span>
                        
                        <span class="flex items-center gap-1">
                            <svg class="w-3.5 h-3.5 text-purple-400 dark:text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                            </svg>
                            {{ article.articleComments|length }}
                        </span>
                        
                        {% if article.author %}
                        <span class="flex items-center gap-1">
                            <svg class="w-3.5 h-3.5 text-amber-400 dark:text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                            </svg>
                            {{ article.author.username }}
                        </span>
                        {% endif %}
                    </div>
                    
                    <!-- Кнопка "Читати" -->
                    <a href="{{ path('app_article_show', {slug: article.slug}) }}" 
                       class="relative inline-flex items-center gap-1.5 px-4 py-2 bg-gradient-to-r from-blue-500 to-blue-600 dark:from-blue-600 dark:to-purple-600 text-white text-xs font-semibold rounded-xl transition-all duration-300 hover:scale-105 hover:shadow-lg active:scale-95 shadow-md shadow-blue-500/20 dark:shadow-purple-500/20 overflow-hidden group/btn flex-shrink-0">
                        <span class="absolute inset-0 bg-gradient-to-r from-blue-400 to-purple-500 opacity-0 group-hover/btn:opacity-20 transition-opacity duration-300"></span>
                        <span class="relative flex items-center gap-1.5">
                            Читати
                            <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover/btn:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                            </svg>
                        </span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</article>