{% set reading_time = blog.content ? (blog.content|striptags|split(' ')|length / 200)|round : 1 %}
{% set excerpt = blog.excerpt ?: (blog.content ? blog.content|striptags|slice(0, 100) ~ '...' : '') %}

<article class="group bg-white dark:bg-gray-900/30 backdrop-blur-sm rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden hover:scale-[1.01] active:scale-95 border border-gray-200 dark:border-gray-700/50">
    <div class="p-5">
        <div class="flex flex-col md:flex-row gap-3">
            <!-- Зображення -->
            {% if blog.getFeaturedImage() %}
            <div class="md:w-2/5 lg:w-1/3 relative">
                <div class="relative overflow-hidden rounded-xl h-56">
                    <img src="{{ asset('uploads/blogs/' ~ blog.getFeaturedImage().filename) }}" 
                         alt="{{ blog.getFeaturedImage().altText|default(blog.title) }}" 
                         class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
                    <div class="absolute top-2 left-2">
                        <span class="px-2 py-1 bg-black/70 text-white text-xs font-bold rounded">
                            {{ reading_time < 1 ? 1 : reading_time }} хв
                        </span>
                    </div>
                </div>
            </div>
            {% endif %}
            
            <!-- Контент -->
            <div class="flex-1">
                <h3 class="text-lg font-bold text-gray-900 dark:text-white/90 mb-2 line-clamp-2">
                    <a href="{{ path('blog_show', {'slug': blog.slug}) }}" 
                       class="hover:text-purple-600 dark:hover:text-purple-400 transition-colors">
                        {{ blog.title }}
                    </a>
                </h3>
                
                <div class="flex flex-wrap items-center gap-3 mb-3 text-sm text-gray-500 dark:text-gray-400">
                    {% if blog.category %}
                    <a href="{{ path('blog_category', {'slug': blog.category.slug}) }}"
                       class="inline-flex items-center gap-1 px-2 py-1 bg-purple-100 dark:bg-purple-900/20 text-purple-600 dark:text-purple-400 text-xs font-medium rounded-full hover:bg-purple-200 dark:hover:bg-purple-800/20 transition-colors">
                        {{ blog.category.name }}
                    </a>
                    {% endif %}
                    
                    <span class="flex items-center gap-1">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/>
                        </svg>
                        {{ blog.publishedAt ? blog.publishedAt|date('d.m.Y') : 'Не опубліковано' }}
                    </span>
                </div>
                
                <p class="text-gray-600 dark:text-gray-300/70 mb-3 line-clamp-2">
                    {{ excerpt }}
                </p>
                
                <div class="flex items-center justify-between pt-3 border-t border-gray-200 dark:border-gray-700/50">
                    <div class="flex items-center gap-4">
                        <span class="flex items-center gap-1 text-sm text-gray-500 dark:text-gray-400">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                            </svg>
                            {{ blog.viewCount|default(0) }}
                        </span>
                        <span class="flex items-center gap-1 text-sm text-gray-500 dark:text-gray-400">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                            </svg>
                            {{ blog.comments|default([])|length }}
                        </span>
                    </div>
                    
                    <a href="{{ path('blog_show', {'slug': blog.slug}) }}" 
                       class="inline-flex items-center gap-1 px-3 py-1.5 bg-purple-100 dark:bg-purple-900/20 text-purple-600 dark:text-purple-400 text-sm font-medium rounded-lg hover:bg-purple-200 dark:hover:bg-purple-800/20 transition-colors">
                        Читати
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </div>
</article>