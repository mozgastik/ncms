{# templates/maintenance.html.twig #}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if settings.title %}{{ settings.title }}{% else %}Сайт на обслуговуванні{% endif %}</title>
    
    {# Tailwind CSS #}
    <script src="https://cdn.tailwindcss.com"></script>
    
    {# Font Awesome #}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        /* ========================================== */
        /* КОЛЬОРОВА ГАМА */
        /* ========================================== */
        
        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
            background: #0f0c29;
            background: linear-gradient(135deg, #0f0c29 0%, #302b63 50%, #24243e 100%);
            position: relative;
            overflow-y: auto;
        }
        
        /* Анімовані хвилі */
        .waves {
            position: fixed;
            inset: 0;
            overflow: hidden;
            z-index: 0;
            pointer-events: none;
        }
        
        .wave {
            position: absolute;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.03);
            animation: waveMove 20s ease-in-out infinite;
        }
        
        .wave:nth-child(1) {
            width: 600px;
            height: 600px;
            top: -300px;
            right: -150px;
            animation-delay: 0s;
            background: rgba(99, 102, 241, 0.08);
        }
        
        .wave:nth-child(2) {
            width: 400px;
            height: 400px;
            bottom: -200px;
            left: -100px;
            animation-delay: -5s;
            background: rgba(139, 92, 246, 0.08);
        }
        
        .wave:nth-child(3) {
            width: 300px;
            height: 300px;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            animation-delay: -10s;
            background: rgba(59, 130, 246, 0.05);
        }
        
        @keyframes waveMove {
            0%, 100% { transform: translate(0, 0) scale(1) rotate(0deg); }
            25% { transform: translate(30px, -20px) scale(1.05) rotate(5deg); }
            50% { transform: translate(-20px, 30px) scale(0.95) rotate(-5deg); }
            75% { transform: translate(20px, -15px) scale(1.02) rotate(3deg); }
        }
        
        /* Частинки */
        .particles {
            position: fixed;
            inset: 0;
            z-index: 0;
            overflow: hidden;
            pointer-events: none;
        }
        
        .particle {
            position: absolute;
            width: 2px;
            height: 2px;
            background: rgba(255, 255, 255, 0.25);
            border-radius: 50%;
            animation: floatParticle 15s linear infinite;
        }
        
        .particle:nth-child(1) { top: 10%; left: 20%; animation-delay: 0s; }
        .particle:nth-child(2) { top: 30%; left: 80%; animation-delay: -3s; }
        .particle:nth-child(3) { top: 60%; left: 10%; animation-delay: -6s; }
        .particle:nth-child(4) { top: 80%; left: 70%; animation-delay: -9s; }
        .particle:nth-child(5) { top: 20%; left: 50%; animation-delay: -12s; }
        .particle:nth-child(6) { top: 70%; left: 40%; animation-delay: -2s; }
        .particle:nth-child(7) { top: 40%; left: 30%; animation-delay: -7s; }
        .particle:nth-child(8) { top: 90%; left: 90%; animation-delay: -4s; }
        
        @keyframes floatParticle {
            0%, 100% { transform: translate(0, 0) scale(1); opacity: 0.3; }
            25% { transform: translate(40px, -80px) scale(1.5); opacity: 0.8; }
            50% { transform: translate(-20px, -150px) scale(0.8); opacity: 0.2; }
            75% { transform: translate(20px, -100px) scale(1.2); opacity: 0.6; }
        }
        
        /* Головна картка */
        .main-card {
            position: relative;
            z-index: 1;
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            border-radius: 1.5rem;
            max-width: 700px;
            width: 100%;
            margin: 0 auto;
        }
        
        /* Градієнтний текст */
        .gradient-text {
            background: linear-gradient(135deg, #a78bfa, #60a5fa, #34d399);
            background-size: 300% 300%;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            animation: gradientShift 4s ease-in-out infinite;
        }
        
        @keyframes gradientShift {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }
        
        /* Прогрес-бар */
        .progress-glow {
            box-shadow: 0 0 15px rgba(99, 102, 241, 0.2);
        }
        
        .progress-bar-transition {
            transition: width 0.5s ease, background-color 0.5s ease;
        }
        
        /* Анімації */
        @keyframes pulse {
            0%, 100% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.05); opacity: 0.8; }
        }
        
        @keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .fade-in-up { animation: fadeInUp 0.6s ease forwards; }
        .icon-glow { filter: drop-shadow(0 0 15px rgba(99, 102, 241, 0.2)); }
        
        .timer-pulse {
            animation: timerPulse 2s ease-in-out infinite;
        }
        
        @keyframes timerPulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.7; }
        }
        
        /* Скролл бар */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.05);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(99, 102, 241, 0.3);
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(99, 102, 241, 0.5);
        }
    </style>
</head>

<body>
    <!-- ========================================== -->
    <!-- ФОНОВІ ЕФЕКТИ -->
    <!-- ========================================== -->
    
    <div class="waves">
        <div class="wave"></div>
        <div class="wave"></div>
        <div class="wave"></div>
    </div>
    
    <div class="particles">
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
    </div>
    
    <!-- ========================================== -->
    <!-- ОСНОВНИЙ КОНТЕНТ -->
    <!-- ========================================== -->
    
    <div class="main-card p-6 md:p-8 text-center fade-in-up">
        
        <!-- Іконка -->
        <div class="mb-5">
            <div class="w-20 h-20 mx-auto mb-4 rounded-full bg-gradient-to-br from-indigo-500/20 to-purple-500/20 flex items-center justify-center border-2 border-indigo-400/30 icon-glow" 
                 style="animation: pulse 2s ease-in-out infinite;">
                <i class="fas fa-sync-alt text-indigo-400 text-3xl" 
                   style="animation: spin 8s linear infinite;"></i>
            </div>
            
            <h1 class="text-2xl md:text-4xl font-bold mb-2 gradient-text">
                {{ settings.title|default('Сайт оновлюється') }}
            </h1>
            
            <p class="text-sm md:text-base text-white/70 max-w-lg mx-auto leading-relaxed">
                {{ settings.message|default('Ми працюємо над покращенням вашого досвіду. Це займе зовсім небагато часу.') }}
            </p>
        </div>

        <!-- Статус -->
        <div class="flex flex-wrap items-center justify-center gap-2 mb-5 text-xs">
            <span class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/20 border border-green-400/30">
                <span class="w-1.5 h-1.5 bg-green-400 rounded-full animate-pulse"></span>
                <span class="text-white/80">Технічні роботи</span>
            </span>
            <span class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-blue-500/20 border border-blue-400/30">
                <i class="fas fa-clock text-blue-400 text-xs"></i>
                <span class="text-white/80">Оновлення</span>
            </span>
            <span class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-purple-500/20 border border-purple-400/30">
                <i class="fas fa-shield-alt text-purple-400 text-xs"></i>
                <span class="text-white/80">Безпека</span>
            </span>
        </div>

        <!-- ========================================== -->
        <!-- ТАЙМЕР -->
        <!-- ========================================== -->
        
        {# Перевіряємо чи є час завершення та чи він ще не минув #}
        {% if remaining is defined and remaining is not null and remaining > 0 %}
            
            <div class="bg-black/20 backdrop-blur-sm rounded-xl p-4 md:p-6 mb-5 border border-white/10">
                
                <div class="flex items-center justify-center gap-2 mb-3">
                    <i class="fas fa-hourglass-half text-yellow-400 text-sm"></i>
                    <span class="text-xs font-medium text-white/60">До завершення:</span>
                </div>
                
                <!-- Таймер -->
                <div class="timer-pulse">
                    <div id="timer" 
                         class="text-4xl md:text-6xl font-mono font-bold text-white mb-4 tracking-wider"
                         x-data="timer({{ remaining }})"
                         x-init="init()">
                        <span x-text="time"></span>
                    </div>
                </div>

                <!-- Прогрес-бар -->
                <div class="relative w-full bg-white/10 rounded-full h-2 overflow-hidden progress-glow">
                    <div id="progressBar" 
                         class="h-full progress-bar-transition rounded-full relative"
                         :class="progressClass"
                         :style="'width: ' + progress + '%'"
                         x-data="progress({{ remaining }})"
                         x-init="initProgress()">
                        <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white to-transparent opacity-20 animate-pulse"></div>
                    </div>
                    
                    <div class="absolute inset-0 flex items-center justify-center">
                        <span class="text-[8px] font-bold text-white drop-shadow-md" x-text="Math.round(progress) + '%'"></span>
                    </div>
                </div>

                <!-- Статус -->
                <div id="statusText" 
                     class="mt-3 text-xs font-medium flex items-center justify-center gap-1.5"
                     :class="statusClass"
                     x-data="status({{ remaining }})"
                     x-init="initStatus()">
                    <i class="fas text-[10px]" :class="statusIcon"></i>
                    <span x-text="statusText"></span>
                </div>
            </div>
            
        {% else %}
            <!-- Якщо час не вказано або вже минув -->
            <div class="bg-yellow-500/20 border border-yellow-400/30 rounded-xl p-4 mb-5">
                <div class="flex items-center justify-center gap-2 text-yellow-300 text-sm">
                    <i class="fas fa-exclamation-triangle"></i>
                    <span>Технічні роботи тривають. Спробуйте пізніше.</span>
                </div>
            </div>
        {% endif %}

        <!-- ========================================== -->
        <!-- ДОДАТКОВА ІНФОРМАЦІЯ -->
        <!-- ========================================== -->
        
        <div class="grid grid-cols-3 gap-2 mb-5">
            <div class="bg-white/5 rounded-lg p-2 border border-white/10 hover:bg-white/10 transition-all duration-300">
                <div class="flex items-center justify-center gap-1.5 mb-1">
                    <i class="fas fa-bolt text-yellow-400 text-xs"></i>
                    <span class="text-[10px] font-medium text-white/70">Швидкість</span>
                </div>
                <p class="text-[9px] text-white/50">Оптимізація</p>
            </div>
            
            <div class="bg-white/5 rounded-lg p-2 border border-white/10 hover:bg-white/10 transition-all duration-300">
                <div class="flex items-center justify-center gap-1.5 mb-1">
                    <i class="fas fa-shield-alt text-green-400 text-xs"></i>
                    <span class="text-[10px] font-medium text-white/70">Безпека</span>
                </div>
                <p class="text-[9px] text-white/50">Захист</p>
            </div>
            
            <div class="bg-white/5 rounded-lg p-2 border border-white/10 hover:bg-white/10 transition-all duration-300">
                <div class="flex items-center justify-center gap-1.5 mb-1">
                    <i class="fas fa-rocket text-purple-400 text-xs"></i>
                    <span class="text-[10px] font-medium text-white/70">Дизайн</span>
                </div>
                <p class="text-[9px] text-white/50">Інтерфейс</p>
            </div>
        </div>

        <!-- Контакти та соціальні мережі -->
        <div class="flex flex-wrap items-center justify-center gap-3 pt-4 border-t border-white/10">
            {% if settings.contactEmail %}
                <a href="mailto:{{ settings.contactEmail }}" 
                   class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/10 hover:bg-white/20 transition-all text-xs text-white/60 hover:text-white">
                    <i class="fas fa-envelope text-[10px]"></i>
                    <span>{{ settings.contactEmail|slice(0, 20) }}</span>
                </a>
            {% endif %}
            
            {% if settings.contactPhone %}
                <a href="tel:{{ settings.contactPhone }}" 
                   class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/10 hover:bg-white/20 transition-all text-xs text-white/60 hover:text-white">
                    <i class="fas fa-phone text-[10px]"></i>
                    <span>{{ settings.contactPhone }}</span>
                </a>
            {% endif %}
            
            {% if settings.socialLinks is defined and settings.socialLinks %}
                {% for platform, url in settings.socialLinks %}
                    {% if url %}
                        <a href="{{ url }}" 
                           target="_blank"
                           class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/10 hover:bg-white/20 transition-all text-xs text-white/60 hover:text-white">
                            <i class="fab fa-{{ platform }} text-[10px]"></i>
                            <span class="capitalize">{{ platform }}</span>
                        </a>
                    {% endif %}
                {% endfor %}
            {% endif %}
            
            <span class="text-[10px] text-white/40">
                <i class="fas fa-clock mr-1"></i>
                <span id="currentTime"></span>
            </span>
        </div>

        <!-- Футер -->
        <div class="mt-4 pt-3 border-t border-white/10">
            <p class="text-[10px] text-white/30">
                Дякуємо за терпіння! 
                <span class="text-white/40">AdNews.FUN</span>
            </p>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- JAVASCRIPT -->
    <!-- ========================================== -->
    
    {% if remaining is defined and remaining is not null and remaining > 0 %}
    <script>
        document.addEventListener('alpine:init', () => {
            // Таймер
            Alpine.data('timer', (initial) => ({
                time: '',
                remaining: initial,
                init() {
                    this.updateDisplay(initial);
                    setInterval(() => {
                        this.remaining--;
                        this.updateDisplay(this.remaining);
                    }, 1000);
                },
                updateDisplay(seconds) {
                    if (seconds < 0) seconds = 0;
                    const h = Math.floor(seconds / 3600);
                    const m = Math.floor((seconds % 3600) / 60);
                    const s = seconds % 60;
                    this.time = `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
                    
                    if (seconds <= 0) {
                        setTimeout(() => location.reload(), 2000);
                    }
                }
            }));

            // Прогрес
            Alpine.data('progress', (initial) => ({
                progress: 100,
                total: initial || 1,
                progressClass: 'h-full bg-gradient-to-r from-green-500 to-emerald-500 progress-bar-transition rounded-full relative',
                initProgress() {
                    this.updateProgress(initial);
                    setInterval(() => {
                        const remaining = document.querySelector('#timer')?.__x?.remaining || 0;
                        this.updateProgress(remaining);
                    }, 1000);
                },
                updateProgress(remaining) {
                    const percent = Math.max(0, (remaining / this.total) * 100);
                    this.progress = percent;
                    
                    if (percent > 70) {
                        this.progressClass = 'h-full bg-gradient-to-r from-green-500 to-emerald-500 progress-bar-transition rounded-full relative';
                    } else if (percent > 40) {
                        this.progressClass = 'h-full bg-gradient-to-r from-yellow-500 to-amber-500 progress-bar-transition rounded-full relative';
                    } else if (percent > 20) {
                        this.progressClass = 'h-full bg-gradient-to-r from-orange-500 to-red-500 progress-bar-transition rounded-full relative';
                    } else {
                        this.progressClass = 'h-full bg-gradient-to-r from-red-500 to-rose-600 progress-bar-transition rounded-full relative';
                    }
                }
            }));

            // Статус
            Alpine.data('status', (initial) => ({
                statusText: 'Робота триває нормально',
                statusIcon: 'fa-check-circle',
                statusClass: 'mt-3 text-xs font-medium flex items-center justify-center gap-1.5 text-green-400',
                initStatus() {
                    this.updateStatus(initial);
                    setInterval(() => {
                        const remaining = document.querySelector('#timer')?.__x?.remaining || 0;
                        this.updateStatus(remaining);
                    }, 1000);
                },
                updateStatus(remaining) {
                    const percent = Math.max(0, (remaining / (initial || 1)) * 100);
                    
                    if (percent > 70) {
                        this.statusText = 'Робота триває';
                        this.statusIcon = 'fa-check-circle';
                        this.statusClass = 'mt-3 text-xs font-medium flex items-center justify-center gap-1.5 text-green-400';
                    } else if (percent > 40) {
                        this.statusText = 'Залишилось небагато';
                        this.statusIcon = 'fa-exclamation-triangle';
                        this.statusClass = 'mt-3 text-xs font-medium flex items-center justify-center gap-1.5 text-yellow-400';
                    } else if (percent > 20) {
                        this.statusText = 'Залишилось мало';
                        this.statusIcon = 'fa-hourglass-half';
                        this.statusClass = 'mt-3 text-xs font-medium flex items-center justify-center gap-1.5 text-orange-400';
                    } else {
                        this.statusText = 'Майже готово!';
                        this.statusIcon = 'fa-exclamation-circle';
                        this.statusClass = 'mt-3 text-xs font-medium flex items-center justify-center gap-1.5 text-red-400';
                    }
                    
                    if (remaining <= 10) {
                        this.statusText = 'Завершення...';
                        this.statusIcon = 'fa-spinner fa-spin';
                        this.statusClass = 'mt-3 text-xs font-medium flex items-center justify-center gap-1.5 text-blue-400';
                    }
                }
            }));
        });

        document.addEventListener('DOMContentLoaded', function() {
            function updateClock() {
                const now = new Date();
                const time = now.toLocaleTimeString('uk-UA', { hour: '2-digit', minute: '2-digit' });
                const currentTimeEl = document.getElementById('currentTime');
                if (currentTimeEl) {
                    currentTimeEl.textContent = time;
                }
            }
            updateClock();
            setInterval(updateClock, 1000);
        });
    </script>
    {% endif %}
</body>
</html>