<footer class="relative bg-gradient-to-br from-gray-50  dark:from-gray-900 dark:via-gray-800 dark:to-blue-900/20 text-gray-800 dark:text-gray-100 py-12 lg:py-16 overflow-hidden">
    <!-- Анімаційні хвилі -->
    <div class="absolute inset-0 overflow-hidden opacity-60">
        <div class="absolute bottom-0 left-[-50%] w-[200%] h-32 bg-gradient-to-r from-blue-200/20 to-cyan-200/20 dark:from-blue-400/10 dark:to-cyan-400/10 rounded-[43%] animate-[wave_8s_ease-in-out_infinite]"></div>
        <div class="absolute bottom-0 left-[-50%] w-[200%] h-28 bg-gradient-to-r from-gray-200/15 to-gray-300/15 dark:from-gray-500/10 dark:to-gray-600/10 rounded-[43%] animate-[wave_10s_ease-in-out_infinite]"></div>
        <div class="absolute bottom-0 left-[-50%] w-[200%] h-24 bg-gradient-to-r from-indigo-200/10 to-purple-200/10 dark:from-indigo-400/10 dark:to-purple-400/10 rounded-[43%] animate-[wave_12s_ease-in-out_infinite]"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 z-10">
        <!-- Верхній ряд: лого, швидкі посилання, користувач -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
            <!-- Лого та опис (2 колонки) -->
            <div class="lg:col-span-2 space-y-4">
                <div class="flex items-center gap-3 mb-4 group">
                    <div class="relative">
                        <div class="w-12 h-12 bg-gradient-to-br from-blue-500 via-purple-500 to-pink-500 rounded-lg flex items-center justify-center shadow-lg shadow-blue-500/20 group-hover:shadow-xl group-hover:shadow-blue-500/30 transition-all duration-500">
                            <i class="fas fa-newspaper text-white text-xl"></i>
                        </div>
                    </div>
                    <div>
                        <h2 class="text-2xl font-bold bg-gradient-to-r from-blue-600 via-purple-600 to-pink-600 bg-clip-text text-transparent">
                            AdNews.FUN
                        </h2>
                        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Ваш новинний портал</p>
                    </div>
                </div>
                <p class="text-gray-600 dark:text-gray-400 text-base leading-relaxed max-w-md bg-gradient-to-r from-white/50 to-transparent dark:from-gray-800/50 p-4 rounded-xl">
                    Ваше надійне джерело останніх новин, глибокого аналізу та цікавих історій з усього світу.
                </p>
                <div class="flex flex-wrap gap-3 pt-2">
                    <span class="inline-flex items-center gap-1.5 text-sm text-gray-500 dark:text-gray-400 px-3 py-1.5 rounded-lg bg-green-50 dark:bg-green-900/20">
                        <i class="fas fa-check-circle text-green-500 text-xs"></i> 24/7 Оновлення
                    </span>
                    <span class="inline-flex items-center gap-1.5 text-sm text-gray-500 dark:text-gray-400 px-3 py-1.5 rounded-lg bg-blue-50 dark:bg-blue-900/20">
                        <i class="fas fa-check-circle text-green-500 text-xs"></i> Перевірені джерела
                    </span>
                    <span class="inline-flex items-center gap-1.5 text-sm text-gray-500 dark:text-gray-400 px-3 py-1.5 rounded-lg bg-purple-50 dark:bg-purple-900/20">
                        <i class="fas fa-check-circle text-green-500 text-xs"></i> Без нав'язливої реклами
                    </span>
                </div>
            </div>

            <!-- Швидкі посилання -->
            <div class="space-y-4">
                <h5 class="text-lg font-semibold text-gray-900 dark:text-white flex items-center gap-2">
                    <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-blue-500 to-cyan-500 flex items-center justify-center">
                        <i class="fas fa-link text-white text-sm"></i>
                    </div>
                    Швидкі посилання
                </h5>
                <ul class="space-y-2">
                    <li>
                        <a href="{{ path('app_home') }}" 
                           class="group flex items-center gap-2 px-3 py-2 rounded-lg text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-all duration-200 hover:bg-blue-50 dark:hover:bg-blue-900/20">
                            <span class="w-8 h-8 rounded-full bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center group-hover:scale-110 transition-transform">
                                <i class="fas fa-home text-blue-500 text-xs"></i>
                            </span>
                            <span class="font-medium">Головна</span>
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('app_page_show', {slug: 'about-us'}) }}" 
                           class="group flex items-center gap-2 px-3 py-2 rounded-lg text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-all duration-200 hover:bg-blue-50 dark:hover:bg-blue-900/20">
                            <span class="w-8 h-8 rounded-full bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center group-hover:scale-110 transition-transform">
                                <i class="fas fa-info-circle text-blue-500 text-xs"></i>
                            </span>
                            <span class="font-medium">Про нас</span>
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Користувацькі посилання -->
            <div class="space-y-4">
                <h5 class="text-lg font-semibold text-gray-900 dark:text-white flex items-center gap-2">
                    <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-purple-500 to-pink-500 flex items-center justify-center">
                        <i class="fas fa-user-circle text-white text-sm"></i>
                    </div>
                    Користувач
                </h5>
                <ul class="space-y-2">
                    {% if app.user %}
                        <li>
                            <a href="{{ path('user_dashboard') }}" 
                               class="group flex items-center gap-2 px-3 py-2 rounded-lg text-gray-600 dark:text-gray-400 hover:text-purple-600 dark:hover:text-purple-400 transition-all duration-200 hover:bg-purple-50 dark:hover:bg-purple-900/20">
                                <span class="w-8 h-8 rounded-full bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center group-hover:scale-110 transition-transform">
                                    <i class="fas fa-tachometer-alt text-purple-500 text-xs"></i>
                                </span>
                                <span class="font-medium">Кабінет</span>
                            </a>
                        </li>
                        <li>
                            <a href="{{ path('app_logout') }}" 
                               class="group flex items-center gap-2 px-3 py-2 rounded-lg text-red-600 dark:text-red-400 hover:text-red-700 dark:hover:text-red-300 transition-all duration-200 hover:bg-red-50 dark:hover:bg-red-900/20">
                                <span class="w-8 h-8 rounded-full bg-red-100 dark:bg-red-900/30 flex items-center justify-center group-hover:scale-110 transition-transform">
                                    <i class="fas fa-sign-out-alt text-red-500 text-xs"></i>
                                </span>
                                <span class="font-medium">Вийти</span>
                            </a>
                        </li>
                    {% else %}
                        <li>
                            <a href="{{ path('app_login') }}" 
                               class="group flex items-center gap-2 px-3 py-2 rounded-lg text-gray-600 dark:text-gray-400 hover:text-green-600 dark:hover:text-green-400 transition-all duration-200 hover:bg-green-50 dark:hover:bg-green-900/20">
                                <span class="w-8 h-8 rounded-full bg-green-100 dark:bg-green-900/30 flex items-center justify-center group-hover:scale-110 transition-transform">
                                    <i class="fas fa-sign-in-alt text-green-500 text-xs"></i>
                                </span>
                                <span class="font-medium">Увійти</span>
                            </a>
                        </li>
                        <li>
                            <a href="{{ path('app_register') }}" 
                               class="group flex items-center gap-2 px-3 py-2 rounded-lg text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-all duration-200 hover:bg-blue-50 dark:hover:bg-blue-900/20">
                                <span class="w-8 h-8 rounded-full bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center group-hover:scale-110 transition-transform">
                                    <i class="fas fa-user-plus text-blue-500 text-xs"></i>
                                </span>
                                <span class="font-medium">Реєстрація</span>
                            </a>
                        </li>
                    {% endif %}
                </ul>
            </div>
        </div>

        <!-- Соцмережі (на всю ширину) -->
        <div class="mt-12 pt-8 border-t border-gray-200/50 dark:border-gray-700/50">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                <h5 class="text-lg font-semibold text-gray-900 dark:text-white flex items-center gap-2">
                    <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-orange-500 to-red-500 flex items-center justify-center">
                        <i class="fas fa-share-alt text-white text-sm"></i>
                    </div>
                    Слідкуй за нами
                </h5>
                <div class="flex flex-wrap gap-3">
                    <a href="#" class="group relative p-3 bg-gradient-to-br from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white rounded-xl shadow-lg transition-all duration-300 hover:scale-110 hover:-translate-y-1">
                        <i class="fab fa-facebook-f text-sm"></i>
                    </a>
                    <a href="#" class="group relative p-3 bg-gradient-to-br from-blue-500 to-cyan-500 hover:from-blue-600 hover:to-cyan-600 text-white rounded-xl shadow-lg transition-all duration-300 hover:scale-110 hover:-translate-y-1">
                        <i class="fab fa-telegram-plane text-sm"></i>
                    </a>
                    <a href="#" class="group relative p-3 bg-gray-800 hover:bg-gray-900 text-white rounded-xl shadow-lg transition-all duration-300 hover:scale-110 hover:-translate-y-1">
                        <i class="fab fa-twitter text-sm"></i>
                    </a>
                    <a href="#" class="group relative p-3 bg-gradient-to-br from-red-600 to-red-700 hover:from-red-700 hover:to-red-800 text-white rounded-xl shadow-lg transition-all duration-300 hover:scale-110 hover:-translate-y-1">
                        <i class="fab fa-youtube text-sm"></i>
                    </a>
                    <a href="#" class="group relative p-3 bg-gradient-to-br from-purple-600 via-pink-600 to-orange-500 hover:from-purple-700 hover:via-pink-700 hover:to-orange-600 text-white rounded-xl shadow-lg transition-all duration-300 hover:scale-110 hover:-translate-y-1">
                        <i class="fab fa-instagram text-sm"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Нижня частина -->
        <div class="mt-8 pt-6 border-t border-gray-200/50 dark:border-gray-700/50">
            <div class="flex flex-col md:flex-row justify-between items-center gap-4 text-sm">
                <div class="text-center md:text-left">
                    <span class="text-gray-500 dark:text-gray-400">&copy; {{ "now"|date("Y") }} AdNews.FUN. Усі права захищені.</span>
                </div>
                <div class="flex items-center gap-4">
                    <a href="{{ path('app_page_show', {slug: 'privacy-policy'}) }}" class="text-gray-500 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Політика конфіденційності</a>
                    <a href="{{ path('app_page_show', {slug: 'faq'}) }}" class="text-gray-500 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Правила користування</a>
                    <a href="/contact" class="text-gray-500 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Контакти</a>
                </div>
                <div class="flex items-center gap-1.5 text-xs text-gray-500 dark:text-gray-400">
                    <span class="text-red-500">❤️</span>
                    <span>Зроблено з любов'ю</span>
                </div>
            </div>
        </div>
    </div>
</footer>

<style>
@keyframes wave {
    0%, 100% { transform: translateX(0) translateY(0) rotate(0deg); }
    50% { transform: translateX(25%) translateY(-8px) rotate(2deg); }
}
@media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
    }
}
</style>