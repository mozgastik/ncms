{# templates/components/quote_widget.html.twig #}

{% set quote = get_random_quote() %}

{% if quote %}
<div class="relative overflow-hidden rounded-xl bg-white dark:bg-gray-800/50 border border-gray-100 dark:border-gray-700/50 hover:border-blue-200 dark:hover:border-blue-800/50 hover:shadow-lg transition-all duration-300 group my-8">
    
    <!-- Декоративний градієнт при наведенні -->
    <div class="absolute inset-0 bg-gradient-to-r from-blue-500/5 to-purple-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
    
    <div class="relative p-5">
        <div class="flex items-center gap-5">
            <!-- Іконка з акцентним кольором -->
            <div class="relative">
                <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center shadow-md group-hover:shadow-lg group-hover:scale-110 transition-all duration-300">
                    <svg class="w-7 h-7 text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-miterlimit="10" stroke-width="1.5" d="M16.0001 7.99997c-1.629-1.629-3.9007-1.91488-6.06614.25057C7.76851 10.416 2.82151 18.0286 4.4505 19.6576c1.629 1.629 9.2416-3.318 11.4071-5.4834 2.0932-2.0933 1.7715-4.54524.1425-6.17423Zm0 0 3.2595-3.15144m-3.2595 3.15144V4m0 3.99997 4 .00002m-3.7978 5.80211-2.1999-2.2155M8.30216 10.211l2.07194 2.0421m-1.25873 3.1838 2.11173 2.1633"/>
                    </svg>
                </div>
                <!-- Маленький акцент -->
                <div class="absolute -bottom-1 -right-1 w-5 h-5 bg-gradient-to-r from-yellow-400 to-orange-500 rounded-full border-2 border-white dark:border-gray-800 flex items-center justify-center">
                    <svg class="w-2.5 h-2.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                    </svg>
                </div>
            </div>
            
            <!-- Текстовий блок -->
            <div class="flex-1">
                <div class="flex items-center justify-between">
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white">Цитата дня</h3>
                    <span class="text-xs text-blue-600 dark:text-blue-400 font-medium">#daily</span>
                </div>
                <p class="text-sm text-gray-600 dark:text-gray-400 mt-0.5 flex items-center gap-2">
                    <span class="w-6 h-px bg-blue-500/50"></span>
                    Надихаємо на звершення
                </p>
            </div>
            
            <!-- Маленька стрілка при наведенні -->
            <div class="opacity-0 group-hover:opacity-100 transition-opacity">
                <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
            </div>
        </div>

        <!-- Контент цитати -->
        <blockquote class="relative mt-6 pl-4 border-l-2 border-blue-500/50 dark:border-blue-400/50">
            <!-- Текст цитати -->
            <div class="relative">
                <p class="text-base md:text-lg text-gray-800 dark:text-white/90 mb-3 leading-relaxed">
                    {{ quote.content }}
                </p>
            </div>
            
            <!-- Автор та додаткова інформація -->
            <div class="flex items-center justify-between flex-wrap gap-3">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full bg-gradient-to-br from-blue-100 to-purple-100 dark:from-blue-500/20 dark:to-purple-500/20 flex items-center justify-center border-2 border-white dark:border-gray-800">
                        <svg class="w-4 h-4 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                        </svg>
                    </div>
                    <span class="font-semibold text-gray-900 dark:text-white/90">{{ quote.author }}</span>
                </div>
                
                <!-- Іконки взаємодії -->
                <div class="flex items-center gap-2">
                    <button class="w-8 h-8 rounded-lg bg-gray-100 hover:bg-gray-200 dark:bg-white/10 dark:hover:bg-white/20 flex items-center justify-center text-gray-600 hover:text-blue-600 dark:text-white/70 dark:hover:text-white transition-all duration-300"
                            onclick="app.copyToClipboard('{{ quote.content|escape('js') }} — {{ quote.author|escape('js') }}')"
                            title="Копіювати">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                        </svg>
                    </button>
                    
                    {% if quote.source or quote.category %}
                        <div class="flex gap-1">
                            {% if quote.source %}
                                <span class="inline-flex items-center gap-1 px-2 py-1 bg-gray-100 dark:bg-white/10 rounded text-gray-600 dark:text-white/70 text-xs">
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                                    </svg>
                                    <span>{{ quote.source }}</span>
                                </span>
                            {% endif %}
                            
                            {% if quote.category %}
                                <span class="inline-flex items-center gap-1 px-2 py-1 bg-gradient-to-r from-blue-50 to-purple-50 dark:from-blue-500/20 dark:to-purple-500/20 text-blue-700 dark:text-white/90 text-xs rounded">
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l5 5a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-5-5A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
                                    </svg>
                                    <span>{{ quote.category }}</span>
                                </span>
                            {% endif %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </blockquote>
    </div>
    
    <!-- Анімований ефект при наведенні -->
    <div class="absolute inset-0 bg-gradient-to-r from-transparent via-blue-500/5 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000 pointer-events-none"></div>
</div>

{% else %}
<!-- Запасний віджет (Варіант 3 у спрощеному вигляді) -->
<div class="relative overflow-hidden rounded-xl bg-white dark:bg-gray-800/50 border border-gray-100 dark:border-gray-700/50 hover:border-blue-200 dark:hover:border-blue-800/50 hover:shadow-lg transition-all duration-300 group my-8">
    
    <div class="relative p-5">
        <div class="flex items-center gap-5">
            <div class="relative">
                <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center shadow-md group-hover:shadow-lg group-hover:scale-110 transition-all duration-300">
                    <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.53 16.93a3.75 3.75 0 1 0 0-7.5 3.75 3.75 0 0 0 0 7.5Z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                    </svg>
                </div>
            </div>
            
            <div class="flex-1">
                <div class="flex items-center justify-between">
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white">Цитата дня</h3>
                </div>
                <p class="text-sm text-gray-600 dark:text-gray-400 mt-0.5 flex items-center gap-2">
                    <span class="w-6 h-px bg-blue-500/50"></span>
                    Надихаємо на звершення
                </p>
            </div>
        </div>

        <div class="mt-6 pl-4 border-l-2 border-blue-500/50 dark:border-blue-400/50">
            <p class="text-base text-gray-600 dark:text-gray-400 italic">
                Тут з'являтимуться надихаючі цитати від видатних мислителів та лідерів
            </p>
            
            {% if is_granted('ROLE_ADMIN') %}
                <div class="mt-4">
                    <a href="{{ path('admin_quote_new') }}" 
                       class="inline-flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-blue-500 to-purple-600 text-white text-sm rounded-lg hover:shadow-md hover:scale-105 transition-all duration-300">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                        </svg>
                        <span>Додати першу цитату</span>
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endif %}

<!-- Стилі (залишаємо тільки необхідне) -->
<style>
/* Кастомний скроллбар для довгих цитат */
.quote-scroll {
    max-height: 200px;
    overflow-y: auto;
    padding-right: 8px;
}

.quote-scroll::-webkit-scrollbar {
    width: 4px;
}

.quote-scroll::-webkit-scrollbar-track {
    background: rgba(0, 0, 0, 0.05);
    border-radius: 2px;
}

.quote-scroll::-webkit-scrollbar-thumb {
    background: rgba(59, 130, 246, 0.3);
    border-radius: 2px;
}

.quote-scroll::-webkit-scrollbar-thumb:hover {
    background: rgba(59, 130, 246, 0.5);
}

.dark .quote-scroll::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.1);
}

.dark .quote-scroll::-webkit-scrollbar-thumb {
    background: rgba(59, 130, 246, 0.5);
}

/* Анімація для появи */
@keyframes slideIn {
    from {
        transform: translateX(100%);
        opacity: 0;
    }
    to {
        transform: translateX(0);
        opacity: 1;
    }
}

.animate-slide-in {
    animation: slideIn 0.3s ease-out;
}
</style>

<script>
// Додаємо глобальний об'єкт app, якщо ще не існує
window.app = window.app || {};

// Функція для копіювання цитати
app.copyToClipboard = function(text) {
    navigator.clipboard.writeText(text).then(() => {
        this.showNotification('✨ Цитату скопійовано в буфер обміну!', 'success');
    }).catch(err => {
        console.error('Помилка копіювання: ', err);
        this.showNotification('❌ Помилка при копіюванні', 'error');
    });
};

// Функція для сповіщень
app.showNotification = function(message, type = 'info') {
    const notification = document.createElement('div');
    
    const colors = {
        success: 'bg-gradient-to-r from-green-500 to-emerald-600',
        error: 'bg-gradient-to-r from-red-500 to-rose-600',
        info: 'bg-gradient-to-r from-blue-500 to-purple-600',
    };
    
    const icons = {
        success: 'fa-check-circle',
        error: 'fa-exclamation-circle',
        info: 'fa-info-circle',
    };
    
    notification.className = `fixed top-4 right-4 px-4 py-3 rounded-lg shadow-xl z-50 animate-slide-in text-white ${colors[type]}`;
    notification.innerHTML = `
        <div class="flex items-center gap-2">
            <i class="fas ${icons[type]} text-sm"></i>
            <span class="text-sm font-medium">${message}</span>
            <button onclick="this.parentElement.parentElement.remove()" class="ml-2 text-white/80 hover:text-white">
                <i class="fas fa-times text-xs"></i>
            </button>
        </div>
    `;
    
    document.body.appendChild(notification);
    
    setTimeout(() => {
        notification.style.opacity = '0';
        notification.style.transform = 'translateX(100%)';
        setTimeout(() => notification.remove(), 300);
    }, 3000);
};

// Додаємо обробник для довгих цитат
document.addEventListener('DOMContentLoaded', function() {
    const quoteBlocks = document.querySelectorAll('blockquote p');
    quoteBlocks.forEach(block => {
        if (block.textContent.length > 200) {
            block.classList.add('quote-scroll');
        }
    });
});
</script>