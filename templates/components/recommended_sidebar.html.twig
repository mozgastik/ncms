    {# 🔥 ТОП-5 статей #}
<div class="bg-white dark:bg-gray-900/30 backdrop-blur-sm rounded-2xl shadow-md p-6 border border-gray-200 dark:border-gray-700/50 hover:shadow-xl transition-all duration-300 group/sidebar">
    
    <!-- Заголовок з декоративним елементом -->
    <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-3">
            <div class="relative">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-orange-500 to-red-600 dark:from-orange-500/80 dark:to-red-600/80 flex items-center justify-center text-white shadow-md group-hover/sidebar:scale-110 group-hover/sidebar:rotate-3 transition-all duration-300">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M12.395 2.553a1 1 0 00-1.45-.385c-.345.23-.614.558-.822.88-.214.33-.403.713-.57 1.116-.334.804-.614 1.768-.84 2.734a31.365 31.365 0 00-.613 3.58 2.64 2.64 0 01-.945-1.067c-.328-.68-.398-1.534-.398-2.654A1 1 0 005.05 6.05 6.981 6.981 0 003 11a7 7 0 1011.95-4.95c-.592-.591-.98-.985-1.348-1.467-.363-.476-.724-1.063-1.207-2.03zM12.12 15.12A3 3 0 017 13s.879.5 2.5.5c0-1 .5-4 1.25-4.5.5 1 .786 1.293 1.371 1.879A2.99 2.99 0 0113 13a2.99 2.99 0 01-.879 2.121z" clip-rule="evenodd"/>
                    </svg>
                </div>
                <div class="absolute -inset-1 bg-gradient-to-r from-orange-500 to-red-600 rounded-xl blur-md opacity-0 group-hover/sidebar:opacity-30 transition-opacity duration-300 -z-10"></div>
            </div>
            <div>
                <h3 class="text-lg font-bold text-gray-900 dark:text-white/90">
                    ТОП-5 статей
                </h3>
                <p class="text-xs text-gray-500 dark:text-gray-400">
                    Найпопулярніші за тиждень
                </p>
            </div>
        </div>
        
        <!-- Декоративна лінія -->
        <div class="w-12 h-0.5 bg-gradient-to-r from-orange-500 to-red-600 rounded-full"></div>
    </div>

    <!-- Список статей -->
    <div class="space-y-2 max-h-120 overflow-y-auto scrollbar-thin scrollbar-thumb-gray-300 dark:scrollbar-thumb-gray-700 pr-2">
        {% for article in popularArticles|slice(0, 5) %}
            <a href="{{ path('app_article_show', {slug: article.slug}) }}" 
               class="group/article relative flex items-center justify-between p-3 rounded-xl hover:bg-gradient-to-r hover:from-orange-500/10 hover:to-red-500/10 dark:hover:from-orange-500/5 dark:hover:to-red-500/5 transition-all duration-300 overflow-hidden">
                
                <!-- Анімований індикатор при наведенні -->
                <span class="absolute left-0 w-1 h-0 bg-gradient-to-b from-orange-500 to-red-600 group-hover/article:h-full transition-all duration-300 rounded-full"></span>
                
                <!-- Назва статті з номером -->
                <div class="flex items-center gap-3 ml-2">
                    <div class="relative">
                    <div class="w-8 h-8 mx-auto rounded-full bg-gradient-to-br 
                                    {{ loop.index == 1 ? 'from-orange-500 to-red-600' : 
                                       loop.index == 2 ? 'from-green-500 to-green-600 :from-gray-500 dark:to-gray-400':
                                       loop.index == 3 ? 'from-amber-500 to-amber-600' :
                                       'from-gray-200 to-gray-300 dark:from-gray-700 dark:to-gray-600' }} 
                                    flex items-center justify-center group-hover:scale-110 transition-transform">
                            <span class="text-sm font-bold {{ loop.index <= 3 ? 'text-white' : 'text-gray-500 dark:text-gray-400' }}">
                                {{ loop.index }}
                            </span>
                        </div>
                        {% if loop.index == 1 %}
                            <span class="absolute -top-0.5 -right-0.5 w-2 h-2 bg-red-500 rounded-full border border-white dark:border-gray-900"></span>
                        {% endif %}
                    </div>
                    <div class="min-w-0">
                        <span class="font-medium text-gray-700 dark:text-gray-300 group-hover/article:text-gray-900 dark:group-hover/article:text-white transition-colors text-sm line-clamp-2">
                            {{ article.title }}
                        </span>
                        <div class="flex items-center gap-2 mt-1">
                            <span class="text-xs text-gray-500 dark:text-gray-400 flex items-center gap-1">
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                </svg>
                                {{ article.views|default(0)|number_format(0, ',', ' ') }}
                            </span>
                            {% if article.publishedAt is defined %}
                                <span class="text-xs text-gray-400 dark:text-gray-500">{{ article.publishedAt|date('d.m') }}</span>
                            {% endif %}
                        </div>
                    </div>
                </div>
                
                <!-- Стрілка, що з'являється при наведенні -->
                <svg class="w-4 h-4 text-orange-500 opacity-0 -translate-x-2 group-hover/article:opacity-100 group-hover/article:translate-x-0 transition-all duration-300" 
                     fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
            </a>
        {% else %}
            <!-- Пустий стан -->
            <div class="text-center py-8">
                <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gray-100 dark:bg-gray-800 flex items-center justify-center">
                    <svg class="w-8 h-8 text-gray-400 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
                <p class="text-gray-500 dark:text-gray-400">Статей поки що немає</p>
            </div>
        {% endfor %}
    </div>

    <!-- Футер з кнопкою -->
    <div class="mt-6 pt-4 border-t border-gray-200 dark:border-gray-800">
        <a href="{{ path('app_article_index') }}" 
           class="inline-flex items-center justify-center w-full gap-2 px-4 py-2.5 text-sm font-medium text-orange-600 dark:text-orange-400 bg-orange-50 dark:bg-orange-900/20 rounded-xl hover:bg-orange-100 dark:hover:bg-orange-900/30 hover:scale-[1.02] active:scale-95 transition-all duration-300 group/btn">
            <span>Всі статті</span>
            <svg class="w-4 h-4 group-hover/btn:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
        </a>
    </div>
</div>
{% set ad_content = ad_zone('sidebar')|trim %}

{# Реклама #}
<div class="bg-white dark:bg-gray-900/30 backdrop-blur-sm rounded-2xl shadow-md p-6 border border-gray-200 dark:border-gray-700/50 hover:shadow-xl transition-all duration-300 group/sidebar">
    
    <!-- Заголовок з декоративним елементом -->
    <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-3">
            <div class="relative">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-cyan-500 to-blue-500 dark:from-cyan-500/80 dark:to-blue-500/80 flex items-center justify-center text-white shadow-md group-hover/sidebar:scale-110 group-hover/sidebar:rotate-3 transition-all duration-300">
                    <i class="fas fa-ad text-lg"></i>
                </div>
                <div class="absolute -inset-1 bg-gradient-to-r from-cyan-500 to-blue-500 rounded-xl blur-md opacity-0 group-hover/sidebar:opacity-30 transition-opacity duration-300 -z-10"></div>
            </div>
            <div>
                <h3 class="text-lg font-bold text-gray-900 dark:text-white/90">Реклама</h3>
                <p class="text-xs text-gray-500 dark:text-gray-400">
                    {% if ad_content %}
                        Підтримайте наших партнерів
                    {% else %}
                        Тут може бути ваша реклама
                    {% endif %}
                </p>
            </div>
        </div>
        
        <!-- Декоративна лінія -->
        <div class="w-12 h-0.5 bg-gradient-to-r from-cyan-500 to-blue-600 rounded-full"></div>
    </div>

    {% if ad_content %}
        <div class="w-full">
            {{ ad_content|raw }}
        </div>
    {% else %}
        <!-- Пустий стан -->
        <div class="text-center py-8">
            <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gray-100 dark:bg-gray-800 flex items-center justify-center">
                <i class="fas fa-ad text-2xl text-gray-400 dark:text-gray-600"></i>
            </div>
            <p class="text-gray-500 dark:text-gray-400 mb-6">Тут може бути ваша реклама</p>
            <a href="{{ path('app_contact') }}" 
               class="inline-flex items-center justify-center w-full gap-2 px-4 py-2.5 text-sm font-medium text-cyan-600 dark:text-cyan-400 bg-cyan-50 dark:bg-cyan-900/20 rounded-xl hover:bg-cyan-100 dark:hover:bg-cyan-900/30 hover:scale-[1.02] active:scale-95 transition-all duration-300 group/btn">
                <span>Розмістити рекламу</span>
                <svg class="w-4 h-4 group-hover/btn:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                </svg>
            </a>
        </div>
    {% endif %}
</div>