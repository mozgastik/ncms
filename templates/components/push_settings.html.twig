{# templates/components/push_settings.html.twig #}

<div x-data="pushSettings()" x-init="init()" class="bg-surface-0 dark:bg-surface-900 rounded-xl p-6">
    <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center">
                <i class="fas fa-bell text-primary-600 dark:text-primary-400"></i>
            </div>
            <div>
                <h3 class="text-lg font-semibold text-surface-900 dark:text-surface-100">
                    Push-сповіщення
                </h3>
                <p class="text-sm text-surface-500 dark:text-surface-400">
                    Отримуйте сповіщення в браузері
                </p>
            </div>
        </div>

        <button 
            @click="toggleSubscription()"
            :disabled="loading || !supported"
            :class="{
                'bg-primary-600 hover:bg-primary-700': !subscribed,
                'bg-surface-200 dark:bg-surface-700 hover:bg-surface-300 dark:hover:bg-surface-600': subscribed,
                'opacity-50 cursor-not-allowed': loading || !supported
            }"
            class="px-4 py-2 rounded-lg text-white font-medium transition-colors"
        >
            <span x-show="loading">
                <i class="fas fa-spinner fa-spin mr-2"></i>
                Завантаження...
            </span>
            <span x-show="!loading && !supported">
                <i class="fas fa-exclamation-triangle mr-2"></i>
                Не підтримується
            </span>
            <span x-show="!loading && supported && !subscribed">
                <i class="fas fa-bell mr-2"></i>
                Підписатися
            </span>
            <span x-show="!loading && supported && subscribed">
                <i class="fas fa-bell-slash mr-2"></i>
                Відписатися
            </span>
        </button>
    </div>

    <template x-if="!supported">
        <div class="p-4 bg-warning-50 dark:bg-warning-900/20 rounded-lg">
            <p class="text-sm text-warning-700 dark:text-warning-300">
                <i class="fas fa-info-circle mr-2"></i>
                Ваш браузер не підтримує push-сповіщення. Спробуйте оновити браузер або використати інший.
            </p>
        </div>
    </template>

    <template x-if="supported && !notificationPermission">
        <div class="p-4 bg-primary-50 dark:bg-primary-900/20 rounded-lg">
            <p class="text-sm text-primary-700 dark:text-primary-300">
                <i class="fas fa-info-circle mr-2"></i>
                Будь ласка, дозвольте сповіщення в браузері
            </p>
        </div>
    </template>

    <template x-if="supported && subscribed">
        <div class="mt-4 p-4 bg-success-50 dark:bg-success-900/20 rounded-lg">
            <p class="text-sm text-success-700 dark:text-success-300">
                <i class="fas fa-check-circle mr-2"></i>
                ✅ Ви підписані на push-сповіщення
            </p>
            <button @click="testNotification()" class="mt-2 text-xs text-primary-600 hover:underline">
                Надіслати тестове сповіщення
            </button>
        </div>
    </template>
</div>

<script>
function pushSettings() {
    return {
        supported: true,
        loading: false,
        subscribed: false,
        notificationPermission: Notification.permission === 'granted',
        pushManager: null,
        
        async init() {
            // Перевірка підтримки
            this.supported = 'serviceWorker' in navigator && 'PushManager' in window;
            
            if (!this.supported) return;
            
            // Завантажити push менеджер
            const module = await import('/assets/js/push-notifications.js');
            this.pushManager = new module.default();
            
            // Перевірити статус підписки
            await this.checkSubscription();
        },
        
        async checkSubscription() {
            const initialized = await this.pushManager.init();
            if (!initialized) return;
            
            this.subscribed = await this.pushManager.getSubscriptionStatus();
        },
        
        async toggleSubscription() {
            if (this.loading) return;
            
            this.loading = true;
            
            try {
                if (this.subscribed) {
                    await this.pushManager.unsubscribe();
                    this.subscribed = false;
                } else {
                    await this.pushManager.subscribe();
                    this.subscribed = true;
                }
            } catch (error) {
                console.error('Toggle failed:', error);
                alert('Помилка: ' + error.message);
            } finally {
                this.loading = false;
            }
        },
        
        async testNotification() {
            const response = await fetch('/push/test', { method: 'POST' });
            const result = await response.json();
            console.log('Test result:', result);
        }
    }
}
</script>