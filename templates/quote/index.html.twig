{% extends 'base.html.twig' %}

{% block title %}Цитати{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <!-- Header -->
    <div class="text-center mb-12">
        <h1 class="text-4xl font-bold text-gray-800 mb-4">
            <i class="fas fa-quote-left text-blue-500"></i>
            Колекція цитат
            <i class="fas fa-quote-right text-blue-500"></i>
        </h1>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            Натхненні цитати від великих мислителів, письменників та лідерів
        </p>
    </div>

    <!-- Статистика -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
        <div class="bg-white rounded-xl shadow-md p-6">
            <div class="flex items-center">
                <div class="p-3 bg-blue-100 rounded-lg">
                    <i class="fas fa-quote-right text-blue-600 text-xl"></i>
                </div>
                <div class="ml-4">
                    <p class="text-sm text-gray-500">Всього цитат</p>
                    <p class="text-2xl font-bold text-gray-800">{{ total_quotes }}</p>
                </div>
            </div>
        </div>
        
        <div class="bg-white rounded-xl shadow-md p-6">
            <div class="flex items-center">
                <div class="p-3 bg-green-100 rounded-lg">
                    <i class="fas fa-users text-green-600 text-xl"></i>
                </div>
                <div class="ml-4">
                    <p class="text-sm text-gray-500">Авторів</p>
                    <p class="text-2xl font-bold text-gray-800">
                        {% set authors = [] %}
                        {% for quote in quotes %}
                            {% if quote.author not in authors %}
                                {% set authors = authors|merge([quote.author]) %}
                            {% endif %}
                        {% endfor %}
                        {{ authors|length }}
                    </p>
                </div>
            </div>
        </div>
        
        <div class="bg-white rounded-xl shadow-md p-6">
            <div class="flex items-center">
                <div class="p-3 bg-purple-100 rounded-lg">
                    <i class="fas fa-tags text-purple-600 text-xl"></i>
                </div>
                <div class="ml-4">
                    <p class="text-sm text-gray-500">Категорій</p>
                    <p class="text-2xl font-bold text-gray-800">{{ categories|length }}</p>
                </div>
            </div>
        </div>
        
        <div class="bg-white rounded-xl shadow-md p-6">
            <div class="flex items-center">
                <div class="p-3 bg-yellow-100 rounded-lg">
                    <i class="fas fa-fire text-yellow-600 text-xl"></i>
                </div>
                <div class="ml-4">
                    <p class="text-sm text-gray-500">Популярні</p>
                    <a href="{{ path('app_popular_quotes') }}" 
                       class="text-2xl font-bold text-gray-800 hover:text-blue-600 transition">
                        Топ-20
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Фільтри та пошук -->
    <div class="bg-white rounded-xl shadow-lg p-6 mb-8">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
            <div>
                <h2 class="text-lg font-semibold text-gray-800 mb-3">Категорії</h2>
                <div class="flex flex-wrap gap-2">
                    <a href="{{ path('app_quote_index') }}" 
                       class="px-4 py-2 rounded-full {{ current_category is null ? 'bg-blue-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200' }}">
                        Всі
                    </a>
                    {% for category in categories %}
                    <a href="{{ path('app_quote_index', {'category': category}) }}" 
                       class="px-4 py-2 rounded-full {{ current_category == category ? 'bg-blue-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200' }}">
                        {{ category }}
                    </a>
                    {% endfor %}
                </div>
            </div>
            
            <div class="flex items-center space-x-4">
                <a href="{{ path('app_quote_of_the_day') }}" 
                   class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-blue-500 to-indigo-600 text-white rounded-lg hover:from-blue-600 hover:to-indigo-700 transition shadow-md">
                    <i class="fas fa-star mr-2"></i>
                    Цитата дня
                </a>
            </div>
        </div>
    </div>

    <!-- Список цитат -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {% for quote in quotes %}
        <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-xl transition-all duration-300">
            <div class="p-8">
                <div class="flex items-start mb-6">
                    <div class="flex-shrink-0 text-blue-400">
                        <i class="fas fa-quote-left text-2xl"></i>
                    </div>
                    <div class="ml-4 flex-1">
                        <blockquote class="text-lg italic text-gray-700 mb-6">
                            {{ quote.content|length > 300 ? quote.content|slice(0, 300) ~ '...' : quote.content }}
                        </blockquote>
                        
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="font-semibold text-gray-800">
                                    {{ quote.author }}
                                </p>
                                {% if quote.source %}
                                    <p class="text-sm text-gray-500 mt-1">
                                        {{ quote.source }}
                                    </p>
                                {% endif %}
                            </div>
                            
                            {% if quote.category %}
                            <span class="px-3 py-1 text-sm bg-blue-100 text-blue-800 rounded-full">
                                {{ quote.category }}
                            </span>
                            {% endif %}
                        </div>
                    </div>
                </div>
                
                <div class="flex justify-between items-center pt-6 border-t border-gray-100">
                    <div class="text-sm text-gray-500">
                        <i class="far fa-eye mr-1"></i>
                        {{ quote.views }} переглядів
                    </div>
                    
                    <div class="flex space-x-3">
                        <a href="{{ path('app_quote_show', {'id': quote.id}) }}" 
                           class="inline-flex items-center px-4 py-2 bg-blue-50 text-blue-700 rounded-lg hover:bg-blue-100 transition">
                            <i class="fas fa-external-link-alt mr-2"></i>
                            Детальніше
                        </a>
                        
                        <button onclick="shareQuote({{ quote.id }}, '{{ quote.content|slice(0, 100) }}...', '{{ quote.author }}')" 
                                class="inline-flex items-center px-4 py-2 bg-gray-50 text-gray-700 rounded-lg hover:bg-gray-100 transition">
                            <i class="fas fa-share-alt mr-2"></i>
                            Поділитись
                        </button>
                    </div>
                </div>
            </div>
        </div>
        {% else %}
        <div class="col-span-2 text-center py-16">
            <div class="text-gray-300 mb-6">
                <i class="fas fa-quote-left text-6xl"></i>
            </div>
            <h3 class="text-2xl font-semibold text-gray-700 mb-4">Цитат не знайдено</h3>
            <p class="text-gray-500 mb-8">Спробуйте іншу категорію або перевірте пізніше</p>
            <a href="{{ path('app_quote_index') }}" 
               class="inline-flex items-center px-8 py-4 bg-blue-600 text-white text-lg rounded-xl hover:bg-blue-700 transition shadow-lg">
                <i class="fas fa-redo mr-3"></i>
                Скинути фільтри
            </a>
        </div>
        {% endfor %}
    </div>

    <!-- Пагінація -->
    {% if total_pages > 1 %}
    <div class="mt-12 flex justify-center">
        <nav class="inline-flex rounded-md shadow">
            {% if current_page > 1 %}
            <a href="{{ path('app_quote_index', {'page': current_page - 1, 'category': current_category}) }}" 
               class="inline-flex items-center px-4 py-2 rounded-l-md border border-gray-300 bg-white text-sm font-medium text-gray-700 hover:bg-gray-50">
                <i class="fas fa-chevron-left mr-2"></i>
                Назад
            </a>
            {% endif %}
            
            {% for page in 1..total_pages %}
                {% if page == current_page %}
                <span class="inline-flex items-center px-4 py-2 border border-gray-300 bg-blue-50 text-sm font-medium text-blue-600">
                    {{ page }}
                </span>
                {% else %}
                <a href="{{ path('app_quote_index', {'page': page, 'category': current_category}) }}" 
                   class="inline-flex items-center px-4 py-2 border border-gray-300 bg-white text-sm font-medium text-gray-700 hover:bg-gray-50">
                    {{ page }}
                </a>
                {% endif %}
            {% endfor %}
            
            {% if current_page < total_pages %}
            <a href="{{ path('app_quote_index', {'page': current_page + 1, 'category': current_category}) }}" 
               class="inline-flex items-center px-4 py-2 rounded-r-md border border-gray-300 bg-white text-sm font-medium text-gray-700 hover:bg-gray-50">
                Далі
                <i class="fas fa-chevron-right ml-2"></i>
            </a>
            {% endif %}
        </nav>
    </div>
    {% endif %}
</div>

<script>
function shareQuote(id, content, author) {
    if (navigator.share) {
        navigator.share({
            title: 'Цитата: ' + author,
            text: content + ' — ' + author,
            url: window.location.origin + '/quote/' + id,
        })
        .then(() => console.log('Успішно поділено'))
        .catch((error) => console.log('Помилка поділу:', error));
    } else {
        // Fallback для браузерів без підтримки Web Share API
        const url = window.location.origin + '/quote/' + id;
        const text = encodeURIComponent(content + ' — ' + author);
        const shareUrl = `https://twitter.com/intent/tweet?text=${text}&url=${encodeURIComponent(url)}`;
        window.open(shareUrl, '_blank', 'width=600,height=400');
    }
}
</script>
{% endblock %}