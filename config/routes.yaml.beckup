# ========== ОСНОВНІ МАРШРУТИ ==========
controllers:
    resource: ../src/Controller/
    type: attribute

# ========== МАРШРУТИ КОРИСТУВАЧІВ ==========
user_dashboard:
    path: /user/dashboard
    controller: App\Controller\User\UserController::dashboard
    defaults:
        _locale: uk

user_profile:
    path: /user/profile
    controller: App\Controller\User\UserController::profile
    defaults:
        _locale: uk

user_comments:
    path: /user/comments
    controller: App\Controller\User\UserController::comments
    defaults:
        _locale: uk

user_change_password:
    path: /user/change-password
    controller: App\Controller\User\UserController::changePassword
    defaults:
        _locale: uk

user_favorites:
    path: /user/favorites
    controller: App\Controller\User\UserController::favorites
    defaults:
        _locale: uk

user_notifications:
    path: /user/notifications
    controller: App\Controller\User\UserController::notifications
    defaults:
        _locale: uk
        
# ========== МАРШРУТИ КОРИСТУВАЧА ДЛЯ ВІДЕО ==========
user_video_index:
    path: /user/videos
    controller: App\Controller\User\UserVideoController::index
    methods: GET

user_video_new:
    path: /user/videos/new
    controller: App\Controller\User\UserVideoController::new
    methods: [GET, POST]

user_video_edit:
    path: /user/videos/{id}/edit
    controller: App\Controller\User\UserVideoController::edit
    methods: [GET, POST]
    requirements:
        id: \d+

user_video_delete:
    path: /user/videos/{id}/delete
    controller: App\Controller\User\UserVideoController::delete
    methods: POST
    requirements:
        id: \d+

user_video_stats:
    path: /user/videos/{id}/stats
    controller: App\Controller\User\UserVideoController::stats
    methods: GET
    requirements:
        id: \d+

# ========== МАРШРУТИ КОРИСТУВАЧА ДЛЯ СТАТТЕЙ ==========
user_article_new:
    path: /user/article/new
    controller: App\Controller\User\UserArticleController::new
    methods: [GET, POST]

user_article_edit:
    path: /user/article/edit/{id}
    controller: App\Controller\User\UserArticleController::edit
    methods: [GET, POST]
    requirements:
        id: \d+

user_article_delete:
    path: /user/article/delete/{id}
    controller: App\Controller\User\UserArticleController::delete
    methods: POST
    requirements:
        id: \d+

user_articles:
    path: /user/articles
    controller: App\Controller\User\UserArticleController::myArticles
    methods: GET

user_article_show:
    path: /user/article/{id}
    controller: App\Controller\User\UserArticleController::show
    methods: GET
    requirements:
        id: \d+

upload_temp_image:
    path: /user/article/upload-temp
    controller: App\Controller\User\UserArticleController::uploadTempImage
    methods: POST

user_article_image_upload:
    path: /user/articles/image/upload
    controller: App\Controller\User\UserArticleController::uploadImage
    methods: [POST]

user_article_image_delete:
    path: /user/articles/image/delete/{id}
    controller: App\Controller\User\UserArticleController::deleteImage
    methods: [DELETE]

user_article_image_list:
    path: /user/articles/image/list
    controller: App\Controller\User\UserArticleController::listImages
    methods: [GET]


# ========== API МАРШРУТИ ==========
api_settings_public:
    path: /api/settings/public
    controller: App\Controller\Admin\SettingsController::publicApi
    methods: GET

api_settings_get:
    path: /api/settings/{key}
    controller: App\Controller\Admin\SettingsController::getApi
    methods: GET
    requirements:
        key: '[a-zA-Z0-9_]+'

api_weather_city:
    path: /api/weather/city
    controller: App\Controller\Api\WeatherController::getWeatherByCity
    methods: [GET]

api_weather_coordinates:
    path: /api/weather/coordinates
    controller: App\Controller\Api\WeatherController::getWeatherByCoordinates
    methods: [GET]

api_image_upload:
    path: /api/images/upload
    controller: App\Controller\Api\ImageController::upload
    methods: [POST]

api_images_list:
    path: /api/images/list
    controller: App\Controller\Api\ImageController::list
    methods: [GET]

api_image_delete:
    path: /api/images/delete/{id}
    controller: App\Controller\Api\ImageController::delete
    methods: [DELETE]
    
# ========== МАРШРУТИ ЛАЙКІВ ==========
app_article_like:
    path: /article/{id}/like
    controller: App\Controller\Article\ArticleLikeController::like
    methods: POST
    requirements:
        id: \d+

app_article_likes_info:
    path: /article/{id}/likes
    controller: App\Controller\Article\ArticleLikeController::getLikesInfo
    methods: GET
    requirements:
        id: \d+

# ========== МАРШРУТИ ВІДЕО ==========
app_video_index:
    path: /video
    controller: App\Controller\Front\VideoController::index
    methods: GET

app_video_show:
    path: /video/{id}
    controller: App\Controller\Front\VideoController::show
    methods: GET
    requirements:
        id: \d+

app_video_category:
    path: /video/category/{id}
    controller: App\Controller\Front\VideoController::category
    methods: GET
    requirements:
        id: \d+

app_video_search:
    path: /video/search
    controller: App\Controller\Front\VideoController::search
    methods: GET

app_video_latest:
    path: /video/latest/{limit}
    controller: App\Controller\Front\VideoController::latest
    methods: GET
    defaults:
        limit: 6
    requirements:
        limit: \d+

app_video_popular:
    path: /video/popular/{limit}
    controller: App\Controller\Front\VideoController::popular
    methods: GET
    defaults:
        limit: 6
    requirements:
        limit: \d+

# ========== ДОПОМІЖНІ МАРШРУТИ ==========
app_home:
    path: /
    controller: App\Controller\Front\HomeController::index
    methods: GET

app_about:
    path: /about
    controller: App\Controller\Front\HomeController::about
    methods: GET

app_contact:
    path: /contact
    controller: App\Controller\Front\HomeController::contact
    methods: [GET, POST]

app_search:
    path: /search
    controller: App\Controller\Front\SearchController::index
    methods: GET

app_sitemap:
    path: /sitemap.xml
    controller: App\Controller\Front\SitemapController::index
    methods: GET

app_rss:
    path: /rss
    controller: App\Controller\Front\RssController::index
    methods: GET

app_category_index:
    path: /category
    controller: App\Controller\Front\CategoryController::index
    methods: GET

app_page_show:
    path: /page/{slug}
    controller: App\Controller\Front\PageController::show
    methods: GET