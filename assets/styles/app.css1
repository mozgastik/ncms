/* assets/styles/app.css */
@import "tailwindcss";

/* ===== ГЛОБАЛЬНІ ЗМІННІ ===== */
@layer base {
  :root {
    /* Світла тема (за замовчуванням) */
    --color-primary-50: #eff6ff;
    --color-primary-100: #dbeafe;
    --color-primary-200: #bfdbfe;
    --color-primary-300: #93c5fd;
    --color-primary-400: #60a5fa;
    --color-primary-500: #3b82f6;
    --color-primary-600: #2563eb;
    --color-primary-700: #1d4ed8;
    --color-primary-800: #1e40af;
    --color-primary-900: #1e3a8a;
    
    /* Поверхні - світла тема */
    --color-surface-0: #ffffff;
    --color-surface-50: #f8fafc;
    --color-surface-100: #f1f5f9;
    --color-surface-200: #e2e8f0;
    --color-surface-300: #cbd5e1;
    --color-surface-400: #94a3b8;
    --color-surface-500: #64748b;
    --color-surface-600: #475569;
    --color-surface-700: #334155;
    --color-surface-800: #1e293b;
    --color-surface-900: #0f172a;
    --color-surface-950: #020617;
    
    /* Стани - світла тема */
    --color-success-500: #22c55e;
    --color-success-600: #16a34a;
    --color-warning-500: #f59e0b;
    --color-warning-600: #d97706;
    --color-danger-500: #ef4444;
    --color-danger-600: #dc2626;
    --color-info-500: #3b82f6;
    --color-info-600: #2563eb;
    
    /* Градієнти - світла тема */
    --gradient-primary: linear-gradient(135deg, #0ea5e9 0%, #3b82f6 100%);
    --gradient-success: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
    --gradient-warning: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
    --gradient-danger: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
    --gradient-surface: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
    
    /* Тіні - світла тема */
    --shadow-glass: 0 8px 32px 0 rgba(31, 38, 135, 0.15);
    --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
    --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1);
    --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1);
    --shadow-xl: 0 20px 25px -5px rgb(0 0 0 / 0.1);
    
    /* Анімації */
    --transition-fast: 150ms cubic-bezier(0.4, 0, 0.2, 1);
    --transition-base: 250ms cubic-bezier(0.4, 0, 0.2, 1);
    --transition-slow: 350ms cubic-bezier(0.4, 0, 0.2, 1);
    --transition-bounce: 500ms cubic-bezier(0.68, -0.55, 0.27, 1.55);
  }

  /* Темна тема */
  .dark {
    /* Поверхні - темна тема */
    --color-surface-0: #0a0a0a;
    --color-surface-50: #171717;
    --color-surface-100: #1a1a1a;
    --color-surface-200: #262626;
    --color-surface-300: #333333;
    --color-surface-400: #4d4d4d;
    --color-surface-500: #666666;
    --color-surface-600: #808080;
    --color-surface-700: #999999;
    --color-surface-800: #b3b3b3;
    --color-surface-900: #cccccc;
    --color-surface-950: #e6e6e6;
    
    /* Градієнти - темна тема */
    --gradient-surface: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    
    /* Тіні - темна тема */
    --shadow-glass: 0 8px 32px 0 rgba(0, 0, 0, 0.3);
    --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.3);
    --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.3);
    --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.3);
    --shadow-xl: 0 20px 25px -5px rgb(0 0 0 / 0.3);
  }
}

/* ===== БАЗОВІ СКИДАННЯ ===== */
@layer base {
  /* Скидання для всіх елементів */
  *,
  *::before,
  *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
  }
  
  /* Базові стилі для html та body */
  html,
  body {
    width: 100%;
    min-height: 100%;
    margin: 0;
    padding: 0;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    scroll-behavior: smooth;
  }
  
  /* Контроль скролу */
  html {
    overflow-x: hidden;
    overflow-y: auto;
  }
  
  body {
    overflow-x: hidden;
    overflow-y: auto;
    position: relative;
    background-color: var(--color-surface-50);
    color: var(--color-surface-900);
  }
  
  /* Темна тема для body */
  .dark body {
    background-color: var(--color-surface-950);
    color: var(--color-surface-50);
  }
  
  /* Коли мобільне меню відкрите */
  body.mobile-menu-open {
    overflow: hidden;
    position: fixed;
    width: 100%;
  }
  
  /* Базові стилі для зображень */
  img,
  svg,
  video,
  canvas {
    max-width: 100%;
    height: auto;
    display: block;
  }
  
  /* Базові стилі для посилань */
  a {
    color: inherit;
    text-decoration: inherit;
  }
  
  /* Базові стилі для кнопок */
  button {
    background: none;
    border: none;
    cursor: pointer;
    font: inherit;
    color: inherit;
  }
  
  button:focus-visible {
    outline: 2px solid var(--color-primary-500);
    outline-offset: 2px;
  }
  
  /* Видалення outline для миші */
  *:focus:not(:focus-visible) {
    outline: none;
  }
  
  /* Стилі для виділення тексту */
  ::selection {
    background-color: var(--color-primary-500);
    color: white;
  }
  
  .dark ::selection {
    background-color: var(--color-primary-600);
    color: white;
  }
  
  /* Alpine.js приховування */
  [x-cloak] {
    display: none !important;
  }
}

/* ===== УНІВЕРСАЛЬНІ ПЕРЕХОДИ ===== */
@layer base {
  .transition-all,
  .transition-colors,
  .transition-opacity,
  .transition-transform,
  .transition-shadow,
  a,
  button {
    transition-property: color, background-color, border-color, text-decoration-color, fill, stroke, opacity, box-shadow, transform, filter, backdrop-filter;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    transition-duration: 150ms;
  }
  
  .no-transitions *,
  .no-transitions *::before,
  .no-transitions *::after {
    transition: none !important;
  }
}

/* ===== КАСТОМНІ УТИЛІТИ ===== */
@layer utilities {
  /* === ГРАДІЄНТИ === */
  .gradient-text {
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  
  .gradient-text-success {
    background: var(--gradient-success);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  
  .gradient-text-warning {
    background: var(--gradient-warning);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  
  .gradient-text-danger {
    background: var(--gradient-danger);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  
  /* === GLASS ЕФЕКТИ === */
  .glass {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: var(--shadow-glass);
  }
  
  .dark .glass {
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  
  .glass-strong {
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.3);
  }
  
  .dark .glass-strong {
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }
  
  .glass-light {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  
  /* === HOVER ЕФЕКТИ === */
  .hover-lift {
    transition: transform var(--transition-base);
  }
  
  .hover-lift:hover {
    transform: translateY(-4px);
  }
  
  .hover-lift:active {
    transform: translateY(-2px);
  }
  
  .hover-glow {
    transition: box-shadow var(--transition-base);
  }
  
  .hover-glow:hover {
    box-shadow: 0 0 25px rgba(59, 130, 246, 0.4);
  }
  
  .dark .hover-glow:hover {
    box-shadow: 0 0 25px rgba(96, 165, 250, 0.4);
  }
  
  .hover-scale {
    transition: transform var(--transition-base);
  }
  
  .hover-scale:hover {
    transform: scale(1.05);
  }
  
  .hover-scale:active {
    transform: scale(0.98);
  }
  
  .hover-rotate {
    transition: transform var(--transition-base);
  }
  
  .hover-rotate:hover {
    transform: rotate(5deg);
  }
  
  /* === FOCUS СТИЛІ === */
  .focus-ring {
    transition: box-shadow var(--transition-fast);
  }
  
  .focus-ring:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.4);
  }
  
  .dark .focus-ring:focus-visible {
    box-shadow: 0 0 0 3px rgba(96, 165, 250, 0.4);
  }
  
  .focus-ring-inset {
    transition: box-shadow var(--transition-fast);
  }
  
  .focus-ring-inset:focus-visible {
    outline: none;
    box-shadow: inset 0 0 0 3px rgba(59, 130, 246, 0.4);
  }
  
  .dark .focus-ring-inset:focus-visible {
    box-shadow: inset 0 0 0 3px rgba(96, 165, 250, 0.4);
  }
  
  /* === КОЛЬОРИ ПОВЕРХОНЬ === */
  .bg-surface-0 { background-color: var(--color-surface-0); }
  .bg-surface-50 { background-color: var(--color-surface-50); }
  .bg-surface-100 { background-color: var(--color-surface-100); }
  .bg-surface-200 { background-color: var(--color-surface-200); }
  .bg-surface-300 { background-color: var(--color-surface-300); }
  .bg-surface-400 { background-color: var(--color-surface-400); }
  .bg-surface-500 { background-color: var(--color-surface-500); }
  .bg-surface-600 { background-color: var(--color-surface-600); }
  .bg-surface-700 { background-color: var(--color-surface-700); }
  .bg-surface-800 { background-color: var(--color-surface-800); }
  .bg-surface-900 { background-color: var(--color-surface-900); }
  .bg-surface-950 { background-color: var(--color-surface-950); }
  
  .text-surface-0 { color: var(--color-surface-0); }
  .text-surface-50 { color: var(--color-surface-50); }
  .text-surface-100 { color: var(--color-surface-100); }
  .text-surface-200 { color: var(--color-surface-200); }
  .text-surface-300 { color: var(--color-surface-300); }
  .text-surface-400 { color: var(--color-surface-400); }
  .text-surface-500 { color: var(--color-surface-500); }
  .text-surface-600 { color: var(--color-surface-600); }
  .text-surface-700 { color: var(--color-surface-700); }
  .text-surface-800 { color: var(--color-surface-800); }
  .text-surface-900 { color: var(--color-surface-900); }
  .text-surface-950 { color: var(--color-surface-950); }
  
  .border-surface-0 { border-color: var(--color-surface-0); }
  .border-surface-50 { border-color: var(--color-surface-50); }
  .border-surface-100 { border-color: var(--color-surface-100); }
  .border-surface-200 { border-color: var(--color-surface-200); }
  .border-surface-300 { border-color: var(--color-surface-300); }
  .border-surface-400 { border-color: var(--color-surface-400); }
  .border-surface-500 { border-color: var(--color-surface-500); }
  .border-surface-600 { border-color: var(--color-surface-600); }
  .border-surface-700 { border-color: var(--color-surface-700); }
  .border-surface-800 { border-color: var(--color-surface-800); }
  .border-surface-900 { border-color: var(--color-surface-900); }
  .border-surface-950 { border-color: var(--color-surface-950); }
  
  /* === СКРОЛБАРИ === */
  .scrollbar-custom {
    scrollbar-width: thin;
    scrollbar-color: #cbd5e1 transparent;
  }
  
  .scrollbar-custom::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }
  
  .scrollbar-custom::-webkit-scrollbar-track {
    background: transparent;
    border-radius: 4px;
  }
  
  .scrollbar-custom::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 4px;
    border: 2px solid transparent;
    background-clip: padding-box;
  }
  
  .scrollbar-custom::-webkit-scrollbar-thumb:hover {
    background: #94a3b8;
  }
  
  .dark .scrollbar-custom {
    scrollbar-color: #475569 transparent;
  }
  
  .dark .scrollbar-custom::-webkit-scrollbar-thumb {
    background: #475569;
  }
  
  .dark .scrollbar-custom::-webkit-scrollbar-thumb:hover {
    background: #64748b;
  }
  
  .scrollbar-thin {
    scrollbar-width: thin;
  }
  
  .scrollbar-thin::-webkit-scrollbar {
    width: 4px;
    height: 4px;
  }
  
  .scrollbar-thin::-webkit-scrollbar-track {
    background: transparent;
  }
  
  .scrollbar-thin::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 4px;
  }
  
  .dark .scrollbar-thin::-webkit-scrollbar-thumb {
    background: #4b5563;
  }
  
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  
  /* === LINE CLAMP === */
  .line-clamp-1 {
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
  }
  
  .line-clamp-2 {
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  
  .line-clamp-3 {
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }
  
  .line-clamp-4 {
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
  }
  
  /* === ТУЛТИПИ === */
  .tooltip {
    position: relative;
  }
  
  .tooltip::before {
    content: attr(data-tooltip);
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(-4px);
    padding: 8px 12px;
    background: var(--color-surface-800);
    color: var(--color-surface-50);
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
    border-radius: 6px;
    opacity: 0;
    visibility: hidden;
    transition: all var(--transition-fast);
    pointer-events: none;
    z-index: 50;
    box-shadow: var(--shadow-lg);
  }
  
  .dark .tooltip::before {
    background: var(--color-surface-700);
    color: var(--color-surface-100);
  }
  
  .tooltip:hover::before {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(-8px);
  }
  
  .tooltip-right::before {
    bottom: 50%;
    left: 100%;
    transform: translateY(50%) translateX(4px);
  }
  
  .tooltip-right:hover::before {
    transform: translateY(50%) translateX(8px);
  }
  
  .tooltip-bottom::before {
    bottom: auto;
    top: 100%;
    transform: translateX(-50%) translateY(4px);
  }
  
  .tooltip-bottom:hover::before {
    transform: translateX(-50%) translateY(8px);
  }
  
  .tooltip-left::before {
    bottom: 50%;
    left: auto;
    right: 100%;
    transform: translateY(50%) translateX(-4px);
  }
  
  .tooltip-left:hover::before {
    transform: translateY(50%) translateX(-8px);
  }
  
  /* === АНІМАЦІЇ === */
  .animate-fade-in {
    animation: fadeIn var(--transition-base) ease-out forwards;
  }
  
  .animate-fade-out {
    animation: fadeOut var(--transition-base) ease-in forwards;
  }
  
  .animate-slide-in {
    animation: slideIn var(--transition-base) ease-out forwards;
  }
  
  .animate-slide-out {
    animation: slideOut var(--transition-base) ease-in forwards;
  }
  
  .animate-scale-in {
    animation: scaleIn var(--transition-base) ease-out forwards;
  }
  
  .animate-scale-out {
    animation: scaleOut var(--transition-base) ease-in forwards;
  }
  
  .animate-pulse-custom {
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  
  .animate-bounce-custom {
    animation: bounce 1s infinite;
  }
  
  .animate-spin-slow {
    animation: spin 3s linear infinite;
  }
  
  .animate-float {
    animation: float 3s ease-in-out infinite;
  }
  
  /* === ЛОАДЕРИ === */
  .loader {
    width: 40px;
    height: 40px;
    border: 3px solid var(--color-surface-200);
    border-top-color: var(--color-primary-500);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }
  
  .dark .loader {
    border-color: var(--color-surface-700);
    border-top-color: var(--color-primary-400);
  }
  
  .loader-dots {
    display: flex;
    gap: 6px;
  }
  
  .loader-dots div {
    width: 8px;
    height: 8px;
    background: var(--color-primary-500);
    border-radius: 50%;
    animation: dots 1.4s ease-in-out infinite;
  }
  
  .loader-dots div:nth-child(2) {
    animation-delay: 0.2s;
  }
  
  .loader-dots div:nth-child(3) {
    animation-delay: 0.4s;
  }
  
  .dark .loader-dots div {
    background: var(--color-primary-400);
  }
  
  /* === ІНТЕРАКТИВНІ ЕЛЕМЕНТИ === */
  .interactive {
    cursor: pointer;
    user-select: none;
    transition: transform var(--transition-fast);
  }
  
  .interactive:active {
    transform: scale(0.97);
  }
  
  .no-tap-highlight {
    -webkit-tap-highlight-color: transparent;
  }
  
  .draggable {
    cursor: grab;
  }
  
  .draggable:active {
    cursor: grabbing;
  }
  
  /* === ТЕКСТОВІ УТИЛІТИ === */
  .text-balance {
    text-wrap: balance;
  }
  
  .text-pretty {
    text-wrap: pretty;
  }
  
  .truncate-2-lines {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .truncate-3-lines {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  /* === КОНТЕЙНЕРИ === */
  .content-container {
    width: 100%;
    max-width: 1280px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 1rem;
    padding-right: 1rem;
  }
  
  @media (min-width: 640px) {
    .content-container {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }
  }
  
  @media (min-width: 1024px) {
    .content-container {
      padding-left: 2rem;
      padding-right: 2rem;
    }
  }
  
  /* === ДЛЯ ШИРОКОГО КОНТЕНТУ === */
  .overflow-x-auto {
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  
  .max-w-full {
    max-width: 100%;
  }
  
  .min-h-screen-dynamic {
    min-height: 100vh;
    min-height: 100dvh;
  }
}

/* ===== КЛЮЧОВІ КАДРИ АНІМАЦІЙ ===== */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes fadeOut {
  from { opacity: 1; }
  to { opacity: 0; }
}

@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slideOut {
  from {
    opacity: 1;
    transform: translateY(0);
  }
  to {
    opacity: 0;
    transform: translateY(20px);
  }
}

@keyframes scaleIn {
  from {
    opacity: 0;
    transform: scale(0.95);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes scaleOut {
  from {
    opacity: 1;
    transform: scale(1);
  }
  to {
    opacity: 0;
    transform: scale(0.95);
  }
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10px); }
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-6px); }
}

@keyframes dots {
  0%, 80%, 100% {
    transform: scale(0);
    opacity: 0.3;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}

/* ===== ПІДТРИМКА ТЕМНОЇ ТЕМИ ===== */
@custom-variant dark (&:where(.dark, .dark *));

/* ===== МЕДІА ЗАПИТИ ДЛЯ ДОСТУПНОСТІ ===== */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

/* ===== ДРУК ===== */
@media print {
  .no-print {
    display: none !important;
  }
  
  a[href]::after {
    content: " (" attr(href) ")";
  }
/* Стилі для кнопки "наверх" - додайте в кінець файлу */
.scroll-to-top {
    transform: translateZ(0);
    backface-visibility: hidden;
    -webkit-font-smoothing: subpixel-antialiased;
}

/* Анімація появи */
@keyframes fadeInScale {
    from {
        opacity: 0;
        transform: scale(0.5);
    }
    to {
        opacity: 1;
        transform: scale(1);
    }
}

.scroll-to-top[style*="display: flex"] {
    animation: fadeInScale 0.3s cubic-bezier(0.68, -0.55, 0.27, 1.55) forwards;
}
}